    "seabuckthorn_m3": {
      "type": "seabuckthorn-omega-7",
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "num": "①",
            "title": "WHAT IS IT?",
            "content": "A fatty acid. Most people have heard of omega-3. Almost nobody has heard of this one. It's also in mother's milk, oddly enough.",
            "highlight_text": "Highlight Subtext"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "num": "②",
            "title": "WHY IS IT RARE?",
            "content": "Barely any plant makes it. Commercially, it usually comes from fish or from macadamia nuts. Sea buckthorn is the exception.",
            "highlight_text": "Highlight Subtext"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "num": "③",
            "title": "HOW MUCH IS IN HERE?",
            "content": "1,560 mg per 100 ml. That's more omega-7 than omega-3, 6 and 9 combined.",
            "highlight_text": "Highlight Subtext"
          }
        },
        "card_4": {
          "type": "card",
          "settings": {
            "num": "④",
            "title": "SO WHY ISN'T IT EVERYWHERE?",
            "content": "Because the berry is a pain. It grows high up, it grows on thorns, and there are about 3 weeks a year to get it down.",
            "highlight_text": "Sugar water with a mountain on the label is a lot easier to make."
          }
        }
      },
