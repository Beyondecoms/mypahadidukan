    "seabuckthorn_m5": {
      "type": "seabuckthorn-honest-warning",
      "settings": {
        "module_tag": "M5 · Let's be honest — this is not a nice drink",
        "design_tag": "",
        "header_title": "LET'S BE HONEST",
        "main_heading": "You might not love the drink right away!",
        "quote_text": "Sea buckthorn is sour. Properly sour - nearer to unripe citrus than to juice. The first spoonful makes most people's face do something.",
        "body_para1": "Nothing is wrong with your bottle. There's just no sugar in it to hide behind.",
        "body_para2": "One tablespoon in a glass of warm water is how most people take it. Add honey if you like.",
        "handwritten_note": "We won't be offended.",
        "photo_caption": "Real first-sip reaction",
        "bg_color": "#fffbef",
        "card_bg": "#ffffff",
        "card_border_color": "#e7ded0",
        "badge_bg": "#ee5922",
        "badge_color": "#ffffff"
      }
    },
    "seabuckthorn_m6": {
      "type": "seabuckthorn-where-it-comes-from",
      "settings": {
        "module_tag": "",
        "design_tag": "",
        "heading": "PICKED WITH A STICK, OFF A THORN BUSH",
        "subtitle": "Ladakh, 3 weeks every September",
        "stamp_text": "Ladakh Wild Harvest",
        "para_1": "Nobody planted sea buckthorn here. It came up on its own along the riverbeds, the way it has for as long as anyone can remember, and Ladakh has ended up with about 9 of every 10 sea buckthorn berries in India.",
        "para_2": "Picking it is nobody's favourite job. The bush is armed - long thorns, set close - so you don't reach into it. You spread a cloth on the ground, take a stick to the branches, and let the berries come down on their own.",
        "para_3": "Then you hurry. They bruise within hours, so whatever comes down in the morning is pressed by evening. September is the whole season. Miss it and then it’s the next year.",
        "para_4": "And nobody is out there spraying a wild bush by a river at 3,000 metres. There's no one to do it.",
        "bg_color": "#fffbef",
        "heading_color": "#1c1918",
        "badge_bg": "#008b75",
        "badge_color": "#ffffff"
      }
    },
