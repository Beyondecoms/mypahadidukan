        "mission_hGJnTL": {
          "type": "mission",
          "settings": {
            "heading": "Our Mission",
            "description": "We are building the world's first source-to-table Premium Himalayan brand that makes high-quality and authentic Himalayan produce accessible to all."
          }
        },
        "values_x9Kp2L": {
          "type": "values",
          "settings": {
            "heading": "Our Vision",
            "values_list": "Our founders are avid travellers. And travelling over the years, they frequently came across many small businesses selling indigenous, organic and unadulterated goods.\n\nBut these gems were tucked away in the mountains. We aim to provide a platform for all these budding entrepreneurs to connect with people throughout the length and breadth of the nation.\n\nThis helps our eco-conscious buyers get high-quality products at affordable prices. And the absence of intermediaries increases our sellers’ income.\n\nQuality products and solid on-ground impact! This is what we stand for in a nutshell."
          }
        }
      },
      "block_order": [
