        "faq_yXhGCz": {
          "type": "faq",
          "settings": {
            "question": "Is Cash on Delivery available?",
            "answer": "No, not on our own site. Here you can pay by UPI, card, netbanking, or wallet, and there's a no-cost EMI option on UPI for larger orders. If you'd rather pay on delivery, we're on Amazon and Flipkart, and COD works fine on both. Same products, just an easier checkout for anyone who prefers paying at the door."
          }
        },
