        },
        "faq_item_9A7kMF": {
          "type": "faq_item",
          "settings": {
            "question": "Are your products really sourced from the Himalayas?",
            "answer": "Yes. Every product we sell is sourced directly from farmers, self-help groups, and cooperatives across nine Himalayan states — including Kashmir, Ladakh, Himachal Pradesh, Uttarakhand, Sikkim, and Meghalaya — as well as Bhutan. We work source-to-shelf, which means we know exactly where each batch comes from. No middlemen, no mystery sourcing."
          }
        },
        "faq_item_8YnbDh": {
          "type": "faq_item",
          "settings": {
            "question": "How do you verify purity and authenticity?",
            "answer": "Every batch goes through rigorous lab testing before it reaches you. We believe purity should be something you can verify, not just something we claim — so our products are tested for active compounds, contaminants, and adulteration depending on the category. We'd rather show you the process than ask you to take our word for it."
          }
        },
        "faq_item_ph3XB9": {
          "type": "faq_item",
          "settings": {
            "question": "How is Kashmiri Saffron different from regular saffron?",
            "answer": "Real saffron has a distinct colour, aroma, and slightly bitter taste — qualities that cheap imitations (often mixed with dyed look-alikes like Gardenia flower) just can't replicate. To make sure you're getting the real thing, we send our saffron to an independent, government-accredited lab for testing before it's sold. Our latest batch passed all purity and quality checks under India's official food safety standards (FSSAI), confirming it's authentic, high-grade Kashmiri saffron — not a diluted substitute."
          }
        },
        "faq_item_bGjx6i": {
          "type": "faq_item",
          "settings": {
            "question": "What makes your Shilajit different from other brands?",
            "answer": "Most shilajit sold online isn't sourced from Ladakh at all, despite the label. Ours is — harvested from high-altitude rocks in the Ladakh region, then purified using traditional methods to remove impurities while preserving its mineral content. It's 100% pure resin, with no additives or fillers, which is why it's earned recognition as an Amazon's Choice product."
          }
        },
        "faq_item_cjx6ic": {
          "type": "faq_item",
          "settings": {
            "question": "Are your products organic and chemical-free?",
            "answer": "Yes — our products are grown and processed without synthetic chemicals, following traditional Pahadi methods used by mountain communities for generations. We work directly with growers who avoid chemical fertilizers and pesticides, so what you're getting is as close to unprocessed and natural as it gets."
          }
        },
        "faq_item_tPGXJd": {
          "type": "faq_item",
          "settings": {
            "question": "Do you test for heavy metals and contaminants?",
            "answer": "Yes. Categories like Shilajit, A2 Ghee, and spices are particularly prone to contamination or adulteration, so we prioritize lab testing for heavy metals and other contaminants in these products specifically. This testing happens before a batch is approved for sale, not after complaints come in."
          }
        },
        "faq_item_NCNtjd": {
          "type": "faq_item",
          "settings": {
            "question": "Where can I see lab reports and quality certificates?",
            "answer": "We publish third-party lab test reports for key products like our Kashmiri Saffron, tested by independent, ISO-certified labs such as FARE Labs. We're adding more batch-wise reports as products are tested — you'll find these on the relevant product pages so you can verify for yourself."
          }
        },
        "faq_item_pHGJU7": {
          "type": "faq_item",
          "settings": {
            "question": "How do you support the farmers you source from?",
            "answer": "We work directly with farmers, women's collectives, and cooperatives across the Himalayan region, cutting out middlemen so producers earn a fairer share of what their goods sell for. We're also part of the Ministry of Commerce's One District One Product programme, working alongside institutions like IIM Kashipur and IIT Mandi to build a more sustainable supply chain for mountain communities."
          }
        }
      },
