    "faq_home_H8fcf4": {
      "type": "faq-home",
      "blocks": {
        "faq_HzyLtf": {
          "type": "faq",
          "settings": {
            "question": "Are Your Products Authentic And Locally Sourced?",
            "answer": "Yes. Every product comes straight from the person who made it - a farmer, an artisan, or a village self-help group. We've met most of them ourselves, which is how we know it's genuine. A few things reach us through a partner in the region, like our Sikkim cardamom, which comes via Pahari Roots. Either way, we can trace a batch back and tell you where it came from. Simply write in and ask."
          }
        },
        "faq_kQXBxP": {
          "type": "faq",
          "settings": {
            "question": "How Long Does Delivery Take?",
            "answer": "Usually 5-7 days, depending on where you are. You'll get the tracking details once it ships. We ship within 24-48 hours."
          }
        },
        "faq_qjwFAz": {
          "type": "faq",
          "settings": {
            "question": "How do I know the shilajit or saffron is real, not adulterated?",
            "answer": "Fair worry; the market's full of fakes. For products like shilajit and saffron, where adulteration is common, we have each batch tested at an NABL-accredited lab and include the report directly in the product description. Read it before you buy."
          }
        },
        "faq_EzkUGc": {
          "type": "faq",
          "settings": {
            "question": "Do you make your own products, or only sell others'?",
            "answer": "Both, and a bit of a third thing. A few products we make ourselves and lab-test. Most we buy directly from farmers and small makers. And we stock several small mountain brands under their own labels, because they were already doing it so well. Each listing tells you which. Look for the name of the brand in the product title!"
          }
        },
        "faq_mzcHbW": {
          "type": "faq",
          "settings": {
            "question": "Will someone call me asking for payment on a prepaid order?",
            "answer": "No, never. We do not call to collect payment on an order you've already paid for. Our only official numbers are +91 84286 11319 and +91 856994 9587, both listed on the site. Anything else is not from us."
          }
        },
        "faq_WP4QCx": {
          "type": "faq",
          "settings": {
            "question": "Do you ship outside India?",
            "answer": "Yes, to a good number of countries. Rates and timelines are on our international shipping page, and if yours isn't listed, message us on WhatsApp, and we'll find out."
          }
        },
        "faq_yXhGCz": {
          "type": "faq",
          "settings": {
            "question": "Is Cash on Delivery available?",
            "answer": "No, not on our own site. Here you can pay by UPI, card, netbanking, or wallet, and there's a no-cost EMI option on UPI for larger orders. If you'd rather pay on delivery, we're on Amazon and Flipkart, and COD works fine on both. Same products, just an easier checkout for anyone who prefers paying at the door."
          }
        },
        "faq_AKft4p": {
          "type": "faq",
          "settings": {
            "question": "What if my order arrives damaged or something's wrong?",
            "answer": "Message us on WhatsApp with a photo, or email support@mypahadidukan.com. We'll sort it - replacement or refund, whichever suits. You'll hear back from an actual person, usually within half an hour."
          }
        },
        "faq_ggBR9D": {
          "type": "faq",
          "settings": {
            "question": "Do these products treat or cure health conditions?",
            "answer": "No, and we'll be straight about it. These are traditional foods and wellness products, not medicine. They've been part of mountain life for generations, but they aren't clinically proven and aren't meant to diagnose, treat, cure, or prevent anything. If you're pregnant, on medication, or managing a condition, check the label warnings and ask your doctor before trying something new."
          }
        }
      },
