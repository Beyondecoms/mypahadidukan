        "custom_liquid": "<p><meta charset=\"UTF-8\"> <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"></p>\n<style>\n  .store-locator #MainContent{padding-bottom:0;}\n  .sl-wrap{width:100vw;position:relative;left:50%;margin-left:-50vw;overflow-x:hidden;}\n  .sl-wrap *{box-sizing:border-box;}\n  .sl-mono{font-family:'Courier New',Courier,monospace;}\n\n  .sl-controls{background:rgb(var(--color-background));border-bottom:1px solid rgb(var(--color-border));padding:14px 20px;position:sticky;top:0;z-index:50;}\n  .sl-controls__inner{max-width:1200px;margin:0 auto;display:flex;gap:14px;align-items:center;}\n  .sl-search{flex:1;min-width:0;position:relative;}\n  .sl-search input{width:100%;padding:10px 14px 10px 38px;border:1px solid rgb(var(--color-border));border-radius:var(--btn-border-radius, 8px);font-family:var(--font-stack-body);font-size:14px;background:rgb(var(--color-form-field, var(--color-background)));color:rgb(var(--color-foreground));outline:none;transition:border-color .15s;}\n  .sl-search input:focus-visible{border-color:rgb(var(--color-button));outline:2px solid rgb(var(--color-button));outline-offset:1px;}\n  .sl-search svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:rgb(var(--color-foreground-secondary));pointer-events:none;}\n  .sl-count{font-size:11px;letter-spacing:.04em;color:rgb(var(--color-button));white-space:nowrap;border:1px dashed rgb(var(--color-button));border-radius:20px;padding:4px 12px;}\n\n  .sl-intro{max-width:1200px;margin:24px auto 0;padding:0 20px;}\n  .sl-intro p{font-family:var(--font-stack-body);font-size:15px;line-height:1.6;color:rgb(var(--color-foreground-secondary));max-width:56ch;}\n\n  .sl-notice{max-width:1200px;margin:18px auto 0;padding:0 20px;}\n  .sl-notice__inner{background:rgb(var(--color-background-secondary));border:1px dashed rgb(var(--color-border));border-left:3px solid rgb(var(--color-button));border-radius:4px;padding:12px 16px;font-family:var(--font-stack-body);font-size:13px;line-height:1.6;color:rgb(var(--color-foreground));}\n\n  .sl-layout{max-width:1200px;margin:28px auto 0;padding:0 20px 56px;display:grid;grid-template-columns:220px 1fr;gap:36px;align-items:start;}\n\n  .sl-directory{position:sticky;top:70px;max-height:calc(100vh - 90px);overflow-y:auto;}\n  .sl-directory__label{font-family:var(--font-stack-header);font-weight:var(--font-weight-header, 600);font-size:12px;letter-spacing:.04em;color:rgb(var(--color-foreground-secondary));text-transform:uppercase;margin-bottom:10px;}\n  .sl-directory__letter{font-size:10px;letter-spacing:.15em;color:rgb(var(--color-button));margin:16px 0 4px 10px;}\n  .sl-directory__letter:first-of-type{margin-top:4px;}\n  .sl-row{all:unset;box-sizing:border-box;cursor:pointer;display:flex;align-items:baseline;gap:6px;width:100%;padding:7px 8px;border-radius:var(--btn-border-radius, 8px);transition:background-color .15s,color .15s;}\n  .sl-row:hover{background:rgb(var(--color-background-secondary));}\n  .sl-row:focus-visible{outline:2px solid rgb(var(--color-button));outline-offset:1px;}\n  .sl-row.is-active{background:rgb(var(--color-button));}\n  .sl-row.is-active .sl-row__name,.sl-row.is-active .sl-row__count{color:rgb(var(--color-button-text));}\n  .sl-row.is-active .sl-row__leader{border-color:rgba(255,255,255,.4);}\n  .sl-row__badge{width:20px;height:20px;flex-shrink:0;align-self:center;border-radius:50%;border:1.5px dashed rgb(var(--color-button));color:rgb(var(--color-button));display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:700;letter-spacing:.02em;}\n  .sl-row.is-active .sl-row__badge{border-color:rgb(var(--color-button-text));color:rgb(var(--color-button-text));}\n  .sl-row__badge--all{border-style:solid;background:rgb(var(--color-button));color:rgb(var(--color-button-text));}\n  .sl-row__name{font-family:var(--font-stack-body);font-size:13.5px;color:rgb(var(--color-foreground));white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n  .sl-row__leader{flex:1;min-width:6px;border-bottom:1px dashed rgb(var(--color-border));margin:0 2px 3px;}\n  .sl-row__count{font-size:11px;color:rgb(var(--color-foreground-secondary));}\n\n  .sl-content{min-width:0;}\n  .sl-city{display:flex;align-items:baseline;gap:8px;padding-bottom:10px;margin-bottom:16px;border-bottom:1px dashed rgb(var(--color-border));}\n  .sl-city:not(:first-child){margin-top:40px;}\n  .sl-city__dot{width:7px;height:7px;border-radius:50%;background:rgb(var(--color-button));flex-shrink:0;}\n  .sl-city__name{font-family:var(--font-stack-header);font-weight:var(--font-weight-header, 600);font-size:20px;color:rgb(var(--color-heading));}\n  .sl-city__count{font-size:11px;color:rgb(var(--color-foreground-secondary));margin-left:auto;white-space:nowrap;}\n\n  .sl-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:16px;}\n\n  .sl-card{background:rgb(var(--color-background));border:1px solid rgb(var(--color-border));border-radius:var(--pcard-radius, 10px);padding:20px;display:flex;flex-direction:column;gap:12px;transition:border-color .15s,box-shadow .15s;}\n  .sl-card:hover{border-color:rgb(var(--color-button));box-shadow:0 2px 10px rgba(0,0,0,.06);}\n  .sl-card__head{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;}\n  .sl-card__name{font-family:var(--font-stack-header);font-weight:var(--font-weight-header, 600);font-size:16px;color:rgb(var(--color-heading));line-height:1.35;}\n  .sl-card__type{display:inline-block;font-family:var(--font-stack-body);font-size:11px;color:rgb(var(--color-foreground-secondary));background:rgb(var(--color-background-secondary));padding:2px 8px;border-radius:20px;margin-top:6px;}\n  .sl-card__badge{width:38px;height:38px;flex-shrink:0;border-radius:50%;border:1.5px dashed rgb(var(--color-button));color:rgb(var(--color-button));display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;transform:rotate(-6deg);}\n  .sl-meta{display:flex;flex-direction:column;gap:8px;}\n  .sl-meta__row{display:flex;align-items:flex-start;gap:8px;font-family:var(--font-stack-body);font-size:13px;color:rgb(var(--color-foreground-secondary));line-height:1.55;}\n  .sl-meta__row svg{flex-shrink:0;margin-top:2px;color:rgb(var(--color-foreground-secondary));}\n  .sl-map{width:100%;height:130px;border:1px solid rgb(var(--color-border));border-radius:6px;}\n  .sl-card__stub{border-top:1px dashed rgb(var(--color-border));padding-top:12px;margin-top:2px;}\n\n  .sl-empty{text-align:center;padding:64px 24px;display:none;}\n  .sl-empty p{font-family:var(--font-stack-body);font-size:14px;color:rgb(var(--color-foreground-secondary));margin-top:12px;}\n\n  .sl-tape{max-width:1200px;margin:8px auto 0;height:4px;background:repeating-linear-gradient(90deg, rgb(var(--color-button)) 0 10px, rgb(var(--color-heading)) 10px 20px);opacity:.55;}\n  .sl-footer{padding:28px 20px 32px;text-align:center;background:rgb(var(--color-background-secondary));border-top:1px dashed rgb(var(--color-border));font-family:var(--font-stack-body);font-size:13px;color:rgb(var(--color-foreground-secondary));}\n  .sl-footer a{color:rgb(var(--color-button));text-decoration:underline;}\n\n  @media(max-width:1023px){\n    .sl-layout{grid-template-columns:1fr;gap:0;padding:0 0 40px;}\n    .sl-directory{position:static;max-height:none;overflow:visible;display:flex;align-items:center;gap:8px;overflow-x:auto;padding:14px 20px;margin:0 0 4px;border-bottom:1px solid rgb(var(--color-border));}\n    .sl-directory__label,.sl-directory__letter,.sl-row__leader{display:none;}\n    .sl-row{flex:none;padding:8px 14px;border:1px solid rgb(var(--color-border));border-radius:20px;}\n    .sl-row.is-active{border-color:rgb(var(--color-button));}\n    .sl-content{padding:20px;}\n  }\n\n  @media (prefers-reduced-motion: reduce){\n    .sl-card,.sl-row{transition:none;}\n  }\n</style>\n<div class=\"sl-wrap\">\n<div class=\"sl-controls\">\n  <div class=\"sl-controls__inner\">\n    <div class=\"sl-search\">\n      <svg stroke-width=\"2\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" fill=\"none\" height=\"15\" width=\"15\" xmlns=\"http://www.w3.org/2000/svg\"><circle r=\"8\" cy=\"11\" cx=\"11\"></circle><path d=\"M21 21l-4.35-4.35\"></path></svg>\n      <input placeholder=\"Search store, city or address...\" id=\"search-input\" type=\"text\">\n    </div>\n    <span id=\"store-count\" class=\"sl-count sl-mono\"></span>\n  </div>\n</div>\n\n<div class=\"sl-intro\">\n</div>\n\n<div class=\"sl-notice\">\n  <div class=\"sl-notice__inner\">These are third-party retail stores, not official MPD stores — please don't contact them for complaints or out-of-city deliveries.</div>\n</div>\n\n<div class=\"sl-layout\">\n  <aside class=\"sl-directory\" id=\"manifest\"></aside>\n  <main class=\"sl-content\">\n    <div id=\"cities-container\"></div>\n    <div id=\"empty-state\" class=\"sl-empty\">\n      <svg stroke-width=\"1.5\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" fill=\"none\" height=\"40\" width=\"40\" xmlns=\"http://www.w3.org/2000/svg\" style=\"color:rgb(var(--color-border))\"><path d=\"M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z\" stroke-linejoin=\"round\" stroke-linecap=\"round\"></path></svg>\n      <p>No stores found</p>\n    </div>\n  </main>\n</div>\n\n<div class=\"sl-tape\"></div>\n<footer class=\"sl-footer\">Know a store that stocks our products? <a href=\"mailto:hello@mypahadidukan.com\">Let us know</a> and we'll add it here.</footer>\n</div>\n<script>\n(function(){\n  var STORES = [\n    { city: 'Bahadurgarh', name: 'Shudh Native Organics', type: 'Organic Store', address: 'Gali No. 2, Jhajjar Rd, near Royal Enfield Showroom, Krishna Colony, Bahadurgarh, Haryana 124507', phone: '' },\n    { city: 'Lucknow', name: 'New Lucknow Store', type: 'Grocery Store', address: 'Picnic Spot Road, Khurram Nagar Rd, opp. Fatimi Masjid, Sector 8, Vikas Nagar, Lucknow, UP 226022', phone: '08881999204' }\n  ];\n\n  var manifestEl = document.getElementById('manifest');\n  var citiesContainer = document.getElementById('cities-container');\n  var emptyState = document.getElementById('empty-state');\n  var storeCount = document.getElementById('store-count');\n  var searchInput = document.getElementById('search-input');\n\n  function cityCode(city){\n    var words = city.trim().split(/\\s+/);\n    if (words.length > 1) return (words[0][0] + words[1][0]).toUpperCase();\n    return city.slice(0, 2).toUpperCase();\n  }\n\n  function mapSrc(address){\n    return 'https://www.google.com/maps?q=' + encodeURIComponent(address) + '&output=embed';\n  }\n\n  function directionsHref(address){\n    return 'https://www.google.com/maps/dir/?api=1&destination=' + encodeURIComponent(address);\n  }\n\n  var cities = [];\n  STORES.forEach(function(s){ if (cities.indexOf(s.city) === -1) cities.push(s.city); });\n  cities.sort(function(a, b){ return a.localeCompare(b); });\n\n  function buildManifest(){\n    var html = '<div class=\"sl-directory__label\">Directory</div>';\n    html += '<button class=\"sl-row is-active\" data-city=\"all\">' +\n      '<span class=\"sl-row__badge sl-row__badge--all sl-mono\">&#10003;</span>' +\n      '<span class=\"sl-row__name\">All locations</span>' +\n      '<span class=\"sl-row__leader\"></span>' +\n      '<span class=\"sl-row__count sl-mono\">' + STORES.length + '</span>' +\n      '</button>';\n\n    var lastLetter = '';\n    cities.forEach(function(city){\n      var letter = city.charAt(0).toUpperCase();\n      if (letter !== lastLetter){\n        html += '<div class=\"sl-directory__letter sl-mono\">' + letter + '</div>';\n        lastLetter = letter;\n      }\n      var count = STORES.filter(function(s){ return s.city === city; }).length;\n      html += '<button class=\"sl-row\" data-city=\"' + city + '\">' +\n        '<span class=\"sl-row__badge sl-mono\">' + cityCode(city) + '</span>' +\n        '<span class=\"sl-row__name\">' + city + '</span>' +\n        '<span class=\"sl-row__leader\"></span>' +\n        '<span class=\"sl-row__count sl-mono\">' + count + '</span>' +\n        '</button>';\n    });\n\n    manifestEl.innerHTML = html;\n  }\n\n  function storeCard(store){\n    var phoneRow = store.phone\n      ? '<div class=\"sl-meta__row\"><svg stroke-width=\"1.5\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" fill=\"none\" height=\"14\" width=\"14\"><path stroke-linejoin=\"round\" stroke-linecap=\"round\" d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z\"></path></svg><span>' + store.phone + '</span></div>'\n      : '';\n\n    return '' +\n      '<div class=\"sl-card\">' +\n        '<div class=\"sl-card__head\">' +\n          '<div><div class=\"sl-card__name\">' + store.name + '</div><span class=\"sl-card__type\">' + store.type + '</span></div>' +\n          '<div class=\"sl-card__badge sl-mono\">' + cityCode(store.city) + '</div>' +\n        '</div>' +\n        '<div class=\"sl-meta\">' +\n          '<div class=\"sl-meta__row\"><svg stroke-width=\"1.5\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" fill=\"none\" height=\"14\" width=\"14\"><path stroke-linejoin=\"round\" stroke-linecap=\"round\" d=\"M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z\"></path><circle stroke-linejoin=\"round\" stroke-linecap=\"round\" r=\"3\" cy=\"10\" cx=\"12\"></circle></svg><span>' + store.address + '</span></div>' +\n          phoneRow +\n        '</div>' +\n        '<iframe class=\"sl-map\" loading=\"lazy\" src=\"' + mapSrc(store.address) + '\"></iframe>' +\n        '<div class=\"sl-card__stub\">' +\n          '<a class=\"m-button m-button--primary\" target=\"_blank\" rel=\"noopener\" href=\"' + directionsHref(store.address) + '\">Directions</a>' +\n        '</div>' +\n      '</div>';\n  }\n\n  var activeCity = 'all';\n  var activeQuery = '';\n\n  function render(){\n    var query = activeQuery.trim().toLowerCase();\n    var filtered = STORES.filter(function(s){\n      var cityMatch = activeCity === 'all' || s.city === activeCity;\n      var textMatch = !query || s.name.toLowerCase().indexOf(query) !== -1 || s.city.toLowerCase().indexOf(query) !== -1 || s.address.toLowerCase().indexOf(query) !== -1;\n      return cityMatch && textMatch;\n    });\n\n    var byCity = {};\n    filtered.forEach(function(s){\n      if (!byCity[s.city]) byCity[s.city] = [];\n      byCity[s.city].push(s);\n    });\n\n    citiesContainer.innerHTML = cities\n      .filter(function(city){ return byCity[city]; })\n      .map(function(city){\n        var stores = byCity[city];\n        return '' +\n          '<div class=\"sl-city\"><span class=\"sl-city__dot\"></span><span class=\"sl-city__name\">' + city + '</span><span class=\"sl-city__count sl-mono\">' + stores.length + ' store' + (stores.length > 1 ? 's' : '') + '</span></div>' +\n          '<div class=\"sl-grid\">' + stores.map(storeCard).join('') + '</div>';\n      }).join('');\n\n    emptyState.style.display = filtered.length ? 'none' : 'block';\n    storeCount.textContent = filtered.length + ' store' + (filtered.length === 1 ? '' : 's') + (activeCity !== 'all' ? ' in ' + activeCity : '');\n  }\n\n  manifestEl.addEventListener('click', function(e){\n    var btn = e.target.closest('.sl-row');\n    if (!btn) return;\n    manifestEl.querySelectorAll('.sl-row').forEach(function(r){ r.classList.remove('is-active'); });\n    btn.classList.add('is-active');\n    activeCity = btn.getAttribute('data-city');\n    render();\n  });\n\n  searchInput.addEventListener('input', function(e){\n    activeQuery = e.target.value;\n    render();\n  });\n\n  buildManifest();\n  render();\n})();\n</script>\n<p>&nbsp;</p>",
        "custom_class": ""
      }
    }
