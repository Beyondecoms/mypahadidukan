<option
  value="{{ pack.id }}"
  data-available="{{ pack.available }}"
  data-price="{{ price | escape }}"
  data-compare-price="{{ compare_price | escape }}"
  data-discount="{{ discount | escape }}"
  {% if pack.id == selected_pack.id %}selected{% endif %}
>
  {{- title | escape -}}
  {%- unless pack.available %} — {{ soldout_label | escape }}{% endunless -%}
</option>
