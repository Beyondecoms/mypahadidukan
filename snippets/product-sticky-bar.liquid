<style>
    /* ── STICKY BOTTOM BAR ── */
.psb-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 8000;
  background: #ffffff;
  border-top: 1px solid rgba(0,0,0,0.1);
  box-shadow: 0 -4px 20px rgba(0,0,0,0.1);
  padding: 12px 24px;

  /* Slide up animation */
  animation: psb-slide-up 0.3s ease forwards;
}

@keyframes psb-slide-up {
  from { transform: translateY(100%); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}

/* ── INNER ── */
.psb-inner {
  width: 100%;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

/* ── PRODUCT INFO ── */
.psb-product {
  display: flex;
  align-items: center;
  gap: 14px;
  flex: 1;
  min-width: 0;
}

/* ── IMAGE ── */
.psb-img-wrap {
  flex-shrink: 0;
  width: 60px;
  height: 60px;
  border-radius: 8px;
  overflow: hidden;
  background: #f5f5f5;
  border: 1px solid rgba(0,0,0,0.08);
}

.psb-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ── INFO TEXT ── */
.psb-info {
  display: flex;
  flex-direction: column;
  gap:0px;
}

.psb-title {
    font-size: 14px;
    font-weight: 400;
    color: #010000;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 500px;
    font-family: var(--font-family-normal);
}

.psb-price-row {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.psb-compare {
    font-size: 14px;
    color: #A1A4AC;
    font-weight: 500;
    text-decoration: line-through;
    font-family: var(--font-family-normal);
}

.psb-price {
    font-size: 16px;
    font-weight: 500;
    color: #231F20;
    font-family: var(--font-family-normal);
}

.psb-discount {
  background: #F3743C;
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  padding: 4px;
  border-radius: 4px;
  line-height: 100%;
  font-family: var(--font-family-normal);
}

/* ── ADD TO CART BUTTON ── */
.psb-atc-btn {
  flex-shrink: 0;
  padding: 18px 61px;
  background: var(--primary-web-color);
  color: #fff;
  border: none;
  border-radius: 12px;
  font-size: 18px;
  font-weight: 700;
  cursor: pointer;
  font-family: var(--font-family-normal);
  letter-spacing: 0.02em;
  transition: background 0.2s ease, transform 0.15s ease;
  white-space: nowrap;
}

.psb-atc-btn:hover {
  background: #155c3e;
  transform: translateY(-1px);
}

.psb-atc-btn:disabled {
  opacity: 0.7;
  cursor: default;
  transform: none;
}

/* ── OUT OF STOCK / NOTIFY ME (sticky bar) ── */
.psb-atc-btn--oos {
  background: #e0e0e0;
  color: #999;
  cursor: not-allowed;
  pointer-events: none;
}

.psb-atc-btn--oos:hover {
  background: #e0e0e0;
  transform: none;
}

.psb-notify-btn {
  flex-shrink: 0;
  padding: 18px 61px;
  background: #e0e0e0;
  color: #777;
  border: none;
  border-radius: 12px;
  font-size: 18px;
  font-weight: 700;
  cursor: pointer;
  font-family: var(--font-family-normal);
  letter-spacing: 0.02em;
  transition: background 0.2s ease, transform 0.15s ease;
  white-space: nowrap;
}

.psb-notify-btn:disabled {
  cursor: not-allowed;
}

.psb-atc-btn:disabled {
  background: #e0e0e0;
  color: #777;
}

.psb-bar {
  flex-wrap: wrap;
}

.psb-cart-error {
  flex-basis: 100%;
  margin: 6px 0 0;
  font-size: 13px;
  color: #b42318;
}

.psb-variant-select{
  display: none;
}
.psb-bar-desktop{
  display: block;
  width: 100%;
}
.psb-bar-mobile{
  display: none;
}
/* ── HIDE ON MOBILE (mobile has its own sticky bar) ── */
@media (max-width: 768px) {
  .psb-bar-mobile{
  display: block;
  width: 100%;
}
.psb-bar-desktop{
  display: none;
}
  .psb-variant-select{
    display: block;
  }
  .psb-bar{
    padding: 10px 14px;
    background: #fff;
    border-top: 1px solid #e5e5e5;
  }

  .psb-inner{
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Product Image */
  .psb-img-wrap{
    width: 58px;
    height: 58px;
    border-radius: 12px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .psb-img-wrap img{
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Product info */
  .psb-product{
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .psb-info{
    flex: 1;
    min-width: 0;
  }

  .psb-title{
        font-size: 13px;
        font-weight: 500;
        line-height: 1.3;
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
        width:280px;
  }
  .atc-select{
    flex-direction: row;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  /* Variant dropdown style */
  .psb-price-row{
    display: none;
  }

  .psb-variant-select{
    width: 100%;
    height: 44px;
    border: 1px solid #ddd;
    border-radius: 14px;
    padding: 0 14px;
    font-size: 15px;
    background: #fff;
    outline: none;
  }

  /* Button */
  .psb-atc-btn,
  .psb-notify-btn{
    height: 44px;
    padding: 0 26px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    flex-shrink: 0;
  }
}
</style>

{%- comment -%}
  Sticky Add to Cart bar on the product page. Shows once the page's own Add to
  Cart has scrolled out of view. Its pack menu, price and button share the
  page's selected pack and quantity (assets/product-main.js).
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_compare = false
  if current_variant.compare_at_price > current_variant.price
    assign has_compare = true
    assign disc = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price
  endif
-%}

{%- capture variant_options -%}
  {%- for variant in product.variants -%}
    <option value="{{ variant.id }}"{% if variant.id == current_variant.id %} selected{% endif %}>
      {{- variant.title | escape }}{% unless variant.available %} (Sold out){% endunless -%}
    </option>
  {%- endfor -%}
{%- endcapture -%}

<div class="psb-bar" id="psb-bar" style="display: none;">
  <div class="psb-bar-desktop">
    <div class="psb-inner">
      <!-- Product Image + Info -->
      <div class="psb-product">
        <div class="psb-img-wrap">
          <img
            src="{{ product.featured_image | image_url: width: 120 }}"
            alt=""
            width="60"
            height="60"
            loading="lazy"
          >
        </div>
        <div class="psb-info">
          <p class="psb-title">{{ product.title }}</p>
          {%- unless product.has_only_default_variant -%}
            <select class="psb-variant-select" aria-label="Pack">{{ variant_options }}</select>
          {%- endunless -%}
          <div class="psb-price-row">
            <span class="psb-compare"{% unless has_compare %} hidden{% endunless %}>
              {%- if has_compare %}₹{{ current_variant.compare_at_price | money_without_currency }}{% endif -%}
            </span>
            <span class="psb-price">₹{{ current_variant.price | money_without_currency }}</span>
            <span class="psb-discount"{% unless has_compare %} hidden{% endunless %}>{{ disc }}% off</span>
          </div>
        </div>
      </div>
      <!-- Add to Cart Button -->
      {%- if product.available -%}
        <button type="button" class="psb-atc-btn" data-psb-atc>Add to Cart</button>
      {%- else -%}
        <button type="button" class="psb-notify-btn" disabled>Out Of Stock</button>
      {%- endif -%}
    </div>
  </div>
  <div class="psb-bar-mobile">
    <div class="psb-inner">
      <div class="psb-bar-mobile-right">
        <div class="psb-img-wrap">
          <img
            src="{{ product.featured_image | image_url: width: 120 }}"
            alt=""
            width="60"
            height="60"
            loading="lazy"
          >
        </div>
      </div>
      <div class="psb-bar-mobile-left">
        <p class="psb-title">{{ product.title }}</p>
        <div class="atc-select">
          {%- unless product.has_only_default_variant -%}
            <select class="psb-variant-select" aria-label="Pack">{{ variant_options }}</select>
          {%- endunless -%}
          {%- if product.available -%}
            <button type="button" class="psb-atc-btn" data-psb-atc>Add to Cart</button>
          {%- else -%}
            <button type="button" class="psb-notify-btn" disabled>Out Of Stock</button>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
  <p class="psb-cart-error" data-psb-cart-error role="alert" hidden></p>
</div>
