{% comment %}
  collection-inline-icon-box.liquid
  -----------------------------------
  Renders the region-selector icon-box inline inside the collection product grid.
  This is the single source of truth for the block DATA — mirrors the settings
  
  from the "icon_box_8ndJdD" section in collection.json.  The styling reuses the same classes from icon-box.liquid / icon-box.css so

  there is NO duplicated CSS. Only the section-ID-scoped inline <style> block
  uses a stable class selector instead of #m-section--{{ section.id }}.

  This snippet accepts no parameters — it is self-contained.
{% endcomment %}

{% liquid
  assign ib_image_max_width = '140px'
  assign ib_item_per_row    = 9
  assign ib_item_gap        = 2
  assign ib_container       = 'container'
%}

<style>
  .m-collection-inline-icon-box-row {
    flex: 0 0 100% !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 24px 0 !important;
    padding: 0 !important;
    min-width: 0 !important;
    overflow: hidden !important;
    grid-column: 1 / -1 !important;
  }

  .m-collection-inline-icon-box {
    --section-padding-top: 20px;
    --section-padding-bottom: 20px;
    --column-gap: 2px;
    --column-gap-mobile: 2px;
    --row-gap: 12px;
    --row-gap-mobile: 22px;
    --items: 9;
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .m-collection-inline-icon-box .shop-region__shell {
    position: relative;
    padding-top: 8px;
    padding-bottom: 8px;
  }

  .m-collection-inline-icon-box .shop-region__grid {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    gap: 0px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 10px;
    position: relative;
    z-index: 1;
  }
  @media only screen and (max-width: 769px){
    .m-collection-inline-icon-box .shop-region__grid{
      }
      display: grid;
  }

  .m-collection-inline-icon-box .shop-region__grid::-webkit-scrollbar {
    height: 6px;
  }

  .m-collection-inline-icon-box .shop-region__grid::-webkit-scrollbar-thumb {
    background: #c7b299;
    border-radius: 20px;
  }

  .m-collection-inline-icon-box .shop-region__column {
    flex: 0 0 16%;
    scroll-snap-align: start;
  }
  height: auto;

  .m-collection-inline-icon-box .shop-region__card {
    height: 100%;
    border-radius: 26px;
    padding: 0px;
    transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
    backdrop-filter: blur(6px);
  }

  .m-collection-inline-icon-box .shop-region__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 42px rgba(81, 52, 23, 0.14);
    border-color: rgba(135, 95, 56, 0.22);
  }

  .m-collection-inline-icon-box .shop-region__card-inner {
    gap: 14px;
    align-items: center;
  }

  .m-collection-inline-icon-box .shop-region__media-wrap {
    width: 100%;
    max-width: 140px;
    margin-inline: auto;
    border-radius: 22px;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(255,255,255,0.36), rgba(255,255,255,0.08));
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.5);
  }

  .m-collection-inline-icon-box .shop-region__media-wrap img,
  .m-collection-inline-icon-box .shop-region__media-wrap .m-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 22px;
    transform: scale(1);
    transition: transform 0.35s ease;
  }

  .m-collection-inline-icon-box .shop-region__card:hover .shop-region__media-wrap img,
  .m-collection-inline-icon-box .shop-region__card:hover .shop-region__media-wrap .m-image {
    transform: scale(1.05);
  }

  .m-collection-inline-icon-box .shop-region__content {
    padding: 4px 4px 2px;
  }

  .m-collection-inline-icon-box .shop-region__title {
    margin: 0 0 8px;
    font-size: clamp(1rem, 0.95rem + 0.4vw, 1.15rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.01em;
    color: rgba(67, 39, 16, 0.96);
  }

  @media (max-width: 768px) {
    .m-collection-inline-icon-box .shop-region__column {
      flex: 0 0 30%;
    }
    .m-collection-inline-icon-box .shop-region__card {
      height: auto !important;
      padding: 0 !important;
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
    }
    .m-collection-inline-icon-box .shop-region__grid {
      gap: 8px !important;
    }
    .m-collection-inline-icon-box .m-icon-box__icon {
      width: 120px !important;
    }
    .m-collection-inline-icon-box .shop-region__card-inner {
      gap: 10px;
    }
    .m-collection-inline-icon-box .shop-region__content {
      padding: 2px 2px 0;
    }
    .m-collection-inline-icon-box .shop-region__title {
      font-size: 0.98rem;
    }
  }
</style>

