{% comment %}
  Render the dedicated Product Certificate block
{% endcomment %}
{% assign lab_reports = product.metafields.custom.lab_report_link.value %}
{% assign reports_count = lab_reports.size %}

{% comment %} Temporary debug check {% endcomment %}
<!-- DEBUG: {{ product.metafields.custom.lab_report_link }} -->
<!-- DEBUG VALUE: {{ product.metafields.custom.lab_report_link.value | json }} -->

{% if lab_reports != blank %}
  {% if reports_count > 1 %}
    {% comment %} RENDER MULTIPLE REPORTS POPUP TRIGGER LAYOUT {% endcomment %}
    <div class="lab-certificate-wrapper" {{ block.shopify_attributes }}>
      <h4 class="lab-certificate__heading">CERTIFICATE</h4>

      <div class="lab-certificate__card">
        <div class="lab-certificate__left">
          <img 
            src="https://cdn.shopify.com/s/files/1/0746/0952/5042/files/lab-tested_icon_ab628022-9076-49e0-b1c7-7437b71236b8.svg?v=1782807472" 
            alt="Lab Tested" 
            class="lab-certificate__stamp-img" 
            loading="lazy" 
            width="70" 
            height="70"
          >
        </div>

        <div class="lab-certificate__right">
          <div class="lab-certificate__title">Lab Tested & Verified</div>
          
          <div class="lab-certificate__badges">
            <span class="lab-badge lab-badge--purity">
              <span>●</span> Purity
            </span>
            <span class="lab-badge lab-badge--metals">
              <span>●</span> Heavy Metals
            </span>
            <span class="lab-badge lab-badge--pesticides">
              <span>●</span> Pesticides
            </span>
            <span class="lab-badge lab-badge--active">
              <span>●</span> Active Ingredients
            </span>
          </div>

          <div class="lab-certificate__reports">
            <div class="lab-certificate__link-row">
              <a href="#" class="lab-certificate__link js-open-reports-modal">
                View Authenticity Report &nbsp;&rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    {% comment %} Modal Popup Dialog HTML {% endcomment %}
    <div id="lab-reports-modal" class="lab-reports-modal-overlay" style="display: none;">
      <div class="lab-reports-modal-content">
        <button type="button" class="lab-reports-modal-close" aria-label="Close modal">&times;</button>
        <h3 class="lab-reports-modal-title">Lab Reports</h3>
        <p class="lab-reports-modal-subtitle">Select a report to view</p>
        
        <div class="lab-reports-modal-grid">
          {% for link in lab_reports %}
            {% if link.url != blank %}
              <div class="lab-reports-modal-item" data-url="{{ link.url }}">
                <div class="lab-reports-modal-icon-circle">
                  <img 
                    src="https://cdn.shopify.com/s/files/1/0746/0952/5042/files/lab-tested_icon_ab628022-9076-49e0-b1c7-7437b71236b8.svg?v=1782807472" 
                    alt="Lab Icon" 
                    class="lab-reports-modal-icon" 
                    width="40" 
                    height="40"
                    loading="lazy"
                  >
                  <div class="lab-reports-modal-arrow">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" width="10" height="10">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </div>
                </div>
                <span class="lab-reports-modal-label">{{ link.text }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    {% comment %} Popup Trigger and Click Actions Javascript {% endcomment %}
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const trigger = document.querySelector('.js-open-reports-modal');
        const modal = document.getElementById('lab-reports-modal');
        const closeBtn = document.querySelector('.lab-reports-modal-close');
        
        if (!trigger || !modal) return;

        function openModal() {
          modal.classList.add('is-active');
          document.body.style.overflow = 'hidden';
        }

        function closeModal() {
          modal.classList.remove('is-active');
          document.body.style.overflow = '';
        }

        trigger.addEventListener('click', function(e) {
          e.preventDefault();
          openModal();
        });

        if (closeBtn) {
          closeBtn.addEventListener('click', closeModal);
        }

        modal.addEventListener('click', function(e) {
          if (e.target === modal) {
            closeModal();
          }
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && modal.classList.contains('is-active')) {
            closeModal();
          }
        });

        const items = modal.querySelectorAll('.lab-reports-modal-item');
        items.forEach(item => {
          item.addEventListener('click', function() {
            const url = this.getAttribute('data-url');
            closeModal();
            if (url) {
              window.open(url, '_blank', 'noopener,noreferrer');
            }
          });
        });
      });
    </script>
  {% else %}
    {% comment %} RENDER SINGLE HORIZONTAL CARD LAYOUT (SEABUCKTHORN / SINGLE LINK) {% endcomment %}
    {% assign single_link = lab_reports | first %}
    {% if single_link.url != blank %}
      <div class="lab-certificate-wrapper" {{ block.shopify_attributes }}>
        <h4 class="lab-certificate__heading">CERTIFICATE</h4>

        <div class="lab-certificate__card">
          <div class="lab-certificate__left">
            <img 
              src="https://cdn.shopify.com/s/files/1/0746/0952/5042/files/lab-tested_icon_ab628022-9076-49e0-b1c7-7437b71236b8.svg?v=1782807472" 
              alt="Lab Tested" 
              class="lab-certificate__stamp-img" 
              loading="lazy" 
              width="70" 
              height="70"
            >
          </div>

          <div class="lab-certificate__right">
            <div class="lab-certificate__title">Lab Tested & Verified</div>
            
            <div class="lab-certificate__badges">
              <span class="lab-badge lab-badge--purity">
                <span>●</span> Purity
              </span>
              <span class="lab-badge lab-badge--metals">
                <span>●</span> Heavy Metals
              </span>
              <span class="lab-badge lab-badge--pesticides">
                <span>●</span> Pesticides
              </span>
              <span class="lab-badge lab-badge--active">
                <span>●</span> Active Ingredients
              </span>
            </div>

            <div class="lab-certificate__reports">
              <div class="lab-certificate__link-row">
                <a href="{{ single_link.url }}" target="_blank" rel="noopener" class="lab-certificate__link">
                  View Authenticity Report &nbsp;&rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    {% endif %}
  {% endif %}

  <style>
    /* Global block container styles */
    .lab-certificate-wrapper {
      margin: 20px 0;
      width: 100%;
    }

    /* Single Card Design CSS */
    .lab-certificate__heading {
      font-size: 16px !important;
      font-weight: 700 !important;
      color: #222 !important;
      margin: 0 0 12px 0 !important;
      text-transform: uppercase !important;
      letter-spacing: 0.05em !important;
      line-height: 1.2 !important;
    }

    .lab-certificate__card {
      display: flex !important;
      align-items: center !important;
      background-color: #fafbf9 !important;
      border: 1px solid #e2ebd5 !important;
      border-radius: 22px !important;
      padding: 28px !important;
      width: 100% !important;
      box-sizing: border-box !important;
      gap: 24px !important;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }

    a.lab-certificate__card {
      text-decoration: none !important;
      color: inherit !important;
    }

    .lab-certificate__card:hover {
      background-color: #f4f6f1 !important;
      border-color: #d1dbbf !important;
      transform: translateY(-2px) !important;
      box-shadow: 0 6px 15px rgba(162, 185, 134, 0.12) !important;
    }

    .lab-certificate__left {
      flex: 0 0 70px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    .lab-certificate__stamp-img {
      width: 70px !important;
      height: 70px !important;
      object-fit: contain !important;
    }

    .lab-certificate__right {
      flex: 1 !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 12px !important;
      text-align: left !important;
    }

    .lab-certificate__title {
      font-size: 22px !important;
      font-weight: 600 !important;
      color: #111 !important;
      margin: 0 !important;
      line-height: 1.3 !important;
    }

    .lab-certificate__badges {
      display: flex !important;
      flex-wrap: wrap !important;
      gap: 8px !important;
    }

    .lab-badge {
      display: inline-flex !important;
      align-items: center !important;
      gap: 6px !important;
      padding: 6px 12px !important;
      border-radius: 999px !important;
      font-size: 14px !important;
      font-weight: 600 !important;
      line-height: 1.2 !important;
    }

    .lab-badge span {
      font-size: 8px !important;
      margin-right: 2px !important;
      display: inline-block !important;
    }

    /* Purity Badge */
    .lab-badge--purity {
      background-color: #ecf3e6 !important;
      color: #3b6b2e !important;
    }
    .lab-badge--purity span {
      color: #3b6b2e !important;
    }

    /* Heavy Metals Badge */
    .lab-badge--metals {
      background-color: #f7ede2 !important;
      color: #7b5930 !important;
    }
    .lab-badge--metals span {
      color: #7b5930 !important;
    }

    /* Pesticides Badge */
    .lab-badge--pesticides {
      background-color: #f1ecf7 !important;
      color: #5c3b82 !important;
    }
    .lab-badge--pesticides span {
      color: #5c3b82 !important;
    }

    /* Active Ingredients Badge */
    .lab-badge--active {
      background-color: #e6eef7 !important;
      color: #31588c !important;
    }
    .lab-badge--active span {
      color: #31588c !important;
    }

    .lab-certificate__reports {
      display: flex !important;
      flex-direction: column !important;
      gap: 8px !important;
      margin-top: 4px !important;
    }

    .lab-certificate__link-row {
      display: block !important;
    }

    .lab-certificate__link {
      font-size: 16px !important;
      font-weight: 600 !important;
      color: #2b5b3c !important;
      text-decoration: underline !important;
      text-underline-offset: 4px !important;
      transition: color 0.2s ease !important;
      display: inline-block !important;
    }

    .lab-certificate__link:hover {
      color: #1b3d26 !important;
    }

    /* Modal dialog overlay styles */
    .lab-reports-modal-overlay {
      position: fixed !important;
      inset: 0 !important;
      z-index: 10000 !important;
      background: rgba(0,0,0,0.5) !important;
      display: none !important;
      align-items: center !important;
      justify-content: center !important;
      backdrop-filter: blur(4px) !important;
    }

    .lab-reports-modal-overlay.is-active {
      display: flex !important;
    }

    .lab-reports-modal-content {
      background: #ffffff !important;
      border-radius: 22px !important;
      padding: 32px !important;
      width: 90% !important;
      max-width: 440px !important;
      position: relative !important;
      box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
      box-sizing: border-box !important;
      text-align: center !important;
    }

    .lab-reports-modal-close {
      position: absolute !important;
      top: 16px !important;
      right: 20px !important;
      font-size: 28px !important;
      font-weight: 400 !important;
      border: none !important;
      background: transparent !important;
      cursor: pointer !important;
      color: #999 !important;
      line-height: 1 !important;
      transition: color 0.2s !important;
    }

    .lab-reports-modal-close:hover {
      color: #333 !important;
    }

    .lab-reports-modal-title {
      font-size: 24px !important;
      font-weight: 700 !important;
      color: #222 !important;
      margin: 0 0 4px 0 !important;
    }

    .lab-reports-modal-subtitle {
      font-size: 14px !important;
      color: #666 !important;
      margin: 0 0 24px 0 !important;
    }

    .lab-reports-modal-grid {
      display: grid !important;
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 20px !important;
    }

    .lab-reports-modal-item {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      cursor: pointer !important;
      transition: transform 0.2s !important;
    }

    .lab-reports-modal-item:hover {
      transform: translateY(-2px) !important;
    }

    .lab-reports-modal-icon-circle {
      width: 70px !important;
      height: 70px !important;
      border-radius: 50% !important;
      background: #fafbf9 !important;
      border: 1px solid #e2ebd5 !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      position: relative !important;
      margin-bottom: 8px !important;
    }

    .lab-reports-modal-icon {
      width: 40px !important;
      height: 40px !important;
      object-fit: contain !important;
    }

    .lab-reports-modal-arrow {
      position: absolute !important;
      bottom: 0px !important;
      right: 0px !important;
      width: 20px !important;
      height: 20px !important;
      border-radius: 50% !important;
      background-color: #3b6b2e !important;
      border: 1.5px solid #fff !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      color: #fff !important;
    }

    .lab-reports-modal-label {
      font-size: 13px !important;
      font-weight: 600 !important;
      color: #333 !important;
      text-align: center !important;
      max-width: 90px !important;
      line-height: 1.3 !important;
    }

    @media screen and (max-width: 767px) {
      .lab-certificate__card {
        padding: 18px !important;
        gap: 16px !important;
      }
      .lab-certificate__left {
        flex: 0 0 55px !important;
      }
      .lab-certificate__stamp-img {
        width: 55px !important;
        height: 55px !important;
      }
      .lab-certificate__title {
        font-size: 17px !important;
      }
      .lab-badge {
        font-size: 11px !important;
        padding: 4px 8px !important;
      }
    }
  </style>
{% endif %}
