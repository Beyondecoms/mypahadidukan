{%- comment -%}
  Product page, mobile layout (shown up to 768px). Rendered by
  sections/product-main.liquid, which passes the values it works out once:
  current_variant, show_amazon, amazon_url, trusted_count, rating,
  rating_count, disclaimer, fresh_batch_text, fresh_batch_dates,
  low_stock_text, has_compare, current_disc.
  Pack, quantity, cart and gallery: assets/product-main.js.
{%- endcomment -%}
<div class="pm-section" id="pm-section-mobile-{{ section.id }}" data-pm-root="mobile">
    <div class="pm-inner">
      <div class="pm-right">

        <!-- Main Image -->
        <div class="pm-main-image-wrap">
          <button
            type="button"
            class="pm-wishlist-btn my-custom-wishlist-button swym-button swym-add-to-wishlist"
            data-with-epi="true"
            data-swaction="addToWishlist"
            data-product-id="{{ product.id }}"
            data-variant-id="{{ current_variant.id }}"
            data-pm-wishlist
            data-product-url="{{ shop.url }}{{ product.url }}"
            aria-label="Add to wishlist"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="1.8" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </button>
          <div class="pm-main-image-slider">
            {%- for image in product.images -%}
              <div class="pm-main-slide{% if forloop.first %} active{% endif %}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
                <img
                  src="{{ image | image_url: width: 900 }}"
                  alt="{{ image.alt | default: product.title | escape }}"
                  class="pm-main-img"
                  width="900"
                  height="{{ 900 | divided_by: image.aspect_ratio | round }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                >
              </div>
            {%- endfor -%}
          </div>
          {%- render 'product-main-dots' -%}
        </div>
      </div>
      <div class="pm-left">
          {% render 'product-main-heading', capsule_features: capsule_features, mobile: true %}

          <!-- Rating row -->
          {%- render 'product-main-rating', rating: rating, rating_count: rating_count, trusted_count: trusted_count -%}

          <!-- Vendor -->
          <p class="pm-vendor">Vendor : <a href="{{ product.vendor | url_for_vendor }}">{{ product.vendor }}</a></p>

          <!-- Price -->
          <div class="pm-price-row">
            <span class="pm-price" data-pm-price>₹{{ current_variant.price | money_without_currency }}</span>
            <span class="pm-compare" data-pm-compare{% unless has_compare %} hidden{% endunless %}>
              {%- if has_compare %}₹{{ current_variant.compare_at_price | money_without_currency }}{% endif -%}
            </span>
            <span class="pm-discount-badge" data-pm-discount{% unless has_compare %} hidden{% endunless %}>{{ current_disc }}% off</span>
            <span class="pm-stock" data-pm-stock{% if low_stock_text == blank %} hidden{% endif %}>{{ low_stock_text }}</span>
          </div>
          <p class="pm-tax-note">MRP inclusive of all taxes</p>

          <!-- Mini Reviews -->
          {%- render 'product-main-mini-reviews' -%}

          <!-- Select Pack -->
          <div class="pm-pack-section">
            <p class="pm-pack-label">Select Pack</p>
            <div class="pm-variants-wrap">
              <div class="pm-variants-grid" role="radiogroup" aria-label="Select pack">
                {%- for variant in product.variants -%}
                  {%- render 'product-main-pack', variant: variant, current_variant: current_variant -%}
                {%- endfor -%}
              </div>
              <div class="pm-variants-dots"></div>
              <!-- Mobile progress bar -->
              <div class="pm-variants-bar">
                <div class="pm-variants-bar-fill"></div>
              </div>
            </div>
          </div>

          <!-- Disclaimer -->
          {%- if disclaimer != blank -%}
            <div class="pm-disclaimer">{{ disclaimer | escape | newline_to_br }}</div>
          {%- endif -%}

          {%- if product.available -%}
            <!-- Quantity + ATC -->
            <div class="pm-atc-row">
              {%- if show_amazon -%}
                <a href="{{ amazon_url }}" class="pm-amazon-btn" target="_blank" rel="noopener">
                  Available at
                  {%- render 'icon-amazon-logo' -%}
                </a>
              {%- endif -%}
              <div class="pm-qty">
                <button type="button" class="pm-qty-btn" data-pm-qty-minus aria-label="Decrease quantity" disabled>−</button>
                <span class="pm-qty-val" data-pm-qty-value aria-live="polite">1</span>
                <button type="button" class="pm-qty-btn" data-pm-qty-plus aria-label="Increase quantity">+</button>
              </div>
            </div>
            <p class="pm-qty-note" data-pm-qty-note hidden></p>
            <button type="button" class="pm-atc-btn" data-pm-atc{% unless current_variant.available %} disabled{% endunless %}>
              {%- if current_variant.available %}Add to Cart{% else %}Sold out{% endif -%}
            </button>
            <p class="pm-cart-error" data-pm-cart-error role="alert" hidden></p>

            <!-- Buy It Now -->
            <div class="pm-buy-row">
              {%- form 'product', product, id: 'pm-gokwik-form-mobile', style: 'display:none' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-pm-form-variant>
                <input type="hidden" name="quantity" value="1" data-pm-form-qty>
              {%- endform -%}

              <button
                type="button"
                class="pm-buy-btn"
                id="pm-buy-btn-mobile"
                data-pm-buy
                onclick="if (typeof onBuyNowClick === 'function') onBuyNowClick(this, '#pm-gokwik-form-mobile')"
                {% unless current_variant.available %}disabled{% endunless %}
                {% if settings.hideFlow %} style="display:none !important;" {% endif %}
              >
                Buy It Now
              </button>
            </div>
          {%- else -%}
            <div class="out-to-notify">
              <button type="button" class="pm-out" disabled>Out of Stock</button>
            </div>
          {%- endif -%}

          {% render 'product-research-link', product: product %}

          <!-- Trust Icons -->
          <div class="pm-trust-row">
            {%- for block in section.blocks -%}
              {%- if block.type == 'trust_icon' -%}
                <div class="pm-trust-item" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != blank -%}
                    <img src="{{ block.settings.icon | image_url: width: 40 }}" alt="{{ block.settings.label }}" width="32" height="32">
                  {%- else -%}
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1a6b4a" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/></svg>
                  {%- endif -%}
                  <span>{{ block.settings.label }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        <!-- Check Delivery -->
        {% comment %} <div class="pm-delivery-section">
          <p class="pm-delivery-title">Check Delivery</p>
          <div class="promise-product-page">
            <div class="sr-promise-pdp-page" id="PromiseEddSection"></div>
          </div>
        </div> {% endcomment %}
  
        
          <!-- Check Delivery -->
          {% comment %} <div class="pm-mobile-delivery-placeholder"></div> {% endcomment %}
          <!-- Fresh Batch Banner -->
          {% comment %} {%- if fresh_batch_text != blank -%}
            <div class="pm-fresh-batch">
              <div class="pm-fresh-left"></div>
              <div class="pm-fresh-content">
                <p class="pm-fresh-title">{{ fresh_batch_text }}</p>
                {%- if fresh_batch_dates != blank -%}
                  <p class="pm-fresh-dates">{{ fresh_batch_dates }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%} {% endcomment %}

          {% render 'product-information-accordion', product: product, panel_prefix: section.id, layout: 'mobile' %}
          <!-- Available Offers -->
          {%- assign offer_blocks = section.blocks | where: 'type', 'offer' -%}
          {%- if offer_blocks.size > 0 and settings.show_product_offer_cards -%}
            <div class="pm-offers-section">
              <p class="pm-offers-title">Available Offers</p>
              {%- if offer_blocks.size == 1 -%}
                  {%- assign single = offer_blocks[0] -%}
                 <div class="pm-offers-s-grid">
                  {%- for block in offer_blocks -%}
                    <div class="pm-offer-s-card" {{ single.shopify_attributes }}>
                      <p class="pm-offer-s-text">{{ single.settings.offer_text }}</p>
                      {%- if block.settings.coupon_code != blank -%}
                        <div class="pm-coupon-s-row">
                          <span class="pm-coupon-s-label">Code: {{ single.settings.coupon_code }}</span>
                          <button class="pm-coupon-s-copy" data-code="{{ single.settings.coupon_code }}">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                          </button>
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                 </div>
              {%- else -%}
                <div class="pm-offers-grid">
                  {%- for block in offer_blocks -%}
                    <div class="pm-offer-card" {{ block.shopify_attributes }}>
                      <p class="pm-offer-text">{{ block.settings.offer_text }}</p>
                      {%- if block.settings.coupon_code != blank -%}
                        <div class="pm-coupon-row">
                          <span class="pm-coupon-label">Code: {{ block.settings.coupon_code }}</span>
                          <button class="pm-coupon-copy" data-code="{{ block.settings.coupon_code }}">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                          </button>
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
            {%- endif -%}
            </div>
          {%- elsif offer_blocks.size > 0 -%}
            {% render 'product-checkout-offer' %}
          {%- endif -%}

        </div>
      </div>
  </div>
