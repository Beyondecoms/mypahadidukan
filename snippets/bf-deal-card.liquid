{%- comment -%}
  One Black Friday deal card. black-friday.js swaps the phase text and runs Add to cart.
  Params: product, name, variant_label, cats, index, phase, eager, plus the label strings passed by bf-deals:
  badge, strip, btn_label, off_format.
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign now_str = variant.price | money_without_trailing_zeros | strip_html | remove: ' ' | remove: '&nbsp;'
  assign was_str = ''
  assign off_str = ''
  assign pct = 0
  if variant.compare_at_price > variant.price
    assign was_str = variant.compare_at_price | money_without_trailing_zeros | strip_html | remove: ' ' | remove: '&nbsp;'
    assign pct = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round
    assign off_str = off_format | replace: '[pct]', pct
  endif

  assign soldout = false
  if phase == 'live' and variant.available == false
    assign soldout = true
  endif
  assign disabled = true
  if phase == 'live' and variant.available
    assign disabled = false
  endif
-%}
<article
  class="bf-card{% if soldout %} is-soldout{% endif %}"
  data-bf-card
  data-phase="{{ phase }}"
  data-index="{{ index }}"
  data-pct="{{ pct }}"
  data-cats="{{ cats | strip }}"
  data-available="{{ variant.available }}"
>
  <div class="bf-card__media">
    {%- if product.featured_media != blank -%}
      <a href="{{ product.url }}" tabindex="-1" aria-hidden="true">
        {%- if eager -%}
          {%- assign loading = 'eager' -%}
        {%- else -%}
          {%- assign loading = 'lazy' -%}
        {%- endif -%}
        {{
          product.featured_media
          | image_url: width: 800
          | image_tag:
            class: 'bf-card__img',
            widths: '300, 450, 600, 800',
            sizes: '(max-width: 900px) 50vw, (max-width: 1100px) 33vw, 320px',
            alt: name,
            loading: loading
        }}
      </a>
    {%- else -%}
      <div class="bf-card__placeholder">
        <span class="bf-card__placeholder-name">{{ name }}</span>
        <span class="bf-card__variant">PRODUCT PHOTO</span>
      </div>
    {%- endif -%}
    {%- if badge != blank -%}
      <span class="bf-card__badge">{{ badge }}</span>
    {%- endif -%}
  </div>

  <div class="bf-card__strip" data-bf-strip>{{ strip }}</div>

  <div class="bf-card__body">
    <h3 class="bf-card__name"><a href="{{ product.url }}">{{ name }}</a></h3>
    <span class="bf-card__variant">{{ variant_label }}</span>
    <div class="bf-card__price">
      <div class="bf-card__price-row">
        <span class="bf-card__was">{{ was_str }}</span>
        <span class="bf-card__now">{{ now_str }}</span>
        <span class="bf-card__off">{{ off_str }}</span>
      </div>
    </div>
  </div>

  <button
    type="button"
    class="bf-card__btn"
    data-bf-add
    data-variant-id="{{ variant.id }}"
    {% if disabled %}
      disabled
    {% endif %}
  >
    {{- btn_label -}}
  </button>
</article>
