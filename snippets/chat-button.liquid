<style>
.chat-float-btn {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    color: #1a2e1a;
    padding: 10px 12px;
    border-radius: 24px;
    font-size: 16px;
    font-weight: 400;
    font-family: var(--font-family-normal);
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.18);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
    border: none;
}

.chat-float-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(0,0,0,0.22);
}

.chat-float-btn svg {
  flex-shrink: 0;
}

/* Push up on mobile to sit above bottom nav */
@media (max-width: 991px) {
  .chat-float-btn {
        bottom: 90px;
        display:none;
        right: 16px;
        padding: 5px 9px;
        font-size: 12px;
  }
}
</style>

