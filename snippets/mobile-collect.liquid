{% comment %}
  Snippet: mobile-collect.liquid
  Usage: {% render 'mobile-collect' %}
  Place this render tag just before </body> in your theme.liquid
{% endcomment %}


{%- comment -%} ============ STYLES ============ {%- endcomment -%}
<style>
/* =============================================
   MOBILE BOTTOM SHEET — OVERLAY
   ============================================= */
.mobile-drawer-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
}
.mobile-drawer-overlay.active {
  display: block;
}

/* =============================================
   BOTTOM SHEET — BASE
   ============================================= */
.mobile-bottom-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 20px 20px 0 0;
  z-index: 1001;
  font-family: "Archivo", sans-serif;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
}
.mobile-bottom-sheet.active {
  transform: translateY(0);
}

/* Drag handle */
.mobile-sheet-handle {
  width: 40px;
  height: 4px;
  background: #D0D0D0;
  border-radius: 2px;
  margin: 12px auto 0;
  flex-shrink: 0;
}

/* Sheet header */
.mobile-sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px 12px;
  flex-shrink: 0;
  border-bottom: 1px solid #F0F0F0;
}
.mobile-sheet-header h3 {
  font-family: "Mrs Eaves", serif;
  font-size: 20px;
  font-weight: normal;
  color: #231F20;
  margin: 0;
}
.mobile-sheet-close {
  background: none;
  border: none;
  font-size: 20px;
  color: #231F20;
  cursor: pointer;
  padding: 0;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
}

/* Sheet footer */
.mobile-sheet-footer {
  display: flex;
  gap: 12px;
  padding: 16px 20px;
  border-top: 1px solid #F0F0F0;
  flex-shrink: 0;
}
.mobile-sheet-footer .btn-clear {
  flex: 1;
  height: 48px;
  background: transparent;
  border: 1px solid #048E79;
  color: #048E79;
  border-radius: 10px;
  font-family: "Archivo", sans-serif;
  font-size: 15px;
  cursor: pointer;
}
.mobile-sheet-footer .btn-apply {
  flex: 1;
  height: 48px;
  background: #048E79;
  border: none;
  color: #fff;
  border-radius: 10px;
  font-family: "Archivo", sans-serif;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
}

/* =============================================
   SORT SHEET — BODY
   ============================================= */
.mobile-sort-body {
  flex: 1;
  overflow-y: auto;
  padding: 8px 20px;
}
.mobile-sort-body .sort-options {
  display: flex;
  flex-direction: column;
}
.mobile-sort-body .sort-options label {
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 15px;
  color: #231F20;
  cursor: pointer;
  padding: 14px 0;
  border-bottom: 1px solid #F0F0F0;
  line-height: 1.4;
}
.mobile-sort-body .sort-options label:last-of-type {
  border-bottom: none;
}
.mobile-sort-body .sort-options input[type="radio"] {
  appearance: none;
  -webkit-appearance: none;
  width: 22px;
  height: 22px;
  border: 2px solid #C8C8C8;
  border-radius: 50%;
  cursor: pointer;
  flex-shrink: 0;
  position: relative;
  background: #fff;
}
.mobile-sort-body .sort-options input[type="radio"]:checked {
  border-color: #048E79;
  background: #fff;
}
.mobile-sort-body .sort-options input[type="radio"]:checked::after {
  content: '';
  position: absolute;
  width: 12px;
  height: 12px;
  background: #048E79;
  border-radius: 50%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* =============================================
   FILTER SHEET — TABBED BODY
   ============================================= */
.mobile-filter-body {
  flex: 1;
  overflow: hidden;
  display: flex;
}

/* Left tab sidebar */
.mobile-filter-tabs {
  width: 100px;
  background: #FAFAFA;
  border-right: 1px solid #F0F0F0;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  flex-shrink: 0;
}
.mobile-filter-tab-btn {
  width: 100%;
  padding: 16px 12px;
  text-align: left;
  background: transparent;
  border: none;
  border-left: 3px solid transparent;
  font-family: "Archivo", sans-serif;
  font-size: 13px;
  color: #777;
  cursor: pointer;
  line-height: 1.3;
}
.mobile-filter-tab-btn.active {
  background: #fff;
  border-left-color: #048E79;
  color: #048E79;
  font-weight: 600;
}

/* Right content panels */
.mobile-filter-panels {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
}
.mobile-filter-panel {
  display: none;
}
.mobile-filter-panel.active {
  display: block;
}
.mobile-filter-panel-title {
  font-family: "Archivo", sans-serif;
  font-size: 14px;
  font-weight: 600;
  color: #231F20;
  margin-bottom: 14px;
}
.mobile-filter-panel label {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 14px;
  color: #231F20;
  cursor: pointer;
  padding: 10px 0;
  border-bottom: 1px solid #F5F5F5;
  line-height: 1.4;
}
.mobile-filter-panel label:last-of-type {
  border-bottom: none;
}
.mobile-filter-panel input[type="checkbox"] {
  appearance: none;
  -webkit-appearance: none;
  width: 22px;
  height: 22px;
  border: 2px solid #C8C8C8;
  border-radius: 6px;
  cursor: pointer;
  flex-shrink: 0;
  position: relative;
  background: #fff;
  transition: background 0.15s, border-color 0.15s;
}
.mobile-filter-panel input[type="checkbox"]:checked {
  background: #048E79;
  border-color: #048E79;
}
.mobile-filter-panel input[type="checkbox"]:checked::after {
  content: '';
  position: absolute;
  left: 6px;
  top: 2px;
  width: 6px;
  height: 11px;
  border: 2px solid #fff;
  border-top: none;
  border-left: none;
  transform: rotate(45deg);
}

/* Price range slider inside filter panel */
.mobile-filter-panel .price-range-labels {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  color: #888;
  margin-bottom: 10px;
}
.mobile-filter-panel input[type="range"] {
  -webkit-appearance: none;
  width: 100%;
  height: 4px;
  background: linear-gradient(to right, #048E79 0%, #048E79 var(--val, 100%), #D0D0D0 var(--val, 100%), #D0D0D0 100%);
  border-radius: 4px;
  outline: none;
  cursor: pointer;
}
.mobile-filter-panel input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 18px;
  height: 18px;
  background: #048E79;
  border-radius: 50%;
  cursor: pointer;
  border: 2px solid #fff;
  box-shadow: 0 0 0 1px #048E79;
}
.mobile-filter-panel input[type="range"]::-moz-range-thumb {
  width: 18px;
  height: 18px;
  background: #048E79;
  border-radius: 50%;
  cursor: pointer;
  border: 2px solid #fff;
  box-shadow: 0 0 0 1px #048E79;
}
</style>


{%- comment -%} ============ HTML ============ {%- endcomment -%}

<!-- Shared overlay -->
<div class="mobile-drawer-overlay" id="mobileOverlay"></div>


<!-- ===== SORT SHEET ===== -->
<div class="mobile-bottom-sheet" id="mobileSortSheet">
  <div class="mobile-sheet-handle"></div>

  <div class="mobile-sheet-header">
    <h3>Sort By</h3>
    <button class="mobile-sheet-close" id="closeMobileSort">&#10005;</button>
  </div>

  <div class="mobile-sort-body">
    <div class="sort-options">
      <label>
        <input type="radio" name="mobileSort" value="recommended" checked>
        Recommended
      </label>
      <label>
        <input type="radio" name="mobileSort" value="new">
        What's New
      </label>
      <label>
        <input type="radio" name="mobileSort" value="trending">
        Trending
      </label>
      <label>
        <input type="radio" name="mobileSort" value="bestseller">
        Best Seller
      </label>
      <label>
        <input type="radio" name="mobileSort" value="hightolow">
        High To Low
      </label>
      <label>
        <input type="radio" name="mobileSort" value="lowtohigh">
        Low To High
      </label>
    </div>
  </div>

  <div class="mobile-sheet-footer">
    <button class="btn-clear" id="clearMobileSort">Clear</button>
    <button class="btn-apply" id="applyMobileSort">Apply</button>
  </div>
</div>


<!-- ===== FILTER SHEET ===== -->
<div class="mobile-bottom-sheet" id="mobileFilterSheet">
  <div class="mobile-sheet-handle"></div>

  <div class="mobile-sheet-header">
    <h3>Filters</h3>
    <button class="mobile-sheet-close" id="closeMobileFilter">&#10005;</button>
  </div>

  <div class="mobile-filter-body">

    <!-- Left tab sidebar -->
    <div class="mobile-filter-tabs">
      <button class="mobile-filter-tab-btn active" data-tab="availability">Availability</button>
      <button class="mobile-filter-tab-btn" data-tab="price">Price</button>
      <button class="mobile-filter-tab-btn" data-tab="category">Category</button>
      <button class="mobile-filter-tab-btn" data-tab="place">Place</button>
    </div>

    <!-- Right content panels -->
    <div class="mobile-filter-panels">

      <!-- Availability -->
      <div class="mobile-filter-panel active" id="panel-availability">
        <div class="mobile-filter-panel-title">Select Availability</div>
        <label>
          <input type="checkbox" value="instock" checked>
          In Stock
        </label>
        <label>
          <input type="checkbox" value="outofstock">
          Out of Stock
        </label>
      </div>

      <!-- Price -->
      <div class="mobile-filter-panel" id="panel-price">
        <div class="mobile-filter-panel-title">Select Price Range</div>
        <div class="price-range-labels">
          <span>₹0</span>
          <span id="mobilePriceValue">₹5000</span>
        </div>
        <input
          type="range"
          id="mobilePriceRange"
          min="0"
          max="5000"
          value="5000"
        >
      </div>

      <!-- Category -->
      <div class="mobile-filter-panel" id="panel-category">
        <div class="mobile-filter-panel-title">Select Category</div>
        <label><input type="checkbox" value="honey"> Honey</label>
        <label><input type="checkbox" value="nuts"> Dry Fruits &amp; Nuts</label>
        <label><input type="checkbox" value="spices"> Spices</label>
        <label><input type="checkbox" value="tea"> Teas &amp; Herbs</label>
        <label><input type="checkbox" value="oil"> Oils</label>
      </div>

      <!-- Place -->
      <div class="mobile-filter-panel" id="panel-place">
        <div class="mobile-filter-panel-title">Select Place</div>
        <label><input type="checkbox" value="ladakh"> Ladakh</label>
        <label><input type="checkbox" value="uttarakhand"> Uttarakhand</label>
        <label><input type="checkbox" value="kashmir"> Kashmir</label>
        <label><input type="checkbox" value="himachal"> Himachal Pradesh</label>
      </div>

    </div>
  </div>

  <div class="mobile-sheet-footer">
    <button class="btn-clear" id="clearMobileFilter">Clear All</button>
    <button class="btn-apply" id="applyMobileFilter">Apply</button>
  </div>
</div>


{%- comment -%} ============ SCRIPT ============ {%- endcomment -%}
<script>
(function () {
  'use strict';

  var overlay     = document.getElementById('mobileOverlay');
  var sortSheet   = document.getElementById('mobileSortSheet');
  var filterSheet = document.getElementById('mobileFilterSheet');

  function isMobile() {
    return window.innerWidth <= 768;
  }

  function openSheet(sheet) {
    overlay.classList.add('active');
    sheet.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeAll() {
    overlay.classList.remove('active');
    sortSheet.classList.remove('active');
    filterSheet.classList.remove('active');
    document.body.style.overflow = '';
  }

  /* ---- Open triggers ---- */
  document.querySelectorAll('.sort-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (isMobile()) openSheet(sortSheet);
    });
  });

  document.querySelectorAll('.filter-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (isMobile()) openSheet(filterSheet);
    });
  });

  /* ---- Close / Clear / Apply ---- */
  document.getElementById('closeMobileSort').addEventListener('click', closeAll);
  document.getElementById('closeMobileFilter').addEventListener('click', closeAll);
  overlay.addEventListener('click', closeAll);

  document.getElementById('clearMobileSort').addEventListener('click', function () {
    document.querySelectorAll('#mobileSortSheet input[type="radio"]').forEach(function (r) {
      r.checked = false;
    });
  });

  document.getElementById('applyMobileSort').addEventListener('click', closeAll);

  document.getElementById('clearMobileFilter').addEventListener('click', function () {
    document.querySelectorAll('#mobileFilterSheet input[type="checkbox"]').forEach(function (c) {
      c.checked = false;
    });
  });

  document.getElementById('applyMobileFilter').addEventListener('click', closeAll);

  /* ---- Filter tab switching ---- */
  document.querySelectorAll('.mobile-filter-tab-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.mobile-filter-tab-btn').forEach(function (b) {
        b.classList.remove('active');
      });
      document.querySelectorAll('.mobile-filter-panel').forEach(function (p) {
        p.classList.remove('active');
      });
      btn.classList.add('active');
      var panel = document.getElementById('panel-' + btn.dataset.tab);
      if (panel) panel.classList.add('active');
    });
  });

  /* ---- Price range slider ---- */
  var priceRange = document.getElementById('mobilePriceRange');
  var priceValue = document.getElementById('mobilePriceValue');
  if (priceRange && priceValue) {
    priceRange.addEventListener('input', function () {
      priceValue.textContent = '₹' + this.value;
      var pct = (this.value / this.max * 100) + '%';
      this.style.setProperty('--val', pct);
    });
    /* Set initial fill */
    priceRange.style.setProperty('--val', '100%');
  }

})();
</script>
