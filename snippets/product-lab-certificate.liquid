{% comment %}
  Render the Lab Certificate product block
{% endcomment %}
{% liquid
  assign lab_report_links = product.metafields.custom.lab_report_link.value
  
  assign certificate_blocks = section.blocks | where: 'type', 'lab_certificate'
  assign current_index = 0
  for b in certificate_blocks
    if b.id == block.id
      assign current_index = forloop.index0
      break
    endif
  endfor
  
  assign current_report = lab_report_links[current_index]
  assign lab_report_url = current_report.url
%}

{%- if lab_report_links != blank -%}
  <div class="lab-certificate-wrapper" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h4 class="lab-certificate__heading">{{ block.settings.heading }}</h4>
    {%- endif -%}

    {%- if lab_report_url != blank -%}
      <a href="{{ lab_report_url }}" target="_blank" rel="noopener" class="lab-certificate__card">
    {%- else -%}
      <div class="lab-certificate__card">
    {%- endif -%}

      <div class="lab-certificate__left">
        {%- if block.settings.icon != blank -%}
          <img src="{{ block.settings.icon | image_url: width: 112 }}" alt="Lab Verification" class="lab-certificate__stamp-img" loading="lazy" width="56" height="56">
        {%- else -%}
          <!-- Premium Verification Seal Badge SVG -->
          <svg class="lab-certificate__stamp" width="56" height="56" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M32 5C17.1 5 5 17.1 5 32S17.1 59 32 59 59 46.9 59 32 46.9 5 32 5zm0 50C19.3 55 9 44.7 9 32S19.3 9 32 9s23 10.3 23 23-10.3 23-23 23z" fill="#111111"/>
            <path d="M32 12c-11 0-20 9-20 20s9 20 20 20 20-9 20-20-9-20-20-20zm0 37c-9.4 0-17-7.6-17-17s7.6-17 17-17 17 7.6 17 17-7.6 17-17 17z" fill="#111111" stroke="#111111" stroke-width="1" stroke-dasharray="2,2"/>
            <path d="M42.3 22.3L28 36.6l-6.3-6.3c-.8-.8-2-.8-2.8 0s-.8 2 0 2.8l7.7 7.7c.4.4.9.6 1.4.6s1-.2 1.4-.6l15.7-15.7c.8-.8.8-2 0-2.8s-2-.8-2.8 0z" fill="#111111"/>
          </svg>
        {%- endif -%}
      </div>

      <div class="lab-certificate__right">
        <span class="lab-certificate__title">{{ block.settings.subtitle | default: 'Third-Party Lab Verified For' }}</span>
        
        <div class="lab-certificate__badges">
          <span class="lab-badge lab-badge--purity">
            <span class="lab-badge__dot"></span>
            <span class="lab-badge__label">Purity</span>
          </span>
          <span class="lab-badge lab-badge--metals">
            <span class="lab-badge__dot"></span>
            <span class="lab-badge__label">Heavy Metals</span>
          </span>
          <span class="lab-badge lab-badge--pesticides">
            <span class="lab-badge__dot"></span>
            <span class="lab-badge__label">Pesticides</span>
          </span>
          <span class="lab-badge lab-badge--active">
            <span class="lab-badge__dot"></span>
            <span class="lab-badge__label">Active Ingredients</span>
          </span>
        </div>

        {%- if lab_report_url != blank -%}
          <div class="lab-certificate__link-row">
            <span class="lab-certificate__link">{{ block.settings.title | default: 'View Authenticity Report' }} &rarr;</span>
          </div>
        {%- endif -%}
      </div>

    {%- if lab_report_url != blank -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}

    {%- if block.settings.bottom_text != blank -%}
      <p class="lab-certificate__bottom-text">{{ block.settings.bottom_text }}</p>
    {%- endif -%}
  </div>

  <style>
    .lab-certificate-wrapper {
      margin: 20px 0;
      width: 100%;
    }

    .lab-certificate__heading {
      font-size: 14px !important;
      font-weight: 700 !important;
      color: #333 !important;
      margin: 0 0 10px 0 !important;
      text-transform: uppercase !important;
      letter-spacing: 0.05em !important;
    }

    .lab-certificate__card {
      display: flex !important;
      align-items: center !important;
      background-color: #fafbf9 !important;
      border: 1px solid #e2ebd5 !important;
      border-radius: 22px !important;
      padding: 20px !important;
      text-decoration: none !important;
      color: inherit !important;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;
      width: 100% !important;
      box-sizing: border-box !important;
      gap: 20px !important;
    }

    a.lab-certificate__card {
      cursor: pointer !important;
    }

    div.lab-certificate__card {
      cursor: default !important;
    }

    a.lab-certificate__card:hover {
      background-color: #f4f6f1 !important;
      border-color: #d1dbbf !important;
      transform: translateY(-2px) !important;
      box-shadow: 0 6px 15px rgba(162, 185, 134, 0.12) !important;
    }

    .lab-certificate__left {
      flex: 0 0 56px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    .lab-certificate__stamp-img {
      width: 56px !important;
      height: 56px !important;
      object-fit: contain !important;
    }

    .lab-certificate__stamp {
      width: 56px !important;
      height: 56px !important;
    }

    .lab-certificate__right {
      flex: 1 !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 10px !important;
      text-align: left !important;
    }

    .lab-certificate__title {
      font-size: 18px !important;
      font-weight: 600 !important;
      color: #222 !important;
      margin: 0 !important;
      line-height: 1.3 !important;
    }

    .lab-certificate__badges {
      display: flex !important;
      flex-wrap: wrap !important;
      gap: 8px !important;
    }

    .lab-badge {
      display: inline-flex !important;
      align-items: center !important;
      gap: 6px !important;
      padding: 4px 10px !important;
      border-radius: 99px !important;
      font-size: 13px !important;
      font-weight: 600 !important;
    }

    .lab-badge__dot {
      width: 6px !important;
      height: 6px !important;
      border-radius: 50% !important;
      display: inline-block !important;
    }

    /* Purity: Green */
    .lab-badge--purity {
      background-color: #ecf3e6 !important;
      color: #3b6b2e !important;
    }
    .lab-badge--purity .lab-badge__dot {
      background-color: #3b6b2e !important;
    }

    /* Metals: Bronze/Gold */
    .lab-badge--metals {
      background-color: #f7ede2 !important;
      color: #7b5930 !important;
    }
    .lab-badge--metals .lab-badge__dot {
      background-color: #7b5930 !important;
    }

    /* Pesticides: Purple */
    .lab-badge--pesticides {
      background-color: #f1ecf7 !important;
      color: #5c3b82 !important;
    }
    .lab-badge--pesticides .lab-badge__dot {
      background-color: #5c3b82 !important;
    }

    /* Active: Blue */
    .lab-badge--active {
      background-color: #e6eef7 !important;
      color: #31588c !important;
    }
    .lab-badge--active .lab-badge__dot {
      background-color: #31588c !important;
    }

    .lab-certificate__link-row {
      margin-top: 2px !important;
    }

    .lab-certificate__link {
      font-size: 14px !important;
      font-weight: 700 !important;
      color: #2b5b3c !important;
      text-decoration: underline !important;
      text-underline-offset: 4px !important;
      transition: color 0.2s ease !important;
    }

    a.lab-certificate__card:hover .lab-certificate__link {
      color: #1b3d26 !important;
    }

    .lab-certificate__bottom-text {
      font-size: 12px !important;
      color: #8A8A8A !important;
      margin: 8px 0 0 0 !important;
      text-align: left !important;
      line-height: 1.4 !important;
    }

    @media screen and (max-width: 767px) {
      .lab-certificate__card {
        padding: 16px !important;
        gap: 14px !important;
      }
      .lab-certificate__left {
        flex: 0 0 46px !important;
      }
      .lab-certificate__stamp-img, .lab-certificate__stamp {
        width: 46px !important;
        height: 46px !important;
      }
      .lab-certificate__title {
        font-size: 15px !important;
      }
      .lab-badge {
        font-size: 11px !important;
        padding: 3px 8px !important;
      }
    }
  </style>
{%- endif -%}
