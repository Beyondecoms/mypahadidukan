  }
  .fd-range {
    width: 100%;
    accent-color: #048E79;
  }
  .fd-mobile-footer {
    display: flex;
    gap: 10px;
    padding: 12px 16px;
    background: #fff;
    border-top: 0.5px solid #e8e5de;
    flex-shrink: 0;
  }
  .fd-clear-btn {
    flex: 1;
    padding: 12px;
    border: none;
    background: none;
    color: #048E79;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    font-family: "Archivo", sans-serif;
    border-radius: 8px;
  }
  .fd-apply-btn {
    flex: 1.5;
    padding: 12px;
    border: none;
    background: #048E79;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    font-family: "Archivo", sans-serif;
    border-radius: 8px;
  }
  .fd-mobile-chips {
    display: flex;
