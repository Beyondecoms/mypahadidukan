{% comment %}
  collection-filter-drawer.liquid
  Accepts:
  - collection: the current collection
  - products: collection.products from inside the section's paginate block (all products, up to 250)
  - section: the collection-tabs-showcase section; its tab blocks are the Place options
  - card_places: per-product tab-collection handles built by the section (",handle,|,handle,|"), blank when Place is not used
  - price_ceiling: top of the price slider (rupees)
{% endcomment %}
{%- liquid
  if products == blank
    assign products = collection.products
  endif
  assign price_ceiling = price_ceiling | default: 5000

  assign types = products | map: 'type' | uniq
  assign has_types = false
  for type in types
    if type != blank
      assign has_types = true
      break
    endif
  endfor

  assign has_places = false
  if card_places != blank
    for block in section.blocks
      assign tab_collection = collections[block.settings.collection]
      if tab_collection != blank
        assign needle = ',' | append: tab_collection.handle | append: ','
        if card_places contains needle
          assign has_places = true
          break
        endif
      endif
    endfor
  endif
-%}
{%- capture filter_close_icon -%}
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
    <path d="M1 1L15 15M15 1L1 15" stroke="currentColor" stroke-width="1.3"/>
  </svg>
{%- endcapture -%}
{%- capture filter_group_toggle -%}
  <span class="filter-group-toggle"><svg width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <path d="M1.09936 9.39047C0.978036 9.52472 0.814461 9.6 0.644032 9.6C0.473603 9.6 0.310028 9.52472 0.188703 9.39047C0.128938 9.32445 0.0814762 9.24575 0.0490799 9.15896C0.0166836 9.07218 0 8.97903 0 8.88494C0 8.79085 0.0166836 8.6977 0.0490799 8.61091C0.0814762 8.52412 0.128938 8.44543 0.188703 8.37941L7.54467 0.209532C7.666 0.0752735 7.82957 0 8 0C8.17043 0 8.334 0.0752735 8.45533 0.209532L15.8113 8.37941C15.8711 8.44543 15.9185 8.52412 15.9509 8.61091C15.9833 8.6977 16 8.79085 16 8.88494C16 8.97903 15.9833 9.07218 15.9509 9.15896C15.9185 9.24575 15.8711 9.32445 15.8113 9.39047C15.69 9.52472 15.5264 9.6 15.356 9.6C15.1855 9.6 15.022 9.52472 14.9006 9.39047L7.99954 1.9395L1.09936 9.39047Z" fill="#231F20"/>
  </svg>
  </span>
{%- endcapture -%}
<div class="filter-drawer filterDrawer" id="CollectionFilterDrawer">
  {% comment %} ===== DESKTOP VIEW ===== {% endcomment %}
  <div class="fd-desktop">
    <div class="filter-header">
      <h3>FILTERS</h3>
      <button type="button" class="closeFilter" aria-label="Close filters">{{ filter_close_icon }}</button>
    </div>

    {% comment %} <div class="active-filters" id="activeFilters"></div> {% endcomment %}
<div class="active-filters" id="drawerActiveFilters"></div>
    <div class="filter-group">
      <div class="filter-group-header">
        <h4>Availability</h4>
        {{ filter_group_toggle }}
      </div>
      <div class="filter-group-body">
        <label><input type="checkbox" class="filter-availability" value="in"> In Stock</label>
        <label><input type="checkbox" class="filter-availability" value="out"> Out Of Stock</label>
      </div>
    </div>
    <div class="filter-group">
      <div class="filter-group-header">
        <h4>Price</h4>
        {{ filter_group_toggle }}
      </div>
      <div class="filter-group-body">
        <div class="price-range-labels">
          <span>₹<span id="priceMin">0</span></span>
          <span>₹<span id="priceMax">{{ price_ceiling }}</span></span>
        </div>
        <div class="dual-range-wrapper">
          <input type="range" min="0" max="{{ price_ceiling }}" value="0" step="1" id="priceRangeMin" class="dual-range" aria-label="Minimum price">
          <input type="range" min="0" max="{{ price_ceiling }}" value="{{ price_ceiling }}" step="1" id="priceRangeMax" class="dual-range" aria-label="Maximum price">
        </div>
      </div>
    </div>

    {%- if has_types -%}
    <div class="filter-group">
      <div class="filter-group-header">
        <h4>Category</h4>
        {{ filter_group_toggle }}
      </div>
      <div class="filter-group-body">
        {% for type in types %}
          {% if type != blank %}
            {% assign type_count = products | where: 'type', type | size %}
            <label>
              <input type="checkbox" class="filter-type" value="{{ type | escape }}" data-label="{{ type | escape }}">
                  {{ type }} ({{ type_count }})
            </label>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    {%- endif -%}

    {%- if has_places -%}
    <div class="filter-group">
      <div class="filter-group-header">
        <h4>Place</h4>
        {{ filter_group_toggle }}
      </div>
      <div class="filter-group-body">
        {% for block in section.blocks %}
          {%- liquid
            assign tab_collection = collections[block.settings.collection]
            assign place_count = 0
            if tab_collection != blank
              assign needle = ',' | append: tab_collection.handle | append: ','
              if card_places contains needle
                assign place_count = card_places | split: needle | size | minus: 1
              endif
            endif
            assign place_label = block.settings.title | default: tab_collection.title
          -%}
          {%- if place_count > 0 %}
          <label>
            <input type="checkbox" class="filter-place" value="{{ tab_collection.handle }}" data-label="{{ place_label | escape }}">
            {{ place_label }} ({{ place_count }})
          </label>
          {%- endif %}
        {% endfor %}
      </div>
    </div>
    {%- endif -%}

  </div>

  {% comment %} ===== MOBILE VIEW ===== {% endcomment %}
  <div class="fd-mobile">

    <div class="fd-mobile-header">
      <button type="button" class="closeFilter fd-mobile-close" id="fdMobileClose" aria-label="Close filters">✕</button>
      <h3>Filters</h3>
      <div style="width:28px"></div>
    </div>

    <div class="fd-mobile-body">

      <div class="fd-tabs">
        <button type="button" class="fd-tab active" data-panel="avail">Availability</button>
        <button type="button" class="fd-tab" data-panel="price">Price</button>
        {%- if has_types %}
        <button type="button" class="fd-tab" data-panel="category">Category</button>
        {%- endif %}
        {%- if has_places %}
        <button type="button" class="fd-tab" data-panel="place">Place</button>
        {%- endif %}
      </div>

      <div class="fd-panels">

        <div class="fd-mobile-chips" id="fdActiveChips"></div>

        <div class="fd-panel active" id="fd-panel-avail">
          <p class="fd-panel-title">Select Availability</p>
          <label class="fd-row">
            <span>In Stock</span>
            <input type="checkbox" class="filter-availability fd-cb" value="in">
            <span class="fd-box"></span>
          </label>
          <label class="fd-row">
            <span>Out Of Stock</span>
            <input type="checkbox" class="filter-availability fd-cb" value="out">
            <span class="fd-box"></span>
          </label>
        </div>

        <div class="fd-panel" id="fd-panel-price">
          <p class="fd-panel-title">Select Price</p>
          <div class="fd-price-labels">
            <span>₹<span id="fdPriceMin">0</span></span>
            <span>₹<span id="fdPriceMax">{{ price_ceiling }}</span></span>
          </div>
          <div class="dual-range-wrapper">
            <input type="range" min="0" max="{{ price_ceiling }}" value="0" step="1" class="dual-range fd-range-min" aria-label="Minimum price">
            <input type="range" min="0" max="{{ price_ceiling }}" value="{{ price_ceiling }}" step="1" class="dual-range fd-range-max" aria-label="Maximum price">
          </div>
        </div>

        {%- if has_types -%}
        <div class="fd-panel" id="fd-panel-category">
          <p class="fd-panel-title">Select Category</p>
          {% for type in types %}
            {% if type != blank %}
            {% assign type_count = products | where: 'type', type | size %}
            <label class="fd-row">
              <span>{{ type }} ({{ type_count }})</span>
              <input type="checkbox" class="filter-type fd-cb" value="{{ type | escape }}" data-label="{{ type | escape }}">
              <span class="fd-box"></span>
            </label>
            {% endif %}
          {% endfor %}
        </div>
        {%- endif -%}

        {%- if has_places -%}
        <div class="fd-panel" id="fd-panel-place">
          <p class="fd-panel-title">Select Place</p>
          {% for block in section.blocks %}
            {%- liquid
              assign tab_collection = collections[block.settings.collection]
              assign place_count = 0
              if tab_collection != blank
                assign needle = ',' | append: tab_collection.handle | append: ','
                if card_places contains needle
                  assign place_count = card_places | split: needle | size | minus: 1
                endif
              endif
              assign place_label = block.settings.title | default: tab_collection.title
            -%}
            {%- if place_count > 0 %}
            <label class="fd-row">
              <span>{{ place_label }} ({{ place_count }})</span>
              <input type="checkbox" class="filter-place fd-cb" value="{{ tab_collection.handle }}" data-label="{{ place_label | escape }}">
              <span class="fd-box"></span>
            </label>
            {%- endif %}
          {% endfor %}
        </div>
        {%- endif -%}

      </div>
    </div>

    <div class="fd-mobile-footer">
      <button type="button" class="fd-clear-btn">Clear All</button>
      <button type="button" class="closeFilter fd-apply-btn">Apply</button>
    </div>

  </div>

</div>


<style>
.fd-mobile { display: none; }
.fd-desktop { display: block; }

.filter-group-body {
  overflow-y: auto !important;
  overflow-x: hidden !important;
  max-height: 500px;
  transition: max-height 0.3s ease, opacity 0.25s ease;
  opacity: 1;
  scrollbar-width: thin;
  padding-bottom: 4px;
}

.filter-group.collapsed .filter-group-body {
  max-height: 0;
  opacity: 0;
  padding-bottom: 0;
}
.filter-group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  padding-bottom: 12px;
  user-select: none;
}
.filter-group-toggle {
  font-size: 16px;
  color: #231F20;
  line-height: 1;
  transition: transform 0.3s ease;
  display: inline-block;
}
.filter-group.collapsed .filter-group-toggle {
  transform: rotate(180deg);
}
/* ===== DUAL RANGE SLIDER ===== */
.dual-range-wrapper {
  position: relative;
  height: 18px;
  margin: 8px;
}
.dual-range {
  position: absolute;
  width: 100%;
  height: 4px;
  background: transparent;
  pointer-events: none;
  -webkit-appearance: none;
  appearance: none;
  top: 50%;
  transform: translateY(-50%);
  outline: none;
  margin: 0;
  padding: 0;
}
.dual-range::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 18px;
  height: 18px;
  background: #048E79;
  border-radius: 50%;
  cursor: pointer;
  pointer-events: all;
  border: 2px solid #fff;
  box-shadow: 0 0 0 1px #048E79;
  position: relative;
  z-index: 2;
}
.dual-range::-moz-range-thumb {
  width: 18px;
  height: 18px;
  background: #048E79;
  border-radius: 50%;
  cursor: pointer;
  pointer-events: all;
  border: 2px solid #fff;
  box-shadow: 0 0 0 1px #048E79;
}
/* Track color JS se inline style mein set hoga */
.dual-range::-webkit-slider-runnable-track {
  background: transparent !important;
}
.dual-range::-moz-range-track {
  background: transparent !important;
}
.dual-range::-ms-track {
  background: transparent !important;
  border-color: transparent;
  color: transparent;
}

/* Make sure base track is gray */
.dual-range-track {
  position: absolute;
  height: 4px;
  background: #D0D0D0;   /* ← unselected color */
  border-radius: 4px;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  z-index: 0;
  pointer-events: none;
}

/* Fill between thumbs stays teal */
.dual-range-fill {
  position: absolute;
  height: 4px;
  background: #048E79;   /* ← selected/between color */
  border-radius: 4px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
  pointer-events: none;
}


@media (max-width: 768px) {
  .fd-desktop { display: none !important; }
  .fd-mobile  { display: flex; flex-direction: column; height: 100%; }

  .fd-mobile-header {
    display: flex;
    align-items: center;
    justify-content: flex-start !important;
    padding: 14px 16px;
    background: #fff;
    border-bottom: 0.5px solid #e8e5de;
    flex-shrink: 0;
    gap:10px;
  }
  .fd-mobile-header h3 {
        font-size: 18px;
        font-weight: 600;
        font-family: Montserrat;
        color: #1a1a1a;
        margin: 0;
  }
  .fd-mobile-close {
    background: none;
    border: none;
    font-size: 17px;
    color: #1a1a1a;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fd-mobile-body {
    display: flex;
    flex: 1;
    overflow: hidden;
  }
  .fd-tabs {
    width: 88px;
    background:#fef5d6;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    overflow-y: auto;
  }
  .fd-tab {
    padding: 15px 10px;
    font-size: 14px;
    color: #555;
    cursor: pointer;
    border: none;
    background: none;
    text-align: left;
    width: 100%;
    font-family: "Archivo", sans-serif;
    line-height: 1.3;
  }
  .fd-tab.active {
    background: #fcfbf9;
    color: #1a1a1a;
    font-weight: 500;
    border-left: 3px solid var(--primary-web-color);
  }
  .fd-panels {
    flex: 1;
    background: #fcfbf9;
    overflow-y: auto;
  }
  .fd-panel {
    display: none;
    padding: 14px 16px;
  }
  .fd-panel.active { display: block; }
  .fd-panel-title {
    font-size: 16px;
    font-weight: 600;
    color: #1a1a1a;
    font-family:var(--font-family-normal);
    margin: 0 0 12px;
  }
  .fd-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 0;
    border-bottom: 0.5px solid #f0ede6;
    cursor: pointer;
    font-size: 13px;
    color: #2a2a2a;
    font-family: "Archivo", sans-serif;
    gap: 8px;
    position: relative;
  }
  .fd-row:last-child { border-bottom: none; }
  /* native checkbox hidden visually but still reachable by keyboard */
  .fd-cb {
    position: absolute !important;
    right: 0;
    top: 50%;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .fd-cb:focus-visible + .fd-box {
    outline: 2px solid #048E79;
    outline-offset: 2px;
  }
  .fd-box {
    width: 20px;
    height: 20px;
    border: 1.5px solid #ccc;
    border-radius: 4px;
    flex-shrink: 0;
    position: relative;
    transition: background 0.15s, border-color 0.15s;
    display: inline-block;
  }
  .fd-cb:checked + .fd-box {
    background: #048E79;
    border-color: #048E79;
  }
  .fd-cb:checked + .fd-box::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 5px;
    width: 9px;
    height: 5px;
    border-left: 2px solid #fff;
    border-bottom: 2px solid #fff;
    transform: rotate(-45deg);
  }
  .fd-price-labels {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: #666;
    margin-bottom: 10px;
    font-family: "Archivo", sans-serif;
  }
  .fd-mobile-footer {
    display: flex;
    gap: 10px;
    padding: 12px 16px;
    background: #fff;
    border-top: 0.5px solid #e8e5de;
    flex-shrink: 0;
  }
  .fd-clear-btn {
    flex: 1;
    padding: 12px;
    border: none;
    background: none;
    color: #048E79;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    font-family: "Archivo", sans-serif;
    border-radius: 8px;
  }
  .fd-apply-btn {
    flex: 1.5;
    padding: 12px;
    border: none;
    background: #048E79;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    font-family: "Archivo", sans-serif;
    border-radius: 8px;
  }
  .fd-mobile-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 10px 16px 0;
    background: #fff;
  }
  .fd-mobile-chips:empty { display: none; }
}
</style>

<script>
(function () {

  /* ---- Desktop: collapse/expand  in js 1 file bole to "collection-tabs-showcase.liquid"---- */
  /* ---- Close (✕), Apply and Clear All are also handled there: they close the sheet,
          reset every filter (both price sliders included) and re-apply ---- */

  /* ---- Mobile: tab switching ---- */
  document.querySelectorAll('.fd-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      var drawer = tab.closest('.filter-drawer');
      drawer.querySelectorAll('.fd-tab').forEach(function(t) { t.classList.remove('active'); });
      drawer.querySelectorAll('.fd-panel').forEach(function(p) { p.classList.remove('active'); });
      tab.classList.add('active');
      var panel = drawer.querySelector('#fd-panel-' + tab.dataset.panel);
      if (panel) panel.classList.add('active');
    });
  });

/* ===== DUAL RANGE SLIDER LOGIC ===== */
  function initDualRange(wrapperEl, minEl, maxEl, minLabelEl, maxLabelEl, onChangeCallback) {
    if (!wrapperEl || !minEl || !maxEl) return;

    /* Track + fill inject karo */
    var track = document.createElement('div');
    track.className = 'dual-range-track';
    var fill = document.createElement('div');
    fill.className = 'dual-range-fill';
    wrapperEl.appendChild(track);
    wrapperEl.appendChild(fill);

    function update() {
      var minVal = parseInt(minEl.value);
      var maxVal = parseInt(maxEl.value);

      /* Cross nahi hone dena */
      if (minVal > maxVal) {
        if (this === minEl) { minEl.value = maxVal; minVal = maxVal; }
        else                { maxEl.value = minVal; maxVal = minVal; }
      }

      var rangeMin = parseInt(minEl.min);
      var rangeMax = parseInt(minEl.max);
      var pctMin = ((minVal - rangeMin) / (rangeMax - rangeMin)) * 100;
      var pctMax = ((maxVal - rangeMin) / (rangeMax - rangeMin)) * 100;

      fill.style.left  = pctMin + '%';
      fill.style.width = (pctMax - pctMin) + '%';

      if (minLabelEl) minLabelEl.textContent = minVal;
      if (maxLabelEl) maxLabelEl.textContent = maxVal;

      if (onChangeCallback) onChangeCallback(minVal, maxVal);
    }

    minEl.addEventListener('input', update);
    maxEl.addEventListener('input', update);
    update.call(minEl); /* initial render */
  }

  /* Desktop dual range */
/* Scope everything to THIS rendered drawer instance, not the whole document */
var thisDrawer = document.currentScript.closest('.filter-grid-wrapper')
  ? document.currentScript.closest('.filter-grid-wrapper').querySelector('.filter-drawer')
  : document.currentScript.parentElement.querySelector('.filter-drawer');
if (!thisDrawer) return;

/* Desktop dual range */
var deskWrapper = thisDrawer.querySelector('.fd-desktop .dual-range-wrapper');
var deskMin     = thisDrawer.querySelector('#priceRangeMin');
var deskMax     = thisDrawer.querySelector('#priceRangeMax');
var deskLabelMin = thisDrawer.querySelector('#priceMin');
var deskLabelMax = thisDrawer.querySelector('#priceMax');

/* Mobile dual range */
var mobWrapper  = thisDrawer.querySelector('.fd-mobile .dual-range-wrapper');
var mobMin      = thisDrawer.querySelector('.fd-range-min');
var mobMax      = thisDrawer.querySelector('.fd-range-max');
var mobLabelMin = thisDrawer.querySelector('#fdPriceMin');
var mobLabelMax = thisDrawer.querySelector('#fdPriceMax');

  /* Sync: jab desktop change ho → mobile bhi update karo aur vice versa */
  function onDeskChange(minV, maxV) {
    if (mobMin) mobMin.value = minV;
    if (mobMax) mobMax.value = maxV;
    if (mobLabelMin) mobLabelMin.textContent = minV;
    if (mobLabelMax) mobLabelMax.textContent = maxV;
    /* mobile fill update */
    updateMobFill(minV, maxV);
  }

  function onMobChange(minV, maxV) {
    if (deskMin) deskMin.value = minV;
    if (deskMax) deskMax.value = maxV;
    if (deskLabelMin) deskLabelMin.textContent = minV;
    if (deskLabelMax) deskLabelMax.textContent = maxV;
    /* desktop fill update */
    updateDeskFill(minV, maxV);
    /* applyFilters trigger */
    var activeTab = document.querySelector('.tab-content.active');
    if (activeTab && activeTab.applyFiltersWithPrice) {
      activeTab.applyFiltersWithPrice(minV, maxV);
    }
  }

  var mobFillEl, deskFillEl;

  function updateFill(fillEl, minV, maxV) {
    if (!fillEl) return;
    var ceil = parseInt((deskMax || mobMax || {}).max) || 5000; /* slider top comes from the markup */
    var pctMin = (minV / ceil) * 100;
    var pctMax = (maxV / ceil) * 100;
    fillEl.style.left  = pctMin + '%';
    fillEl.style.width = (pctMax - pctMin) + '%';
  }

  function updateMobFill(minV, maxV)  { updateFill(mobFillEl, minV, maxV); }
  function updateDeskFill(minV, maxV) { updateFill(deskFillEl, minV, maxV); }

  initDualRange(deskWrapper, deskMin, deskMax, deskLabelMin, deskLabelMax, function(minV, maxV) {
    deskFillEl = deskWrapper && deskWrapper.querySelector('.dual-range-fill');
    onDeskChange(minV, maxV);
    var activeTab = document.querySelector('.tab-content.active');
    if (activeTab && activeTab.applyFiltersWithPrice) {
      activeTab.applyFiltersWithPrice(minV, maxV);
    }
  });

  initDualRange(mobWrapper, mobMin, mobMax, mobLabelMin, mobLabelMax, function(minV, maxV) {
    mobFillEl = mobWrapper && mobWrapper.querySelector('.dual-range-fill');
    onMobChange(minV, maxV);
  });
})();
</script>
