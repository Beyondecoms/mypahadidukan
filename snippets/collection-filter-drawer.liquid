      </div>
      <div class="filter-group-body">
        <label><input type="checkbox" class="filter-availability" value="in"> In Stock</label>
        <label><input type="checkbox" class="filter-availability" value="out"> Out Of Stock</label>
      </div>
    </div>
    <div class="filter-group">
      <div class="filter-group-header">
        <h4>Price</h4>
        <span class="filter-group-toggle"><svg width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M1.09936 9.39047C0.978036 9.52472 0.814461 9.6 0.644032 9.6C0.473603 9.6 0.310028 9.52472 0.188703 9.39047C0.128938 9.32445 0.0814762 9.24575 0.0490799 9.15896C0.0166836 9.07218 0 8.97903 0 8.88494C0 8.79085 0.0166836 8.6977 0.0490799 8.61091C0.0814762 8.52412 0.128938 8.44543 0.188703 8.37941L7.54467 0.209532C7.666 0.0752735 7.82957 0 8 0C8.17043 0 8.334 0.0752735 8.45533 0.209532L15.8113 8.37941C15.8711 8.44543 15.9185 8.52412 15.9509 8.61091C15.9833 8.6977 16 8.79085 16 8.88494C16 8.97903 15.9833 9.07218 15.9509 9.15896C15.9185 9.24575 15.8711 9.32445 15.8113 9.39047C15.69 9.52472 15.5264 9.6 15.356 9.6C15.1855 9.6 15.022 9.52472 14.9006 9.39047L7.99954 1.9395L1.09936 9.39047Z" fill="#231F20"/>
</svg>
</span>
      </div>
      <div class="filter-group-body">
        <div class="price-range-labels">
          <span>₹<span id="priceMin">0</span></span>
          <span>₹<span id="priceMax">5000</span></span>
        </div>
        <div class="dual-range-wrapper">
          <input type="range" min="0" max="5000" value="0"    step="1" id="priceRangeMin" class="dual-range">
          <input type="range" min="0" max="5000" value="5000" step="1" id="priceRangeMax" class="dual-range" id="priceRange">
        </div>
      </div>
    </div>

    <div class="filter-group">
      <div class="filter-group-header">
        <h4>Category</h4>
        <span class="filter-group-toggle"><svg width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M1.09936 9.39047C0.978036 9.52472 0.814461 9.6 0.644032 9.6C0.473603 9.6 0.310028 9.52472 0.188703 9.39047C0.128938 9.32445 0.0814762 9.24575 0.0490799 9.15896C0.0166836 9.07218 0 8.97903 0 8.88494C0 8.79085 0.0166836 8.6977 0.0490799 8.61091C0.0814762 8.52412 0.128938 8.44543 0.188703 8.37941L7.54467 0.209532C7.666 0.0752735 7.82957 0 8 0C8.17043 0 8.334 0.0752735 8.45533 0.209532L15.8113 8.37941C15.8711 8.44543 15.9185 8.52412 15.9509 8.61091C15.9833 8.6977 16 8.79085 16 8.88494C16 8.97903 15.9833 9.07218 15.9509 9.15896C15.9185 9.24575 15.8711 9.32445 15.8113 9.39047C15.69 9.52472 15.5264 9.6 15.356 9.6C15.1855 9.6 15.022 9.52472 14.9006 9.39047L7.99954 1.9395L1.09936 9.39047Z" fill="#231F20"/>
</svg>
</span>
      </div>
      <div class="filter-group-body">
        {% assign types = collection.products | map: 'type' | uniq %}
        {% for type in types %}
          {% assign type_count = collection.products | where: 'type', type | size %}
          {% if type != blank %}
            <label>
              <input type="checkbox" class="filter-type" value="{{ type }}">
                  {{ type }} ({{ type_count }})
            </label>
          {% endif %}

        {% endfor %}
      </div>
    </div>

    <div class="filter-group">
      <div class="filter-group-header">
        <h4>Place</h4>
        <span class="filter-group-toggle"><svg width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
<path d="M1.09936 9.39047C0.978036 9.52472 0.814461 9.6 0.644032 9.6C0.473603 9.6 0.310028 9.52472 0.188703 9.39047C0.128938 9.32445 0.0814762 9.24575 0.0490799 9.15896C0.0166836 9.07218 0 8.97903 0 8.88494C0 8.79085 0.0166836 8.6977 0.0490799 8.61091C0.0814762 8.52412 0.128938 8.44543 0.188703 8.37941L7.54467 0.209532C7.666 0.0752735 7.82957 0 8 0C8.17043 0 8.334 0.0752735 8.45533 0.209532L15.8113 8.37941C15.8711 8.44543 15.9185 8.52412 15.9509 8.61091C15.9833 8.6977 16 8.79085 16 8.88494C16 8.97903 15.9833 9.07218 15.9509 9.15896C15.9185 9.24575 15.8711 9.32445 15.8113 9.39047C15.69 9.52472 15.5264 9.6 15.356 9.6C15.1855 9.6 15.022 9.52472 14.9006 9.39047L7.99954 1.9395L1.09936 9.39047Z" fill="#231F20"/>
</svg>
</span>
      </div>
      <div class="filter-group-body">
        {% assign tags = collection.products | map: 'tags' | join: ',' | split: ',' | uniq %}
        {% for tag in tags %}
          <label>
            <input type="checkbox" class="filter-tag" value="{{ tag }}">
            {{ tag }}
          </label>
        {% endfor %}
      </div>
    </div>

  </div>

  {% comment %} ===== MOBILE VIEW ===== {% endcomment %}
  <div class="fd-mobile">

    <div class="fd-mobile-header">
      <button class="closeFilter fd-mobile-close" id="fdMobileClose">✕</button>
      <h3>Filters</h3>
      <div style="width:28px"></div>
    </div>

    <div class="fd-mobile-body">

      <div class="fd-tabs">
        <button class="fd-tab active" data-panel="avail">Availability</button>
        <button class="fd-tab" data-panel="price">Price</button>
        <button class="fd-tab" data-panel="category">Category</button>
        <button class="fd-tab" data-panel="place">Place</button>
      </div>

      <div class="fd-panels">

        <div class="fd-mobile-chips" id="fdActiveChips"></div>

        <div class="fd-panel active" id="fd-panel-avail">
          <p class="fd-panel-title">Select Availability</p>
          <label class="fd-row">
            <span>In Stock</span>
            <input type="checkbox" class="filter-availability fd-cb" value="in">
            <span class="fd-box"></span>
          </label>
          <label class="fd-row">
            <span>Out Of Stock</span>
            <input type="checkbox" class="filter-availability fd-cb" value="out">
            <span class="fd-box"></span>
          </label>
        </div>

        {% comment %} <div class="fd-panel" id="fd-panel-price">
          <p class="fd-panel-title">Select Price</p>
          <div class="fd-price-labels">
            <span>₹0</span>
            <span id="fdPriceVal">₹5000</span>
          </div>
          <input type="range" min="0" max="5000" value="5000" step="1" class="fd-range filter-price-range">
        </div> {% endcomment %}
        <div class="fd-panel" id="fd-panel-price">
          <p class="fd-panel-title">Select Price</p>
          <div class="fd-price-labels">
            <span>₹<span id="fdPriceMin">0</span></span>
            <span>₹<span id="fdPriceMax">5000</span></span>
          </div>
          <div class="dual-range-wrapper">
            <input type="range" min="0" max="5000" value="0"    step="1" class="dual-range fd-range-min">
            <input type="range" min="0" max="5000" value="5000" step="1" class="dual-range fd-range-max">
          </div>
        </div>
        <div class="fd-panel" id="fd-panel-category">
          <p class="fd-panel-title">Select Category</p>
          {% assign types = collection.products | map: 'type' | uniq %}
          {% for type in types %}
            {% assign type_count = collection.products | where: 'type', type | size %}
            {% if type != blank %}
            <label class="fd-row">
              <span>{{ type }} ({{ type_count }})</span>
              <input type="checkbox" class="filter-type fd-cb" value="{{ type }}">
              <span class="fd-box"></span>
            </label>
            {% endif %}

          {% endfor %}
        </div>

        <div class="fd-panel" id="fd-panel-place">
          <p class="fd-panel-title">Select Place</p>
          {% assign tags = collection.products | map: 'tags' | join: ',' | split: ',' | uniq %}
          {% for tag in tags %}
            <label class="fd-row">
              <span>{{ tag }}</span>
              <input type="checkbox" class="filter-tag fd-cb" value="{{ tag }}">
              <span class="fd-box"></span>
            </label>
          {% endfor %}
        </div>

      </div>
    </div>

    <div class="fd-mobile-footer">
      <button class="fd-clear-btn">Clear All</button>
      <button class="closeFilter fd-apply-btn">Apply</button>
    </div>

  </div>

</div>


<style>
.fd-mobile { display: none; }
.fd-desktop { display: block; }

.filter-group-body {
  overflow-y: auto !important;
  overflow-x: hidden !important;
  max-height: 500px;
  transition: max-height 0.3s ease, opacity 0.25s ease;
  opacity: 1;
  scrollbar-width: thin;
  padding-bottom: 4px;
}

.filter-group.collapsed .filter-group-body {
  max-height: 0;
  opacity: 0;
  padding-bottom: 0;
}
.filter-group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  padding-bottom: 12px;
  user-select: none;
}
.filter-group-toggle {
  font-size: 16px;
  color: #231F20;
  line-height: 1;
  transition: transform 0.3s ease;
  display: inline-block;
}
.filter-group.collapsed .filter-group-toggle {
  transform: rotate(180deg);
}
/* ===== DUAL RANGE SLIDER ===== */
.dual-range-wrapper {
  position: relative;
  height: 18px;
  margin: 8px;
}
.dual-range {
  position: absolute;
  width: 100%;
  height: 4px;
  background: transparent;
  pointer-events: none;
  -webkit-appearance: none;
  appearance: none;
  top: 50%;
  transform: translateY(-50%);
  outline: none;
  margin: 0;
  padding: 0;
}
.dual-range::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 18px;
  height: 18px;
  background: #048E79;
  border-radius: 50%;
  cursor: pointer;
  pointer-events: all;
  border: 2px solid #fff;
  box-shadow: 0 0 0 1px #048E79;
  position: relative;
  z-index: 2;
}
.dual-range::-moz-range-thumb {
  width: 18px;
  height: 18px;
  background: #048E79;
  border-radius: 50%;
  cursor: pointer;
  pointer-events: all;
  border: 2px solid #fff;
  box-shadow: 0 0 0 1px #048E79;
}
/* Track color JS se inline style mein set hoga */
.dual-range::-webkit-slider-runnable-track {
  background: transparent !important;
}
.dual-range::-moz-range-track {
  background: transparent !important;
}
.dual-range::-ms-track {
  background: transparent !important;
  border-color: transparent;
  color: transparent;
}

/* Make sure base track is gray */
.dual-range-track {
  position: absolute;
  height: 4px;
  background: #D0D0D0;   /* ← unselected color */
  border-radius: 4px;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  z-index: 0;
  pointer-events: none;
}

/* Fill between thumbs stays teal */
.dual-range-fill {
  position: absolute;
  height: 4px;
  background: #048E79;   /* ← selected/between color */
  border-radius: 4px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
  pointer-events: none;
}


@media (max-width: 768px) {
  .fd-desktop { display: none !important; }
  .fd-mobile  { display: flex; flex-direction: column; height: 100%; }

  .fd-mobile-header {
    display: flex;
    align-items: center;
    justify-content: flex-start !important;
    padding: 14px 16px;
    background: #fff;
    border-bottom: 0.5px solid #e8e5de;
    flex-shrink: 0;
    gap:10px;
  }
  .fd-mobile-header h3 {
        font-size: 18px;
        font-weight: 600;
        font-family: Montserrat;
        color: #1a1a1a;
        margin: 0;
  }
  .fd-mobile-close {
    background: none;
    border: none;
    font-size: 17px;
    color: #1a1a1a;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fd-mobile-body {
    display: flex;
    flex: 1;
    overflow: hidden;
  }
  .fd-tabs {
    width: 88px;
    background:#fef5d6;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    overflow-y: auto;
  }
  .fd-tab {
    padding: 15px 10px;
    font-size: 14px;
    color: #555;
    cursor: pointer;
    border: none;
    background: none;
    text-align: left;
    width: 100%;
    font-family: "Archivo", sans-serif;
    line-height: 1.3;
  }
  .fd-tab.active {
    background: #fcfbf9;
    color: #1a1a1a;
    font-weight: 500;
    border-left: 3px solid var(--primary-web-color);
  }
  .fd-panels {
    flex: 1;
    background: #fcfbf9;
    overflow-y: auto;
  }
  .fd-panel {
    display: none;
    padding: 14px 16px;
  }
  .fd-panel.active { display: block; }
  .fd-panel-title {
    font-size: 16px;
    font-weight: 600;
    color: #1a1a1a;
    font-family:var(--font-family-normal);
    margin: 0 0 12px;
  }
  .fd-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 0;
    border-bottom: 0.5px solid #f0ede6;
    cursor: pointer;
    font-size: 13px;
    color: #2a2a2a;
    font-family: "Archivo", sans-serif;
    gap: 8px;
  }
  .fd-row:last-child { border-bottom: none; }
  .fd-cb { display: none !important; }
  .fd-box {
    width: 20px;
    height: 20px;
    border: 1.5px solid #ccc;
    border-radius: 4px;
    flex-shrink: 0;
    position: relative;
    transition: background 0.15s, border-color 0.15s;
    display: inline-block;
  }
  .fd-cb:checked + .fd-box {
    background: #048E79;
    border-color: #048E79;
  }
  .fd-cb:checked + .fd-box::after {
    content: '';
    position: absolute;
    left: 4px;
    top: 5px;
    width: 9px;
    height: 5px;
    border-left: 2px solid #fff;
    border-bottom: 2px solid #fff;
