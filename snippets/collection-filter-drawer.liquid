{% comment %} collection-filter-drawer.liquid {% endcomment %}
<div class="filter-drawer filterDrawer">
  {% comment %} ===== DESKTOP VIEW ===== {% endcomment %}
  <div class="fd-desktop">
    <div class="filter-header">
      <h3>FILTERS</h3>
<button class="closeFilter"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg"   xmlns:xlink="http://www.w3.org/1999/xlink">
    <rect width="16" height="16" fill="url(#pattern0_518_6030)"/>
    <defs>
    <pattern id="pattern0_518_6030" patternContentUnits="objectBoundingBox" width="1" height="1">
    <use xlink:href="#image0_518_6030" transform="scale(0.00195312)"/>
    </pattern>
    <image id="image0_518_6030" width="512" height="512" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
    </defs>
    </svg>
</button>
    </div>

    {% comment %} <div class="active-filters" id="activeFilters"></div> {% endcomment %}
<div class="active-filters" id="drawerActiveFilters"></div>
    <div class="filter-group">
      <div class="filter-group-header">
        <h4>Availability</h4>
        <span class="filter-group-toggle"><svg width="16" height="10" viewBox="0 0 16 10" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1.09936 9.39047C0.978036 9.52472 0.814461 9.6 0.644032 9.6C0.473603 9.6 0.310028 9.52472 0.188703 9.39047C0.128938 9.32445 0.0814762 9.24575 0.0490799 9.15896C0.0166836 9.07218 0 8.97903 0 8.88494C0 8.79085 0.0166836 8.6977 0.0490799 8.61091C0.0814762 8.52412 0.128938 8.44543 0.188703 8.37941L7.54467 0.209532C7.666 0.0752735 7.82957 0 8 0C8.17043 0 8.334 0.0752735 8.45533 0.209532L15.8113 8.37941C15.8711 8.44543 15.9185 8.52412 15.9509 8.61091C15.9833 8.6977 16 8.79085 16 8.88494C16 8.97903 15.9833 9.07218 15.9509 9.15896C15.9185 9.24575 15.8711 9.32445 15.8113 9.39047C15.69 9.52472 15.5264 9.6 15.356 9.6C15.1855 9.6 15.022 9.52472 14.9006 9.39047L7.99954 1.9395L1.09936 9.39047Z" fill="#231F20"/>
