</style>

<script>
(function () {

  /* ---- Desktop: collapse/expand  in js 1 file bole to "collection-tabs-showcase.liquid"---- */

  /* ---- Mobile: tab switching ---- */
  document.querySelectorAll('.fd-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      var drawer = tab.closest('.filter-drawer');
      drawer.querySelectorAll('.fd-tab').forEach(function(t) { t.classList.remove('active'); });
      drawer.querySelectorAll('.fd-panel').forEach(function(p) { p.classList.remove('active'); });
      tab.classList.add('active');
      var panel = drawer.querySelector('#fd-panel-' + tab.dataset.panel);
      if (panel) panel.classList.add('active');
    });
  });

  /* ---- Mobile: price range label ---- */
  document.querySelectorAll('.fd-range').forEach(function(range) {
    range.addEventListener('input', function() {
      var valEl = document.getElementById('fdPriceVal');
      if (valEl) valEl.textContent = '₹' + range.value;
    });
  });

/* ---- Mobile: Clear All ---- */
document.querySelectorAll('.fd-clear-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var drawer = btn.closest('.filter-drawer');
    drawer.querySelectorAll('.fd-cb').forEach(function(cb) { cb.checked = false; });
    var range = drawer.querySelector('.fd-range');
    if (range) range.value = 5000;
    var valEl = document.getElementById('fdPriceVal');
    if (valEl) valEl.textContent = '₹5000';

    /* Reset price range and re-apply filters */
    var activeTab = document.querySelector('.tab-content.active');
    if (activeTab && activeTab.applyFiltersWithPrice) {
      activeTab.applyFiltersWithPrice(0, 5000);
    }
  });
});

/* ---- Mobile: Apply button → close drawer + apply filters ---- */
document.querySelectorAll('.fd-apply-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var drawer = btn.closest('.filter-drawer');
    if (drawer) drawer.classList.remove('active');

    /* Also close the filter-grid-wrapper open state */
    var filterGridWrap = drawer.closest('.filter-grid-wrapper');
    if (filterGridWrap) filterGridWrap.classList.remove('filter-open');

    /* Trigger filter apply on active tab */
    var activeTab = document.querySelector('.tab-content.active');
    if (activeTab && activeTab.applyFiltersWithPrice) {
      var minVal = parseInt(document.querySelector('.fd-range-min') && document.querySelector('.fd-range-min').value) || 0;
      var maxVal = parseInt(document.querySelector('.fd-range-max') && document.querySelector('.fd-range-max').value) || 5000;
      activeTab.applyFiltersWithPrice(minVal, maxVal);
    }
  });
});

  /* ---- Mobile: close button ---- */
  var mobileCloseBtn = document.getElementById('fdMobileClose');
  if (mobileCloseBtn) {
    mobileCloseBtn.addEventListener('click', function() {
      var drawer = mobileCloseBtn.closest('.filter-drawer');
      if (drawer) drawer.classList.remove('active');
    });
  }

  /* ---- Chips mirror with working click handlers ---- */
  /* innerHTML copy se event listeners nahi aate, isliye
     MutationObserver mein cloneNode + fresh listeners lagate hain */
  {% comment %} var mainChips   = document.getElementById('activeFilters'); {% endcomment %}
   var mainChips = document.querySelector('.grid-area #activeFilters');
  var mobileChips = document.getElementById('fdActiveChips');

  function syncChips() {
    if (!mainChips || !mobileChips) return;
    mobileChips.innerHTML = '';
    Array.from(mainChips.children).forEach(function(chip) {
      var clone = chip.cloneNode(true);
      var cloneBtn = clone.querySelector('button');
      var origBtn  = chip.querySelector('button');
      if (cloneBtn && origBtn) {
        cloneBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          origBtn.click(); /* original chip remove + filter re-apply */
        });
      }
      mobileChips.appendChild(clone);
    });
  }

  if (mainChips && mobileChips) {
    var observer = new MutationObserver(syncChips);
    observer.observe(mainChips, { childList: true, subtree: true });
  }
/* ===== DUAL RANGE SLIDER LOGIC ===== */
  function initDualRange(wrapperEl, minEl, maxEl, minLabelEl, maxLabelEl, onChangeCallback) {
    if (!wrapperEl || !minEl || !maxEl) return;

    /* Track + fill inject karo */
    var track = document.createElement('div');
    track.className = 'dual-range-track';
    var fill = document.createElement('div');
    fill.className = 'dual-range-fill';
    wrapperEl.appendChild(track);
    wrapperEl.appendChild(fill);

    function update() {
      var minVal = parseInt(minEl.value);
      var maxVal = parseInt(maxEl.value);

      /* Cross nahi hone dena */
      if (minVal > maxVal) {
        if (this === minEl) { minEl.value = maxVal; minVal = maxVal; }
        else                { maxEl.value = minVal; maxVal = minVal; }
      }

      var rangeMin = parseInt(minEl.min);
      var rangeMax = parseInt(minEl.max);
      var pctMin = ((minVal - rangeMin) / (rangeMax - rangeMin)) * 100;
      var pctMax = ((maxVal - rangeMin) / (rangeMax - rangeMin)) * 100;

      fill.style.left  = pctMin + '%';
      fill.style.width = (pctMax - pctMin) + '%';

      if (minLabelEl) minLabelEl.textContent = minVal;
      if (maxLabelEl) maxLabelEl.textContent = maxVal;

      if (onChangeCallback) onChangeCallback(minVal, maxVal);
    }

    minEl.addEventListener('input', update);
    maxEl.addEventListener('input', update);
    update.call(minEl); /* initial render */
  }

  /* Desktop dual range */
/* Scope everything to THIS rendered drawer instance, not the whole document */
var thisDrawer = document.currentScript.closest('.filter-grid-wrapper')
  ? document.currentScript.closest('.filter-grid-wrapper').querySelector('.filter-drawer')
  : document.currentScript.parentElement.querySelector('.filter-drawer');

/* Desktop dual range */
var deskWrapper = thisDrawer.querySelector('.fd-desktop .dual-range-wrapper');
var deskMin     = thisDrawer.querySelector('#priceRangeMin');
var deskMax     = thisDrawer.querySelector('#priceRangeMax');
var deskLabelMin = thisDrawer.querySelector('#priceMin');
var deskLabelMax = thisDrawer.querySelector('#priceMax');

/* Mobile dual range */
var mobWrapper  = thisDrawer.querySelector('.fd-mobile .dual-range-wrapper');
var mobMin      = thisDrawer.querySelector('.fd-range-min');
var mobMax      = thisDrawer.querySelector('.fd-range-max');
var mobLabelMin = thisDrawer.querySelector('#fdPriceMin');
var mobLabelMax = thisDrawer.querySelector('#fdPriceMax');

  /* Sync: jab desktop change ho → mobile bhi update karo aur vice versa */
  function onDeskChange(minV, maxV) {
    if (mobMin) mobMin.value = minV;
    if (mobMax) mobMax.value = maxV;
    if (mobLabelMin) mobLabelMin.textContent = minV;
    if (mobLabelMax) mobLabelMax.textContent = maxV;
    /* mobile fill update */
    updateMobFill(minV, maxV);
  }

  function onMobChange(minV, maxV) {
    if (deskMin) deskMin.value = minV;
    if (deskMax) deskMax.value = maxV;
    if (deskLabelMin) deskLabelMin.textContent = minV;
    if (deskLabelMax) deskLabelMax.textContent = maxV;
    /* desktop fill update */
    updateDeskFill(minV, maxV);
    /* applyFilters trigger */
    {% comment %} applyFiltersWithPrice(minV, maxV); {% endcomment %}
     var activeTab = document.querySelector('.tab-content.active');

if (activeTab && activeTab.applyFiltersWithPrice) {
  activeTab.applyFiltersWithPrice(minV, maxV);
}
  }

  var mobFillEl, deskFillEl;

  function updateFill(fillEl, minV, maxV) {
    if (!fillEl) return;
    var pctMin = (minV / 5000) * 100;
    var pctMax = (maxV / 5000) * 100;
    fillEl.style.left  = pctMin + '%';
    fillEl.style.width = (pctMax - pctMin) + '%';
  }

  function updateMobFill(minV, maxV)  { updateFill(mobFillEl, minV, maxV); }
  function updateDeskFill(minV, maxV) { updateFill(deskFillEl, minV, maxV); }

  initDualRange(deskWrapper, deskMin, deskMax, deskLabelMin, deskLabelMax, function(minV, maxV) {
    deskFillEl = deskWrapper && deskWrapper.querySelector('.dual-range-fill');
    onDeskChange(minV, maxV);
    {% comment %} applyFiltersWithPrice(minV, maxV); {% endcomment %}
     var activeTab = document.querySelector('.tab-content.active');

if (activeTab && activeTab.applyFiltersWithPrice) {
  activeTab.applyFiltersWithPrice(minV, maxV);
}
  });

  initDualRange(mobWrapper, mobMin, mobMax, mobLabelMin, mobLabelMax, function(minV, maxV) {
    mobFillEl = mobWrapper && mobWrapper.querySelector('.dual-range-fill');
    onMobChange(minV, maxV);
  });
})();
</script>
<script>
(function () {

  /* ===== Filter drawer open → add height to product-grid ===== */

  var GRID_CLASS = 'filter-open-tall'; /* class we add/remove */

  /* Inject the style once */
  var styleTag = document.createElement('style');
  styleTag.textContent = '.filter-open-tall { height: 159vh !important; }';
  document.head.appendChild(styleTag);

  function getGrid() {
    return document.querySelector('.grid-area');
  }

  function onDrawerOpen() {
    var g = getGrid();
    if (g) g.classList.add(GRID_CLASS);
  }

  function onDrawerClose() {
    var g = getGrid();
    if (g) g.classList.remove(GRID_CLASS);
  }

  /* Watch the .filterDrawer for the 'active' class being added/removed */
  var filterDrawer = document.querySelector('.filter-drawer.filterDrawer');
  if (filterDrawer) {
    var observer = new MutationObserver(function (mutations) {
      mutations.forEach(function (mutation) {
        if (mutation.attributeName === 'class') {
          if (filterDrawer.classList.contains('active')) {
            onDrawerOpen();
          } else {
            onDrawerClose();
          }
        }
      });
    });
    observer.observe(filterDrawer, { attributes: true });
  }

})();
</script>