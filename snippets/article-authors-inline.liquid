{%- comment -%}
  Self-contained author box for the blog post section (no other snippets needed).
  Usage, in the article section just before Related Posts:
    {% render 'article-authors-inline', article: article, heading: 'About the author' %}
  Reads article.metafields.custom.author (single metaobject or list).
{%- endcomment -%}

{%- liquid
  assign author_field = article.metafields.custom.author
  assign is_list = false
  assign author_count = 1
  if author_field.type contains 'list'
    assign is_list = true
    assign author_count = author_field.value.size
  endif
-%}

{%- if author_field.value != blank -%}
  <style>
    .m-article-authors { margin: 40px 0; }
    .m-article-authors__heading { margin: 0 0 20px; }
    .m-article-authors__list { display: grid; gap: 20px; }
    .m-article-authors .author-card {
      display: flex;
      gap: 24px;
      align-items: flex-start;
      padding: 24px;
      border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
      border-radius: 20px;
    }
    .m-article-authors .author-card__photo {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      object-fit: cover;
      display: block;
      flex-shrink: 0;
    }
    .m-article-authors .author-card__body { flex: 1; min-width: 0; }
    .m-article-authors .author-card__name {
      font-size: 18px;
      font-weight: 600;
      margin: 0 0 4px;
      line-height: 1.3;
    }
    .m-article-authors .author-card__name a { color: inherit; text-decoration: none; }
    .m-article-authors .author-card__role { margin: 0 0 10px; font-size: 14px; opacity: 0.7; }
    .m-article-authors .author-card__bio p { margin: 0 0 8px; }
    .m-article-authors .author-card__more {
      display: inline-block;
      margin-top: 8px;
      font-size: 15px;
      font-weight: 600;
      color: #D97706;
      text-decoration: underline;
      text-underline-offset: 4px;
    }
    @media screen and (max-width: 767px) {
      .m-article-authors .author-card {
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 20px;
      }
    }
  </style>

  <div class="m-article-authors">
    {%- if heading != blank -%}
      <h3 class="m-article-authors__heading">{{ heading }}</h3>
    {%- endif -%}

    <div class="m-article-authors__list">
      {%- for i in (1..author_count) -%}
        {%- if is_list -%}
          {%- assign author = author_field.value[forloop.index0] -%}
        {%- else -%}
          {%- assign author = author_field.value -%}
        {%- endif -%}
        {%- assign author_url = author.system.url -%}
        <div class="author-card">
          {%- if author.photo.value != blank -%}
            {%- if author_url != blank -%}<a href="{{ author_url }}">{%- endif -%}
            {{
              author.photo.value
              | image_url: width: 240, height: 240, crop: 'center'
              | image_tag: loading: 'lazy', alt: author.name.value, class: 'author-card__photo', width: 96, height: 96
            }}
            {%- if author_url != blank -%}</a>{%- endif -%}
          {%- endif -%}

          <div class="author-card__body">
            <p class="author-card__name">
              {%- if author_url != blank -%}
                <a href="{{ author_url }}">{{ author.name.value }}</a>
              {%- else -%}
                {{ author.name.value }}
              {%- endif -%}
            </p>

            {%- if author.role.value != blank -%}
              <p class="author-card__role">{{ author.role.value }}</p>
            {%- endif -%}

            {%- if author.bio.value != blank -%}
              <div class="author-card__bio rte">{{ author.bio | metafield_tag }}</div>
            {%- endif -%}

            {%- if author_url != blank -%}
              <a href="{{ author_url }}" class="author-card__more">More from {{ author.name.value }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
