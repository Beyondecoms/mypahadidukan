<!-- DESKTOP TOPBAR -->
<div class="collection-topbar desktop-topbar">
  <!-- FILTER BUTTON -->
  <button class="filter-btn filterToggle">
    <svg width="22" height="20" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M21 1H1L9 10.46V17L13 19V10.46L21 1Z"
        stroke="#048E79"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    Show Filter
  </button>

  <!-- TITLE -->
  <div class="collection-heading">
    <h2 class="collection-title">
      {{ collection.metafields.custom.collection_heading.value | default: collection.title }}
    </h2>
    <p class="collection-count productCount">
      ({{ collection.products_count }} products)
    </p>
    {%- if collection.metafields.custom.collection_top_description != blank -%}
      <div class="collection-top-description rte">
        {{ collection.metafields.custom.collection_top_description | metafield_tag }}
      </div>
    {%- endif -%}
    <div class="sort-status-message" style="display:none;"></div>
  </div>

  <!-- SORT BUTTON -->
  <button class="sort-btn sortToggle">
    <svg width="18" height="12" viewBox="0 0 18 12" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path
        d="M1 12H5C5.55 12 6 11.55 6 11C6 10.45 5.55 10 5 10H1C0.45 10 0 10.45 0 11C0 11.55 0.45 12 1 12ZM0 1C0 1.55 0.45 2 1 2H17C17.55 2 18 1.55 18 1C18 0.45 17.55 0 17 0H1C0.45 0 0 0.45 0 1ZM1 7H11C11.55 7 12 6.55 12 6C12 5.45 11.55 5 11 5H1C0.45 5 0 5.45 0 6C0 6.55 0.45 7 1 7Z"
        fill="#048E79"
      />
    </svg>
    Sort
  </button>

</div>


<!-- MOBILE TOPBAR -->
<div class="collection-topbar-mobile">

  <!-- TITLE + COUNT -->
  <div class="mobile-heading-row">
    <h2 class="collection-title">
      {{ collection.metafields.custom.collection_heading.value | default: collection.title }}
    </h2>

    <p class="collection-count productCount">
      ({{ collection.products_count }} products)
    </p>

    {%- if collection.metafields.custom.collection_top_description != blank -%}
      <div class="collection-top-description rte">
        {{ collection.metafields.custom.collection_top_description | metafield_tag }}
      </div>
    {%- endif -%}

    <div class="sort-status-message" style="display:none;"></div>
  </div>

  <!-- FILTER + SORT -->
  <div class="mobile-btn-row">

    <button class="filter-btn filterToggle">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M14.1116 11.9989V19.0024C14.1471 19.269 14.0582 19.5534 13.8538 19.7401C13.7716 19.8225 13.6739 19.8878 13.5664 19.9324C13.4589 19.977 13.3436 20 13.2272 20C13.1108 20 12.9956 19.977 12.8881 19.9324C12.7806 19.8878 12.6829 19.8225 12.6007 19.7401L10.8142 17.9537C10.7174 17.8589 10.6437 17.743 10.599 17.615C10.5543 17.487 10.5397 17.3505 10.5565 17.216V11.9989H10.5298L5.41053 5.4398C5.2662 5.25452 5.20107 5.01965 5.22938 4.7865C5.2577 4.55335 5.37714 4.34088 5.56162 4.19553C5.73048 4.0711 5.91712 4 6.11265 4H18.5554C18.7509 4 18.9376 4.0711 19.1064 4.19553C19.2909 4.34088 19.4104 4.55335 19.4387 4.7865C19.467 5.01965 19.4019 5.25452 19.2575 5.4398L14.1382 11.9989H14.1116Z" fill="#5C5C5C"/>
      </svg>
      Filter
    </button>

    <button class="sort-btn sortToggle">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M13.47 7.52983C13.6107 7.67028 13.8013 7.74917 14 7.74917C14.1988 7.74917 14.3894 7.67028 14.53 7.52983L15.25 6.80983V16.9998C15.25 17.1987 15.329 17.3895 15.4697 17.5302C15.6104 17.6708 15.8011 17.7498 16 17.7498C16.1989 17.7498 16.3897 17.6708 16.5304 17.5302C16.671 17.3895 16.75 17.1987 16.75 16.9998V6.80983L17.47 7.52983C17.5387 7.60352 17.6215 7.66262 17.7135 7.70361C17.8055 7.7446 17.9048 7.76664 18.0055 7.76842C18.1062 7.7702 18.2062 7.75167 18.2996 7.71395C18.393 7.67623 18.4779 7.62009 18.5491 7.54887C18.6203 7.47765 18.6764 7.39281 18.7142 7.29943C18.7519 7.20604 18.7704 7.10601 18.7686 7.00531C18.7668 6.9046 18.7448 6.80529 18.7038 6.71329C18.6628 6.62129 18.6037 6.53849 18.53 6.46983L16.53 4.46983C16.3894 4.32938 16.1988 4.25049 16 4.25049C15.8013 4.25049 15.6107 4.32938 15.47 4.46983L13.47 6.46983C13.3296 6.61045 13.2507 6.80108 13.2507 6.99983C13.2507 7.19858 13.3296 7.3892 13.47 7.52983ZM8.75003 17.1898L9.47003 16.4698C9.53869 16.3961 9.62149 16.337 9.71349 16.296C9.80549 16.2551 9.90481 16.233 10.0055 16.2312C10.1062 16.2295 10.2062 16.248 10.2996 16.2857C10.393 16.3234 10.4779 16.3796 10.5491 16.4508C10.6203 16.522 10.6764 16.6068 10.7142 16.7002C10.7519 16.7936 10.7704 16.8936 10.7686 16.9944C10.7668 17.0951 10.7448 17.1944 10.7038 17.2864C10.6628 17.3784 10.6037 17.4612 10.53 17.5298L8.53003 19.5298C8.38941 19.6703 8.19878 19.7492 8.00003 19.7492C7.80128 19.7492 7.61066 19.6703 7.47003 19.5298L5.47003 17.5298C5.39634 17.4612 5.33724 17.3784 5.29625 17.2864C5.25526 17.1944 5.23322 17.0951 5.23144 16.9944C5.22966 16.8936 5.24819 16.7936 5.28591 16.7002C5.32363 16.6068 5.37977 16.522 5.45099 16.4508C5.52221 16.3796 5.60705 16.3234 5.70043 16.2857C5.79382 16.248 5.89385 16.2295 5.99455 16.2312C6.09526 16.233 6.19457 16.2551 6.28657 16.296C6.37857 16.337 6.46137 16.3961 6.53003 16.4698L7.25003 17.1898V6.99983C7.25003 6.80092 7.32905 6.61015 7.4697 6.4695C7.61035 6.32885 7.80112 6.24983 8.00003 6.24983C8.19894 6.24983 8.38971 6.32885 8.53036 6.4695C8.67101 6.61015 8.75003 6.80092 8.75003 6.99983V17.1898Z" fill="#5C5C5C"/>
      </svg>
      Sort
    </button>

  </div>

</div>

<style>
  .filter-btn {
  position: relative;
  overflow: visible;
}

.filter-count-badge {
  position: absolute;
  top: -10px;
  right: -10px;
  background: #f3743c;
  color: #fff;
  font-size: 13px;
  font-weight: 700;
  min-width: 22px;
  height: 22px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 3;
}

  /* DESKTOP */
  .collection-topbar {
    width: 100%;
    min-height: 74px;
    height: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2%;
    position: relative;
    padding: 10px 0;
  }

  .filter-btn,
  .sort-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: none;
    border: 1px solid var(--primary-web-color);
    cursor: pointer;
    color: var(--primary-web-color);
    padding: 1em 2em;
    border-radius: 6px;
    font-weight: 700;
    font-size: 14px;
    font-family: var(--font-family-normal);
    position: relative;
    flex-shrink: 0;
  }

  .collection-heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    gap: 6px;
  }

  .collection-title {
    font-family: var(--font-heading-family);
    font-size: 48px;
    color: #231F20;
    margin: 0;
    text-align: center;
    line-height: 1.1;
  }

  .collection-count {
    font-size: 24px;
    font-family: "Mrs Eaves";
    color: #231F20;
    margin: 0;
    line-height: 1;
  }

  .collection-top-description {
    font-family: var(--font-family-normal, 'Archivo', sans-serif);
    font-size: 15px;
    line-height: 1.6;
    color: #4a4a4a;
    text-align: center;
    margin-top: 6px;
    max-width: 750px;
  }

  .collection-top-description p {
    margin: 0 0 8px 0;
  }

  .collection-top-description p:last-child {
    margin-bottom: 0;
  }

  .collection-top-description a {
    color: var(--primary-web-color, #048E79);
    text-decoration: underline;
  }

  /* MOBILE HIDE */
  .collection-topbar-mobile {
    display: none;
  }


  /* =========================
      MOBILE VIEW
  ========================== */

  @media (max-width: 768px) {

    /* Desktop hide */
    .desktop-topbar {
      display: none;
    }

    /* Mobile show */
    .collection-topbar-mobile {
      display: flex;
      flex-direction: column;
      gap: 18px;
      width: 100%;
    }

    /* title + count row */
    .mobile-heading-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      flex-wrap: wrap;
      text-align: center;
    }

    .mobile-heading-row .collection-title {
      font-size: 23px;
    }

    .mobile-heading-row .collection-count {
      font-size: 14px;
    }

    .mobile-heading-row .collection-top-description {
      flex-basis: 100%;
      width: 100%;
      font-size: 13px;
      line-height: 1.5;
      color: #4a4a4a;
      padding: 0 10px;
      margin-top: 6px;
      text-align: center;
    }

    .mobile-heading-row .collection-top-description p {
      margin: 0 0 6px 0;
    }

    .mobile-heading-row .collection-top-description p:last-child {
      margin-bottom: 0;
    }

    .mobile-heading-row .collection-top-description a {
      color: var(--primary-web-color, #048E79);
      text-decoration: underline;
    }

    /* button row */
    .mobile-btn-row {
      display: flex;
      align-items: center;
      gap: 0px !important;
      width: 100%;
      background: #fff5d4;
    }
    .mobile-btn-row .filter-btn,
    .mobile-btn-row .sort-btn {
        flex: 1;
        padding: 12px 16px;
        font-size: 14px;
        border: none;
        color: #5C5C5C;
    }
    .mobile-btn-row .filter-btn{
        border: 1px solid #0000001A;
        border-radius: 0;
    }
    .mobile-btn-row .sort-btn{
        border: 1px solid #0000001A;
        border-radius: 0;
        border-left: none;
    }
    .filter-count-badge {
      top: 9px;
      right: 51%;
      font-size: 8px;
      font-weight: 700;
      min-width: 12px;
      height: 12px;
      border-radius: 50%;
     }
  }
</style>
