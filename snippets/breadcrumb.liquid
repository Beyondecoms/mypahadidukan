{% assign arrow_svg = '<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7.38939 4.72205C7.29566 4.81581 7.243 4.94297 7.243 5.07555C7.243 5.20813 7.29566 5.33529 7.38939 5.42905L11.6101 9.64975C11.7038 9.74351 11.7565 9.87067 11.7565 10.0032C11.7565 10.263 11.7038 10.263 11.6101 10.3567L7.38939 14.5774C7.29831 14.6718 7.24792 14.7981 7.24906 14.9291C7.2502 15.0602 7.30278 15.1857 7.39548 15.2784C7.48819 15.3711 7.61359 15.4236 7.74469 15.4248C7.87579 15.4259 8.00209 15.3755 8.09639 15.2844L12.3171 11.0632C12.5981 10.7818 12.7559 10.4004 12.7559 10.0027C12.7559 9.60508 12.5981 9.22367 12.3171 8.94225L8.09639 4.72155C8.00256 4.62788 7.87537 4.57531 7.74279 4.57541C7.61021 4.5755 7.48309 4.62825 7.38939 4.72205Z" fill="black" fill-opacity="0.6"/></svg>' %}
<style>
    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: #6b7280;
        padding: 12px 0;
    }

    .breadcrumb a {
        color: #1E1E1E;
        text-decoration: none;
        font-size: 12px;
        font-family: var(--font-family-normal);
        font-weight: 400;
    }

    .breadcrumb a:hover {
        color: #111;
        text-decoration: underline;
    }

    .breadcrumb-sep {
        color: #9ca3af;
        font-size: 14px;
        margin-top:8px;
    }

    .breadcrumb-current {
        color: #1E1E1E;
        text-decoration: none;
        font-size: 12px;
        font-family: var(--font-family-normal);
        font-weight: 600;
    }

</style>
<nav class="breadcrumb" aria-label="breadcrumb">
  {% if template == 'product' %}
    <a href="/">Home</a>
    <span class="breadcrumb-sep">{{ arrow_svg }}</span>
    <span class="breadcrumb-current">{{ product.title | truncatewords: 4 }}</span>

  {% elsif template == 'collection' %}
    <a href="/">Home</a>
    <span class="breadcrumb-sep">{{ arrow_svg }}</span>
    <span class="breadcrumb-current">{{ collection.title }}</span>

  {% elsif template == 'page' %}
    <a href="/">Home</a>
    <span class="breadcrumb-sep">{{ arrow_svg }}</span>
    <span class="breadcrumb-current">{{ page.title }}</span>

  {% elsif template == 'blog' %}
    <a href="/">Home</a>
    <span class="breadcrumb-sep">{{ arrow_svg }}</span>
    <span class="breadcrumb-current">{{ blog.title }}</span>

  {% elsif template == 'article' %}
    <a href="/">Home</a>
    <span class="breadcrumb-sep">{{ arrow_svg }}</span>
    <a href="{{ blog.url }}">{{ blog.title }}</a>
    <span class="breadcrumb-sep">{{ arrow_svg }}</span>
    <span class="breadcrumb-current">{{ article.title | truncatewords: 4 }}</span>

  {% else %}
    <a href="/">Home</a>
  {% endif %}
</nav>