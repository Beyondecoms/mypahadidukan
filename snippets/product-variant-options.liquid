{% comment %}
  Renders product variant options

  Accepts:
  - product: {Object} product object.
  - option: {Object} current product_option object.
  - picker_type: {String} type of picker to dispay


  Usage:
  {% render 'product-variant-options',
    product: product,
    option: option,
    picker_type: picker_type
  %}
{% endcomment %}
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign image_size = 100
-%}

{%- for value in option.values -%}
  {%- liquid
    assign option_disabled = true
    if value.available
      assign option_disabled = false
    endif

    assign value_downcase = value | downcase | strip
    assign product_colors = settings.product_colors | split: ','
    assign selected_color = value_downcase | split: ' ' | last | handle
    assign selected_image = ''

    for product_color in product_colors
      assign parts = product_color | strip | split: ':'
      assign name = parts.first | downcase | strip
      assign color = parts.last | strip
      if name == value_downcase
        assign selected_color = color
      endif
    endfor

    for i in (1..100)
      assign key = 'filter_color' | append: i
      assign key_second = 'filter_color' | append: i | append: '.png'
      assign setting_value = settings[key] | downcase | strip

      if texture_style != '' and setting_value == value_downcase
        assign selected_image = key_second | asset_url
      endif
    endfor
  -%}

  {%- capture input_id -%}
    {{ section.id }}-{{ option.position }}-{{ forloop.index0 -}}
  {%- endcapture -%}

  {%- capture input_name -%}
    {{ option.name }}-{{ option.position }}
  {%- endcapture -%}

  {%- capture label_unavailable -%}
    <span class="m:visually-hidden label-unavailable">
      {%- render 'new-locale', key: 'products.product.variant_sold_out_or_unavailable' -%}
    </span>
  {%- endcapture -%}

  {%- capture input_dataset -%}
    data-product-url="{{ value.product_url }}"
    data-option-value-id="{{ value.id }}"
  {%- endcapture -%}

  {%- case picker_type -%}
    {%- when 'swatch_color' -%}
      <div
        class="m-product-option--node m-tooltip m-tooltip--top{% if option_disabled %} m-product-option--node__unavailable{% endif %}"
        data-option-type="{{ picker_type }}"
        data-option-position="{{ option.position }}"
        data-value="{{- value | escape -}}"
      >
        {%- capture help_text -%}
          <span class="m:visually-hidden">{{ value | escape }}</span>
          {{ label_unavailable }}
        {%- endcapture -%}
        {% render 'swatch-input',
          id: input_id,
          name: input_name,
          value: value,
          swatch: value.swatch,
          product_form_id: product_form_id,
          checked: value.selected,
          visually_disabled: option_disabled,
          help_text: help_text,
          additional_props: input_dataset,
          image_size: image_size
        %}
      </div>
    {%- when 'button' -%}
      {%- liquid
        assign resolved_variant = null
        for var in product.variants
          assign matches = true
          for opt in product.options_with_values
            assign opt_idx = forloop.index0
            if opt.name == option.name
              if var.options[opt_idx] != value
                assign matches = false
                break
              endif
            else
              if var.options[opt_idx] != opt.selected_value
                assign matches = false
                break
              endif
            endif
          endfor
          if matches
            assign resolved_variant = var
            break
          endif
        endfor

        if resolved_variant == null
          assign opt_idx = option.position | minus: 1
          for var in product.variants
            if var.options[opt_idx] == value
              assign resolved_variant = var
              break
            endif
          endfor
        endif

        if resolved_variant == null
          assign resolved_variant = value.variant
        endif

        if card_show_image == null
          assign card_show_image = true
        endif
        if card_show_discount == null
          assign card_show_discount = true
        endif
        if card_show_compare_price == null
          assign card_show_compare_price = true
        endif
        if card_show_checkmark == null
          assign card_show_checkmark = true
        endif
        if card_image_size == null
          assign card_image_size = 80
        endif

        assign variant_image = resolved_variant.image | default: resolved_variant.featured_media | default: resolved_variant.featured_image | default: product.featured_media | default: product.featured_image
        assign has_discount = false
        if resolved_variant.compare_at_price > resolved_variant.price
          assign has_discount = true
          assign discount_amount = resolved_variant.compare_at_price | minus: resolved_variant.price
          assign discount_percent = discount_amount | times: 100 | divided_by: resolved_variant.compare_at_price | round
        endif
      -%}
      <div
        class="m-product-option--node{% if option_disabled %} m-product-option--node__unavailable{% endif %}{% if value.selected %} m-product-option--node__selected{% endif %}"
        data-option-type="{{ picker_type }}"
        data-option-position="{{ option.position }}"
        data-value="{{- value | escape -}}"
      >
        <input
          data-option-type="{{ picker_type }}"
          type="radio"
          id="{{ input_id }}"
          name="{{ input_name }}"
          value="{{ value }}"
          form="{{ product_form_id }}"
          class="m-product-option__input{% if option_disabled %} disabled{% endif %}"
          {% if value.selected %}
            checked
          {% endif %}
          {% if disabled %}
            disabled
          {% endif %}
          {{ input_dataset }}
        >
        <label for="{{ input_id }}" class="rich-variant-card{% if product.vendor != 'My Pahadi Dukan' %} rich-variant-card--simple{% endif %}" data-option-type="{{ picker_type }}">
          {%- if card_show_checkmark and value.selected -%}
            <span class="rich-variant-card__checkmark">
              <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22">
                <circle cx="12" cy="12" r="10" fill="var(--card-selected-border-color, #F58220)" />
                <path d="M8.5 12.5l2 2 5-5" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </span>
          {%- endif -%}

          {%- if product.vendor == 'My Pahadi Dukan' -%}
            {%- if card_show_image and variant_image != blank -%}
              <div class="rich-variant-card__image-wrapper">
                <img
                  src="{{ variant_image | image_url: width: card_image_size }}"
                  alt="{{ value | escape }}"
                  loading="lazy"
                  width="{{ card_image_size }}"
                  height="{{ card_image_size }}"
                  class="rich-variant-card__image"
                >
              </div>
            {%- endif -%}
          {%- endif -%}

          <div class="rich-variant-card__content">
            <span class="rich-variant-card__title">{{ value }}</span>
            
            {%- if product.vendor == 'My Pahadi Dukan' -%}
              {%- if card_show_discount and has_discount -%}
                <span class="rich-variant-card__discount">Save {{ discount_percent }}%</span>
              {%- endif -%}
            {%- endif -%}

            <div class="rich-variant-card__pricing">
              <span class="rich-variant-card__price">
                {{ resolved_variant.price | money | replace: '.00', '' }}
              </span>
              {%- if product.vendor == 'My Pahadi Dukan' -%}
                {%- if card_show_compare_price and has_discount -%}
                  <span class="rich-variant-card__compare-price">
                    {{ resolved_variant.compare_at_price | money | replace: '.00', '' }}
                  </span>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        </label>
      </div>
  
    {%- when 'color' -%}
      {% liquid
        assign style = 'background-color: ' | append: selected_color | append: ';'
      %}
      <div
        class="m-product-option--node m-tooltip m-tooltip--top{% if option_disabled %} m-product-option--node__unavailable{% endif %}"
        data-option-type="{{ picker_type }}"
        data-option-position="{{ option.position }}"
        data-value="{{- value | escape -}}"
      >
        <div class="m-product-option--swatch">
          <input
            type="radio"
            id="{{ input_id }}"
            name="{{ input_name }}"
            value="{{ value }}"
            form="{{ product_form_id }}"
            class="m-product-option__input{% if option_disabled %} disabled{% endif %}"
            {% if value.selected %}
              checked
            {% endif %}
            {% if disabled %}
              disabled
            {% endif %}
            {{ input_dataset }}
          >
          <label
            for="{{ input_id }}"
            class="m-product-option--node__label"
            data-option-type="{{ picker_type }}"
            {% if style %}
              style="{{ style }}"
            {% endif %}
          >
            {{- value -}}
          </label>
        </div>
        <span class="m-tooltip__content">{{- value -}}</span>
      </div>
    {%- when 'image' -%}
      {% liquid
        assign label_class = 'm-product-option--node__label'
        assign style = ''
        if value.variant.image != blank
          assign image_url = value.variant.image | image_url: width: image_size
          assign style = style | append: 'background-image: url(' | append: image_url | append: ');'
        elsif selected_image != blank
          assign style = style | append: 'background-image: url(' | append: selected_image | append: ');'
        else
          if value.swatch.color
            assign style = style | append: 'background-color: ' | append: value.swatch.color | append: ';'
          else
            assign style = style | append: 'background-color: ' | append: selected_color | append: ';'
          endif
        endif

        if style
          assign label_class = label_class | append: ' has-bg-img'
        endif
      %}
      <div
        class="m-product-option--node m-tooltip m-tooltip--top{% if option_disabled %} m-product-option--node__unavailable{% endif %}"
        data-option-type="{{ picker_type }}"
        data-option-position="{{ option.position }}"
        data-value="{{- value | escape -}}"
      >
        <input
          type="radio"
          id="{{ input_id }}"
          name="{{ input_name }}"
          value="{{ value }}"
          form="{{ product_form_id }}"
          class="m-product-option__input{% if option_disabled %} disabled{% endif %}"
          {% if value.selected %}
            checked
          {% endif %}
          {% if disabled %}
            disabled
          {% endif %}
          {{ input_dataset }}
        >
        <label
          for="{{ input_id }}"
          class="{{ label_class }}"
          data-option-type="image"
          {% if style %}
            style="{{ style }}"
          {% endif %}
        >
          {{- value -}}
        </label>
        <span class="m-tooltip__content">{{- value -}}</span>
      </div>
    {%- when 'default' -%}
      {% comment %}Custom Image{% endcomment %}
      {% liquid
        assign label_class = 'm-product-option--node__label'
        assign style = ''
        if selected_image != blank
          assign label_class = label_class | append: ' has-bg-img'
          assign style = style | append: 'background-image: url(' | append: selected_image | append: ');'
        else
          assign style = style | append: 'background-color: ' | append: selected_color | append: ';'
        endif
      %}
      <div
        class="m-product-option--node m-tooltip m-tooltip--top{% if option_disabled %} m-product-option--node__unavailable{% endif %}"
        data-option-type="color"
        data-option-position="{{ option.position }}"
        data-value="{{- value | escape -}}"
      >
        <div class="m-product-option--swatch">
          <input
            type="radio"
            id="{{ input_id }}"
            name="{{ input_name }}"
            value="{{ value }}"
            form="{{ product_form_id }}"
            class="m-product-option__input{% if option_disabled %} disabled{% endif %}"
            {% if value.selected %}
              checked
            {% endif %}
            {% if disabled %}
              disabled
            {% endif %}
            {{ input_dataset }}
          >
          <label
            for="{{ input_id }}"
            class="{{ label_class }}"
            data-option-type="color"
            {% if style %}
              style="{{ style }}"
            {% endif %}
          >
            {{- value -}}
          </label>
        </div>
        <span class="m-tooltip__content">{{- value -}}</span>
      </div>
    {%- else -%}
      {% liquid
        assign swatch_value = null
        assign swatch_focal_point = null

        if value.swatch == blank
          assign value_downcase = value | downcase | strip
          assign product_colors = settings.product_colors | split: ','
          assign swatch_value = value | split: ' ' | last | handle

          for product_color in product_colors
            assign parts = product_color | strip | split: ':'
            assign name = parts.first | downcase | strip
            assign color = parts.last | strip
            if name == value_downcase
              assign swatch_value = color
            endif
          endfor
        else
          if value.swatch.image
            assign image_url = value.swatch.image | image_url: width: 52
            assign swatch_value = 'url(' | append: image_url | append: ')'
            assign swatch_focal_point = value.swatch.image.presentation.focal_point
          elsif value.swatch.color
            assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
          endif
        endif
      %}
      <option
        id="{{ input_id }}"
        class="m-product-option--node"
        value="{{ value | escape }}"
        {% if value.selected %}
          selected="selected"
        {% endif %}
        {% if swatch_value and picker_type == 'swatch_dropdown' %}
          data-option-swatch-value="{{ swatch_value }}"
          {% if swatch_focal_point %}
            data-option-swatch-focal-point="{{ swatch_focal_point }}"
          {% endif %}
        {% endif %}
        {{ input_dataset }}
      >
        {{- value -}}
      </option>
  {%- endcase -%}
{%- endfor -%}

        <style>
          .m-product-option--content {
            display: grid !important;
            grid-template-columns: repeat(var(--card-desktop-cards-per-row, 3), minmax(220px, 1fr)) !important;
            gap: var(--card-spacing, 20px) !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
          }

          .m-product-option--node {
            width: 100% !important;
            max-width: none !important;
            min-width: 0 !important;
            height: auto !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            background: none !important;
          }

          /* Hide native radio button inputs */
          .m-product-option__input[data-option-type="button"] {
            position: absolute !important;
            overflow: hidden !important;
            clip: rect(0 0 0 0) !important;
            height: 1px !important;
            width: 1px !important;
            margin: -1px !important;
            padding: 0 !important;
            border: 0 !important;
          }

          .rich-variant-card {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: flex-start !important;
            border: var(--card-border-thickness, 1px) solid #e5e5e5 !important;
            border-radius: var(--card-border-radius, 16px) !important;
            padding: 20px !important;
            background-color: #fff !important;
            cursor: pointer !important;
            position: relative !important;
            transition: all 0.2s ease-in-out !important;
            min-height: 194px !important;
            height: auto !important;
            width: 100% !important;
            box-sizing: border-box !important;
          }

          /* Simple Design for other vendors */
          .rich-variant-card--simple {
            min-height: 94px !important;
            padding: 16px 20px !important;
            align-items: flex-start !important;
          }
          .rich-variant-card--simple .rich-variant-card__content {
            align-items: flex-start !important;
            text-align: left !important;
          }
          .rich-variant-card--simple .rich-variant-card__title {
            width: 100% !important;
            border-bottom: 1px dotted #ccc !important;
            padding-bottom: 6px !important;
            margin-bottom: 6px !important;
            text-align: left !important;
          }
          .rich-variant-card--simple .rich-variant-card__pricing {
            justify-content: flex-start !important;
            margin-top: 0 !important;
            width: 100% !important;
          }

          /* Selected state border */
          .m-product-option--node__selected .rich-variant-card,
          .m-product-option__input:checked + .rich-variant-card {
            border-color: var(--card-selected-border-color, #F58220) !important;
            background-color: rgba(245, 130, 32, 0.03) !important; /* Subtle orange/primary highlight */
            box-shadow: 0 4px 12px rgba(245, 130, 32, 0.08) !important;
          }

          /* Checkmark styling */
          .rich-variant-card__checkmark {
            position: absolute !important;
            top: 2px !important;
            right: 2px !important;
            width: 22px !important;
            height: 22px !important;
            z-index: 2 !important;
          }

          /* Image wrapper */
          .rich-variant-card__image-wrapper {
            width: var(--card-image-size, 90px) !important;
            height: var(--card-image-size, 90px) !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            margin-bottom: 16px !important;
          }

          .rich-variant-card__image {
            width: 100% !important;
            height: 100% !important;
            object-fit: contain !important;
          }

          .rich-variant-card__content {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            text-align: center !important;
            width: 100% !important;
          }

          .rich-variant-card__title {
            font-size: 12px !important;
            font-weight: 600 !important;
            color: #333 !important;
            margin-bottom: 8px !important;
            line-height: 1.4 !important;
          }

          .rich-variant-card__discount {
            font-size: 12px !important;
            font-weight: 600 !important;
            color: var(--card-selected-border-color, #F58220) !important;
            margin-bottom: 10px !important;
          }

          .rich-variant-card__pricing {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 8px !important;
            margin-top: auto !important; /* Push pricing to the bottom */
          }

          .rich-variant-card__price {
            font-size: 14px !important;
            font-weight: 700 !important;
            color: #111 !important;
          }

          .rich-variant-card__compare-price {
            font-size: 14px !important;
            text-decoration: line-through !important;
            color: #999 !important;
          }

          /* Mobile responsive rules */
          @media screen and (max-width: 767px) {
            .m-product-option--content {
              display: flex !important;
              flex-wrap: nowrap !important;
              overflow-x: auto !important;
              scroll-snap-type: x mandatory !important;
              gap: 12px !important;
              padding: 8px 4px !important;
              margin: 0 !important;
              width: auto !important;
              -webkit-overflow-scrolling: touch !important;
            }
            
            .m-product-option--content::-webkit-scrollbar {
              display: none !important; /* Hide scrollbar for clean look */
            }

            .m-product-option--node {
              flex: 0 0 125px !important;
              scroll-snap-align: start !important;
              height: auto !important;
            }

            .rich-variant-card {
              padding: 12px !important;
              border-radius: 16px !important;
              min-height: 170px !important;
              height: auto !important;
              display: flex !important;
              flex-direction: column !important;
              align-items: center !important;
              justify-content: flex-start !important;
            }

            .rich-variant-card__image-wrapper {
              width: 50px !important;
              height: 50px !important;
              margin-bottom: 8px !important;
            }

            .rich-variant-card__image {
              width: 100% !important;
              height: 100% !important;
              object-fit: contain !important;
            }

            .rich-variant-card__title {
              font-size: 12px !important;
              font-weight: 600 !important;
              line-height: 1.2 !important;
              text-align: center !important;
              margin-bottom: 4px !important;
              display: -webkit-box !important;
              -webkit-line-clamp: 2 !important;
              -webkit-box-orient: vertical !important;
              overflow: hidden !important;
            }

            .rich-variant-card__discount {
              font-size: 10px !important;
              font-weight: 600 !important;
              color: #F58220 !important;
              margin: 4px 0 !important;
            }

            .rich-variant-card__pricing {
              display: flex !important;
              flex-direction: row !important;
              align-items: center !important;
              justify-content: center !important;
              gap: 6px !important;
              margin-top: auto !important;
            }

            .rich-variant-card__price {
              font-size: 14px !important;
              font-weight: 700 !important;
            }

            .rich-variant-card__compare-price {
              font-size: 13px !important;
              color: #999 !important;
              text-decoration: line-through !important;
            }

            /* Mobile styles for Simple design */
            .rich-variant-card--simple {
              min-height: 80px !important;
              padding: 12px !important;
              align-items: flex-start !important;
            }
            .rich-variant-card--simple .rich-variant-card__content {
              align-items: flex-start !important;
              text-align: left !important;
            }
            .rich-variant-card--simple .rich-variant-card__title {
              width: 100% !important;
              border-bottom: 1px dotted #ccc !important;
              padding-bottom: 4px !important;
              margin-bottom: 4px !important;
              text-align: left !important;
              -webkit-line-clamp: unset !important;
              display: block !important;
            }
            .rich-variant-card--simple .rich-variant-card__pricing {
              justify-content: flex-start !important;
              margin-top: 0 !important;
              width: 100% !important;
            }
          }
        </style>
