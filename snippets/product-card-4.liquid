{% comment %}
  Accepts:
  - product: {Object} Product (required)
  - show_variant_options: {Boolean} Show variant swatches at the bottom (optional)
  - hide_title: {String} Hide product title (optional)
  - image_ratio: {String} Product media ratio (optional)
  - show_vendor: {Boolean} Show product vendor (optional)
  - show_cart_button: {Boolean} Show Add to cart button (optional)
  - show_quickview_button: {Boolean} Show Quickview button (optional)
  - show_wishlist_button: {Boolean} Show Wishlist button (optional)
  - column_wrapper: {Boolean} Wrap product card (optional)
  - remove_params: {Boolean} Remove url params (optional)

  Usage:
  {% render 'product-card-4', product: product %}
{% endcomment %}

{% liquid
  if show_variant_options == null
    assign show_variant_options = settings.show_swatch_option
  endif
  if show_inventory == null
    assign show_inventory = settings.pcard_show_inventory
  endif

  assign show_title = true
  if hide_title == true
    assign show_title = false
  endif

  if image_ratio == null or image_ratio == blank or image_ratio == '3/4'
    assign image_ratio = '1/1'
  endif

  if image_ratio == 'original'
    assign image_ratio = product.featured_image.aspect_ratio | default: '1/1'
  endif

  if show_vendor == null
    assign show_vendor = settings.show_vendor
  endif

  if show_desc == null
    assign show_desc = true
  endif

  assign sold_out = false
  if product.available == false
    assign sold_out = true
  endif

  assign discount = ''
  assign compare_at_price = product.compare_at_price
  assign price = product.price
  assign on_sale = false
  if compare_at_price > price
    assign on_sale = true
    assign discount = compare_at_price | minus: price | times: 100 | divided_by: compare_at_price
  endif

  assign show_on_sale_badge = false
  if settings.on_sale_badge != 'hide' and on_sale
    assign show_on_sale_badge = true
  endif

  assign quick_add_text = 'products.product.quick_add' | t
  unless product.has_only_default_variant
    capture quick_add_text
      render 'new-locale', key: 'products.product.select_options'
    endcapture
  endunless

  assign sold_number = product.metafields.foxkit.sold_number
  assign selected_variant = product.selected_or_first_available_variant

  if product.available
    assign variant_id = product.first_available_variant.id
  else
    assign variant_id = product.selected_or_first_available_variant.id
  endif
  assign selected_variant_id = ''
  if section.settings.change_product_variant_on_fitlering
    assign variant_id = product.selected_or_first_available_variant.id
    assign selected_variant_id = product.selected_variant.id
  endif

  if pcard_alignment == null
    assign pcard_alignment = settings.pcard_alignment
  endif

  assign pcard_default_image = settings.pcard_default_image
  if image_ratio == null or image_ratio == blank or image_ratio == '3/4'
    assign image_ratio = '1/1'
  endif

  if show_cart_button == null
    assign show_cart_button = settings.show_cart_button
  endif

  if show_quickview_button == null
    assign show_quickview_button = settings.show_quickview_button
  endif

  if show_wishlist_button == null
    assign show_wishlist_button = settings.show_wishlist_button
  endif

  if show_compare_button == null
    assign show_compare_button = settings.show_compare_button
  endif

  assign current_variant = product.selected_or_first_available_variant
  assign preview_image = current_variant.featured_image | default: current_variant.featured_media.preview_image | default: current_variant.image | default: product.featured_image | default: product.featured_media.preview_image | default: product.media[0].preview_image
  if section.settings.change_product_variant_on_fitlering == true and product.selected_variant.image != null
    assign preview_image = product.selected_variant.image
  endif

  if image_ratio == 'original'
    assign image_ratio = preview_image.aspect_ratio | default: product.media[0].aspect_ratio | default: '1/1'
  endif

  assign second_image = ''
  if settings.show_second_img and product.images.size > 1 and product.images[1] != blank
    assign second_image = product.images[1]
  endif

  assign product_card_classes = 'm-product-card m-product-card--style-4'
  if sold_out
    assign product_card_classes = product_card_classes | append: ' m-product-card--soldout'
  endif
  if on_sale
    assign product_card_classes = product_card_classes | append: ' m-product-card--onsale'
  endif
  if settings.show_second_img and second_image != blank
    assign product_card_classes = product_card_classes | append: ' m-product-card--show-second-img'
  endif

  assign product_url = product.url
  if remove_params
    assign product_url = product.url | split: '?' | first
  endif

  assign first_media_type = product.media.first.media_type

  assign show_video = false
  if settings.pcard_show_video and first_media_type == 'video'
    assign show_video = true
  endif

  assign loading = 'lazy'
  assign fetchpriority = 'low'
  if index == 1 and section_index <= 2
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif
%}
{%- if column_wrapper -%}<div class="m:column">{%- endif -%}
<div
  class="{{ product_card_classes }}{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}"
  data-view="card"
  {% if sold_number != blank %}
    data-sold-number="{{ sold_number }}"
  {% endif %}
  data-product-id="{{ product.id }}"
  {% if animated %}
    data-cascade
    style="--animation-order: {{ index }};"
  {% endif %}
>
  <div class="m-product-card__media">
    <a
      class="m-product-card__link m:block m:w-full"
      href="{{ product_url }}"
      aria-label="{{ product.title | default: 'product title' }}"
    >
      {% if preview_image != blank or first_media_type == 'video' %}
        {% unless show_video %}
          <div class="m-product-card__main-image">
            {%- liquid
              assign asp_rat = '1/1'
              assign alt = alt | default: preview_image.alt | escape
            -%}
            {%- capture sizes -%}(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2){%- endcapture -%}
            <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat }}">
              {{
                preview_image
                | image_url: width: 1100
                | image_tag:
                  loading: loading,
                  fetchpriority: fetchpriority,
                  class: 'm:w-full m:h-full',
                  alt: alt,
                  sizes: sizes,
                  widths: '165, 360, 535, 750, 940, 1100'
              }}
            </responsive-image>
          </div>

          {%- if second_image != blank -%}
            <div class="m-product-card__hover-image">
              {%- liquid
                assign asp_rat = '1/1'
                assign alt = alt | default: second_image.alt | escape
              -%}
              {%- capture sizes -%}(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2){%- endcapture -%}
              <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat }}">
                {{
                  second_image
                  | image_url: width: 1100
                  | image_tag:
                    loading: loading,
                    fetchpriority: fetchpriority,
                    class: 'm:w-full m:h-full',
                    alt: alt,
                    sizes: sizes,
                    widths: '165, 360, 535, 750, 940, 1100'
                }}
              </responsive-image>
            </div>
          {%- endif -%}
        {% else %}
          <m-video-component
            class="m:block m-product-card__video"
            data-type="mp4"
            style="--aspect-ratio: {{ image_ratio }}"
          >
            {{
              product.media.first
              | media_tag:
                image_size: '1500px',
                autoplay: true,
                loop: true,
                controls: false,
                muted: true,
                playsinline: true
            }}
          </m-video-component>
        {% endunless %}
      {% else %}
        {% if pcard_default_image != blank %}
          {%- liquid
            assign asp_rat = '1/1'
            assign alt = alt | default: pcard_default_image.alt | escape
          -%}
          {%- capture sizes -%}(min-width: {{ settings.container_width }}px) {{ settings.container_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2){%- endcapture -%}
          <responsive-image class="m-image" style="--aspect-ratio: {{ asp_rat }}">
            {{
              pcard_default_image
              | image_url: width: 1100
              | image_tag:
                loading: loading,
                fetchpriority: fetchpriority,
                class: 'm:w-full m:h-full',
                alt: alt,
                sizes: sizes,
                widths: '165, 360, 535, 750, 940, 1100'
            }}
          </responsive-image>
        {% else %}
          <div style="--aspect-ratio: {{ image_ratio }}">
            {{ 'product-1' | placeholder_svg_tag: 'm-placeholder-svg' }}
          </div>
        {% endif %}
      {% endif %}
    </a>

    <!-- Top-left Discount Badge -->
    {% if on_sale %}
      <span class="m-product-card__discount-badge">
        SAVE {{ discount }}%
      </span>
    {% endif %}

    <!-- Top-right Wishlist Icon -->
    {%- if show_wishlist_button -%}
      <div class="m-product-card__wishlist-btn">
        {% assign wishlist_app = settings.wishlist_app %}
        {% if wishlist_app == 'growave' %}
          <div class="m-tooltip m-wishlist-button m-button--icon m-tooltip--style-1 m-tooltip--left">
            <span class="m-tooltip-icon m:block">
              {% capture the_snippet_fave_icon %}{% render 'ssw-widget-faveicon' with product.id %}{% endcapture %}
              {% unless the_snippet_fave_icon contains 'Liquid error' %}
                {{ the_snippet_fave_icon }}
              {% else %}
                {% render 'mm-ssw-widget-faveicon' with product.id %}
              {% endunless %}
            </span>
          </div>
        {% else %}
          {% render 'tooltip', type: 'wishlist', product: product, class_name: 'm-tooltip--left' %}
        {% endif %}
      </div>
    {%- endif -%}

    <!-- Quick view icon (bottom right of image) -->
    {%- if show_quickview_button -%}
      <div class="m-product-card__quickview-btn">
        {% render 'tooltip', type: 'quickview', section: section, product: product, class_name: 'm-tooltip--top' %}
      </div>
    {%- endif -%}
  </div>

  <div class="m-product-card__content m:text-{{ pcard_alignment }}">
    <!-- 6. REVIEWS -->
    {% if settings.show_review_badge %}
      <div class="m-product-card__reviews m:text-color-body">
        {% render 'product-reviews-app__badge', product: product %}
      </div>
    {% endif %}

    <!-- 7. VENDOR -->
    {%- if product.vendor != blank -%}
      <span class="m-product-card__vendor">{{ product.vendor }}</span>
    {%- endif -%}

    <!-- 8. PRODUCT TITLE -->
    {% if show_title == true %}
      <h3 class="m-product-card__title">
        <a href="{{ product_url }}" class="m-product-card__name{% if settings.uppercase_prd_name %} m:uppercase{% endif %}">
          {{ product.title }}
        </a>
      </h3>
    {% endif %}

    <!-- 9. PRODUCT DESCRIPTION -->
    {%- if show_desc -%}
      {%- assign short_desc = product.metafields.custom.one_liner | default: product.description | strip_html | truncatewords: 10, '...' -%}
      {%- if short_desc != blank -%}
        <div class="m-product-card__description">
          {{ short_desc }}
        </div>
      {%- endif -%}
    {%- endif -%}

    <!-- 10. SIZE / QUANTITY -->
    {% liquid
      assign variant_size = ''
      for option in product.options_with_values
        assign downcased_name = option.name | downcase
        if downcased_name contains 'size' or downcased_name contains 'weight' or downcased_name contains 'quantity' or downcased_name contains 'volume' or downcased_name contains 'pack'
          assign variant_size = product.selected_or_first_available_variant.options[forloop.index0]
          break
        endif
      endfor
    %}
    {% if variant_size != blank %}
      <div class="m-product-card__size">
        {{ variant_size }}
      </div>
    {% endif %}

    <!-- 11. PRICE and 12. COUPON / OFFER ROW -->
    <div class="m-product-card__price-row">
      <div class="m-product-card__price">
        {% render 'product-prices', product: product, is_product_card: true %}
      </div>

      {% if product.available and product.metafields.custom.offer_on_the_card != blank %}
        {% unless product.id == 8304817176882 %}
          {% assign offer_text = product.metafields.custom.offer_on_the_card | strip %}
          {% assign offer_parts = offer_text | split: ' ' %}
          {% assign offer_code = offer_parts.first | upcase %}
          {% assign offer_msg = offer_text | remove_first: offer_code | strip | downcase | capitalize %}
          
          {% assign is_pahari_haat = false %}
          {% if product.title contains 'Pahari Haat' %}
            {% assign is_pahari_haat = true %}
          {% endif %}

          {% if is_pahari_haat %}
            <div class="meta-offer-list meta-offer-list--haat {% if product.title contains 'Pahari Haat' %}pahari-haat{% endif %}">
              <span class="meta-offer-msg meta-offer-msg--haat">
                {{ offer_text }}
              </span>
            </div>
          {% else %}
            <div class="meta-offer-list">
              <span class="meta-offer-msg">{{ offer_msg }}</span>
              <span class="meta-offer-code">{{ offer_code }}</span>
            </div>
          {% endif %}
        {% endunless %}
      {% endif %}
    </div>

    <!-- Variant Option swatches if configured -->
    {% if product.has_only_default_variant == false and show_variant_options %}
      {% render 'product-card-option',
        product: product,
        show_variant_options: show_variant_options,
        pcard_alignment: pcard_alignment,
        context: context
      %}
    {% endif %}

    <!-- 13. ADD TO CART BUTTON -->
    {%- if show_cart_button -%}
      <div class="m-product-card__atc-wrapper">
        {% render 'product-card-quick-add-btn', product: product, quick_add_text: quick_add_text, section: section %}
      </div>
    {%- endif -%}
  </div>

  <input hidden name="id" required value="{{ variant_id }}" data-selected-variant="{{ selected_variant_id }}">

  <style>
    .m-product-card--style-4 {
      display: flex !important;
      flex-direction: column !important;
      justify-content: space-between !important;
      height: 100% !important;
      background: #ffffff !important;
      border: 1px solid #d1d1d1 !important;
      border-radius: 20px !important;
      padding: 0 !important;
      overflow: hidden !important;
      box-shadow: 0 0 1px 1px #f3f3f3 !important;
      box-sizing: border-box !important;
      transition: all 0.25s ease !important;
    }
    .m-product-card--style-4:hover {
      transform: translateY(-4px) !important;
      box-shadow: 0 8px 20px rgba(0,0,0,0.06) !important;
    }

    .m-product-card--style-4 .m-product-card__media {
      position: relative !important;
      overflow: hidden !important;
      border-radius: 0 !important;
      background-color: #ffffff !important;
      margin-bottom: 12px !important;
      aspect-ratio: 1/1 !important;
      width: 100% !important;
    }
    .m-product-card--style-4 .m-product-card__link,
    .m-product-card--style-4 .m-product-card__main-image,
    .m-product-card--style-4 .m-image {
      width: 100% !important;
      height: 100% !important;
      display: block !important;
      aspect-ratio: 1/1 !important;
      position: relative !important;
    }
    .m-product-card--style-4 responsive-image.m-image:before,
    .m-product-card--style-4 [style*='--aspect-ratio']:before {
      padding-top: 100% !important;
    }
    .m-product-card--style-4 .m-product-card__media img {
      object-fit: contain !important;
      object-position: center !important;
      width: 100% !important;
      height: 100% !important;
      top: 0 !important;
      left: 0 !important;
      position: absolute !important;
      padding: 0px !important;
      box-sizing: border-box !important;
    }

    .m-product-card--style-4 .m-product-card__content {
      display: flex !important;
      flex-direction: column !important;
      flex: 1 !important;
      justify-content: flex-start !important;
      gap: 6px !important;
      min-height: auto !important;
      padding: 0 15px 15px 15px !important;
    }

    .m-product-card--style-4 .m-product-card__discount-badge {
      position: absolute !important;
      top: 10px !important;
      left: 10px !important;
      background: #e8513f !important;
      color: #ffffff !important;
      font-size: 11px !important;
      font-weight: 700 !important;
      padding: 4px 10px !important;
      border-radius: 99px !important;
      text-transform: uppercase !important;
      z-index: 10 !important;
      line-height: normal !important;
    }

    .m-product-card--style-4 .m-product-card__wishlist-btn {
      position: absolute !important;
      top: 12px !important;
      right: 12px !important;
      z-index: 10 !important;
    }

    .m-product-card--style-4 .m-product-card__quickview-btn {
      position: absolute !important;
      bottom: 12px !important;
      right: 12px !important;
      z-index: 10 !important;
    }

    /* Transparent Overlay Icons (No backgrounds or circular borders) */
    .m-product-card--style-4 .m-product-card__wishlist-btn .m-tooltip,
    .m-product-card--style-4 .m-product-card__quickview-btn .m-tooltip {
      background: transparent !important;
      border: none !important;
      box-shadow: none !important;
      width: auto !important;
      height: auto !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .m-product-card--style-4 .m-product-card__wishlist-btn .m-tooltip-icon,
    .m-product-card--style-4 .m-product-card__quickview-btn .m-tooltip-icon {
      color: #c0503b !important;
      display: block !important;
    }

    .m-product-card--style-4 .m-product-card__wishlist-btn .m-wishlist-button.added-to-wishlist .m-tooltip-icon,
    .m-product-card--style-4 .m-product-card__wishlist-btn .m-wishlist-button.active .m-tooltip-icon,
    .m-product-card--style-4 .m-product-card__wishlist-btn .m-wishlist-button.is-active .m-tooltip-icon {
      display: none !important;
    }

    .m-product-card--style-4 .m-product-card__wishlist-btn .m-wishlist-button.added-to-wishlist .m-tooltip-icon--active,
    .m-product-card--style-4 .m-product-card__wishlist-btn .m-wishlist-button.active .m-tooltip-icon--active,
    .m-product-card--style-4 .m-product-card__wishlist-btn .m-wishlist-button.is-active .m-tooltip-icon--active {
      display: block !important;
    }

    .m-product-card--style-4 .m-product-card__wishlist-btn svg,
    .m-product-card--style-4 .m-product-card__quickview-btn svg {
      width: 24px !important;
      height: 24px !important;
      stroke: #c0503b !important;
      fill: none !important;
    }

    .m-product-card--style-4 .m-product-card__wishlist-btn .m-wishlist-button.added-to-wishlist svg {
      fill: #c0503b !important;
    }

    .m-product-card--style-4 .m-product-card__reviews {
      font-size: 13px !important;
      font-weight: 600 !important;
      color: #666 !important;
      margin: 0 !important;
      height: auto !important;
      display: flex !important;
      align-items: center !important;
      gap: 4px !important;
    }

    .m-product-card--style-4 .m-product-card__vendor {
      font-size: 13px !important;
      color: #ba5d37 !important;
      font-weight: 600 !important;
      margin: 0 !important;
      line-height: 1.2 !important;
      text-transform: capitalize !important;
    }

    .m-product-card--style-4 .m-product-card__title {
      margin: 0 !important;
    }

    .m-product-card--style-4 .m-product-card__name {
      font-size: 15px !important;
      font-weight: 700 !important;
      color: #222 !important;
      line-height: 1.3 !important;
      display: -webkit-box !important;
      -webkit-line-clamp: 4 !important;
      -webkit-box-orient: vertical !important;
      overflow: hidden !important;
      height: 4em !important;
      text-decoration: none !important;
    }

    .m-product-card--style-4 .m-product-card__description {
      font-size: 13px !important;
      color: #666666 !important;
      line-height: 1.4 !important;
      display: -webkit-box !important;
      -webkit-line-clamp: 2 !important;
      -webkit-box-orient: vertical !important;
      overflow: hidden !important;
      margin: 0 !important;
      height: 2.8em !important;
    }

    .m-product-card--style-4 .m-product-card__size {
      font-size: 13px !important;
      color: #888888 !important;
      font-weight: 500 !important;
      margin: 0 !important;
      line-height: 1.2 !important;
    }

    .m-product-card--style-4 .m-product-card__price-row {
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
      width: 100% !important;
      margin-top: auto !important;
      margin-bottom: 8px !important;
      gap: 8px !important;
    }

    .m-product-card--style-4 .m-product-card__price {
      display: flex !important;
      align-items: center !important;
      gap: 6px !important;
    }

    /* Selling price — regular product (no sale) */
    .m-product-card--style-4 .m-product-card__price span.m-price-item.m-price-item--regular {
      color: #00584b !important;
      font-size: 16px !important;
      font-weight: 800 !important;
    }

    /* Selling price — on-sale product (actual current price) */
    .m-product-card--style-4 .m-product-card__price .m-price__sale span.m-price-item.m-price-item--sale {
      color: #00584b !important;
      font-size: 16px !important;
      font-weight: 800 !important;
    }

    /* Compare-at / struck-through original price (inside .m-price__sale) */
    .m-product-card--style-4 .m-product-card__price .m-price__sale s.m-price-item.m-price-item--regular {
      color: #999999 !important;
      font-size: 13px !important;
      font-weight: 500 !important;
      text-decoration: line-through !important;
    }

    .m-product-card--style-4 .meta-offer-list {
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-end !important;
      justify-content: center !important;
      background: linear-gradient(to right, rgba(253, 232, 229, 0), rgba(253, 232, 229, 1)) !important;
      border: none !important;
      border-radius: 0 !important;
      padding: 4px 8px 4px 16px !important;
      box-sizing: border-box !important;
      line-height: 1.2 !important;
      gap: 2px !important;
      max-width: 50% !important;
      width: auto !important;
      overflow: visible !important;
    }

    .m-product-card--style-4 .meta-offer-list span {
      background: transparent !important;
      border: none !important;
      padding: 0 !important;
      margin: 0 !important;
      display: block !important;
      white-space: nowrap !important;
      justify-content: flex-end !important;
      width: auto !important;
      height: auto !important;
      box-shadow: none !important;
      text-transform: none !important;
    }

    .m-product-card--style-4 .meta-offer-msg {
      font-size: 11px !important;
      font-weight: 600 !important;
      color: #111111 !important;
      text-align: right !important;
    }

    .m-product-card--style-4 .meta-offer-code {
      font-size: 11px !important;
      font-weight: 700 !important;
      color: #c0503b !important;
      text-align: right !important;
    }

    .m-product-card--style-4 .m-product-card__atc-wrapper {
      margin-top: auto !important;
      width: 100% !important;
