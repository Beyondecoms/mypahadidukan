{%- comment -%}
  ──────────────────────────────────────────────────────────────────────────────
  PARENT-CHILD BLOG ARTICLE REDIRECT
  ──────────────────────────────────────────────────────────────────────────────
  Single source of truth:
    article.metafields.custom.parent_article.value (One → Blog post reference)

  Behavior:
  - If custom.parent_article is present and target URL != current article URL:
    1. Immediately hides page content via CSS to prevent flashing
    2. Issues meta http-equiv="refresh"
    3. Executes window.location.replace() to redirect to the parent article
  - If custom.parent_article is EMPTY (e.g. Main Article):
    Does nothing. Main article loads normally.
  - Prevents redirect loops:
    Never redirects an article to itself.
  ──────────────────────────────────────────────────────────────────────────────
{%- endcomment -%}

{%- unless request.design_mode -%}
  {%- liquid
    # 1. Primary target: corrected metafield custom.parent_article
    assign parent_article = article.metafields.custom.parent_article.value
    if parent_article == blank
      assign parent_article = article.metafields.custom.parent_article
    endif

    # 2. Safety fallback during transition (in case the temporary custom_parent_article is still present)
    if parent_article == blank
      assign parent_article = article.metafields.custom.custom_parent_article.value
    endif
    if parent_article == blank
      assign parent_article = article.metafields.custom.custom_parent_article
    endif

    assign redirect_target_url = ''

    if parent_article != blank
      if parent_article.url != blank
        assign redirect_target_url = parent_article.url
      else
        assign parent_str = parent_article | append: '' | strip
        if parent_str contains '/'
          assign redirect_target_url = parent_str
        endif
      endif
    endif

    # Avoid redirect loops: Never redirect to the current article itself
    if redirect_target_url != blank
      if redirect_target_url == article.url
        assign redirect_target_url = ''
      endif
    endif
  -%}

  {%- if redirect_target_url != blank -%}
    <style>
      html, body {
        display: none !important;
        visibility: hidden !important;
        opacity: 0 !important;
      }
    </style>
    <meta http-equiv="refresh" content="0; url={{ redirect_target_url }}">
    <link rel="canonical" href="{{ redirect_target_url }}">
    <script>
      (function() {
        var targetUrl = {{ redirect_target_url | json }};
        if (!targetUrl) return;

        var currentPath = window.location.pathname.replace(/\/+$/, '');
        var parser = document.createElement('a');
        parser.href = targetUrl;
        var targetPath = parser.pathname.replace(/\/+$/, '');

        // Never redirect if already on the target path (prevents loop)
        if (currentPath === targetPath) {
          document.documentElement.style.display = '';
          return;
        }

        // Preserve query parameters (UTM tags, ads tracking) and hash
        var search = window.location.search || '';
        var hash = window.location.hash || '';
        var finalUrl = targetUrl;
        if (search) {
          finalUrl += (finalUrl.indexOf('?') === -1 ? '?' : '&') + search.substring(1);
        }
        finalUrl += hash;

        window.location.replace(finalUrl);
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0; url={{ redirect_target_url }}">
      <div style="padding: 40px; text-align: center; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        <p style="font-size: 16px; color: #201d1b;">
          Redirecting to <a href="{{ redirect_target_url }}" style="color: #008b75; font-weight: 700;">{{ redirect_target_url }}</a>...
        </p>
      </div>
    </noscript>
  {%- endif -%}
{%- endunless -%}
