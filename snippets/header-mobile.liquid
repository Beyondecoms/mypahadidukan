                    {%- assign child_has_children = true -%}
                {%- endif -%}
                <li class="mob-drawer-item mob-drawer-item--l2">
                    <div class="mob-drawer-link-row">
                    <a href="{{ childlink.url }}" class="mob-drawer-sub-link mob-drawer-sub-link--l2">
                        {%- if child_has_children -%}
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1a6b4a" stroke-width="2">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                        {%- else -%}
                        <span class="mob-sub-dot"></span>
                        {%- endif -%}
                        {{ childlink.title }}
                    </a>
                    {%- if child_has_children -%}
                        <button class="mob-drawer-toggle mob-drawer-toggle--l2" aria-label="Toggle submenu">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                        </button>
                    {%- endif -%}
                    </div>

