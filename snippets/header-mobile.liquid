{{ 'header-mobile.css' | asset_url | stylesheet_tag }}

<div class="mob-header" style="background: {{ section.settings.bg_color }};">
  <!-- Main Header Row -->
  <div class="mob-header-row">
    <div class="mob-drawer-cross">
        <!-- Hamburger -->
        <button class="mob-hamburger" id="mobDrawerOpen" aria-label="Open menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        </button>

        <!-- Logo -->
        <div class="mob-logo">
        <a href="{{ routes.root_url }}">
            {%- if section.settings.logo != blank -%}
            <img
                src="{{ section.settings.logo | image_url: width: 160 }}"
                alt="{{ shop.name }}"
                width="{{ section.settings.logo_width | default: 100 }}"
                height="auto"
                loading="eager"
            >
            {%- else -%}
            <span class="mob-shop-name">{{ shop.name }}</span>
            {%- endif -%}
        </a>
        </div>
    </div>
    <!-- Icons: Wishlist | Account | Cart -->
    <div class="mob-icons">
      <a href="{{ section.settings.wishlist_url | default: '/pages/wishlist' }}" class="mob-icon" aria-label="Wishlist">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </a>
      <a href="{{ routes.account_url }}" class="mob-icon" aria-label="Account">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" class="mob-icon mob-cart-icon" aria-label="Cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        {%- if cart.item_count > 0 -%}
            <span class="mob-cart-count" id="header-cart-count">{{ cart.item_count }}</span>
          {%- else -%}
            <span class="mob-cart-count" id="header-cart-count" style="display:none;">0</span>
          {%- endif -%}
      </a>
    </div>

  </div>

<!-- Search Bar -->
<div class="mob-search-row">
  <form action="{{ routes.search_url }}" method="get" role="search" class="mob-search-form">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
    </svg>
    <input
      type="search"
      name="q"
      placeholder=""
      class="mob-search-input"
      aria-label="Search"
      autocomplete="off"
      id="mobSearchInput-{{ section.id }}"
    >
    <div class="mob-search-rotating-placeholder" id="mobSearchRotatingPlaceholder-{{ section.id }}" aria-hidden="true">
      <span class="mob-srp-static">Search for&nbsp;</span>
      <span class="mob-srp-word-wrap">
        {%- assign mob_words = section.settings.rotating_words | split: ',' -%}
        {%- for word in mob_words -%}
          <span class="mob-srp-word">{{ word | strip }}</span>
        {%- endfor -%}
      </span>
    </div>
  </form>
  <div class="mob-search-suggestions" id="mobSearchSuggestions-{{ section.id }}"></div>
</div>

</div>

<!-- ── SIDE DRAWER OVERLAY ── -->
<div class="mob-overlay" id="mobOverlay"></div>

<!-- ── SIDE DRAWER ── -->
<div class="mob-drawer" id="mobDrawer">

  <!-- Drawer Header -->
  <div class="mob-drawer-header" style="background: {{ section.settings.bg_color }};">
    <div class="mob-drawer-cross">
        <button class="mob-drawer-close" id="mobDrawerClose" aria-label="Close menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>
        <div class="mob-drawer-logo">
        {%- if section.settings.logo != blank -%}
            <img
            src="{{ section.settings.logo | image_url: width: 120 }}"
            alt="{{ shop.name }}"
            width="100"
            height="auto"
            >
        {%- else -%}
            <span class="mob-shop-name">{{ shop.name }}</span>
        {%- endif -%}
        </div>
    </div>
    <div class="mob-drawer-header-icons">
      <a href="{{ routes.account_url }}" class="mob-icon" aria-label="Account">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" class="mob-icon mob-cart-icon" aria-label="Cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="mob-cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>
  </div>

