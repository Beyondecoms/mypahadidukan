                    {%- if child_has_children -%}
                    <ul class="mob-drawer-sub mob-drawer-sub--l3">
                        {%- for grandchild in childlink.links -%}
                        <li>
                            <a href="{{ grandchild.url }}" class="mob-drawer-sub-link mob-drawer-sub-link--l3">
                            <span class="mob-sub-dot mob-sub-dot--small"></span>
                            {{ grandchild.title }}
                            </a>
                        </li>
                        {%- endfor -%}
                    </ul>
                    {%- endif -%}

                </li>
                {%- endfor -%}
            </ul>
            {%- endif -%}

        </li>
        {%- endfor -%}
    </ul>
    </nav>
  <!-- Drawer Footer: Currency -->
  <div class="mob-drawer-footer">
    {%- if section.settings.show_currency and localization.available_countries.size > 1 -%}
      <localization-form>
        {%- form 'localization', id: 'MobCountryForm', class: 'localization-form' -%}
          <div class="mob-currency-selector">
            <button type="button" class="mob-currency-btn" aria-expanded="false">
              {{ localization.country.currency.iso_code }}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>
            <ul class="mob-currency-dropdown">
              {%- for country in localization.available_countries -%}
                <li>
                  <button type="submit" name="country_code" value="{{ country.iso_code }}">
                    {{ country.name }} ({{ country.currency.iso_code }})
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endform -%}
      </localization-form>
    {%- endif -%}
      <a href="{{ section.settings.track_order_url }}" class="mob-track-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
        Track Your Order
      </a>
  </div>

</div>

<script>
(function () {
  var openBtn = document.getElementById('mobDrawerOpen');
  var closeBtn = document.getElementById('mobDrawerClose');
  var drawer = document.getElementById('mobDrawer');
  var overlay = document.getElementById('mobOverlay');

  function openDrawer() {
    drawer.classList.add('open');
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer.classList.remove('open');
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  if (openBtn) openBtn.addEventListener('click', openDrawer);
  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (overlay) overlay.addEventListener('click', closeDrawer);

// Submenu toggles — handles all levels
var toggles = document.querySelectorAll('.mob-drawer-toggle');
toggles.forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.mob-drawer-item');
    var sub = item.querySelector(':scope > .mob-drawer-sub');
    if (!sub) return;

    var isOpen = item.classList.contains('open');

    // Close siblings at same level only
    var parent = item.parentElement;
    parent.querySelectorAll(':scope > .mob-drawer-item.open').forEach(function(el) {
      if (el !== item) {
        el.classList.remove('open');
        var elSub = el.querySelector(':scope > .mob-drawer-sub');
        if (elSub) elSub.style.maxHeight = null;
        // Also close any open children inside
        el.querySelectorAll('.mob-drawer-item.open').forEach(function(child) {
          child.classList.remove('open');
          var childSub = child.querySelector(':scope > .mob-drawer-sub');
          if (childSub) childSub.style.maxHeight = null;
        });
      }
    });

    if (!isOpen) {
      item.classList.add('open');
      sub.style.maxHeight = sub.scrollHeight + 'px';
      // Update parent max-height to fit
      var parentSub = item.closest('.mob-drawer-sub');
      if (parentSub) {
        parentSub.style.maxHeight = parentSub.scrollHeight + sub.scrollHeight + 'px';
      }
    } else {
      item.classList.remove('open');
      sub.style.maxHeight = null;
    }
  });
});

  // Mobile cart open drawer
  var cartIcons = document.querySelectorAll('.mob-cart-icon');
  cartIcons.forEach(function(icon) {
    icon.addEventListener('click', function(e) {
      e.preventDefault();
      document.dispatchEvent(new CustomEvent('cart:open'));
      var cartDrawer = document.querySelector('cart-drawer');
      if (cartDrawer && cartDrawer.open) { cartDrawer.open(); return; }
      var cartBtn = document.querySelector('[data-cart-icon-bubble], #cart-icon-bubble');
      if (cartBtn) cartBtn.click();
    });
  });

  // Currency dropdown
  var currBtn = document.querySelector('.mob-currency-btn');
  var currDrop = document.querySelector('.mob-currency-dropdown');
  if (currBtn && currDrop) {
    currBtn.addEventListener('click', function() {
      var isOpen = currDrop.style.display === 'block';
      currDrop.style.display = isOpen ? 'none' : 'block';
    });
  }
})();
/* ── Mobile Predictive Search ── */
var mobSearchInput = document.getElementById('mobSearchInput-{{ section.id }}');
var mobSuggestionsBox = document.getElementById('mobSearchSuggestions-{{ section.id }}');

if (mobSearchInput && mobSuggestionsBox) {

  /* ── Mobile rotating placeholder ── */
  var mobRotatingBox = document.getElementById('mobSearchRotatingPlaceholder-{{ section.id }}');
  var mobWordEls = mobRotatingBox ? mobRotatingBox.querySelectorAll('.mob-srp-word') : [];

  if (mobRotatingBox && mobWordEls.length > 1) {
    var mobWordIndex = 0;
    mobWordEls.forEach(function(el, i) { el.classList.toggle('active', i === 0); });

    function mobRotateWord() {
      var current = mobWordEls[mobWordIndex];
      var nextIndex = (mobWordIndex + 1) % mobWordEls.length;
      var next = mobWordEls[nextIndex];

      current.classList.remove('active');
      current.classList.add('exit');
      next.classList.add('active');

      setTimeout(function() {
        current.classList.remove('exit');
      }, 400);

      mobWordIndex = nextIndex;
    }

    var mobRotateTimer = setInterval(mobRotateWord, 2200);

    function mobToggleRotatingVisibility() {
      var hasValue = mobSearchInput.value.length > 0;
      mobRotatingBox.style.opacity = hasValue ? '0' : '1';
    }

    mobSearchInput.addEventListener('input', mobToggleRotatingVisibility);
    mobSearchInput.addEventListener('focus', mobToggleRotatingVisibility);
    mobSearchInput.addEventListener('blur', mobToggleRotatingVisibility);
  }

  var mobDebounceTimer;
  var mobCurrentQuery = '';
    function mobFormatMoney(cents) {
      return '₹' + Math.round(cents);
    }

    function mobRenderSuggestions(results) {
      mobSuggestionsBox.innerHTML = '';
      if (!results || results.length === 0) {
        mobSuggestionsBox.innerHTML = '<div class="mob-search-no-results">No results found</div>';
        mobSuggestionsBox.classList.add('open');
        return;
      }
      results.forEach(function(item) {
        var a = document.createElement('a');
        a.className = 'mob-search-suggestion-item';
        a.href = item.url;

        var imgHtml = item.featured_image && item.featured_image.url
          ? '<img class="mob-search-suggestion-img" src="' + item.featured_image.url + '" alt="' + item.title + '">'
          : '<div class="mob-search-suggestion-img-placeholder"></div>';

        {% comment %} var priceHtml = item.price
          ? '<span class="mob-search-suggestion-price">' + mobFormatMoney(item.price) + '</span>'
          : ''; {% endcomment %}

        a.innerHTML = imgHtml +
          '<span class="mob-search-suggestion-title">' + item.title + '</span>';

        mobSuggestionsBox.appendChild(a);
      });
      mobSuggestionsBox.classList.add('open');
    }

    function mobFetchSuggestions(query) {
      if (query.length < 1) {
        mobSuggestionsBox.classList.remove('open');
        return;
      }
      fetch('/search/suggest.json?q=' + encodeURIComponent(query) + '&resources[type]=product&resources[limit]=6&resources[options][unavailable_products]=last&resources[options][fields]=title,product_type,variants.title')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var products = data.resources && data.resources.results && data.resources.results.products;
          mobRenderSuggestions(products || []);
        })
        .catch(function() {
          mobSuggestionsBox.classList.remove('open');
        });
    }

    mobSearchInput.addEventListener('input', function() {
      mobCurrentQuery = this.value.trim();
      clearTimeout(mobDebounceTimer);
      if (mobCurrentQuery.length < 1) {
        mobSuggestionsBox.classList.remove('open');
        return;
      }
      mobDebounceTimer = setTimeout(function() {
        mobFetchSuggestions(mobCurrentQuery);
      }, 250);
    });

    mobSearchInput.addEventListener('focus', function() {
      if (mobCurrentQuery.length >= 1) mobSuggestionsBox.classList.add('open');
    });

    document.addEventListener('click', function(e) {
      if (!mobSearchInput.contains(e.target) && !mobSuggestionsBox.contains(e.target)) {
        mobSuggestionsBox.classList.remove('open');
      }
    });

    mobSearchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') mobSuggestionsBox.classList.remove('open');
    });
  }
</script>