{% comment %}
  Renders a blog article card matching the visual style of the
  Blog Articles Grid's .bag-card.

  Accepts:
  - article: {Object} article object (required)
  - show_image: {Boolean} show the featured image
  - show_date: {Boolean} show the published date
  - show_author: {Boolean} show the article author
  - show_badge: {Boolean} show the blog/tag badge on the image
  - media_aspect_ratio: {Number|String} aspect ratio for the image, e.g. 1, 1.6 (16/10), 1.78 (16/9)
  - lazy_load: {Boolean} use lazy loading for the image
  - skip_styles: {Boolean} don't print the <style> tag (use when rendering many
                 cards in a loop so the CSS is only output once)

  Usage:
  {% render 'article-card',
    article: item,
    show_image: true,
    show_date: section.settings.article_show_date,
    show_author: section.settings.article_show_author,
    show_badge: true,
    media_aspect_ratio: 1,
    lazy_load: lazy_load
  %}
{% endcomment %}

{%- unless skip_styles -%}
  {{ 'article-card.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- liquid
  assign ratio = media_aspect_ratio | default: 1.6
  assign ratio = ratio | append: '' | plus: 0.0
  if ratio <= 0
    assign ratio = 1.6
  endif

  assign loading_attr = 'lazy'
  if lazy_load == false
    assign loading_attr = 'eager'
  endif

  assign ac_badge = article.tags.first | default: article.blog.title
-%}

<a href="{{ article.url }}" class="ac-card">

  {%- if show_image -%}
    <div class="ac-img-wrap" style="aspect-ratio: {{ ratio }};">
      {%- if show_badge and ac_badge != blank -%}
        <span class="ac-badge">{{ ac_badge }}</span>
      {%- endif -%}

      {%- if article.image != blank -%}
        <img
          src="{{ article.image | image_url: width: 600 }}"
          srcset="{{ article.image | image_url: width: 300 }} 300w, {{ article.image | image_url: width: 600 }} 600w, {{ article.image | image_url: width: 900 }} 900w"
          sizes="(min-width: 900px) 33vw, 50vw"
          alt="{{ article.image.alt | default: article.title | escape }}"
          class="ac-img"
          loading="{{ loading_attr }}"
          width="{{ article.image.width }}"
          height="{{ article.image.height }}"
        >
      {%- else -%}
        <div class="ac-img-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag: 'ac-placeholder-svg' }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="ac-body">
    {%- if show_date or show_author -%}
      <div class="ac-meta">
        {%- if show_date -%}
          <span class="ac-date">{{ article.published_at | date: '%b %d, %Y' }}</span>
        {%- endif -%}
        {%- if show_date and show_author -%}
          <span class="ac-meta-dot">&middot;</span>
        {%- endif -%}
        {%- if show_author -%}
          <span class="ac-author">{{ article.author }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <h3 class="ac-title">{{ article.title }}</h3>
    <p class="ac-excerpt">
      {{ article.excerpt_or_content | strip_html | truncate: 120 }}
    </p>
    <div class="ac-read">
      Read More
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 8 16 12 12 16"/>
        <line x1="8" y1="12" x2="16" y2="12"/>
      </svg>
    </div>
  </div>
</a>
