{% comment %} collection-sort-drawer.liquid {% endcomment %}

<div class="sort-drawer">

  {% comment %} ===== DESKTOP VIEW (existing — untouched) ===== {% endcomment %}
  <div class="sd-desktop">

    <div class="sort-header">
      <h3>Sort By</h3>
      <button class="closeSort"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
<rect width="16" height="16" fill="url(#pattern0_518_6030)"/>
<defs>
<pattern id="pattern0_518_6030" patternContentUnits="objectBoundingBox" width="1" height="1">
<use xlink:href="#image0_518_6030" transform="scale(0.00195312)"/>
</pattern>
<image id="image0_518_6030" width="512" height="512" preserveAspectRatio="none" xlink:href="data:image/png;base64,"/>
</defs>
</svg>
</button>
    </div>

    <div class="sort-options">
      <label>
        <input type="radio" name="sort" value="recommended" class="sort-option">
        Recommended
      </label>
      <label>
        <input type="radio" name="sort" value="new" class="sort-option">
        What's New
      </label>
      <label>
        <input type="radio" name="sort" value="trending" class="sort-option">
        Trending
      </label>
      <label>
        <input type="radio" name="sort" value="bestseller" class="sort-option">
        Bestseller
      </label>
      <label>
        <input type="radio" name="sort" value="low-high" class="sort-option">
        Price: Low to High
      </label>
      <label>
        <input type="radio" name="sort" value="high-low" class="sort-option">
        Price: High to Low
      </label>
      <button class="reset-sort">Reset Sort</button>
    </div>

  </div>

  {% comment %} ===== MOBILE VIEW ===== {% endcomment %}
  <div class="sd-mobile">

    <div class="sd-mobile-header">
      <button class="closeSort sd-mobile-close" id="sdMobileClose">✕</button>
      <h3>Sort By</h3>
      <div style="width:28px"></div>
    </div>

    <div class="sd-mobile-options">

      <label class="sd-row">
        <span>Recommended</span>
        <input type="radio" name="sort-mobile" value="recommended" class="sort-option sd-radio">
        <span class="sd-box"></span>
      </label>

      <label class="sd-row">
        <span>What's New</span>
        <input type="radio" name="sort-mobile" value="new" class="sort-option sd-radio">
        <span class="sd-box"></span>
      </label>

      <label class="sd-row">
        <span>Trending</span>
        <input type="radio" name="sort-mobile" value="trending" class="sort-option sd-radio">
        <span class="sd-box"></span>
      </label>

      <label class="sd-row">
        <span>Best Seller</span>
        <input type="radio" name="sort-mobile" value="bestseller" class="sort-option sd-radio">
        <span class="sd-box"></span>
      </label>

      <label class="sd-row">
        <span>High To Low</span>
        <input type="radio" name="sort-mobile" value="high-low" class="sort-option sd-radio">
        <span class="sd-box"></span>
      </label>

      <label class="sd-row">
        <span>Low To High</span>
        <input type="radio" name="sort-mobile" value="low-high" class="sort-option sd-radio">
        <span class="sd-box"></span>
      </label>

    </div>

    <div class="sd-mobile-footer">
      <button class="reset-sort sd-clear-btn">Clear</button>
      <button class="closeSort sd-apply-btn">Apply</button>
    </div>

  </div>

</div>
