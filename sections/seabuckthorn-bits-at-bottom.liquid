{{ 'section-seabuckthorn-m7.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign m7_heading = product.metafields.custom.m7_section_heading.value
  assign m7_subtitle = product.metafields.custom.m7_subtitle.value
  assign m7_desc = product.metafields.custom.m7_description.value
  assign m7_add_desc = product.metafields.custom.m7_additional_description.value
  assign m7_highlight = product.metafields.custom.m7_highlight_text.value

  # Support both new List of Images (custom.m7_images) and old Single Image (custom.m7_image)
  assign m7_images_raw = product.metafields.custom.m7_images.value | default: product.metafields.custom.m7_images | default: product.metafields.custom['m7_images'].value | default: product.metafields.custom['m7_images'] | default: product.metafields.custom['m7-images'].value | default: product.metafields.custom['m7-images']
  assign m7_single_raw = product.metafields.custom.m7_image.value | default: product.metafields.custom.m7_image | default: product.metafields.custom['m7_image'].value | default: product.metafields.custom['m7_image']

  assign m7_images_count = 0
  if m7_images_raw != blank
    assign m7_images_count = m7_images_raw.size | default: 0
  elsif m7_single_raw != blank
    assign m7_images_count = 1
  endif

  assign has_images = false
  if m7_images_count > 0
    assign has_images = true
  endif

  assign has_text = false
  if m7_heading != blank or m7_subtitle != blank or m7_desc != blank or m7_add_desc != blank or m7_highlight != blank
    assign has_text = true
  endif

  assign has_content = false
  if has_text or has_images
    assign has_content = true
  endif

  assign image_only = false
  if has_images and has_text == false
    assign image_only = true
  endif

  assign m7_alt = m7_heading | default: product.title | escape

  # Grid columns for multi-image layout (clamped between 1 and 4)
  assign m7_grid_cols = m7_images_count | at_most: 4
  if m7_grid_cols < 1
    assign m7_grid_cols = 1
  endif
-%}

{%- if has_content -%}
<div class="sb-m7-section">
  <div class="sb-m7-container">
    
    <!-- Top Meta Row -->
    <div class="sb-m7-top-bar">
      <span class="sb-m7-module-badge">M7 · You'll see bits at the bottom</span>
    </div>

    <!-- Main Card Box -->
    <div class="sb-m7-card-wrapper{% if image_only %} sb-m7-card-wrapper--image-only{% endif %}">

      {%- if image_only -%}
        <!-- Image-only layout: responsive grid of images -->
        <div class="sb-m7-images-grid" style="--m7-grid-cols: {{ m7_grid_cols }};">
          {%- if m7_images_raw != blank -%}
            {%- for image in m7_images_raw -%}
              {%- if image != blank -%}
                {%- assign img_alt = image.alt | default: m7_alt | escape -%}
                <div class="sb-m7-photo-box{% if m7_images_count == 1 %} sb-m7-photo-box--large{% else %} sb-m7-photo-box--multi{% endif %}">
                  {{ image | image_url: width: 1200 | image_tag:
                    loading: 'lazy',
                    alt: img_alt
                  }}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- elsif m7_single_raw != blank -%}
            {%- assign img_alt = m7_single_raw.alt | default: m7_alt | escape -%}
            <div class="sb-m7-photo-box sb-m7-photo-box--large">
              {{ m7_single_raw | image_url: width: 1200 | image_tag:
                loading: 'lazy',
                alt: img_alt
              }}
            </div>
          {%- endif -%}
        </div>

      {%- else -%}
        <!-- Two-column layout with text -->
        <div class="sb-m7-grid{% unless has_images %} sb-m7-grid--no-image{% endunless %}">
          
          <!-- Photo Column (Only if images are present) -->
          {%- if has_images -%}
            <div class="sb-m7-photo-col">
              {%- if m7_images_count > 1 -%}
                <div class="sb-m7-photo-stack">
                  {%- for image in m7_images_raw -%}
                    {%- if image != blank -%}
                      {%- assign img_alt = image.alt | default: m7_alt | escape -%}
                      <div class="sb-m7-photo-box">
                        {{ image | image_url: width: 600 | image_tag:
                          loading: 'lazy',
                          alt: img_alt
                        }}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              {%- else -%}
                {%- assign single_img_obj = m7_single_raw -%}
                {%- if m7_images_raw != blank -%}
                  {%- assign single_img_obj = m7_images_raw | first -%}
                {%- endif -%}
                {%- assign img_alt = single_img_obj.alt | default: m7_alt | escape -%}
                <div class="sb-m7-photo-box">
                  {{ single_img_obj | image_url: width: 600 | image_tag:
                    loading: 'lazy',
                    alt: img_alt
                  }}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          <!-- Content Column -->
          <div class="sb-m7-content-col">
            {%- if m7_heading != blank -%}
              <h2 class="sb-m7-title">{{ m7_heading }}</h2>
            {%- endif -%}
            {%- if m7_subtitle != blank -%}
              <h3 class="sb-m7-subtitle">"{{ m7_subtitle }}"</h3>
            {%- endif -%}
            
            {%- if m7_desc != blank or m7_add_desc != blank or m7_highlight != blank -%}
              <div class="sb-m7-body">
                {%- if m7_desc != blank -%}
                  <p>{{ m7_desc | newline_to_br }}</p>
                {%- endif -%}
                {%- if m7_add_desc != blank -%}
                  <p>{{ m7_add_desc | newline_to_br }}</p>
                {%- endif -%}
                {%- if m7_highlight != blank -%}
                  <p class="sb-m7-shake-note"><em>{{ m7_highlight }}</em></p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

        </div>
      {%- endif -%}

    </div>

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "M7 - Bits at bottom",
  "tag": "section",
  "class": "section-sb-m7",
  "settings": [],
  "presets": [
    {
      "name": "M7 - Bits at bottom"
    }
  ]
}
{% endschema %}
