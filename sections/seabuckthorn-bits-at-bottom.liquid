{{ 'section-seabuckthorn-m7.css' | asset_url | stylesheet_tag }}

<div class="sb-m7-section" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="sb-m7-container">
    
    <!-- Top Meta Row -->
    <div class="sb-m7-top-bar">
      <span class="sb-m7-module-badge">{{ section.settings.module_tag }}</span>
      {%- if section.settings.design_tag != blank -%}
        <span class="sb-m7-pill-badge" style="background-color: {{ section.settings.badge_bg }}; color: {{ section.settings.badge_color }};">{{ section.settings.design_tag }}</span>
      {%- endif -%}
    </div>

    <!-- Main Card Box -->
    <div class="sb-m7-card-wrapper">
      <div class="sb-m7-grid">
        
        <!-- Photo Column -->
        <div class="sb-m7-photo-col">
          <div class="sb-m7-photo-box">
            {%- if section.settings.sediment_image != blank -%}
              <img src="{{ section.settings.sediment_image | image_url: width: 500 }}" alt="{{ section.settings.heading }}" loading="lazy" width="500" height="500">
            {%- else -%}
              <div class="sb-m7-photo-placeholder">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                </svg>
                <p style="margin: 8px 0 0 0; font-weight: 700; font-size: 0.85rem;">Existing Sediment Photo</p>
              </div>
            {%- endif -%}
          </div>
        </div>

        <!-- Content Column -->
        <div class="sb-m7-content-col">
          <h2 class="sb-m7-title">{{ section.settings.heading }}</h2>
          <h3 class="sb-m7-subtitle">"{{ section.settings.subtitle }}"</h3>
          
          <div class="sb-m7-body">
            <p>{{ section.settings.para_1 }}</p>
            <p>{{ section.settings.para_2 }}</p>
            <p class="sb-m7-shake-note"><em>{{ section.settings.shake_text }}</em></p>
          </div>
        </div>

      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "M7 - Bits at bottom",
  "tag": "section",
  "class": "section-sb-m7",
  "settings": [
    {
      "type": "text",
      "id": "module_tag",
      "label": "Module Tag",
      "default": "M7 · You'll see bits at the bottom"
    },
    {
      "type": "text",
      "id": "design_tag",
      "label": "Design Badge",
      "default": "design-led"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "YOU'LL SEE BITS AT THE BOTTOM"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "This is the good news"
    },
    {
      "type": "textarea",
      "id": "para_1",
      "label": "Paragraph 1",
      "default": "That's the berry, doing what berries do."
    },
    {
      "type": "textarea",
      "id": "para_2",
      "label": "Paragraph 2",
      "default": "Leave the bottle standing and it settles. A little sediment, the odd fragment of seed."
    },
    {
      "type": "text",
      "id": "shake_text",
      "label": "Shake Note",
      "default": "Shake it and it all comes back."
    },
    {
      "type": "image_picker",
      "id": "sediment_image",
      "label": "Sediment Photo"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fffbef"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Pill Badge BG",
      "default": "#008b75"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Pill Badge Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "M7 - Bits at bottom"
    }
  ]
}
{% endschema %}
