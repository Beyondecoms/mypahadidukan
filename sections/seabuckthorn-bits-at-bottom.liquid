{{ 'section-seabuckthorn-m7.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign m7_heading = product.metafields.custom.m7_section_heading.value
  assign m7_subtitle = product.metafields.custom.m7_subtitle.value
  assign m7_desc = product.metafields.custom.m7_description.value
  assign m7_add_desc = product.metafields.custom.m7_additional_description.value
  assign m7_highlight = product.metafields.custom.m7_highlight_text.value
  assign m7_image = product.metafields.custom.m7_image.value | default: product.metafields.custom.m7_image
  assign m7_alt = m7_heading | default: product.title | escape

  assign has_content = false
  if m7_heading != blank or m7_subtitle != blank or m7_desc != blank or m7_add_desc != blank or m7_highlight != blank or m7_image != blank
    assign has_content = true
  endif
-%}

{%- if has_content -%}
<div class="sb-m7-section">
  <div class="sb-m7-container">
    
    <!-- Top Meta Row -->
    <div class="sb-m7-top-bar">
      <span class="sb-m7-module-badge">M7 · You'll see bits at the bottom</span>
    </div>

    <!-- Main Card Box -->
    <div class="sb-m7-card-wrapper">
      <div class="sb-m7-grid{% if m7_image == blank %} sb-m7-grid--no-image{% endif %}" style="{% if m7_image == blank %}grid-template-columns: 1fr;{% endif %}">
        
        <!-- Photo Column (Only if image is present) -->
        {%- if m7_image != blank -%}
          <div class="sb-m7-photo-col">
            <div class="sb-m7-photo-box">
              <img src="{{ m7_image | image_url: width: 500 }}" alt="{{ m7_alt }}" loading="lazy" width="500" height="500">
            </div>
          </div>
        {%- endif -%}

        <!-- Content Column -->
        <div class="sb-m7-content-col">
          {%- if m7_heading != blank -%}
            <h2 class="sb-m7-title">{{ m7_heading }}</h2>
          {%- endif -%}
          {%- if m7_subtitle != blank -%}
            <h3 class="sb-m7-subtitle">"{{ m7_subtitle }}"</h3>
          {%- endif -%}
          
          {%- if m7_desc != blank or m7_add_desc != blank or m7_highlight != blank -%}
            <div class="sb-m7-body">
              {%- if m7_desc != blank -%}
                <p>{{ m7_desc | newline_to_br }}</p>
              {%- endif -%}
              {%- if m7_add_desc != blank -%}
                <p>{{ m7_add_desc | newline_to_br }}</p>
              {%- endif -%}
              {%- if m7_highlight != blank -%}
                <p class="sb-m7-shake-note"><em>{{ m7_highlight }}</em></p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

      </div>
    </div>

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "M7 - Bits at bottom",
  "tag": "section",
  "class": "section-sb-m7",
  "settings": [],
  "presets": [
    {
      "name": "M7 - Bits at bottom"
    }
  ]
}
{% endschema %}
