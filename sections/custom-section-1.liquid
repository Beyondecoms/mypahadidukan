{%- liquid
  assign bg_color = section.settings.bg_color | default: '#FAF3E8'
  assign heading_color = section.settings.heading_color | default: '#BA5D37'
  assign card_bg_color = section.settings.card_bg_color | default: '#FFF5EA'
  assign card_title_color = section.settings.card_title_color | default: '#BA5D37'
  assign dash_color = section.settings.dash_color | default: '#F26522'
  assign desktop_cards = section.settings.desktop_cards | default: 8
  assign mobile_cards = section.settings.mobile_cards | default: 2
  assign card_gap = section.settings.card_gap | default: 12
  assign card_radius = section.settings.card_radius | default: 14
  assign padding_top = section.settings.padding_top | default: 48
  assign padding_bottom = section.settings.padding_bottom | default: 48
-%}

<div
  id="shop-by-category-{{ section.id }}"
  class="shop-by-category-section"
  style="
    --sbc-bg: {{ bg_color }};
    --sbc-heading-color: {{ heading_color }};
    --sbc-card-bg: {{ card_bg_color }};
    --sbc-card-title-color: {{ card_title_color }};
    --sbc-dash-color: {{ dash_color }};
    --sbc-cards-desktop: {{ desktop_cards }};
    --sbc-cards-mobile: {{ mobile_cards }};
    --sbc-card-gap: {{ card_gap }}px;
    --sbc-card-radius: {{ card_radius }}px;
    --sbc-pt: {{ padding_top }}px;
    --sbc-pb: {{ padding_bottom }}px;
  "
>
  <div class="shop-by-category__inner">
    {%- if section.settings.heading != blank -%}
      <div class="shop-by-category__header">
        <h2 class="shop-by-category__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="shop-by-category__carousel-wrapper" data-carousel-wrapper>
      {%- if section.settings.show_arrows and section.blocks.size > 0 -%}
        <button
          type="button"
          class="shop-by-category__arrow shop-by-category__arrow--prev"
          aria-label="Previous category"
          data-arrow="prev"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
      {%- endif -%}

      <div class="shop-by-category__track" data-carousel-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_title = block.settings.title
            assign block_image = block.settings.image
            assign block_link = block.settings.link
          -%}
          <div class="shop-by-category__item" {{ block.shopify_attributes }}>
            <a
              {% if block_link != blank %}href="{{ block_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
              class="shop-by-category__card"
            >
              {%- if block_title != blank and section.settings.show_card_title -%}
                <div class="shop-by-category__card-header">
                  <span class="shop-by-category__card-title">{{ block_title }}</span>
                  {%- if section.settings.show_card_dash -%}
                    <span class="shop-by-category__card-dash"></span>
                  {%- endif -%}
                </div>
              {%- endif -%}

              <div class="shop-by-category__card-media">
                {%- if block_image != blank -%}
                  {{
                    block_image
                    | image_url: width: 450
                    | image_tag:
                      loading: 'lazy',
                      class: 'shop-by-category__card-img',
                      widths: '150, 200, 280, 360, 450',
                      alt: block_title | default: block_image.alt | default: 'Category'
                  }}
                {%- else -%}
                  <div class="shop-by-category__card-placeholder">
                    {{ 'image' | placeholder_svg_tag: 'shop-by-category__placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>
            </a>
          </div>
        {%- else -%}
          {%- for i in (1..8) -%}
            <div class="shop-by-category__item">
              <div class="shop-by-category__card">
                <div class="shop-by-category__card-header">
                  <span class="shop-by-category__card-title">Category {{ i }}</span>
                  <span class="shop-by-category__card-dash"></span>
                </div>
                <div class="shop-by-category__card-media">
                  <div class="shop-by-category__card-placeholder">
                    {{ 'image' | placeholder_svg_tag: 'shop-by-category__placeholder-svg' }}
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_arrows and section.blocks.size > 0 -%}
        <button
          type="button"
          class="shop-by-category__arrow shop-by-category__arrow--next"
          aria-label="Next category"
          data-arrow="next"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  #shop-by-category-{{ section.id }} {
    background-color: var(--sbc-bg);
    padding-top: var(--sbc-pt);
    padding-bottom: var(--sbc-pb);
    width: 100%;
    position: relative;
    box-sizing: border-box;
    font-family: inherit;
  }

  #shop-by-category-{{ section.id }} * {
    box-sizing: border-box;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__inner {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 16px;
    box-sizing: border-box;
    position: relative;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__header {
    text-align: center;
    margin-bottom: 24px;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__heading {
    margin: 0;
    color: var(--sbc-heading-color);
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.3;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__track {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--sbc-card-gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 8px 4px 14px 4px;
    width: 100%;
    scroll-behavior: smooth;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__track::-webkit-scrollbar {
    display: none;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__item {
    flex: 0 0 calc((100% - (var(--sbc-cards-desktop) - 0.5) * var(--sbc-card-gap)) / var(--sbc-cards-desktop));
    min-width: 0;
    scroll-snap-align: start;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__card {
    display: flex;
    flex-direction: column;
    background-color: var(--sbc-card-bg);
    border-radius: var(--sbc-card-radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    height: 100%;
    position: relative;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    cursor: pointer;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(186, 93, 55, 0.14);
  }

  #shop-by-category-{{ section.id }} .shop-by-category__card-header {
    padding: 12px 10px 4px 10px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-height: 42px;
    z-index: 2;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__card-title {
    color: var(--sbc-card-title-color);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__card-dash {
    display: block;
    width: 18px;
    height: 5px;
    border-radius: 3px;
    background-color: var(--sbc-dash-color);
    flex-shrink: 0;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__card-media {
    width: 100%;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--sbc-card-radius);
    aspect-ratio: 1 / 1.1;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: var(--sbc-card-radius);
    transition: transform 0.35s ease;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__card:hover .shop-by-category__card-img {
    transform: scale(1.03);
  }

  #shop-by-category-{{ section.id }} .shop-by-category__card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.03);
    min-height: 140px;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__placeholder-svg {
    width: 50%;
    height: 50%;
    opacity: 0.4;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: #ffffff;
    border: none;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2c2c2c;
    cursor: pointer;
    z-index: 10;
    transition: transform 0.2s ease, opacity 0.2s ease, box-shadow 0.2s ease;
    padding: 0;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__arrow:hover:not(:disabled) {
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
  }

  #shop-by-category-{{ section.id }} .shop-by-category__arrow:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    pointer-events: none;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__arrow--prev {
    left: 2px;
  }

  #shop-by-category-{{ section.id }} .shop-by-category__arrow--next {
    right: 2px;
  }

  @media (max-width: 1200px) {
    #shop-by-category-{{ section.id }} .shop-by-category__item {
      flex: 0 0 calc((100% - 5.5 * var(--sbc-card-gap)) / 6);
    }
  }

  @media (max-width: 991px) {
    #shop-by-category-{{ section.id }} .shop-by-category__item {
      flex: 0 0 calc((100% - 3.5 * var(--sbc-card-gap)) / 4.2);
    }
    #shop-by-category-{{ section.id }} .shop-by-category__heading {
      font-size: 22px;
    }
  }

  @media (max-width: 767px) {
    #shop-by-category-{{ section.id }} .shop-by-category__inner {
      padding: 0 12px;
    }
    #shop-by-category-{{ section.id }} .shop-by-category__heading {
      font-size: 19px;
      letter-spacing: 0.04em;
    }
    #shop-by-category-{{ section.id }} .shop-by-category__header {
      margin-bottom: 16px;
    }
    #shop-by-category-{{ section.id }} .shop-by-category__item {
      flex: 0 0 calc((100% - (var(--sbc-cards-mobile) + 0.3) * var(--sbc-card-gap)) / (var(--sbc-cards-mobile) + 0.3));
    }
    #shop-by-category-{{ section.id }} .shop-by-category__arrow {
      width: 32px;
      height: 32px;
    }
    #shop-by-category-{{ section.id }} .shop-by-category__arrow--prev {
      left: -2px;
    }
    #shop-by-category-{{ section.id }} .shop-by-category__arrow--next {
      right: -2px;
    }
    #shop-by-category-{{ section.id }} .shop-by-category__card-title {
      font-size: 11px;
    }
    #shop-by-category-{{ section.id }} .shop-by-category__card-dash {
      width: 14px;
      height: 4px;
    }
  }
</style>

<script>
  (function () {
    function initCategoryCarousel() {
      var section = document.getElementById('shop-by-category-{{ section.id }}');
      if (!section) return;

      var track = section.querySelector('[data-carousel-track]');
      var prevBtn = section.querySelector('[data-arrow="prev"]');
      var nextBtn = section.querySelector('[data-arrow="next"]');

      if (!track) return;

      function updateArrows() {
        if (!prevBtn || !nextBtn) return;
        var maxScrollLeft = track.scrollWidth - track.clientWidth;
        prevBtn.disabled = track.scrollLeft <= 4;
        nextBtn.disabled = track.scrollLeft >= maxScrollLeft - 4;
      }

      function scrollTrack(direction) {
        var card = track.querySelector('.shop-by-category__item');
        if (!card) return;
        var cardWidth = card.getBoundingClientRect().width;
        var gap = parseFloat(getComputedStyle(track).gap) || 12;
        var scrollAmount = (cardWidth + gap) * 2;
        if (direction === 'prev') {
          track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        } else {
          track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          scrollTrack('prev');
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          scrollTrack('next');
        });
      }

      track.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows, { passive: true });
      updateArrows();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCategoryCarousel);
    } else {
      initCategoryCarousel();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target.id === 'shopify-section-{{ section.id }}' || e.target.querySelector('#shop-by-category-{{ section.id }}')) {
        initCategoryCarousel();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Shop by Category",
  "tag": "section",
  "class": "custom-section-shop-by-category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "SHOP BY CATEGORY"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#FAF3E8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#BA5D37"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background color",
      "default": "#FFF5EA"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card title color",
      "default": "#BA5D37"
    },
    {
      "type": "color",
      "id": "dash_color",
      "label": "Decorative dash color",
      "default": "#F26522"
    },
    {
      "type": "checkbox",
      "id": "show_card_title",
      "label": "Show card title (if provided in block)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_card_dash",
      "label": "Show decorative dash",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_cards",
      "min": 4,
      "max": 10,
      "step": 1,
      "label": "Number of cards on desktop",
      "default": 8
    },
    {
      "type": "range",
      "id": "mobile_cards",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Number of cards on mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 6,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Card gap",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 4,
      "max": 28,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Gifting"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Pure & Natural Seabuckthorn"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Pahadi Wellness"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Jams & Spreads"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Dry Fruits"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Natural Beverages"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Pure Honey"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Pure Ghee"
          }
        }
      ]
    }
  ]
}
{% endschema %}
