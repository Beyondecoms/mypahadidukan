              {%- endif -%}
            {%- endif -%}
            {{ block.settings.tab_label }}
          </button>
        {%- endfor -%}
      </div>
    </div>

    <!-- Video Panel -->
    <div class="why-choose-video-wrap">
      {%- for block in section.blocks -%}
        <div class="why-video-panel {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}">
          {%- if block.settings.youtube_url != blank -%}
            {%- assign video_id = block.settings.youtube_url | split: 'v=' | last | split: '&' | first -%}
            {%- if block.settings.youtube_url contains 'youtu.be/' -%}
              {%- assign video_id = block.settings.youtube_url | split: 'youtu.be/' | last | split: '?' | first -%}
            {%- endif -%}
            <iframe
                src="https://www.youtube.com/embed/{{ video_id }}?rel=0&modestbranding=1&autoplay={% if forloop.first %}1{% else %}0{% endif %}&mute=1&loop=1&playlist={{ video_id }}"
                title="{{ block.settings.tab_label }}"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
                ></iframe>
          {%- else -%}
            <div class="why-video-placeholder">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#999" stroke-width="1.5">
                <polygon points="5 3 19 12 5 21 5 3"/>
              </svg>
              <p>No video added</p>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<script>
(function () {
  const tabs = document.querySelectorAll('.why-tab');
  const panels = document.querySelectorAll('.why-video-panel');
  if (!tabs.length) return;

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const idx = tab.dataset.index;

      // Pause current active iframe by clearing src
      const activePanel = document.querySelector('.why-video-panel.active');
      if (activePanel) {
        const activeIframe = activePanel.querySelector('iframe');
        if (activeIframe) {
          activeIframe.src = activeIframe.src; // reset to stop
          activeIframe.src = activeIframe.src.replace('autoplay=1', 'autoplay=0');
        }
      }

      tabs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));

      tab.classList.add('active');

      const newPanel = document.querySelector('.why-video-panel[data-index="' + idx + '"]');
      newPanel.classList.add('active');

      // Autoplay new iframe
      const newIframe = newPanel.querySelector('iframe');
        if (newIframe) {
        const baseSrc = newIframe.src
            .replace('autoplay=0', '')
            .replace('autoplay=1', '');
        newIframe.src = baseSrc + (baseSrc.includes('?') ? '&' : '?') + 'autoplay=1&mute=1&loop=1&playlist=' + baseSrc.split('/embed/')[1].split('?')[0];
        }
    });
  });
})();
</script>

{% schema %}
{
  "name": "Why Choose Us",
  "tag": "section",
  "class": "why-choose-outer",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Why Choose My Pahadi Dukan ?"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#fdf6e3"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Video Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "default": "Our Vision"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Tab icon (optional)"
        },
        {
          "type": "text",
          "id": "youtube_url",
          "label": "YouTube URL",
          "info": "Paste full YouTube URL e.g. https://www.youtube.com/watch?v=XXXXX"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "tab_label": "Our Vision",
            "youtube_url": ""
          }
        },
        {
          "type": "tab",
          "settings": {
            "tab_label": "Our Sources",
            "youtube_url": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}