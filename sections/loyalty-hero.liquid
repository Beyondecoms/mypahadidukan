{%- comment -%}
  Loyalty page hero.
  Guests see the full-width banner (separate mobile crop) with the animated
  "Join" button, which opens the YourToken sign-in when the widget is on the
  page. Shoppers signed in to YourToken see the member dashboard instead:
  points, tier progress by spend and the tier ladder, filled in by
  loyalty-page.js. Falls back to the bundled loyalty-* assets when no images
  are picked. Styles: section-loyalty-page.css
{%- endcomment -%}
{% render 'loyalty-page-assets' %}
<script src="{{ 'loyalty-page.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  # The sign-in link stays off account URLs, which KwikPass takes over and returns to /account.
  if section.settings.open_yourtoken
    assign login_fallback = request.path | append: '?showYt=true'
  else
    assign login_fallback = routes.account_register_url
  endif
  assign button_link = section.settings.button_link | default: login_fallback
  assign show_member = section.settings.show_member_banner

  if desktop_image != blank
    assign desktop_ratio = desktop_image.aspect_ratio
  else
    assign desktop_ratio = '3.125'
  endif

  if mobile_image != blank
    assign mobile_ratio = mobile_image.aspect_ratio
  elsif desktop_image != blank
    assign mobile_ratio = desktop_image.aspect_ratio
  else
    assign mobile_ratio = '0.9524'
  endif

  if section.settings.member_art != blank
    assign member_art_url = section.settings.member_art | image_url: width: 400
  else
    assign member_art_url = 'loyalty-badges-stack.webp' | asset_url
  endif

  if section.settings.tier_1_badge != blank
    assign first_badge_url = section.settings.tier_1_badge | image_url: width: 160
  else
    assign first_badge_url = 'loyalty-tier-1.webp' | asset_url
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --lp-hero-ratio: {{ desktop_ratio }};
    --lp-hero-ratio-mobile: {{ mobile_ratio }};
  }
  #shopify-section-{{ section.id }} .lp-hero__media {
    aspect-ratio: var(--lp-hero-ratio);
  }
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .lp-hero__media {
      aspect-ratio: var(--lp-hero-ratio-mobile);
    }
  }
</style>

<loyalty-hero
  class="lp lp-hero"
  data-state="guest"
  data-shop-id="{{ shop.id }}"
  data-customer="{{ customer.id }}"
>
  {%- if section.settings.heading != blank -%}
    <h1 class="visually-hidden">{{ section.settings.heading | escape }}</h1>
  {%- endif -%}

  <div class="lp-hero__guest">
    <picture class="lp-hero__media">
      {%- if mobile_image != blank -%}
        <source
          media="(max-width: 768px)"
          srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 550 }} 550w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w"
          sizes="100vw"
          width="{{ mobile_image.width }}"
          height="{{ mobile_image.height }}"
        >
      {%- elsif desktop_image == blank -%}
        <source
          media="(max-width: 768px)"
          srcset="{{ 'loyalty-hero-mobile.webp' | asset_url }}"
          width="648"
          height="698"
        >
      {%- endif -%}

      {%- if desktop_image != blank -%}
        {{
          desktop_image
          | image_url: width: 2880
          | image_tag:
            alt: section.settings.image_alt,
            sizes: '100vw',
            widths: '750, 1100, 1500, 2000, 2880',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- else -%}
        <img
          src="{{ 'loyalty-hero-desktop.webp' | asset_url }}"
          alt="{{ section.settings.image_alt | escape }}"
          width="2880"
          height="936"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}
    </picture>

    {%- if section.settings.show_button -%}
      <a
        href="{{ button_link }}"
        class="lp-hero__cta"
        {% if section.settings.open_yourtoken %}
          data-lp-login
        {% endif %}
      >
        {%- if section.settings.button_image != blank -%}
          <img
            src="{{ section.settings.button_image | image_url: width: section.settings.button_image.width }}"
            alt="{{ section.settings.button_label | escape }}"
            width="{{ section.settings.button_image.width }}"
            height="{{ section.settings.button_image.height }}"
            loading="eager"
          >
        {%- else -%}
          <img
            src="{{ 'loyalty-join-button.gif' | asset_url }}"
            alt="{{ section.settings.button_label | escape }}"
            width="702"
            height="210"
            loading="eager"
          >
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>

  {%- if show_member -%}
    <div class="lp-member" data-lp-member data-tier="0" data-loading>
      <div class="lp-member__inner">
        <div class="lp-member__points">
          <div class="lp-member__art">
            <img src="{{ member_art_url }}" alt="" width="363" height="235" loading="lazy" data-lp-art>
          </div>
          <div class="lp-member__summary">
            <p class="lp-member__count">
              <span class="lp-member__num" data-lp-points>0</span>
              {{ section.settings.points_label | escape }}
            </p>
            <p class="lp-member__status" data-lp-status>{{ section.settings.start_text | escape }}</p>
          </div>
        </div>

        <div class="lp-member__card">
          <div class="lp-member__progress">
            <p class="lp-member__title">
              <span data-lp-tier-name>{{ section.settings.member_label | escape }}</span>
              <span class="lp-member__since" hidden>
                <span class="lp-member__since-label">{{ section.settings.since_label | escape }}</span>
                <span data-lp-since></span>
              </span>
            </p>
            <div
              class="lp-member__bar"
              role="progressbar"
              aria-label="{{ section.settings.progress_label | escape }}"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="0"
              data-lp-bar
            >
              <span class="lp-member__fill" data-lp-fill></span>
              <img
                class="lp-member__next"
                src="{{ first_badge_url }}"
                alt=""
                width="202"
                height="202"
                loading="lazy"
                data-lp-next-badge
              >
            </div>
            <div class="lp-member__note">
              <p class="lp-member__spent" data-lp-spent></p>
              <p class="lp-member__goal" data-lp-goal></p>
            </div>
          </div>

          <ol class="lp-ladder" role="list">
            {%- for i in (1..3) -%}
              {%- liquid
                assign name_key = 'tier_' | append: i | append: '_name'
                assign spend_key = 'tier_' | append: i | append: '_spend'
                assign badge_key = 'tier_' | append: i | append: '_badge'
                assign badge = section.settings[badge_key]
                assign fallback_badge = 'loyalty-tier-' | append: i | append: '.webp'
              -%}
              <li class="lp-ladder__tier" data-lp-ladder="{{ i }}">
                <span class="lp-ladder__badge">
                  {% render 'loyalty-image',
                    image: badge,
                    fallback: fallback_badge,
                    fallback_width: 202,
                    fallback_height: 202,
                    alt: '',
                    class: 'lp-ladder__img',
                    sizes: '48px'
                  %}
                  <svg class="lp-ladder__check" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="12"/>
                    <path d="M6.8 12.4l3.4 3.3 7-7.1" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="lp-ladder__name">
                  {{- section.settings[name_key] | escape -}}
                  <span class="visually-hidden" data-lp-ladder-status hidden>
                    ({{- section.settings.unlocked_label | escape -}})
                  </span>
                </span>
                <span class="lp-ladder__req" data-lp-req>₹{{ section.settings[spend_key] }}</span>
              </li>
            {%- endfor -%}
          </ol>
        </div>
      </div>

      <script type="application/json" data-lp-config>
        {
          "currency": {{ shop.currency | json }},
          "prefix": {{ section.settings.tier_prefix | json }},
          "memberLabel": {{ section.settings.member_label | json }},
          "startText": {{ section.settings.start_text | json }},
          "goalText": {{ section.settings.goal_text | json }},
          "topText": {{ section.settings.top_text | json }},
          "art": {{ member_art_url | json }},
          "tiers": [
            {%- for i in (1..3) -%}
              {%- liquid
                assign name_key = 'tier_' | append: i | append: '_name'
                assign spend_key = 'tier_' | append: i | append: '_spend'
                assign badge_key = 'tier_' | append: i | append: '_badge'
                assign badge = section.settings[badge_key]
                if badge != blank
                  assign badge_url = badge | image_url: width: 160
                  assign badge_large_url = badge | image_url: width: 400
                else
                  assign badge_url = 'loyalty-tier-' | append: i | append: '.webp' | asset_url
                  assign badge_large_url = 'loyalty-tier-' | append: i | append: '-lg.webp' | asset_url
                endif
              -%}
              {
                "name": {{ section.settings[name_key] | json }},
                "spend": {{ section.settings[spend_key] | default: 0 | json }},
                "badge": {{ badge_url | json }},
                "badgeLarge": {{ badge_large_url | json }}
              }
              {%- unless forloop.last %},{% endunless -%}
            {%- endfor -%}
          ]
        }
      </script>
    </div>
  {%- endif -%}
</loyalty-hero>

{%- comment -%} Avoids a guest flash for members. Signed out of the store means guest. {%- endcomment -%}
{%- if show_member and customer -%}
  <script>
    try {
      if (window.localStorage.getItem('widget_session')) {
        document.currentScript.previousElementSibling.setAttribute('data-state', 'member');
      }
    } catch (error) {}
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Loyalty: Hero banner",
  "tag": "section",
  "class": "lp-section lp-section--hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading",
      "info": "Hidden on screen. Read by search engines and screen readers.",
      "default": "Loyalty Circle"
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image",
      "info": "Leave empty to use the bundled banner. Recommended 2880 x 936px."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Leave empty to use the bundled mobile banner. Recommended 648 x 680px."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Banner alt text",
      "default": "Join the Loyalty Circle: sign up and shop, earn 10 points for every ₹100 spent, then keep shopping to upgrade tiers and unlock perks."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "button_image",
      "label": "Button image",
      "info": "Leave empty to use the bundled animated button. GIFs are supported."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Used as the button's alt text.",
      "default": "Join Loyalty Circle"
    },
    {
      "type": "checkbox",
      "id": "open_yourtoken",
      "label": "Sign in and return to this page",
      "info": "Guests sign in with the store login and come back to this page. Members get the YourToken rewards widget.",
      "default": true
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Used when the sign-in above is off. Defaults to the create account page."
    },
    {
      "type": "header",
      "content": "Member dashboard",
      "info": "Replaces the banner for shoppers signed in to YourToken. Shows their points and progress to the next tier by spend."
    },
    {
      "type": "checkbox",
      "id": "show_member_banner",
      "label": "Show member dashboard",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "member_art",
      "label": "Image before the first tier",
      "info": "Leave empty to use the bundled stack of tier badges."
    },
    {
      "type": "text",
      "id": "points_label",
      "label": "Points label",
      "default": "points"
    },
    {
      "type": "text",
      "id": "start_text",
      "label": "Text before the first order",
      "default": "Start collecting points"
    },
    {
      "type": "text",
      "id": "member_label",
      "label": "Name before the first tier",
      "default": "Member"
    },
    {
      "type": "text",
      "id": "tier_prefix",
      "label": "Tier name prefix",
      "info": "Shown before tier names, e.g. \"MPD Crushing\".",
      "default": "MPD"
    },
    {
      "type": "text",
      "id": "since_label",
      "label": "Member since label",
      "default": "since"
    },
    {
      "type": "text",
      "id": "goal_text",
      "label": "Next tier text",
      "info": "[amount] is the spend left and [tier] the next tier.",
      "default": "[amount] more to [tier]"
    },
    {
      "type": "inline_richtext",
      "id": "top_text",
      "label": "Top tier text",
      "default": "Enjoy your <strong>premium benefits</strong>"
    },
    {
      "type": "text",
      "id": "progress_label",
      "label": "Progress bar label",
      "info": "Read by screen readers.",
      "default": "Progress to the next tier"
    },
    {
      "type": "text",
      "id": "unlocked_label",
      "label": "Unlocked tier label",
      "info": "Read by screen readers.",
      "default": "unlocked"
    },
    {
      "type": "header",
      "content": "Tier 1"
    },
    {
      "type": "text",
      "id": "tier_1_name",
      "label": "Name",
      "default": "Crushing"
    },
    {
      "type": "number",
      "id": "tier_1_spend",
      "label": "Spend to reach (₹)",
      "default": 2999
    },
    {
      "type": "image_picker",
      "id": "tier_1_badge",
      "label": "Badge"
    },
    {
      "type": "header",
      "content": "Tier 2"
    },
    {
      "type": "text",
      "id": "tier_2_name",
      "label": "Name",
      "default": "Obsessed"
    },
    {
      "type": "number",
      "id": "tier_2_spend",
      "label": "Spend to reach (₹)",
      "default": 4999
    },
    {
      "type": "image_picker",
      "id": "tier_2_badge",
      "label": "Badge"
    },
    {
      "type": "header",
      "content": "Tier 3"
    },
    {
      "type": "text",
      "id": "tier_3_name",
      "label": "Name",
      "default": "Committed"
    },
    {
      "type": "number",
      "id": "tier_3_spend",
      "label": "Spend to reach (₹)",
      "default": 7999
    },
    {
      "type": "image_picker",
      "id": "tier_3_badge",
      "label": "Badge"
    }
  ],
  "presets": [
    {
      "name": "Loyalty: Hero banner"
    }
  ]
}
{% endschema %}
