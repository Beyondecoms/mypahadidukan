{%- comment -%}
  Author box for blog posts.
  Reads the "custom.authors" metafield on the article (list of Author metaobjects).
  Add it to the blog post template in the theme editor, below the post content.
{%- endcomment -%}

{%- assign authors = article.metafields.custom.author.value -%}

{%- if authors != blank -%}
  <div class="article-authors page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="article-authors__heading h4">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- assign author = authors -%}
      {%- assign author_url = author.system.url -%}
      <div class="author-card">
        {%- if author.photo.value != blank -%}
          {%- if author_url != blank -%}<a href="{{ author_url }}" class="author-card__photo-link">{%- endif -%}
          {{
            author.photo.value
            | image_url: width: 240, height: 240, crop: 'center'
            | image_tag: loading: 'lazy', alt: author.name.value, class: 'author-card__photo', width: 96, height: 96
          }}
          {%- if author_url != blank -%}</a>{%- endif -%}
        {%- endif -%}

        <div class="author-card__body">
          <p class="author-card__name">
            {%- if author_url != blank -%}
              <a href="{{ author_url }}">{{ author.name.value }}</a>
            {%- else -%}
              {{ author.name.value }}
            {%- endif -%}
          </p>

          {%- if author.role.value != blank -%}
            <p class="author-card__role">{{ author.role.value }}</p>
          {%- endif -%}

          {%- if author.bio.value != blank -%}
            <div class="author-card__bio rte">{{ author.bio | metafield_tag }}</div>
          {%- endif -%}

          
        

          {%- if author_url != blank and section.settings.show_more_link -%}
            <a href="{{ author_url }}" class="author-card__more">More from {{ author.name.value }} &rarr;</a>
          {%- endif -%}
        </div>
      </div>
  
  </div>
{%- endif -%}

{% stylesheet %}
  .article-authors { margin-top: 4rem; margin-bottom: 4rem; max-width: 72rem; }
  .article-authors__heading { margin-bottom: 1.6rem; }
  .author-card {
    display: flex; gap: 2rem; align-items: flex-start;
    padding: 2rem; margin-bottom: 1.6rem;
    border: 1px solid rgba(var(--color-foreground), 0.12); border-radius: 1.2rem;
  }
  .author-card__photo { width: 9.6rem; height: 9.6rem; border-radius: 50%; object-fit: cover; display: block; }
  .author-card__body { flex: 1; min-width: 0; }
  .author-card__name { font-size: 1.8rem; font-weight: 600; margin: 0 0 0.4rem; }
  .author-card__name a { color: inherit; text-decoration: none; }
  .author-card__role { margin: 0 0 0.8rem; opacity: 0.7; font-size: 1.4rem; }
  .author-card__bio p { margin: 0 0 0.8rem; }
  .author-social { list-style: none; padding: 0; margin: 0.8rem 0 0; display: flex; flex-wrap: wrap; gap: 1.2rem; font-size: 1.4rem; }
  .author-card__more { display: inline-block; margin-top: 1rem; font-size: 1.4rem; }
  @media screen and (max-width: 749px) {
    .author-card { flex-direction: column; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Article authors",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About the author"
    },
    {
      "type": "checkbox",
      "id": "show_more_link",
      "label": "Show link to author page",
      "default": true
    }
  ],
  "presets": [
    { "name": "Article authors" }
  ]
}
{% endschema %}
