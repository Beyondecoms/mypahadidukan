{%- comment -%}
  Author box for blog posts.
  Uses the theme's own section wrapper (container, color scheme, padding, header)
  so it matches the "Blog posts" / related articles section.
  Reads article.metafields.custom.author — works whether it's a single
  metaobject reference or a list.
{%- endcomment -%}

{%- liquid
  assign author_field = article.metafields.custom.author

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif

  assign classes = 'm-section m-article-authors m-gradient m-color-' | append: section.settings.color_scheme
-%}

{%- if author_field.value != blank -%}
  <style>
    #m-article-authors-{{ section.id }} {
      --section-padding-top: {{ section.settings.padding_top }}px;
      --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    #m-article-authors-{{ section.id }} .m-section__header {
      margin-bottom: 24px;
    }
    #m-article-authors-{{ section.id }} .m-article-authors__list {
      display: grid;
      gap: 20px;
    }
    #m-article-authors-{{ section.id }} .author-card {
      display: flex;
      gap: 24px;
      align-items: flex-start;
      padding: 24px;
      border: 1px solid color-mix(in srgb, currentColor 12%, transparent);
      border-radius: 20px;
    }
    #m-article-authors-{{ section.id }} .author-card__photo {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      object-fit: cover;
      display: block;
      flex-shrink: 0;
    }
    #m-article-authors-{{ section.id }} .author-card__body {
      flex: 1;
      min-width: 0;
    }
    #m-article-authors-{{ section.id }} .author-card__name {
      font-size: 18px;
      font-weight: 600;
      margin: 0 0 4px;
      line-height: 1.3;
    }
    #m-article-authors-{{ section.id }} .author-card__name a {
      color: inherit;
      text-decoration: none;
    }
    #m-article-authors-{{ section.id }} .author-card__role {
      margin: 0 0 10px;
      font-size: 14px;
      opacity: 0.7;
    }
    #m-article-authors-{{ section.id }} .author-card__bio p {
      margin: 0 0 8px;
    }
    #m-article-authors-{{ section.id }} .author-card__more {
      display: inline-block;
      margin-top: 8px;
      font-size: 15px;
      font-weight: 600;
      color: #D97706;
      text-decoration: underline;
      text-underline-offset: 4px;
    }
    @media screen and (max-width: 767px) {
      #m-article-authors-{{ section.id }} .author-card {
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 20px;
      }
    }
  </style>

  <section
    id="m-article-authors-{{ section.id }}"
    class="{{ classes }}"
    data-section-id="{{ section.id }}"
  >
    <div class="{{ container }} m-section-my m-section-py">
      {%- if section.settings.heading != blank -%}
        {% render 'index-section-header',
          section_settings: section.settings,
          show_button_on_header: false
        %}
      {%- endif -%}

      <div class="m-article-authors__list">
        {%- if author_field.type contains 'list' -%}
          {%- for author in author_field.value -%}
            {% render 'author-card-custom', author: author, show_link: section.settings.show_more_link %}
          {%- endfor -%}
        {%- else -%}
          {% render 'author-card-custom', author: author_field.value, show_link: section.settings.show_more_link %}
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Article authors",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About the author"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h3",
      "options": [
        { "label": "Medium", "value": "h3" },
        { "label": "Large", "value": "h2" }
      ]
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Text alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container-fluid",
      "options": [
        { "value": "container-fluid", "label": "Default" },
        { "value": "w-full", "label": "Full width" },
        { "value": "container", "label": "Use container box" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "checkbox",
      "id": "show_more_link",
      "label": "Show link to author page",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    }
  ],
  "presets": [
    { "name": "Article authors", "category": "Blog" }
  ]
}
{% endschema %}
