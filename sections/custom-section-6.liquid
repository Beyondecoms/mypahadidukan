{%- liquid
  assign heading = section.settings.heading
  assign heading_color = section.settings.heading_color | default: '#1F2937'
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign card_bg = section.settings.card_bg | default: '#E2E8F0'
  assign label_color = section.settings.label_color | default: '#111827'
  assign show_arrows = section.settings.show_arrows
  assign desktop_cards = section.settings.desktop_cards | default: 6
  assign mobile_cards = section.settings.mobile_cards | default: 2
  assign card_gap = section.settings.card_gap | default: 16
  assign card_radius = section.settings.card_radius | default: 22
  assign padding_top = section.settings.padding_top | default: 48
  assign padding_bottom = section.settings.padding_bottom | default: 48
-%}

<div
  id="custom-section-6-{{ section.id }}"
  class="custom-section-6"
  style="
    --cs6-bg: {{ bg_color }};
    --cs6-heading-color: {{ heading_color }};
    --cs6-card-bg: {{ card_bg }};
    --cs6-label-color: {{ label_color }};
    --cs6-cards-desktop: {{ desktop_cards }};
    --cs6-cards-mobile: {{ mobile_cards }};
    --cs6-gap: {{ card_gap }}px;
    --cs6-card-radius: {{ card_radius }}px;
    --cs6-pt: {{ padding_top }}px;
    --cs6-pb: {{ padding_bottom }}px;
  "
>
  <div class="custom-section-6__container">
    {%- if heading != blank -%}
      <div class="custom-section-6__header">
        <h2 class="custom-section-6__heading">{{ heading }}</h2>
      </div>
    {%- endif -%}

    <div class="custom-section-6__carousel-wrapper" data-carousel-wrapper>
      {%- if show_arrows and section.blocks.size > 0 -%}
        <button
          type="button"
          class="custom-section-6__arrow custom-section-6__arrow--prev"
          aria-label="Previous items"
          data-arrow="prev"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
      {%- endif -%}

      <div class="custom-section-6__track" data-carousel-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_image = block.settings.image
            assign block_image_url = block.settings.image_by_url
            assign block_title = block.settings.title
            assign raw_link = block.settings.link

            if block_title != blank
              assign search_query = block_title | url_encode
              assign search_link = '/search?type=product&q=' | append: search_query
            else
              assign search_link = ''
            endif

            if raw_link == blank or raw_link contains '/products/' or raw_link contains '/collections/all/'
              assign block_link = search_link
            else
              assign block_link = raw_link
            endif
          -%}

          <div class="custom-section-6__item" {{ block.shopify_attributes }}>
            {%- if block_link != blank -%}
              <a href="{{ block_link }}" class="custom-section-6__card" aria-label="{{ block_title | default: 'Spotlight Item' | escape }}">
            {%- else -%}
              <div class="custom-section-6__card">
            {%- endif -%}

              <div class="custom-section-6__media-box">
                {%- if block_image_url != blank -%}
                  <img
                    src="{{ block_image_url }}"
                    loading="lazy"
                    class="custom-section-6__image"
                    alt="{{ block_title | default: 'Spotlight Product' | escape }}"
                  >
                {%- elsif block_image != blank -%}
                  {{
                    block_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      class: 'custom-section-6__image',
                      widths: '400, 600, 800, 1000, 1200',
                      sizes: '(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 250px',
                      alt: block_title | default: block_image.alt | default: 'Spotlight Product'
                  }}
                {%- else -%}
                  <div class="custom-section-6__placeholder">
                    {{ 'product-1' | placeholder_svg_tag: 'custom-section-6__placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>

              {%- if block_title != blank -%}
                <div class="custom-section-6__label-box">
                  <span class="custom-section-6__label">{{ block_title }}</span>
                </div>
              {%- endif -%}

            {%- if block_link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          {%- assign default_labels = 'Juice,Dried Fruits,Oils,Juice,Dried Fruits,Teas' | split: ',' -%}
          {%- for label in default_labels -%}
            <div class="custom-section-6__item">
              <a href="/search?type=product&q={{ label | url_encode }}" class="custom-section-6__card" aria-label="{{ label | escape }}">
                <div class="custom-section-6__media-box">
                  <div class="custom-section-6__placeholder">
                    {{ 'product-1' | placeholder_svg_tag: 'custom-section-6__placeholder-svg' }}
                  </div>
                </div>
                <div class="custom-section-6__label-box">
                  <span class="custom-section-6__label">{{ label }}</span>
                </div>
              </a>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>

      {%- if show_arrows and section.blocks.size > 0 -%}
        <button
          type="button"
          class="custom-section-6__arrow custom-section-6__arrow--next"
          aria-label="Next items"
          data-arrow="next"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  #custom-section-6-{{ section.id }} {
    background-color: var(--cs6-bg);
    padding-top: var(--cs6-pt);
    padding-bottom: var(--cs6-pb);
    width: 100%;
    position: relative;
    box-sizing: border-box;
    font-family: inherit;
  }


@media only screen and (max-width: 749px){
   #custom-section-6-{{ section.id }}{
   padding-top: 20px;
   padding-bottom: 20px;
   }
 }


  

  #custom-section-6-{{ section.id }} * {
    box-sizing: border-box;
  }

  #custom-section-6-{{ section.id }} .custom-section-6__container {
    width: 100%;
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
  }

  #custom-section-6-{{ section.id }} .custom-section-6__header {
    text-align: center;
    /* margin-bottom: 28px; */
  }

  #custom-section-6-{{ section.id }} .custom-section-6__heading {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    color: var(--cs6-heading-color);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  #custom-section-6-{{ section.id }} .custom-section-6__carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  #custom-section-6-{{ section.id }} .custom-section-6__track {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--cs6-gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 4px 14px 4px;
    width: 100%;
    scroll-behavior: smooth;
  }

  #custom-section-6-{{ section.id }} .custom-section-6__track::-webkit-scrollbar {
    display: none;
  }

  #custom-section-6-{{ section.id }} .custom-section-6__item {
    flex: 0 0 calc((100% - (var(--cs6-cards-desktop) - 1) * var(--cs6-gap)) / var(--cs6-cards-desktop));
    min-width: 0;
    scroll-snap-align: start;
    display: flex;
  }

  #custom-section-6-{{ section.id }} .custom-section-6__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-radius: var(--cs6-card-radius);
    /* background: linear-gradient(180deg, #F8FAFC 0%, #EBF0F5 50%, var(--cs6-card-bg) 100%); */
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    position: relative;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  #custom-section-6-{{ section.id }} .custom-section-6__card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.1);
  }

  #custom-section-6-{{ section.id }} .custom-section-6__media-box {
    width: 100%;
    aspect-ratio: 1 / 0.9;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px 16px 4px 16px;
  }

  #custom-section-6-{{ section.id }} .custom-section-6__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    display: block;
    transition: transform 0.32s ease;
    image-rendering: -webkit-optimize-contrast;
  }

  #custom-section-6-{{ section.id }} .custom-section-6__card:hover .custom-section-6__image {
    transform: scale(1.04);
  }

  #custom-section-6-{{ section.id }} .custom-section-6__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.35;
  }

  #custom-section-6-{{ section.id }} .custom-section-6__placeholder-svg {
    width: 50%;
    height: 50%;
  }

  #custom-section-6-{{ section.id }} .custom-section-6__label-box {
    width: 100%;
    padding: 8px 8px 12px 8px;
    text-align: center;
    margin-top: auto;
  }

  #custom-section-6-{{ section.id }} .custom-section-6__label {
    font-size: 15px;
    font-weight: 700;
    color: var(--cs6-label-color);
    line-height: 1.25;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #custom-section-6-{{ section.id }} .custom-section-6__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #FFFFFF;
    border: none;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1F2937;
    cursor: pointer;
    z-index: 10;
    transition: transform 0.2s ease, opacity 0.2s ease, box-shadow 0.2s ease;
    padding: 0;
  }

  #custom-section-6-{{ section.id }} .custom-section-6__arrow:hover:not(:disabled) {
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
  }

  #custom-section-6-{{ section.id }} .custom-section-6__arrow:disabled {
    opacity: 0.25;
    cursor: not-allowed;
    pointer-events: none;
  }

  #custom-section-6-{{ section.id }} .custom-section-6__arrow--prev {
    left: 4px;
  }

  #custom-section-6-{{ section.id }} .custom-section-6__arrow--next {
    right: 4px;
  }

  @media (max-width: 1200px) {
    #custom-section-6-{{ section.id }} .custom-section-6__item {
      flex: 0 0 calc((100% - 4 * var(--cs6-gap)) / 5);
    }
  }

  @media (max-width: 991px) {
    #custom-section-6-{{ section.id }} .custom-section-6__container {
      padding: 0 16px;
    }
    #custom-section-6-{{ section.id }} .custom-section-6__item {
      flex: 0 0 calc((100% - 2.5 * var(--cs6-gap)) / 3.4);
    }
    #custom-section-6-{{ section.id }} .custom-section-6__heading {
      font-size: 21px;
    }
  }

  @media (max-width: 767px) {
    #custom-section-6-{{ section.id }} .custom-section-6__container {
      padding: 0 12px;
    }
    #custom-section-6-{{ section.id }} .custom-section-6__header {
      /* margin-bottom: 18px; */
    }
    #custom-section-6-{{ section.id }} .custom-section-6__heading {
      font-size: 18px;
    }
    #custom-section-6-{{ section.id }} .custom-section-6__item {
      flex: 0 0 calc((100% - (var(--cs6-cards-mobile) - 0.2) * var(--cs6-gap)) / var(--cs6-cards-mobile));
    }
    #custom-section-6-{{ section.id }} .custom-section-6__arrow {
      width: 30px;
      height: 30px;
    }
    #custom-section-6-{{ section.id }} .custom-section-6__arrow--prev {
      left: 0px;
    }
    #custom-section-6-{{ section.id }} .custom-section-6__arrow--next {
      right: 0px;
    }
    #custom-section-6-{{ section.id }} .custom-section-6__label {
      font-size: 13px;
    }
  }
</style>

<script>
  (function () {
    function initSpotlightCarousel() {
      var section = document.getElementById('custom-section-6-{{ section.id }}');
      if (!section) return;

      var track = section.querySelector('[data-carousel-track]');
      var prevBtn = section.querySelector('[data-arrow="prev"]');
      var nextBtn = section.querySelector('[data-arrow="next"]');

      if (!track) return;

      function updateArrows() {
        if (!prevBtn || !nextBtn) return;
        var maxScrollLeft = track.scrollWidth - track.clientWidth;
        prevBtn.disabled = track.scrollLeft <= 4;
        nextBtn.disabled = track.scrollLeft >= maxScrollLeft - 4;
      }

      function scrollTrack(direction) {
        var card = track.querySelector('.custom-section-6__item');
        if (!card) return;
        var cardWidth = card.getBoundingClientRect().width;
        var gap = parseFloat(getComputedStyle(track).gap) || 16;
        var scrollAmount = (cardWidth + gap) * 2;
        if (direction === 'prev') {
          track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        } else {
          track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          scrollTrack('prev');
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          scrollTrack('next');
        });
      }

      track.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows, { passive: true });
      setTimeout(updateArrows, 100);
      updateArrows();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSpotlightCarousel);
    } else {
      initSpotlightCarousel();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target.id === 'shopify-section-{{ section.id }}' || e.target.querySelector('#custom-section-6-{{ section.id }}')) {
        initSpotlightCarousel();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Spotlight (Section 6)",
  "tag": "section",
  "class": "custom-section-6-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This Season Spotlight"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1F2937"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card base color",
      "default": "#CFD8E2"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label text color",
      "default": "#111827"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_cards",
      "min": 4,
      "max": 10,
      "step": 1,
      "label": "Cards per row on desktop",
      "default": 6
    },
    {
      "type": "range",
      "id": "mobile_cards",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Cards per row on mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 8,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "spotlight_item",
      "name": "Spotlight Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        },
        {
          "type": "text",
          "id": "image_by_url",
          "label": "Product image by URL (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label text",
          "default": "Juice"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "This Season Spotlight (Section 6)",
      "blocks": [
        {
          "type": "spotlight_item",
          "settings": {
            "title": "Juice"
          }
        },
        {
          "type": "spotlight_item",
          "settings": {
            "title": "Dried Fruits"
          }
        },
        {
          "type": "spotlight_item",
          "settings": {
            "title": "Oils"
          }
        },
        {
          "type": "spotlight_item",
          "settings": {
            "title": "Juice"
          }
        },
        {
          "type": "spotlight_item",
          "settings": {
            "title": "Dried Fruits"
          }
        },
        {
          "type": "spotlight_item",
          "settings": {
            "title": "Teas"
          }
        }
      ]
    }
  ]
}
{% endschema %}
