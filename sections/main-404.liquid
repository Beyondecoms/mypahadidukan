{%- comment -%}
  404 hero: "Return to sender" message, CTAs and the postage-stamp illustration.
  The rest of the 404 page reuses existing sections (see templates/404.json):
  collection-circles, product-slider and faq-home. Page-level spacing for those
  lives at the bottom of section-main-404.css.
{%- endcomment -%}
{{ 'section-main-404.css' | asset_url | stylesheet_tag }}
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Archivo:wght@800&family=Caveat:wght@500;600&display=swap"
>

{%- liquid
  assign primary_link = section.settings.primary_link | default: routes.root_url
  assign secondary_link = section.settings.secondary_link | default: routes.all_products_collection_url
-%}

<style>
  #shopify-section-{{ section.id }} {
    --nf-bg: {{ section.settings.bg_color }};
    --nf-panel: {{ section.settings.panel_color }};
    --nf-accent: {{ section.settings.accent_color }};
    --nf-accent-hover: {{ section.settings.accent_hover_color }};
    --nf-wave: {{ section.settings.wave_color }};
  }
</style>

<div class="nf-hero">
  <div class="nf-hero__inner">
    <div class="nf-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nf-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h1 class="nf-hero__title">{{ section.settings.heading }}</h1>

      {%- if section.settings.text != blank -%}
        <p class="nf-hero__text">{{ section.settings.text }}</p>
      {%- endif -%}

      <div class="nf-hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ primary_link }}" class="nf-btn nf-btn--primary">{{ section.settings.primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ secondary_link }}" class="nf-btn nf-btn--ghost">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.note != blank -%}
        <p class="nf-hero__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>

    <div class="nf-hero__visual">
      <div class="nf-stamp">
        {% render 'icon-404-stamp', stamp_color: section.settings.stamp_color %}
      </div>
    </div>
  </div>

  {%- if section.settings.show_wave -%}
    <svg class="nf-hero__wave" width="100%" height="22" aria-hidden="true" focusable="false">
      <defs>
        <pattern id="nf-wave-{{ section.id }}" width="80" height="22" patternUnits="userSpaceOnUse">
          <path class="nf-hero__wave-fill" d="M0,22 V10 Q20,-2 40,10 T80,10 V22 Z"/>
        </pattern>
      </defs>
      <rect width="100%" height="22" fill="url(#nf-wave-{{ section.id }})"/>
    </svg>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "404 Hero",
  "tag": "section",
  "class": "nf-hero-outer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Handwritten eyebrow",
      "default": "Return to sender!"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We couldn't deliver this page to you."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "It seems to have wandered off the trail somewhere in the mountains. The link may be old, or the address may have a typo. Let's get you back to the village."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Back to home"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link",
      "info": "Defaults to the home page"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Shop all products"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Handwritten note",
      "default": "Psst... our bestsellers are right below."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FCF0BE"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Illustration panel",
      "default": "#F4E1C6"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (eyebrow and primary button)",
      "default": "#347F6C"
    },
    {
      "type": "color",
      "id": "accent_hover_color",
      "label": "Primary button hover",
      "default": "#285F51"
    },
    {
      "type": "color",
      "id": "stamp_color",
      "label": "Stamp border",
      "default": "#347F6C"
    },
    {
      "type": "checkbox",
      "id": "show_wave",
      "label": "Show wave divider",
      "default": true
    },
    {
      "type": "color",
      "id": "wave_color",
      "label": "Wave divider",
      "info": "Match the background of the next section",
      "default": "#FFFBF0"
    }
  ]
}
{% endschema %}
