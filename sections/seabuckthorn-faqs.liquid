{{ 'section-seabuckthorn-m11.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign m11_questions = product.metafields.custom.m11_questions.value
  assign m11_answers = product.metafields.custom.m11_answers.value

  assign has_content = false
  if m11_questions != blank and m11_questions.size > 0
    assign has_content = true
  endif
-%}

{%- if has_content -%}
<div class="sb-m11-section" style="background-color: {{ section.settings.bg_color | default: '#fffbef' }};">
  <div class="sb-m11-container">
    
    <!-- Top Meta Row -->
    {%- if section.settings.module_tag != blank or section.settings.design_tag != blank -%}
      <div class="sb-m11-top-bar">
        {%- if section.settings.module_tag != blank -%}
          <span class="sb-m11-module-badge">{{ section.settings.module_tag }}</span>
        {%- endif -%}
        {%- if section.settings.design_tag != blank -%}
          <span class="sb-m11-pill-badge" style="background-color: {{ section.settings.badge_bg }}; color: {{ section.settings.badge_color }};">{{ section.settings.design_tag }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Header Section -->
    {%- if section.settings.heading != blank -%}
      <div class="sb-m11-header">
        <h2 class="sb-m11-title" style="color: {{ section.settings.heading_color | default: '#1c1918' }};">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <!-- Accordion List -->
    <div class="sb-m11-faq-list">
      {%- for question in m11_questions -%}
        {%- assign answer = m11_answers[forloop.index0] -%}
        {%- if question != blank and answer != blank -%}
          <div class="sb-m11-faq-item {% if forloop.first %}active{% endif %}">
            <button class="sb-m11-faq-question" type="button" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
              <span>{{ question }}</span>
              <span class="sb-m11-faq-icon">+</span>
            </button>
            <div class="sb-m11-faq-answer">
              <p>{{ answer | newline_to_br }}</p>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</div>

<script>
(function() {
  const initFaqAccordion = () => {
    const section = document.querySelector('.sb-m11-section');
    if (!section) return;
    const items = section.querySelectorAll('.sb-m11-faq-item');
    items.forEach(item => {
      const btn = item.querySelector('.sb-m11-faq-question');
      if (!btn || btn.dataset.bound) return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const isOpen = item.classList.contains('active');
        items.forEach(i => {
          i.classList.remove('active');
          const b = i.querySelector('.sb-m11-faq-question');
          if (b) b.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('active');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaqAccordion);
  } else {
    initFaqAccordion();
  }
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "M11 - FAQs",
  "tag": "section",
  "class": "section-sb-m11",
  "settings": [
    {
      "type": "paragraph",
      "content": "Content is dynamically loaded from product metafields (custom.m11_questions & custom.m11_answers). If empty, the section will not be shown."
    },
    {
      "type": "text",
      "id": "module_tag",
      "label": "Module Tag",
      "default": "M11 · Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "design_tag",
      "label": "Design Tag",
      "default": "Clear Answers"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge Background",
      "default": "#008b75"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1c1918"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fffbef"
    }
  ],
  "presets": [
    {
      "name": "M11 - FAQs"
    }
  ]
}
{% endschema %}
