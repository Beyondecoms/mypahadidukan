{{ 'section-seabuckthorn-m11.css' | asset_url | stylesheet_tag }}

<div class="sb-m11-section" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="sb-m11-container">
    
    <!-- Top Meta Row -->
    <div class="sb-m11-top-bar">
      <span class="sb-m11-module-badge">{{ section.settings.module_tag }}</span>
      {%- if section.settings.design_tag != blank -%}
        <span class="sb-m11-pill-badge" style="background-color: {{ section.settings.badge_bg }}; color: {{ section.settings.badge_color }};">{{ section.settings.design_tag }}</span>
      {%- endif -%}
    </div>

    <!-- Header Section -->
    <div class="sb-m11-header">
      <h2 class="sb-m11-title" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
    </div>

    <!-- Accordion List -->
    <div class="sb-m11-faq-list">
      {%- for block in section.blocks -%}
        <div class="sb-m11-faq-item {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }}>
          <button class="sb-m11-faq-question" type="button" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
            <span>{{ block.settings.question }}</span>
            <span class="sb-m11-faq-icon">+</span>
          </button>
          <div class="sb-m11-faq-answer">
            <p>{{ block.settings.answer }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

<script>
(function() {
  const items = document.querySelectorAll('.sb-m11-faq-item');
  items.forEach(item => {
    const btn = item.querySelector('.sb-m11-faq-question');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const isOpen = item.classList.contains('active');
      items.forEach(i => {
        i.classList.remove('active');
        const b = i.querySelector('.sb-m11-faq-question');
        if (b) b.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('active');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
})();
</script>

{% schema %}
{
  "name": "M11 - Go on, ask (FAQs)",
  "tag": "section",
  "class": "section-sb-m11",
  "settings": [
    {
      "type": "text",
      "id": "module_tag",
      "label": "Module Tag",
      "default": "M11 · Go on, ask"
    },
    {
      "type": "text",
      "id": "design_tag",
      "label": "Design Badge",
      "default": "copy-led"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fffbef"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1c1918"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Pill Badge BG",
      "default": "#008b75"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Pill Badge Text Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Why is it so sour? Is my bottle off?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "It's meant to taste like that. Sea buckthorn is a sharp, tart berry to begin with, and there's no sugar in this bottle to round it off. Most people mix a spoon into warm water and add a little honey the first few times."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "M11 - Go on, ask (FAQs)",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Why is it so sour? Is my bottle off?",
            "answer": "It's meant to taste like that. Sea buckthorn is a sharp, tart berry to begin with, and there's no sugar in this bottle to round it off. Most people mix a spoon into warm water and add a little honey the first few times."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Is this a juice I can just drink?",
            "answer": "No, it's thick pulp, and drinking it straight is a bit much. One tablespoon (10 ml) goes into a glass of water. A 300 ml bottle makes about 30 glasses."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "There's stuff settled at the bottom. Is that normal?",
            "answer": "Completely. Whole pressed berry separates when it sits, and you'll sometimes find a fragment of seed in there. Give it a shake before you pour."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Why is there a preservative if it's pure?",
            "answer": "Because pressed berry with nothing in it keeps for about a week. The bottle is 99.99% sea buckthorn pulp and 0.01% E211, a permitted Class 2 preservative. That's the whole ingredient list."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How do I know it's really from Ladakh?",
            "answer": "Ladakh sea buckthorn carries a GI tag of its own, granted in 2023 - a government confirmation of origin rather than a claim we're making. Ours is wild-harvested from high altitude in Ladakh and Spiti, and every batch is lab-tested with the report published on this page."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How much vitamin C is actually in it?",
            "answer": "322 mg per 100 ml, tested. A 10 ml serving works out to roughly half an adult's recommended daily intake."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What's the difference between the pulp and the oil?",
            "answer": "The pulp is pressed from the whole berry and carries the vitamin C. The oil is extracted from the seed or the pulp and concentrates the fatty acids instead. Different products, different jobs."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How long does it last?",
            "answer": "Unopened, check the date on the bottle. Once opened, refrigerate and finish within four weeks."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can everyone drink this?",
            "answer": "It's a food, not a supplement or a treatment, and we're not going to pretend otherwise. Anyone with a vitamin C allergy should skip it. If you're pregnant, breastfeeding or on medication, have a word with your doctor first."
          }
        }
      ]
    }
  ]
}
{% endschema %}
