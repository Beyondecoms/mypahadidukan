{{ 'section-seabuckthorn-m8.css' | asset_url | stylesheet_tag }}

<div class="sb-m8-section" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="sb-m8-container">
    
    <!-- Top Meta Row -->
    <div class="sb-m8-top-bar">
      <span class="sb-m8-module-badge">{{ section.settings.module_tag }}</span>
      {%- if section.settings.design_tag != blank -%}
        <span class="sb-m8-pill-badge" style="background-color: {{ section.settings.badge_bg }}; color: {{ section.settings.badge_color }};">{{ section.settings.design_tag }}</span>
      {%- endif -%}
    </div>

    <!-- Main Card Box -->
    <div class="sb-m8-card-wrapper">
      <div class="sb-m8-header">
        <h2 class="sb-m8-title">{{ section.settings.heading }}</h2>
      </div>

      <div class="sb-m8-body">
        <p>{{ section.settings.description }}</p>
      </div>

      <!-- Cross Badges Row -->
      <div class="sb-m8-cross-list">
        <div class="sb-m8-cross-item"><span>✕</span> Dilution</div>
        <div class="sb-m8-cross-item"><span>✕</span> Added sugar</div>
        <div class="sb-m8-cross-item"><span>✕</span> Contamination</div>
      </div>

      <!-- CTA Button -->
      {%- if section.settings.report_url != blank -%}
        <a href="{{ section.settings.report_url }}" class="sb-m8-cta-btn" target="_blank" rel="noopener">
          {{ section.settings.btn_label }} →
        </a>
      {%- else -%}
        <a href="#lab-report" class="sb-m8-cta-btn">
          {{ section.settings.btn_label }} →
        </a>
      {%- endif -%}

    </div>

  </div>
</div>

{% schema %}
{
  "name": "M8 - Every batch tested",
  "tag": "section",
  "class": "section-sb-m8",
  "settings": [
    {
      "type": "text",
      "id": "module_tag",
      "label": "Module Tag",
      "default": "M8 · Every batch tested. Report published."
    },
    {
      "type": "text",
      "id": "design_tag",
      "label": "Design Badge",
      "default": "proof"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "EVERY BATCH TESTED. REPORT PUBLISHED."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every batch is tested at an NABL-accredited lab before it goes on sale - before listing, not after complaints."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Read the latest batch report"
    },
    {
      "type": "url",
      "id": "report_url",
      "label": "Batch Report URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fffbef"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Pill Badge BG",
      "default": "#008b75"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Pill Badge Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "M8 - Every batch tested"
    }
  ]
}
{% endschema %}
