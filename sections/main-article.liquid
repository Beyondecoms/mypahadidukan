{% render 'article-redirect',
  article: article,
  blog: blog,
  search_blogs: section.settings.related_blogs
%}

{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}
{{ 'card-product.css' | asset_url | stylesheet_tag }}
{{ 'section-product-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  # ─────────────────────────────────────────────────────
  # 1. BLOG CATEGORY — existing: custom.blog_category (single line text)
  # ─────────────────────────────────────────────────────
  assign blog_category_raw = article.metafields.custom.blog_category
  assign blog_category = blog_category_raw.value | default: blog_category_raw
  if blog_category == blank
    assign blog_category = article.tags.first | default: blog.title
  endif

  # ── Client Category Normalization ──
  # Info -> Product guides | Travel -> Origins | Health and Wellness -> Use & care | Recipes
  assign cat_check = blog_category | downcase | strip
  if cat_check == 'info'
    assign blog_category = 'Product guides'
  elsif cat_check == 'travel'
    assign blog_category = 'Origins'
  elsif cat_check == 'health and wellness' or cat_check == 'health & wellness' or cat_check == 'wellness'
    assign blog_category = 'Use & care'
  endif

  # ─────────────────────────────────────────────────────
  # 2. AUTHOR — existing: custom.author (metaobject)
  # ─────────────────────────────────────────────────────
  assign author_obj = article.metafields.custom.author.value
  assign author_name = ''
  if author_obj != blank
    assign author_name = author_obj.name | default: author_obj.title | default: author_obj.author_name
    assign author_photo = author_obj.photo | default: author_obj.image | default: author_obj.author_image | default: author_obj.avatar
    assign author_bio = author_obj.bio | default: author_obj.description | default: author_obj.about | default: author_obj.author_bio
    assign author_designation = author_obj.designation | default: author_obj.role | default: author_obj.position | default: author_obj.job_title
    assign author_profile_url = author_obj.profile_url | default: author_obj.link | default: author_obj.url | default: author_obj.website
  endif
  if author_name == blank
    assign author_name = article.author
    assign author_photo = blank
    assign author_bio = blank
    assign author_designation = blank
    assign author_profile_url = blank
  endif

  # ─────────────────────────────────────────────────────
  # 3. BLOG TAGS — existing: custom.blog_tags
  # Can be list/array of strings or comma-separated/JSON string
  # ─────────────────────────────────────────────────────
  assign blog_tags_raw = article.metafields.custom.blog_tags
  assign blog_tags_val = blog_tags_raw.value | default: blog_tags_raw
  assign blog_tags_list = blank
  if blog_tags_raw.value != blank and blog_tags_raw.value.first != blank
    assign blog_tags_list = blog_tags_raw.value
  elsif blog_tags_val != blank
    assign blog_tags_clean_str = blog_tags_val | remove: '[' | remove: ']' | remove: '"' | remove: "'" | remove: '\"'
    assign blog_tags_list = blog_tags_clean_str | split: ','
  endif

  # ─────────────────────────────────────────────────────
  # 4. BLOG PRODUCTS — existing: custom.blog_products (product reference)
  # Can be single or list of product references
  # ─────────────────────────────────────────────────────
  assign blog_products_raw = article.metafields.custom.blog_products
  assign blog_products = blog_products_raw.value
  # Normalize: if it's a single object not an array, wrap it
  assign blog_products_type = blog_products_raw.type

  # ─────────────────────────────────────────────────────
  # 5. FAQS — existing: custom.faqs (metaobject list)
  # ─────────────────────────────────────────────────────
  assign blog_faqs_raw = article.metafields.custom.faqs
  assign blog_faqs = blog_faqs_raw.value | default: blog_faqs_raw

  # ─────────────────────────────────────────────────────
  # 6. RELATED ARTICLES — custom.related_articles + topic matching, see snippets/article-related-articles.liquid
  # ─────────────────────────────────────────────────────

  # ─────────────────────────────────────────────────────
  # 7. READING TIME — NEW: custom.reading_time (single line text)
  # Falls back to calculated estimate
  # ─────────────────────────────────────────────────────
  assign reading_time_manual = article.metafields.custom.reading_time.value | default: article.metafields.custom.reading_time
  if reading_time_manual != blank
    assign reading_time_display = reading_time_manual
  else
    assign word_count = article.content | strip_html | split: ' ' | size
    assign calc_reading_time = word_count | divided_by: 200
    if calc_reading_time < 1
      assign calc_reading_time = 1
    endif
    assign reading_time_display = calc_reading_time | append: ' min read'
  endif

  # ─────────────────────────────────────────────────────
  # 8. ARTICLE INTRO — NEW: custom.article_intro (multi-line text)
  # Shown below meta, above featured image
  # ─────────────────────────────────────────────────────
  assign article_intro_raw = article.metafields.custom.article_intro
  assign article_intro = article_intro_raw.value | default: article_intro_raw
  # Also use Shopify's built-in excerpt as a fallback
  if article_intro == blank and article.excerpt != blank
    assign article_intro = article.excerpt
  endif

  # ─────────────────────────────────────────────────────
  # 9. FEATURED PRODUCT — NEW: custom.featured_product (product reference)
  # Single product shown in-article as premium card
  # ─────────────────────────────────────────────────────
  assign featured_product = article.metafields.custom.featured_product.value | default: article.metafields.custom.featured_product

  # ─────────────────────────────────────────────────────
  # 10. CTA FIELDS — NEW: custom.cta_title, cta_description, cta_button_text, cta_link
  # ─────────────────────────────────────────────────────
  assign cta_title = article.metafields.custom.cta_title.value | default: article.metafields.custom.cta_title
  assign cta_description = article.metafields.custom.cta_description.value | default: article.metafields.custom.cta_description
  assign cta_button_text = article.metafields.custom.cta_button_text.value | default: article.metafields.custom.cta_button_text
  assign cta_link = article.metafields.custom.cta_link.value | default: article.metafields.custom.cta_link
  # Determine if any CTA content exists
  assign has_cta = false
  if cta_title != blank or cta_description != blank
    assign has_cta = true
  endif
  if cta_button_text == blank
    assign cta_button_text = 'Explore Products'
  endif
  if cta_link == blank
    assign cta_link = '/collections/all'
  endif
-%}

<article class="article-page" itemscope itemtype="https://schema.org/BlogPosting">
  
  <!-- Reading Progress Bar -->
  <div class="article-progress-bar" id="articleProgressBar" aria-hidden="true">
    <div class="article-progress-bar__fill"></div>
  </div>

  <div class="article-page__container">

    <!-- ── BREADCRUMB + BACK LINK ── -->
    <div class="article-top-nav">
      <nav class="article-breadcrumb" aria-label="Breadcrumb">
        <ol class="article-breadcrumb__list">
          <li class="article-breadcrumb__item"><a href="{{ routes.root_url }}">Home</a></li>
          <li class="article-breadcrumb__separator" aria-hidden="true">/</li>
          <li class="article-breadcrumb__item"><a href="{{ blog.url }}">{{ blog.title }}</a></li>
          {%- if blog_category != blank and blog_category != blog.title -%}
            <li class="article-breadcrumb__separator" aria-hidden="true">/</li>
            <li class="article-breadcrumb__item">
              <span class="article-breadcrumb__cat">{{ blog_category }}</span>
            </li>
          {%- endif -%}
          <li class="article-breadcrumb__separator" aria-hidden="true">/</li>
          <li class="article-breadcrumb__item article-breadcrumb__item--current" aria-current="page">
            <span>{{ article.title }}</span>
          </li>
        </ol>
      </nav>

      <a href="{{ blog.url }}" class="article-back-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Back to {{ blog.title | default: 'Blog' }}</span>
      </a>
    </div>

    <!-- ── ARTICLE HERO ── -->
    <header class="article-hero">

      <!-- Category Badge -->
      {%- if blog_category != blank -%}
        <div class="article-hero__category">
          <span class="article-badge">
            {%- assign cat_icon_check = blog_category | downcase | strip -%}
            {%- if cat_icon_check == 'product guides' or cat_icon_check == 'info' -%}
              <!-- Product guides: Magnifier over jar / inspection icon -->
              <svg class="article-badge__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 3h12l-1 4H7L6 3z"></path>
                <path d="M6 7v11a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V7"></path>
                <circle cx="11" cy="14" r="2.5"></circle>
                <line x1="13" y1="16" x2="16" y2="19"></line>
              </svg>
            {%- elsif cat_icon_check == 'origins' or cat_icon_check == 'travel' -%}
              <!-- Origins: Mountain icon -->
              <svg class="article-badge__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m8 3 4 8 5-5 5 15H2L8 3z"></path>
              </svg>
            {%- elsif cat_icon_check == 'use & care' or cat_icon_check == 'health and wellness' or cat_icon_check == 'wellness' -%}
              <!-- Use & care: Spoon and jar / wellness hands icon -->
              <svg class="article-badge__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 2a2 2 0 0 0-2 2v4a3 3 0 0 0 3 3h1v9a2 2 0 1 0 4 0V2H7z"></path>
                <path d="M15 8h4a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-4"></path>
              </svg>
            {%- elsif cat_icon_check == 'recipes' or cat_icon_check == 'recipe' -%}
              <!-- Recipes: Recipe card icon -->
              <svg class="article-badge__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
                <path d="M6 6h10"></path>
                <path d="M6 10h10"></path>
                <path d="M6 14h6"></path>
              </svg>
            {%- else -%}
              <svg class="article-badge__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m8 3 4 8 5-5 5 15H2L8 3z"></path>
              </svg>
            {%- endif -%}
            <span>{{ blog_category }}</span>
          </span>
        </div>
      {%- endif -%}

      <!-- H1 Article Title -->
      <h1 class="article-hero__title" itemprop="headline">{{ article.title | escape }}</h1>

      <!-- Author / Date / Reading Time -->
      <div class="article-hero__meta">
        {%- if author_name != blank -%}
          <div class="article-hero__author" itemprop="author" itemscope itemtype="https://schema.org/Person">
            {%- if author_photo != blank -%}
              <img
                src="{{ author_photo | image_url: width: 80, height: 80, crop: 'center' }}"
                alt="{{ author_name | escape }}"
                class="article-hero__author-avatar"
                width="44"
                height="44"
                loading="eager"
              >
            {%- else -%}
              <span class="article-hero__author-initial" aria-hidden="true">
                {{ author_name | slice: 0, 1 | upcase }}
              </span>
            {%- endif -%}
            <span class="article-hero__author-name" itemprop="name">{{ author_name }}</span>
          </div>
          <span class="article-hero__meta-dot" aria-hidden="true">&bull;</span>
        {%- endif -%}

        <time class="article-hero__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}" itemprop="datePublished">
          {{ article.published_at | date: '%B %d, %Y' }}
        </time>

        {%- if reading_time_display != blank -%}
          <span class="article-hero__meta-dot" aria-hidden="true">&bull;</span>
          <span class="article-hero__reading-time">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {{ reading_time_display }}
          </span>
        {%- endif -%}
      </div>

      <!-- Article Intro (custom.article_intro / excerpt fallback) -->
      {%- if article_intro != blank -%}
        <div class="article-intro" itemprop="description">
          {%- if article_intro contains '<' -%}
            {{ article_intro }}
          {%- else -%}
            <p>{{ article_intro }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <!-- Blog Tags (custom.blog_tags) -->
      {%- if blog_tags_list != blank and blog_tags_list.size > 0 -%}
        <div class="article-tags">
          {%- for tag in blog_tags_list -%}
            {%- assign tag_clean = tag | remove: '[' | remove: ']' | remove: '"' | remove: "'" | remove: '\"' | strip -%}
            {%- if tag_clean != blank -%}
              <a href="{{ routes.search_url }}?q={{ tag_clean | url_encode }}&type=article" class="article-tag">{{ tag_clean }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- elsif article.tags.size > 0 -%}
        <div class="article-tags">
          {%- for tag in article.tags -%}
            {%- assign tag_clean = tag | remove: '[' | remove: ']' | remove: '"' | remove: "'" | remove: '\"' | strip -%}
            {%- if tag_clean != blank -%}
              <a href="{{ routes.search_url }}?q={{ tag_clean | url_encode }}&type=article" class="article-tag">{{ tag_clean }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Featured Image (Large, full-width, 16:9) -->
      {%- if article.image -%}
        <div class="article-hero__media-wrap">
          <div class="article-hero__media">
            <img
              srcset="
                {% if article.image.width >= 375 %}{{ article.image | image_url: width: 375 }} 375w,{% endif %}
                {% if article.image.width >= 550 %}{{ article.image | image_url: width: 550 }} 550w,{% endif %}
                {% if article.image.width >= 750 %}{{ article.image | image_url: width: 750 }} 750w,{% endif %}
                {% if article.image.width >= 1100 %}{{ article.image | image_url: width: 1100 }} 1100w,{% endif %}
                {% if article.image.width >= 1500 %}{{ article.image | image_url: width: 1500 }} 1500w,{% endif %}
                {{ article.image | image_url }} {{ article.image.width }}w
              "
              sizes="(min-width: 1200px) 1200px, 95vw"
              src="{{ article.image | image_url: width: 1200 }}"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="{{ article.image.width }}"
              height="{{ article.image.height }}"
              alt="{{ article.image.alt | default: article.title | escape }}"
              class="article-hero__img"
              itemprop="image"
            >
          </div>
          {%- if article.image.alt != blank and article.image.alt != article.title -%}
            <div class="article-hero__caption">{{ article.image.alt }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

    </header>

    <!-- ── TWO-COLUMN EDITORIAL LAYOUT ── -->
    <div class="article-main-layout">

      <!-- ── LEFT: Sidebar Column (Desktop Only) — the TOC sticks while the article scrolls ── -->
      <aside class="article-sidebar-column" id="article-sidebar">
        <div class="article-sidebar-track">

          <!-- Sticky "In This Article" TOC Card -->
          <nav id="article-toc-desktop" class="article-toc-card" aria-label="Table of contents" style="display: none;">
            <div class="article-toc-card__header">
              <div class="article-toc-card__title-wrap">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="8" y1="6" x2="21" y2="6"></line>
                  <line x1="8" y1="12" x2="21" y2="12"></line>
                  <line x1="8" y1="18" x2="21" y2="18"></line>
                  <line x1="3" y1="6" x2="3.01" y2="6"></line>
                  <line x1="3" y1="12" x2="3.01" y2="12"></line>
                  <line x1="3" y1="18" x2="3.01" y2="18"></line>
                </svg>
                <h3 class="article-toc-card__title">In this article</h3>
              </div>
            </div>
            <div class="article-toc-card__progress">
              <div class="article-toc-card__progress-bar" id="articleTocProgressBar"></div>
            </div>
            <ol id="article-toc-desktop-list" class="article-toc-card__list"></ol>
          </nav>

        </div>

        <!-- Sidebar Trust Widget (always shown; sits at the end of the column, below the TOC track) -->
        <div class="article-sidebar-widget">
          <div class="article-sidebar-widget__icon">🏔️</div>
          <h4 class="article-sidebar-widget__title">Pure Himalayan sourcing</h4>
          <p class="article-sidebar-widget__text">Authentic, unadulterated ingredients harvested directly from Himalayan valleys and trusted farming collectives.</p>
          <a href="/collections/all" class="article-sidebar-widget__link">
            <span>Explore collection</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </aside>

      <!-- ── RIGHT: Main Reading Column ── -->
      <main class="article-content-column">

        <!-- Mobile TOC Accordion (shown above content on mobile) -->
        <nav id="article-toc-mobile" class="article-toc--mobile" aria-label="Table of contents">
          <button
            type="button"
            class="article-toc__mobile-btn"
            aria-expanded="false"
            aria-controls="article-toc-mobile-panel"
            aria-label="Toggle Table of Contents"
          >
            <div class="article-toc__mobile-title">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
              <span>In this article</span>
              <span class="article-toc__count" id="article-toc-mobile-count"></span>
            </div>
            <svg class="article-toc__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div id="article-toc-mobile-panel" class="article-toc__mobile-panel" hidden>
            <ol class="article-toc__list--mobile"></ol>
          </div>
        </nav>

        {%- render 'article-buy-button-card' -%}

        <!-- ── MAIN ARTICLE CONTENT BODY ── -->
        <div class="article-content-body rte" itemprop="articleBody">
          {{ article.content }}
        </div>

        <!-- ── FAQ SECTION (existing custom.faqs metaobject) — plain, always-open text that reads as part of the article ── -->
        {%- if blog_faqs != blank and blog_faqs.size > 0 -%}
          <section class="article-faq-section" aria-labelledby="article-faq-title">
            <h2 class="article-faq-section__title" id="article-faq-title">Frequently asked questions</h2>

            <div class="article-faq-list">
              {%- for item in blog_faqs -%}
                {%- assign faq = item.value | default: item -%}
                {%- assign faq_question = faq.question.value | default: faq.question | default: faq.title | default: faq.faq_question | default: faq.heading -%}
                {%- assign faq_answer = faq.answer.value | default: faq.answer | default: faq.description | default: faq.faq_answer | default: faq.content -%}
                {%- if faq_question contains '{"type":"root"' -%}
                  {%- assign q_chunks = faq_question | split: '"value":"' -%}
                  {%- assign faq_question = q_chunks[1] | split: '"' | first -%}
                {%- endif -%}
                {%- if faq_question != blank and faq_answer != blank -%}
                  <div class="article-faq-item">
                    <h3 class="article-faq-item__question">{{ faq_question }}</h3>
                    <div class="article-faq-item__answer">
                      {%- if faq_answer contains '{"type":"root"' -%}
                        {%- assign ans_chunks = faq_answer | split: '"value":"' -%}
                        {%- for chunk in ans_chunks -%}
                          {%- unless forloop.first -%}
                            {%- assign clean_chunk = chunk | split: '"' | first -%}
                            {%- if clean_chunk != blank -%}
                              <p>{{ clean_chunk }}</p>
                            {%- endif -%}
                          {%- endunless -%}
                        {%- endfor -%}
                      {%- elsif faq.answer.value != blank or faq.answer != blank -%}
                        {{ faq.answer | metafield_tag }}
                      {%- elsif faq_answer contains '<' -%}
                        {{ faq_answer }}
                      {%- else -%}
                        <p>{{ faq_answer }}</p>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </section>

          <!-- FAQ Structured Data (JSON-LD) -->
          <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
              {%- assign faq_first = true -%}
              {%- for item in blog_faqs -%}
                {%- assign faq = item.value | default: item -%}
                {%- assign faq_question = faq.question.value | default: faq.question | default: faq.title | default: faq.faq_question | default: faq.heading -%}
                {%- assign faq_answer = faq.answer.value | default: faq.answer | default: faq.description | default: faq.faq_answer | default: faq.content -%}
                {%- if faq_question contains '{"type":"root"' -%}
                  {%- assign q_chunks = faq_question | split: '"value":"' -%}
                  {%- assign faq_question = q_chunks[1] | split: '"' | first -%}
                {%- endif -%}
                {%- assign faq_schema_text = faq_answer -%}
                {%- if faq_answer contains '{"type":"root"' -%}
                  {%- assign faq_schema_text = '' -%}
                  {%- assign ans_chunks = faq_answer | split: '"value":"' -%}
                  {%- for chunk in ans_chunks -%}
                    {%- unless forloop.first -%}
                      {%- assign clean_chunk = chunk | split: '"' | first -%}
                      {%- assign faq_schema_text = faq_schema_text | append: ' ' | append: clean_chunk -%}
                    {%- endunless -%}
                  {%- endfor -%}
                {%- endif -%}
                {%- if faq_question != blank and faq_answer != blank -%}
                  {%- unless faq_first -%},{%- endunless -%}
                  {
                    "@type": "Question",
                    "name": {{ faq_question | strip_html | strip | json }},
                    "acceptedAnswer": {
                      "@type": "Answer",
                      "text": {{ faq_schema_text | strip_html | strip | json }}
                    }
                  }
                  {%- assign faq_first = false -%}
                {%- endif -%}
              {%- endfor -%}
            ]
          }
          </script>
        {%- endif -%}

        <!-- ── FEATURED PRODUCT CARD (custom.featured_product) ── -->
        {%- if featured_product != blank -%}
          {%- assign fp = featured_product -%}
          <section class="article-featured-product" aria-label="Featured product recommendation">
            <div class="article-featured-product__inner">
              <div class="article-featured-product__label">
                <span class="article-featured-product__eyebrow">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                  Featured recommendation
                </span>
              </div>
              <div class="article-featured-product__media">
                {%- if fp.featured_image != blank -%}
                  <a href="{{ fp.url }}" class="article-featured-product__media-link" tabindex="-1" aria-hidden="true">
                    <img
                      src="{{ fp.featured_image | image_url: width: 400 }}"
                      srcset="{{ fp.featured_image | image_url: width: 200 }} 200w, {{ fp.featured_image | image_url: width: 400 }} 400w"
                      sizes="(min-width: 768px) 200px, 40vw"
                      alt="{{ fp.featured_image.alt | default: fp.title | escape }}"
                      loading="lazy"
                      width="200"
                      height="200"
                      class="article-featured-product__img"
                    >
                  </a>
                {%- endif -%}
              </div>
              <div class="article-featured-product__content">
                {%- if fp.type != blank -%}
                  <span class="article-featured-product__type">{{ fp.type }}</span>
                {%- endif -%}
                <h3 class="article-featured-product__title">
                  <a href="{{ fp.url }}">{{ fp.title }}</a>
                </h3>
                {%- if fp.description != blank -%}
                  <p class="article-featured-product__desc">
                    {{ fp.description | strip_html | truncate: 120 }}
                  </p>
                {%- endif -%}
                <div class="article-featured-product__price-row">
                  <span class="article-featured-product__price">
                    {{ fp.price | money }}
                  </span>
                  {%- if fp.compare_at_price > fp.price -%}
                    <span class="article-featured-product__compare-price">{{ fp.compare_at_price | money }}</span>
                    {%- assign discount_pct = fp.compare_at_price | minus: fp.price | times: 100 | divided_by: fp.compare_at_price -%}
                    <span class="article-featured-product__badge-save">{{ discount_pct }}% off</span>
                  {%- endif -%}
                </div>
                {%- if fp.available -%}
                  {%- assign fp_variant = fp.selected_or_first_available_variant -%}
                  <div class="article-featured-product__actions">
                    <button
                      type="button"
                      class="article-product-atc-btn article-featured-product__atc-btn cp-atc"
                      data-variant-id="{{ fp_variant.id }}"
                      aria-label="Add {{ fp.title | escape }} to cart"
                    >
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                      </svg>
                      <span>Add to cart</span>
                    </button>
                    <a href="{{ fp.url }}" class="article-featured-product__btn">
                      <span>View details</span>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </a>
                  </div>
                {%- else -%}
                  <div class="article-featured-product__actions">
                    <button type="button" class="article-product-atc-btn article-product-atc-btn--oos" disabled>
                      Out of stock
                    </button>
                    <a href="{{ fp.url }}" class="article-featured-product__btn">
                      <span>View details</span>
                    </a>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </section>
        {%- endif -%}

        <!-- ── BLOG PRODUCTS SLIDER (custom.blog_products) — injected at ~20% by JS ── -->
        {%- assign blog_prods = article.metafields.custom.blog_products.value | default: article.metafields.custom.blog_products -%}
        {%- assign has_blog_prods = false -%}
        {%- if blog_prods != blank -%}
          {%- if blog_prods.first != nil or blog_prods.size > 0 or blog_prods.title != blank -%}
            {%- assign has_blog_prods = true -%}
          {%- endif -%}
        {%- endif -%}
        {%- if has_blog_prods -%}
        <template id="bp-slider-tpl">
          <section class="article-products-section article-products-section--slider" aria-label="Recommended products">
            <div class="article-products-section__header-row">
              <div class="article-products-section__header-text">
                <span class="article-section-eyebrow">Featured products</span>
                <h3 class="article-products-section__title">From My Pahadi Dukan</h3>
              </div>
              <div class="article-bp-slider-arrows">
                <button class="article-bp-slider-btn article-bp-slider-btn--prev" aria-label="Previous products" type="button">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
                <button class="article-bp-slider-btn article-bp-slider-btn--next" aria-label="Next products" type="button">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
              </div>
            </div>
            <div class="article-bp-slider-wrap">
              <div class="article-bp-slider-track">
                {%- if blog_prods.first != nil or blog_prods.size > 0 -%}
                  {%- for prod in blog_prods -%}
                    {%- if prod.title != blank -%}
                      <div class="article-bp-slide">
                        {% render 'product-slider-card',
                          product: prod,
                          position: forloop.index,
                          show_secondary_image: true,
                          discount_text: 'Extra 10% Discount at Checkout'
                        %}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                {%- elsif blog_prods.title != blank -%}
                  {%- assign prod = blog_prods -%}
                  <div class="article-bp-slide">
                    {% render 'product-slider-card',
                      product: prod,
                      position: 1,
                      show_secondary_image: true,
                      discount_text: 'Extra 10% Discount at Checkout'
                    %}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </section>
        </template>
        {%- endif -%}

        <!-- ── AUTHOR CARD ── -->
        {%- if author_name != blank or author_bio != blank -%}
          <section class="article-author-section" aria-label="Author profile">
            <div class="article-author-card">
              <div class="article-author-card__avatar-wrap">
                {%- if author_photo != blank -%}
                  <img
                    src="{{ author_photo | image_url: width: 160, height: 160, crop: 'center' }}"
                    alt="{{ author_name | escape }}"
                    class="article-author-card__avatar"
                    width="76"
                    height="76"
                    loading="lazy"
                  >
                {%- elsif author_name != blank -%}
                  <div class="article-author-card__avatar article-author-card__avatar--initial" aria-hidden="true">
                    {{ author_name | slice: 0, 1 | upcase }}
                  </div>
                {%- endif -%}
              </div>
              <div class="article-author-card__content">
                <div class="article-author-card__header">
                  <div>
                    <span class="article-author-card__label">Written by</span>
                    {%- if author_name != blank -%}
                      <h3 class="article-author-card__name">{{ author_name }}</h3>
                    {%- endif -%}
                    {%- if author_designation != blank -%}
                      <span class="article-author-card__designation">{{ author_designation }}</span>
                    {%- endif -%}
                  </div>
                  {%- if author_profile_url != blank -%}
                    <a href="{{ author_profile_url }}" class="article-author-card__link">View profile &rarr;</a>
                  {%- endif -%}
                </div>
                {%- if author_bio != blank -%}
                  <div class="article-author-card__bio">
                    {%- if author_bio contains '{"type":"root"' -%}
                      {%- assign bio_chunks = author_bio | split: '"value":"' -%}
                      {%- for chunk in bio_chunks -%}
                        {%- unless forloop.first -%}
                          {%- assign clean_chunk = chunk | split: '"' | first -%}
                          {%- if clean_chunk != blank -%}
                            <p>{{ clean_chunk }}</p>
                          {%- endif -%}
                        {%- endunless -%}
                      {%- endfor -%}
                    {%- elsif author_obj.bio.value != blank or author_obj.bio != blank -%}
                      {{ author_obj.bio | metafield_tag }}
                    {%- elsif author_bio contains '<' -%}
                      {{ author_bio }}
                    {%- else -%}
                      <p>{{ author_bio }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </section>
        {%- endif -%}

        <!-- ── FINAL CTA (from custom.cta_* metafields or branded default) ── -->
        {%- if has_cta -%}
          <section class="article-final-cta article-final-cta--metafield" aria-label="Call to action">
            <div class="article-final-cta__inner">
              <div class="article-final-cta__badge">
                <span>Authentic Himalayan harvest</span>
              </div>
              {%- if cta_title != blank -%}
                <h3 class="article-final-cta__heading">{{ cta_title }}</h3>
              {%- endif -%}
              {%- if cta_description != blank -%}
                <p class="article-final-cta__desc">{{ cta_description }}</p>
              {%- endif -%}
              <div class="article-final-cta__actions">
                <a href="{{ cta_link }}" class="article-final-cta__btn">
                  <span>{{ cta_button_text }}</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </section>
        {%- else -%}
          <!-- Default branded CTA when no metafield values set -->
          <section class="article-final-cta" aria-label="Explore Pahadi Collection">
            <div class="article-final-cta__inner">
              <div class="article-final-cta__badge">
                <span>Authentic Himalayan harvest</span>
              </div>
              <h3 class="article-final-cta__heading">Ready to experience authentic Pahadi flavours?</h3>
              <p class="article-final-cta__desc">
                Explore our collection of authentic spices, herbs and Himalayan ingredients directly sourced from high-altitude farmers.
              </p>
              <div class="article-final-cta__actions">
                <a href="/collections/all" class="article-final-cta__btn">
                  <span>Explore Pahadi products</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
              </div>
            </div>
          </section>
        {%- endif -%}

        {%- comment -%}
          Previous/Next navigation removed as per client requirements:
          "Let’s keep only Related Articles section and remove the 'Previous' section."
        {%- endcomment -%}

        <!-- App Blocks -->
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div class="article-app-block" {{ block.shopify_attributes }}>
              {% render block %}
            </div>
          {%- endif -%}
        {%- endfor -%}

      </main>

    </div><!-- /.article-main-layout -->

    <!-- ── WIDE RELATED ARTICLES SECTION (3-Column Grid) ── -->
    {% render 'article-related-articles',
      article: article,
      blog: blog,
      search_blogs: section.settings.related_blogs,
      topics: section.settings.related_topics
    %}

    <!-- Comments Section -->
    {%- if blog.comments_enabled? -%}
      <div class="article-comments-section" id="comments">
        {%- if article.comments_count > 0 -%}
          <h2>{{ 'blogs.article.comments' | t: count: article.comments_count }}</h2>
          {% paginate article.comments by 5 %}
            {%- for comment in article.comments -%}
              <article class="article-comments-item" id="{{ comment.id }}">
                {{ comment.content }}
                <footer>
                  <small><strong>{{ comment.author }}</strong> &bull; {{ comment.created_at | date: '%B %d, %Y' }}</small>
                </footer>
              </article>
            {%- endfor -%}
            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate %}
            {%- endif -%}
          {% endpaginate %}
        {%- endif -%}

        {% form 'new_comment', article %}
          <h3>{{ 'blogs.article.comment_form_title' | t }}</h3>
          {%- if form.posted_successfully? -%}
            <p class="form__message" role="status">{{ 'blogs.article.success' | t }}</p>
          {%- endif -%}
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
            <input type="text" name="comment[author]" placeholder="{{ 'blogs.article.name' | t }}" required value="{{ form.author }}" style="padding: 12px 16px; border-radius: 10px; border: 1.5px solid #e7ded0; font-family: inherit;">
            <input type="email" name="comment[email]" placeholder="{{ 'blogs.article.email' | t }}" required value="{{ form.email }}" style="padding: 12px 16px; border-radius: 10px; border: 1.5px solid #e7ded0; font-family: inherit;">
          </div>
          <textarea name="comment[body]" rows="4" placeholder="{{ 'blogs.article.message' | t }}" required style="width: 100%; padding: 12px 16px; border-radius: 10px; border: 1.5px solid #e7ded0; margin-bottom: 16px; font-family: inherit;">{{ form.body }}</textarea>
          <button type="submit" class="button" style="background: #008b75; color: #fff; padding: 12px 28px; border-radius: 30px; border: none; font-weight: 700; cursor: pointer;">
            {{ 'blogs.article.post' | t }}
          </button>
        {% endform %}
      </div>
    {%- endif -%}

  </div><!-- /.article-page__container -->
</article>

<!-- Article Structured Data -->
<script type="application/ld+json">{{ article | structured_data }}</script>

<!-- Interactive Editorial Logic: TOC, Progress Bar, Step Cards, Tip Cards, Add to Cart -->
<script>
(function() {
  'use strict';

  function initBlogArticle() {
    // ── 0. DOM AUTO-CLEANER (Strips bracketed tags & rich text AST) ──
    try {
      // 1. Clean Tags: strip [, ], ", '
      document.querySelectorAll('.article-tag').forEach(function(tag) {
        var raw = tag.textContent;
        if (raw && (raw.indexOf('[') !== -1 || raw.indexOf(']') !== -1 || raw.indexOf('"') !== -1 || raw.indexOf("'") !== -1)) {
          tag.textContent = raw.replace(/[\[\]"']/g, '').trim();
        }
      });

      // 2. Parse any raw AST JSON in bio, FAQ, etc.
      function parseRichTextAst(str) {
        if (typeof str !== 'string' || str.indexOf('{"type":"root"') === -1) return null;
        try {
          var data = JSON.parse(str.trim());
          function extract(node) {
            if (!node) return '';
            if (node.type === 'text') return node.value || '';
            if (node.children && Array.isArray(node.children)) {
              return node.children.map(extract).join('');
            }
            return '';
          }
          if (data.type === 'root' && Array.isArray(data.children)) {
            return data.children.map(function(c) {
              return '<p>' + extract(c) + '</p>';
            }).join('');
          }
        } catch(e) {
          var matches = str.match(/"value":"([^"]+)"/g);
          if (matches && matches.length > 0) {
            return matches.map(function(m) {
              return '<p>' + m.replace('"value":"', '').slice(0, -1) + '</p>';
            }).join('');
          }
        }
        return null;
      }

      var astSelectors = ['.article-author-card__bio', '.article-faq-item__answer', '.article-faq-item__question'];
      astSelectors.forEach(function(sel) {
        document.querySelectorAll(sel).forEach(function(el) {
          var txt = el.textContent || '';
          if (txt.indexOf('{"type":"root"') !== -1) {
            var cleanHtml = parseRichTextAst(txt);
            if (cleanHtml) el.innerHTML = cleanHtml;
          }
        });
      });
    } catch (cleanErr) {
      console.warn('AST cleanup error:', cleanErr);
    }

    var contentEl = document.querySelector('.article-content-body');

    // ── 1. TABLE OF CONTENTS GENERATOR ──
    var tocSidebar = document.getElementById('article-sidebar');
    var tocDesktop = document.getElementById('article-toc-desktop');
    var tocDesktopList = document.getElementById('article-toc-desktop-list');
    var tocMobile = document.getElementById('article-toc-mobile');
    var tocMobilePanel = document.getElementById('article-toc-mobile-panel');
    var tocMobileList = tocMobile ? tocMobile.querySelector('.article-toc__list--mobile') : null;
    var tocMobileBtn = document.querySelector('.article-toc__mobile-btn');
    var tocMobileCount = document.getElementById('article-toc-mobile-count');

    if (contentEl) {

      // ── Open all article content links in new tab ──
      contentEl.querySelectorAll('a').forEach(function(link) {
        var href = link.getAttribute('href');
        if (href && !href.startsWith('#')) {
          link.setAttribute('target', '_blank');
          link.setAttribute('rel', 'noopener noreferrer');
        }
      });
      contentEl.addEventListener('click', function(e) {
        var a = e.target.closest('a');
        if (a && a.href && !a.getAttribute('href').startsWith('#')) {
          a.setAttribute('target', '_blank');
          a.setAttribute('rel', 'noopener noreferrer');
        }
      });

      // ── Clean up Shopify Rich Text Editor image alignment bug ──
      contentEl.querySelectorAll('img').forEach(function(img) {
        if (!img.classList.contains('article-product-mini-card__img')) {
          var floatVal = img.style.float || (img.getAttribute('style') && img.getAttribute('style').indexOf('float: none') !== -1 ? 'none' : '');
          if (!floatVal || floatVal === 'none') {
            img.style.marginLeft = 'auto';
            img.style.marginRight = 'auto';
            img.style.display = 'block';
          }
        }
      });

      // ── Inject Blog Products Slider at ~20% of Article Content ──
      var bpSliderTpl = document.getElementById('bp-slider-tpl');
      if (bpSliderTpl && !contentEl.querySelector('.article-products-section--slider')) {
        var blocks = Array.from(contentEl.children).filter(function(node) {
          return node.tagName !== 'SCRIPT' && node.tagName !== 'STYLE' && node.tagName !== 'TEMPLATE';
        });

        if (blocks.length > 0) {
          var totalContentHeight = contentEl.scrollHeight || contentEl.offsetHeight;
          var targetHeight = totalContentHeight * 0.20;
          var contentTop = contentEl.getBoundingClientRect().top + window.pageYOffset;
          var bestBlock = blocks[0];
          var minDiff = Infinity;

          for (var b = 0; b < blocks.length; b++) {
            var block = blocks[b];
            var blockBottom = (block.getBoundingClientRect().bottom + window.pageYOffset) - contentTop;
            var diff = Math.abs(blockBottom - targetHeight);

            if (diff < minDiff) {
              minDiff = diff;
              bestBlock = block;
            }

            if (blockBottom >= targetHeight && (block.tagName === 'P' || block.tagName === 'UL' || block.tagName === 'OL' || block.tagName === 'DIV' || block.tagName === 'BLOCKQUOTE')) {
              bestBlock = block;
              break;
            }
          }

          if (bestBlock) {
            var frag = bpSliderTpl.content ? bpSliderTpl.content.cloneNode(true) : null;
            var sliderNode = frag ? frag.firstElementChild : (bpSliderTpl.firstElementChild ? bpSliderTpl.firstElementChild.cloneNode(true) : null);
            if (sliderNode) {
              bestBlock.insertAdjacentElement('afterend', sliderNode);
              initBpSlider(sliderNode);
            }
          }
        }
      }

    // FAQ sits right after the body as part of the article, so it gets a TOC entry too
    var h2Elements = document.querySelectorAll('.article-content-body h2, .article-faq-section__title');
    if (h2Elements.length >= 2) {
      if (tocDesktopList) tocDesktopList.innerHTML = '';
      if (tocMobileList) tocMobileList.innerHTML = '';
      var existingIds = {};

      h2Elements.forEach(function(h2, index) {
        var text = (h2.textContent || '').trim().replace(/^CHAPTER\s*/i, '');
        if (!text) return;

        var id = h2.id;
        if (!id) {
          id = text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
          if (!id) id = 'section-' + (index + 1);
          if (existingIds[id]) {
            existingIds[id]++;
            id = id + '-' + existingIds[id];
          } else {
            existingIds[id] = 1;
          }
          h2.id = id;
        }

        if (tocDesktopList) {
          var liD = document.createElement('li');
          liD.className = 'article-toc-card__item';
          var aD = document.createElement('a');
          aD.href = '#' + id;
          aD.textContent = text;
          aD.setAttribute('data-target-id', id);
          aD.addEventListener('click', function(e) {
            e.preventDefault();
            scrollToSection(id);
          });
          liD.appendChild(aD);
          tocDesktopList.appendChild(liD);
        }

        if (tocMobileList) {
          var liM = document.createElement('li');
          var aM = document.createElement('a');
          aM.href = '#' + id;
          aM.textContent = text;
          aM.setAttribute('data-target-id', id);
          aM.addEventListener('click', function(e) {
            e.preventDefault();
            if (tocMobileBtn && tocMobilePanel) {
              tocMobileBtn.setAttribute('aria-expanded', 'false');
              tocMobilePanel.setAttribute('hidden', '');
            }
            scrollToSection(id);
          });
          liM.appendChild(aM);
          tocMobileList.appendChild(liM);
        }
      });

      if (tocMobileCount) tocMobileCount.textContent = h2Elements.length + ' sections';
      if (tocDesktop) tocDesktop.style.display = 'block';
      if (tocSidebar) tocSidebar.classList.add('has-toc');
      if (tocMobile) tocMobile.classList.add('is-ready');

      // Mobile TOC Toggle
      if (tocMobileBtn && tocMobilePanel) {
        tocMobileBtn.addEventListener('click', function() {
          var isExpanded = tocMobileBtn.getAttribute('aria-expanded') === 'true';
          if (isExpanded) {
            tocMobileBtn.setAttribute('aria-expanded', 'false');
            tocMobilePanel.setAttribute('hidden', '');
          } else {
            tocMobileBtn.setAttribute('aria-expanded', 'true');
            tocMobilePanel.removeAttribute('hidden');
          }
        });
      }

      function scrollToSection(id) {
        var target = document.getElementById(id);
        if (target) {
          var offset = 96;
          var top = target.getBoundingClientRect().top + window.pageYOffset - offset;
          window.scrollTo({ top: top, behavior: 'smooth' });
          if (history.pushState) history.pushState(null, null, '#' + id);
        }
      }

      // ScrollSpy via IntersectionObserver
      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              var activeId = entry.target.id;
              if (tocDesktopList) {
                tocDesktopList.querySelectorAll('.article-toc-card__item').forEach(function(item) {
                  var link = item.querySelector('a');
                  if (link && link.getAttribute('data-target-id') === activeId) {
                    item.classList.add('is-active');
                  } else {
                    item.classList.remove('is-active');
                  }
                });
              }
              if (tocMobileList) {
                tocMobileList.querySelectorAll('li').forEach(function(item) {
                  var link = item.querySelector('a');
                  if (link && link.getAttribute('data-target-id') === activeId) {
                    item.classList.add('is-active');
                  } else {
                    item.classList.remove('is-active');
                  }
                });
              }
            }
          });
        }, { rootMargin: '-15% 0px -70% 0px', threshold: 0 });

        h2Elements.forEach(function(h2) { observer.observe(h2); });
      }
    }

    // ── 2. READING PROGRESS BAR ──
    var globalProgressBar = document.querySelector('.article-progress-bar__fill');
    var tocProgressBar = document.getElementById('articleTocProgressBar');

    function updateProgressBar() {
      var docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      if (docHeight <= 0) return;
      var pct = Math.min(100, Math.max(0, (window.pageYOffset / docHeight) * 100));
      if (globalProgressBar) globalProgressBar.style.width = pct + '%';
      if (tocProgressBar) tocProgressBar.style.width = pct + '%';
    }

    window.addEventListener('scroll', updateProgressBar, { passive: true });
    updateProgressBar();

    // ── 3. STEP-BY-STEP INSTRUCTION CARDS ──
    contentEl.querySelectorAll('ol').forEach(function(ol) {
      var items = ol.querySelectorAll('li');
      if (items.length < 2) return;
      var isStepList = true;
      items.forEach(function(li) {
        if (!li.querySelector('strong, b') && li.textContent.trim().length > 150) isStepList = false;
      });
      if (!isStepList) return;

      var stepGrid = document.createElement('div');
      stepGrid.className = 'article-step-grid';

      items.forEach(function(li, idx) {
        var stepNumStr = (idx + 1 < 10) ? '0' + (idx + 1) : '' + (idx + 1);
        var strongEl = li.querySelector('strong, b');
        var stepTitle = '', stepDesc = '';

        if (strongEl) {
          stepTitle = strongEl.textContent.trim().replace(/:$/, '');
          var cloneLi = li.cloneNode(true);
          var cloneStrong = cloneLi.querySelector('strong, b');
          if (cloneStrong) cloneStrong.remove();
          stepDesc = cloneLi.textContent.trim().replace(/^:\s*/, '');
        } else {
          var text = li.textContent.trim();
          var periodIdx = text.indexOf('.');
          // Split "Short title. Details" only when something follows the period; a single
          // short sentence would otherwise become a title with an empty description
          if (periodIdx > 0 && periodIdx < 45 && text.substring(periodIdx + 1).trim()) {
            stepTitle = text.substring(0, periodIdx).trim();
            stepDesc = text.substring(periodIdx + 1).trim();
          } else {
            stepTitle = 'Step ' + (idx + 1);
            stepDesc = text;
          }
        }

        var card = document.createElement('div');
        card.className = 'article-step-card';
        card.innerHTML =
          '<div class="article-step-card__header">' +
            '<span class="article-step-card__num">' + stepNumStr + '</span>' +
            '<h4 class="article-step-card__title">' + stepTitle + '</h4>' +
          '</div>' +
          (stepDesc ? '<p class="article-step-card__desc">' + stepDesc + '</p>' : '');
        stepGrid.appendChild(card);
      });

      ol.parentNode.replaceChild(stepGrid, ol);
    });

    // ── 4. TIP & CALLOUT CARDS ──
    contentEl.querySelectorAll('p').forEach(function(p) {
      var text = p.textContent.trim();
      var isTip = false, tipType = 'tip', badgeText = 'COOKING TIP';

      if (/^(Tip|Pro Tip|Chef's Tip)[\s:]/i.test(text)) {
        isTip = true; badgeText = 'COOKING TIP';
      } else if (/^(Important|Note|Warning|Caution)[\s:]/i.test(text)) {
        isTip = true; tipType = 'info'; badgeText = 'IMPORTANT NOTE';
      } else if (/^Remember[\s:]/i.test(text)) {
        isTip = true; badgeText = 'KEY REMINDER';
      }

      if (isTip && !p.closest('.article-step-card') && !p.closest('.article-product-cta-card')) {
        var cleanText = text.replace(/^(Tip|Pro Tip|Chef's Tip|Important|Note|Warning|Caution|Remember)[\s:]+\s*/i, '');
        var tipCard = document.createElement('aside');
        tipCard.className = 'article-tip-card' + (tipType === 'info' ? ' article-tip-card--info' : '');
        tipCard.innerHTML =
          '<div class="article-tip-card__header">' +
            '<span class="article-tip-card__badge">' +
              '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">' +
                '<circle cx="12" cy="12" r="10"></circle>' +
                '<line x1="12" y1="16" x2="12" y2="12"></line>' +
                '<line x1="12" y1="8" x2="12.01" y2="8"></line>' +
              '</svg>' +
              badgeText +
            '</span>' +
          '</div>' +
          '<p class="article-tip-card__text">' + cleanText + '</p>';
        p.parentNode.replaceChild(tipCard, p);
      }
    });
    } // end if (contentEl)

    // ── 5. BLOG PRODUCT ADD TO CART INTEGRATION ──
    document.addEventListener('click', async function (e) {
      // .ps-atc: the homepage product card, used by the products slider and in-article buy-button cards
      var btn = e.target.closest('.article-product-atc-btn, .cp-atc, .article-page .ps-atc');
      if (!btn || btn.disabled) return;

      var variantId = btn.getAttribute('data-variant-id');
      if (!variantId) return;

      e.preventDefault();
      var originalHtml = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<svg class="article-atc-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle><path d="M12 2a10 10 0 0 1 10 10" stroke-linecap="round"></path></svg><span>Adding...</span>';

      try {
        var response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1,
            sections: ['cart-drawer'],
            sections_url: window.location.pathname
          })
        });

        if (!response.ok) {
          throw new Error(await response.text());
        }

        var data = await response.json();

        if (data.sections && data.sections['cart-drawer']) {
          var parser = new DOMParser();
          var html = parser.parseFromString(data.sections['cart-drawer'], 'text/html');

          // Replace drawer body
          var newBody = html.querySelector('#nc-body');
          var oldBody = document.querySelector('#nc-body');
          if (newBody && oldBody) oldBody.replaceWith(newBody);

          // Replace breakdown
          var newBreakdown = html.querySelector('.nc-price-breakdown');
          var oldBreakdown = document.querySelector('.nc-price-breakdown');
          if (newBreakdown) {
            if (oldBreakdown) {
              oldBreakdown.replaceWith(newBreakdown);
            } else {
              var footer = document.querySelector('.cart-drawer__footer');
              if (footer) footer.insertAdjacentElement('beforebegin', newBreakdown);
            }
          }

          // Replace footer
          var newFooter = html.querySelector('.cart-drawer__footer');
          var oldFooter = document.querySelector('.cart-drawer__footer');
          if (newFooter && oldFooter) oldFooter.replaceWith(newFooter);
        }

        // Open cart drawer
        var drawer = document.querySelector('#nc-cart-drawer');
        if (drawer) {
          drawer.classList.add('is-open');
          drawer.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }

        // Refresh cart count & pubsub
        try {
          var cart = await fetch('/cart.js').then(function(r) { return r.json(); });
          if (typeof publish !== 'undefined' && typeof PUB_SUB_EVENTS !== 'undefined') {
            publish(PUB_SUB_EVENTS.cartUpdate, {
              source: 'blog-article',
              cartData: cart
            });
          }
          if (typeof window.ncUpdatePriceBreakdown === 'function') {
            window.ncUpdatePriceBreakdown(cart);
          }
        } catch (cErr) {
          console.warn('Cart count update error:', cErr);
        }

        btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg><span>Added ✓</span>';
        btn.classList.add('is-added');

        setTimeout(function() {
          btn.innerHTML = originalHtml;
          btn.disabled = false;
          btn.classList.remove('is-added');
        }, 1500);

      } catch (err) {
        console.error('Error adding product to cart:', err);
        btn.innerHTML = '<span>Error adding</span>';
        setTimeout(function() {
          btn.innerHTML = originalHtml;
          btn.disabled = false;
        }, 2000);
      }
    });

    function initBpSlider(slider) {
      if (!slider) return;
      var track = slider.querySelector('.article-bp-slider-track');
      var prevBtn = slider.querySelector('.article-bp-slider-btn--prev');
      var nextBtn = slider.querySelector('.article-bp-slider-btn--next');
      if (!track) return;

      function updateControls() {
        if (!prevBtn || !nextBtn) return;
        var maxScroll = track.scrollWidth - track.clientWidth - 4;
        prevBtn.disabled = track.scrollLeft <= 4;
        nextBtn.disabled = track.scrollLeft >= maxScroll;
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          var amount = Math.max(220, track.clientWidth * 0.75);
          track.scrollBy({ left: -amount, behavior: 'smooth' });
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          var amount = Math.max(220, track.clientWidth * 0.75);
          track.scrollBy({ left: amount, behavior: 'smooth' });
        });
      }

      track.addEventListener('scroll', updateControls, { passive: true });
      window.addEventListener('resize', updateControls);
      setTimeout(updateControls, 300);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlogArticle);
  } else {
    initBlogArticle();
  }
})();
</script>

