          "default": "Card Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Card description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us Section 1",
      "settings": {
        "heading": "Welcome to My Pahadi Dukan",
        "description": "<p>To our founders are avid travellers. And travelling over the years, they frequently came across many small businesses selling indigenous, organic and unadulterated goods. But these gems were tucked away in the mountains. We aim to provide a platform for all these budding entrepreneurs to connect with people throughout the length and breadth of the nation. This helps our eco-conscious buyers get high-quality products at affordable prices. And the absence of intermediaries increases our sellers’ income. Quality products and solid on-ground impact! This is what we stand for in a nutshell.</p>",
        "bg_top": "#FFFFFF",
        "bg_cards_area": "#F7F3EB",
        "heading_color": "#1F2937",
        "body_color": "#4B5563",
        "card_bg": "#FFFFFF",
        "card_heading_color": "#1F2937",
        "card_text_color": "#4B5563",
        "card_radius": 8,
        "desktop_padding_top": 60,
        "desktop_padding_bottom": 56,
        "cards_padding_top": 56,
        "cards_padding_bottom": 64,
        "mobile_padding_top": 40,
        "mobile_padding_bottom": 36,
        "cards_mobile_padding_top": 36,
        "cards_mobile_padding_bottom": 44
      },
      "blocks": [
        {
