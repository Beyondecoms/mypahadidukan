{%- liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign bg_top = section.settings.bg_top | default: '#FFFFFF'
  assign bg_cards_area = section.settings.bg_cards_area | default: '#F7F3EB'
  assign heading_color = section.settings.heading_color | default: '#1F2937'
  assign body_color = section.settings.body_color | default: '#4B5563'
  assign card_bg = section.settings.card_bg | default: '#FFFFFF'
  assign card_heading_color = section.settings.card_heading_color | default: '#1F2937'
  assign card_text_color = section.settings.card_text_color | default: '#4B5563'
  assign card_radius = section.settings.card_radius | default: 8

  assign desktop_padding_top = section.settings.desktop_padding_top | default: 60
  assign desktop_padding_bottom = section.settings.desktop_padding_bottom | default: 56
  assign cards_padding_top = section.settings.cards_padding_top | default: 56
  assign cards_padding_bottom = section.settings.cards_padding_bottom | default: 64

  assign mobile_padding_top = section.settings.mobile_padding_top | default: 40
  assign mobile_padding_bottom = section.settings.mobile_padding_bottom | default: 36
  assign cards_mobile_padding_top = section.settings.cards_mobile_padding_top | default: 36
  assign cards_mobile_padding_bottom = section.settings.cards_mobile_padding_bottom | default: 44
-%}

<div
  id="about-us-section-1-{{ section.id }}"
  class="about-us-section-1"
  style="
    --aus1-bg-top: {{ bg_top }};
    --aus1-bg-cards: {{ bg_cards_area }};
    --aus1-heading-color: {{ heading_color }};
    --aus1-body-color: {{ body_color }};
    --aus1-card-bg: {{ card_bg }};
    --aus1-card-heading-color: {{ card_heading_color }};
    --aus1-card-text-color: {{ card_text_color }};
    --aus1-card-radius: {{ card_radius }}px;
    --aus1-pt: {{ desktop_padding_top }}px;
    --aus1-pb: {{ desktop_padding_bottom }}px;
    --aus1-pt-mb: {{ mobile_padding_top }}px;
    --aus1-pb-mb: {{ mobile_padding_bottom }}px;
    --aus1-cards-pt: {{ cards_padding_top }}px;
    --aus1-cards-pb: {{ cards_padding_bottom }}px;
    --aus1-cards-pt-mb: {{ cards_mobile_padding_top }}px;
    --aus1-cards-pb-mb: {{ cards_mobile_padding_bottom }}px;
  "
>
  <!-- 1. TOP WELCOME CONTENT AREA -->
  <div class="about-us-section-1__top">
    <div class="about-us-section-1__top-container">
      {%- if heading != blank -%}
        <h2 class="about-us-section-1__heading">{{ heading | escape }}</h2>
      {%- endif -%}

      {%- if description != blank -%}
        <div class="about-us-section-1__description rte">
          {%- if description contains '<p>' -%}
            {{ description }}
          {%- else -%}
            <p>{{ description }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <!-- 2. VISION + MISSION + VALUES CARDS AREA -->
  <div class="about-us-section-1__cards-area">
    <div class="about-us-section-1__cards-container">
      {%- if section.blocks.size > 0 -%}
        <div class="about-us-section-1__cards-grid">
          {%- for block in section.blocks -%}
            {%- liquid
              assign block_heading = block.settings.heading
              assign block_description = block.settings.description
            -%}
            <div class="about-us-section-1__card about-us-section-1__card--{{ block.type }}" {{ block.shopify_attributes }}>
              <div class="about-us-section-1__card-inner">
                {%- if block_heading != blank -%}
                  <h3 class="about-us-section-1__card-heading">{{ block_heading | escape }}</h3>
                {%- endif -%}

                {%- if block.type == 'values' -%}
                  {%- assign values_content = block.settings.values_list | default: block_description -%}
                  {%- if values_content != blank -%}
                    <ul class="about-us-section-1__values-list">
                      {%- assign val_lines = values_content | newline_to_br | split: '<br />' -%}
                      {%- for val_line in val_lines -%}
                        {%- assign clean_val = val_line | strip | remove: '<ul>' | remove: '</ul>' | remove: '<li>' | remove: '</li>' | remove: '<p>' | remove: '</p>' | strip -%}
                        {%- if clean_val != blank -%}
                          <li class="about-us-section-1__value-item">
                            {% comment %} <span class="about-us-section-1__value-bullet">
                              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <circle cx="10" cy="10" r="10" fill="#EBF4EC"/>
                                <path d="M6 10.2L8.7 12.9L14 7.5" stroke="#2E7D32" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                              </svg>
                            </span> {% endcomment %}
                            <span class="about-us-section-1__value-text">{{ clean_val }}</span>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                {%- else -%}
                  {%- if block_description != blank -%}
                    <div class="about-us-section-1__card-description">
                      {%- if block_description contains '<p>' -%}
                        {{ block_description }}
                      {%- else -%}
                        <p>{{ block_description | newline_to_br }}</p>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  #about-us-section-1-{{ section.id }} {
    width: 100%;
    position: relative;
    box-sizing: border-box;
    font-family: inherit;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  #about-us-section-1-{{ section.id }} * {
    box-sizing: border-box;
  }

  /* --- TOP CONTENT AREA --- */
  #about-us-section-1-{{ section.id }} .about-us-section-1__top {
    background-color: var(--aus1-bg-top);
    padding-top: var(--aus1-pt);
    padding-bottom: var(--aus1-pb);
    width: 100%;
  }

  #about-us-section-1-{{ section.id }} .about-us-section-1__top-container {
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  #about-us-section-1-{{ section.id }} .about-us-section-1__heading {
    margin: 0 0 20px 0;
    font-size: 34px;
    line-height: 1.25;
    font-weight: 600;
    color: var(--aus1-heading-color);
    letter-spacing: -0.01em;
  }

  #about-us-section-1-{{ section.id }} .about-us-section-1__description {
    color: var(--aus1-body-color);
    font-size: 16.5px;
    line-height: 1.8;
    max-width: 890px;
    margin: 0 auto;
  }

  #about-us-section-1-{{ section.id }} .about-us-section-1__description p {
    margin: 0 0 16px 0;
    color: inherit;
    font-size: inherit;
    line-height: inherit;
  }

  #about-us-section-1-{{ section.id }} .about-us-section-1__description p:last-child {
    margin-bottom: 0;
  }

  /* --- VISION + MISSION CARDS AREA --- */
  #about-us-section-1-{{ section.id }} .about-us-section-1__cards-area {
    background-color: var(--aus1-bg-cards);
    padding-top: var(--aus1-cards-pt);
    padding-bottom: var(--aus1-cards-pb);
    width: 100%;
  }

  #about-us-section-1-{{ section.id }} .about-us-section-1__cards-container {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 24px;
  }

  #about-us-section-1-{{ section.id }} .about-us-section-1__cards-grid {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_most: 3 | at_least: 1 }}, 1fr);
    gap: 32px;
    align-items: stretch;
  }

  #about-us-section-1-{{ section.id }} .about-us-section-1__card {
    background-color: var(--aus1-card-bg);
    border-radius: var(--aus1-card-radius);
    padding: 48px 36px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    border: 1px solid rgba(0, 0, 0, 0.04);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    min-height: 220px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  #about-us-section-1-{{ section.id }} .about-us-section-1__card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.04);
  }

  #about-us-section-1-{{ section.id }} .about-us-section-1__card-inner {
    width: 100%;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #about-us-section-1-{{ section.id }} .about-us-section-1__card-heading {
    margin: 0 0 14px 0;
    font-size: 24px;
    line-height: 1.3;
    font-weight: 600;
    color: var(--aus1-card-heading-color);
    letter-spacing: -0.01em;
  }

    #about-us-section-1-{{ section.id }} .about-us-section-1__card-description {
    color: var(--aus1-card-text-color);
    font-size: 15.5px;
    line-height: 1.65;
  }

  #about-us-section-1-{{ section.id }} .about-us-section-1__card-description p {
    margin: 0 0 12px 0;
    color: inherit;
    font-size: inherit;
    line-height: inherit;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  #about-us-section-1-{{ section.id }} .about-us-section-1__card-description p:last-child {
    margin-bottom: 0;
  }

  /* --- VALUES LIST STYLING --- */
  #about-us-section-1-{{ section.id }} .about-us-section-1__values-list {
    list-style: none;
    padding: 0;
    margin: 4px auto 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    width: fit-content;
    text-align: left;
  }

  #about-us-section-1-{{ section.id }} .about-us-section-1__value-item {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--aus1-card-text-color);
    font-size: 15.5px;
    line-height: 1.4;
    font-weight: 500;
  }

  #about-us-section-1-{{ section.id }} .about-us-section-1__value-bullet {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* --- RESPONSIVE / MOBILE STYLES --- */
  @media screen and (max-width: 991px) {
    #about-us-section-1-{{ section.id }} .about-us-section-1__heading {
      font-size: 28px;
    }

    #about-us-section-1-{{ section.id }} .about-us-section-1__description {
      font-size: 15.5px;
      line-height: 1.75;
    }

    #about-us-section-1-{{ section.id }} .about-us-section-1__cards-grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }

    #about-us-section-1-{{ section.id }} .about-us-section-1__card {
      padding: 38px 28px;
    }
  }

  @media screen and (max-width: 767px) {
    #about-us-section-1-{{ section.id }} .about-us-section-1__top {
      padding-top: var(--aus1-pt-mb);
      padding-bottom: var(--aus1-pb-mb);
    }

    #about-us-section-1-{{ section.id }} .about-us-section-1__top-container {
      padding: 0 18px;
    }

    #about-us-section-1-{{ section.id }} .about-us-section-1__heading {
      font-size: 24px;
      margin-bottom: 14px;
    }

    #about-us-section-1-{{ section.id }} .about-us-section-1__description {
      font-size: 14.5px;
      line-height: 1.7;
    }

    #about-us-section-1-{{ section.id }} .about-us-section-1__cards-area {
      padding-top: var(--aus1-cards-pt-mb);
      padding-bottom: var(--aus1-cards-pb-mb);
    }

    #about-us-section-1-{{ section.id }} .about-us-section-1__cards-container {
      padding: 0 18px;
    }

    #about-us-section-1-{{ section.id }} .about-us-section-1__cards-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    #about-us-section-1-{{ section.id }} .about-us-section-1__card {
      padding: 32px 20px;
      min-height: auto;
    }

    #about-us-section-1-{{ section.id }} .about-us-section-1__card-heading {
      font-size: 21px;
      margin-bottom: 10px;
    }

    #about-us-section-1-{{ section.id }} .about-us-section-1__card-description {
      font-size: 14.5px;
      line-height: 1.6;
    }

    #about-us-section-1-{{ section.id }} .about-us-section-1__values-list {
      gap: 10px;
    }

    #about-us-section-1-{{ section.id }} .about-us-section-1__value-item {
      font-size: 14.5px;
    }
  }
</style>

