{%- liquid
  assign heading = section.settings.heading | default: 'In the Press'
  assign subheading = section.settings.subheading
  assign heading_color = section.settings.heading_color | default: '#000000'
  assign subheading_color = section.settings.subheading_color | default: '#555555'
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  
  assign card_bg = section.settings.card_bg | default: '#FFF6D6'
  assign card_text_color = section.settings.card_text_color | default: '#2C221E'
  assign card_radius = section.settings.card_radius | default: 16
  
  assign outlet_color = section.settings.outlet_color | default: '#1F2937'
  assign read_time_color = section.settings.read_time_color | default: '#6B7280'
  
  assign desktop_columns = section.settings.desktop_columns | default: 4
  assign card_gap = section.settings.card_gap | default: 20
  
  assign padding_top = section.settings.padding_top | default: 40
  assign padding_bottom = section.settings.padding_bottom | default: 40
-%}

<div
  id="custom-section-11-{{ section.id }}"
  class="custom-section-11"
  style="
    --cs11-bg: {{ bg_color }};
    --cs11-heading-color: {{ heading_color }};
    --cs11-subheading-color: {{ subheading_color }};
    --cs11-card-bg: {{ card_bg }};
    --cs11-card-text: {{ card_text_color }};
    --cs11-card-radius: {{ card_radius }}px;
    --cs11-outlet-color: {{ outlet_color }};
    --cs11-readtime-color: {{ read_time_color }};
    --cs11-columns: {{ desktop_columns }};
    --cs11-gap: {{ card_gap }}px;
    --cs11-pt: {{ padding_top }}px;
    --cs11-pb: {{ padding_bottom }}px;
  "
>
  <div class="custom-section-11__container">
    {%- if heading != blank or subheading != blank -%}
      <div class="custom-section-11__header">
        {%- if heading != blank -%}
          <h2 class="custom-section-11__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="custom-section-11__subheading">{{ subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="custom-section-11__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign quote_text = block.settings.quote_text
            assign outlet_name = block.settings.outlet_name
            assign read_time = block.settings.read_time
            assign logo_image = block.settings.logo_image
            assign logo_url = block.settings.logo_url
            assign link = block.settings.link
          -%}
          <div class="custom-section-11__card-wrapper" {{ block.shopify_attributes }}>
            {%- if link != blank -%}
              <a href="{{ link }}" class="custom-section-11__card custom-section-11__card--link" target="_blank" rel="noopener noreferrer">
            {%- else -%}
              <div class="custom-section-11__card">
            {%- endif -%}

              <div class="custom-section-11__quote-box">
                {%- if quote_text != blank -%}
                  <blockquote class="custom-section-11__quote">
                    {{ quote_text }}
                  </blockquote>
                {%- endif -%}
              </div>

              <div class="custom-section-11__footer">
                <div class="custom-section-11__logo-wrap">
                  {%- if logo_image != blank -%}
                    {{
                      logo_image
                      | image_url: width: 120
                      | image_tag:
                        loading: 'lazy',
                        class: 'custom-section-11__logo-img',
                        widths: '60, 90, 120',
                        alt: outlet_name | default: 'Press Outlet Logo'
                    }}
                  {%- elsif logo_url != blank -%}
                    <img
                      src="{{ logo_url }}"
                      loading="lazy"
                      class="custom-section-11__logo-img"
                      alt="{{ outlet_name | default: 'Press Outlet Logo' | escape }}"
                      width="44"
                      height="44"
                    >
                  {%- else -%}
                    <svg class="custom-section-11__logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/>
                      <path d="M18 14h-8"/>
                      <path d="M15 18h-5"/>
                      <path d="M10 6h8v4h-8V6Z"/>
                    </svg>
                  {%- endif -%}
                </div>

                <div class="custom-section-11__meta">
                  {%- if outlet_name != blank -%}
                    <span class="custom-section-11__outlet-name">{{ outlet_name }}</span>
                  {%- endif -%}
                  {%- if read_time != blank -%}
                    <span class="custom-section-11__read-time">{{ read_time }}</span>
                  {%- endif -%}
                </div>
              </div>

            {%- if link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  #custom-section-11-{{ section.id }} {
    background-color: var(--cs11-bg);
    padding-top: var(--cs11-pt);
    padding-bottom: var(--cs11-pb);
    width: 100%;
    position: relative;
    box-sizing: border-box;
    font-family: inherit;
  }

  #custom-section-11-{{ section.id }} * {
    box-sizing: border-box;
  }

  #custom-section-11-{{ section.id }} .custom-section-11__container {
    max-width: 1360px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }

  #custom-section-11-{{ section.id }} .custom-section-11__header {
    text-align: center;
    margin-bottom: 36px;
  }

  #custom-section-11-{{ section.id }} .custom-section-11__heading {
    font-size: 26px;
    font-weight: 700;
    color: var(--cs11-heading-color);
    margin: 0 0 8px 0;
    line-height: 1.25;
    font-family: inherit;
  }

  #custom-section-11-{{ section.id }} .custom-section-11__subheading {
    font-size: 15px;
    color: var(--cs11-subheading-color);
    margin: 0;
    line-height: 1.5;
  }

  #custom-section-11-{{ section.id }} .custom-section-11__grid {
    display: grid;
    grid-template-columns: repeat(var(--cs11-columns), 1fr);
    gap: var(--cs11-gap);
    align-items: stretch;
  }

  #custom-section-11-{{ section.id }} .custom-section-11__card-wrapper {
    display: flex;
    height: 100%;
  }

  #custom-section-11-{{ section.id }} .custom-section-11__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  #custom-section-11-{{ section.id }} .custom-section-11__card--link:hover {
    transform: translateY(-4px);
  }

  #custom-section-11-{{ section.id }} .custom-section-11__quote-box {
    background-color: var(--cs11-card-bg);
    border-radius: var(--cs11-card-radius);
    padding: 30px 24px;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 140px;
  }

  #custom-section-11-{{ section.id }} .custom-section-11__quote {
    margin: 0;
    padding: 0;
    border: none;
    font-size: 15px;
    line-height: 1.45;
    font-weight: 700;
    color: var(--cs11-card-text);
    text-align: center;
    font-family: inherit;
  }

  #custom-section-11-{{ section.id }} .custom-section-11__footer {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 14px;
    padding-left: 2px;
  }

  #custom-section-11-{{ section.id }} .custom-section-11__logo-wrap {
    width: 44px;
    height: 44px;
    min-width: 44px;
    border-radius: 50%;
    border: 1px solid #E2E8F0;
    background-color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  #custom-section-11-{{ section.id }} .custom-section-11__logo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #custom-section-11-{{ section.id }} .custom-section-11__logo-icon {
    width: 20px;
    height: 20px;
    color: #64748B;
  }

  #custom-section-11-{{ section.id }} .custom-section-11__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  #custom-section-11-{{ section.id }} .custom-section-11__outlet-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--cs11-outlet-color);
    line-height: 1.2;
  }

  #custom-section-11-{{ section.id }} .custom-section-11__read-time {
    font-size: 12px;
    font-weight: 400;
    color: var(--cs11-readtime-color);
    line-height: 1.2;
  }

  @media (max-width: 1024px) {
    #custom-section-11-{{ section.id }} .custom-section-11__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    #custom-section-11-{{ section.id }} .custom-section-11__grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding-bottom: 8px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    #custom-section-11-{{ section.id }} .custom-section-11__grid::-webkit-scrollbar {
      display: none;
    }

    #custom-section-11-{{ section.id }} .custom-section-11__card-wrapper {
      flex: 0 0 82%;
      max-width: 300px;
      scroll-snap-align: start;
    }

    #custom-section-11-{{ section.id }} .custom-section-11__heading {
      font-size: 22px;
    }

    #custom-section-11-{{ section.id }} .custom-section-11__quote-box {
      padding: 24px 18px;
      min-height: 120px;
    }

    #custom-section-11-{{ section.id }} .custom-section-11__quote {
      font-size: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Section 11",
  "tag": "section",
  "class": "section-custom-11",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Header Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In the Press"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#555555"
    },
    {
      "type": "header",
      "content": "Card Settings"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Quote Box Background",
      "default": "#FFF6D6"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Quote Text Color",
      "default": "#2C221E"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 16
    },
    {
      "type": "color",
      "id": "outlet_color",
      "label": "Outlet Name Color",
      "default": "#1F2937"
    },
    {
      "type": "color",
      "id": "read_time_color",
      "label": "Read Time Color",
      "default": "#6B7280"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Desktop Columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap Between Cards",
      "default": 20
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "press_item",
      "name": "Press Card",
      "settings": [
        {
          "type": "textarea",
          "id": "quote_text",
          "label": "Quote / Press Headline",
          "default": "My Pahadi Dukan Secures Funding to Scale Himalayan Wellness Offerings"
        },
        {
          "type": "text",
          "id": "outlet_name",
          "label": "Publication / Outlet Name",
          "default": "The Hindu"
        },
        {
          "type": "text",
          "id": "read_time",
          "label": "Read Time / Subtitle",
          "default": "2 min read"
        },
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Outlet Logo Image"
        },
        {
          "type": "text",
          "id": "logo_url",
          "label": "Outlet Logo Image URL (Optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Article Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Section 11",
      "blocks": [
        {
          "type": "press_item",
          "settings": {
            "quote_text": "There's macaron towers and pesto babkas to treats from the mountains up North",
            "outlet_name": "The Hindu",
            "read_time": "2 min read"
          }
        },
        {
          "type": "press_item",
          "settings": {
            "quote_text": "My Pahadi Dukan Secures Funding to Scale Himalayan Wellness Offerings",
            "outlet_name": "The Hindu",
            "read_time": "2 min read"
          }
        },
        {
          "type": "press_item",
          "settings": {
            "quote_text": "My Pahadi Dukan Secures Funding to Scale Himalayan Wellness Offerings",
            "outlet_name": "The Hindu",
            "read_time": "2 min read"
          }
        },
        {
          "type": "press_item",
          "settings": {
            "quote_text": "My Pahadi Dukan Secures Funding to Scale Himalayan Wellness Offerings",
            "outlet_name": "The Hindu",
            "read_time": "2 min read"
          }
        }
      ]
    }
  ]
}
{% endschema %}
