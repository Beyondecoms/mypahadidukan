{{ 'section-seabuckthorn-m5.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign m5_eyebrow = product.metafields.custom.m5_eyebrow.value
  assign m5_heading = product.metafields.custom.m5_heading.value
  assign m5_quote = product.metafields.custom.m5_quote.value
  assign m5_desc = product.metafields.custom.m5_description.value
  assign m5_usage = product.metafields.custom.m5_usage_text.value
  assign m5_highlight = product.metafields.custom.m5_highlight_text.value
  assign m5_image = product.metafields.custom.m5_image.value | default: product.metafields.custom.m5_image
  assign m5_caption = product.metafields.custom.m5_image_caption.value
  assign m5_alt = m5_caption | default: m5_heading | default: product.title | escape

  assign has_content = false
  if m5_eyebrow != blank or m5_heading != blank or m5_quote != blank or m5_desc != blank or m5_usage != blank or m5_highlight != blank or m5_image != blank
    assign has_content = true
  endif
-%}

{%- if has_content -%}
<div class="sb-m5-section" style="{% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}">
  <div class="sb-m5-container">

    <!-- Main Card Box -->
    <div class="sb-m5-card-wrapper" style="background-color: {{ section.settings.card_bg }}; border-color: {{ section.settings.card_border_color }};">
      <div class="sb-m5-grid" style="{% if m5_image == blank %}grid-template-columns: 1fr;{% endif %}">
        
        <!-- Content Column -->
        <div class="sb-m5-content-col">
          {%- if m5_eyebrow != blank -%}
            <h4 class="sb-m5-header-title">{{ m5_eyebrow }}</h4>
          {%- endif -%}
          {%- if m5_heading != blank -%}
            <h2 class="sb-m5-main-heading">{{ m5_heading | newline_to_br }}</h2>
          {%- endif -%}
          
          {%- if m5_quote != blank -%}
            <div class="sb-m5-quote">
              "{{ m5_quote | newline_to_br }}"
            </div>
          {%- endif -%}

          {%- if m5_desc != blank or m5_usage != blank -%}
            <div class="sb-m5-body-text">
              {%- if m5_desc != blank -%}
                <p>{{ m5_desc | newline_to_br }}</p>
              {%- endif -%}
              {%- if m5_usage != blank -%}
                <p>{{ m5_usage | newline_to_br }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if m5_highlight != blank -%}
            <div class="sb-m5-handwritten">
              <em>{{ m5_highlight | newline_to_br }}</em>
            </div>
          {%- endif -%}
        </div>

        <!-- Image Column (Only if image is present) -->
        {%- if m5_image != blank -%}
          <div class="sb-m5-image-col">
            <div class="sb-m5-photo-box">
              {{ m5_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: m5_alt, width: 600, height: 450 }}
            </div>
            {%- if m5_caption != blank -%}
              <div class="sb-m5-photo-caption">{{ m5_caption }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>
    </div>

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "M5 - The honest warning",
  "tag": "section",
  "class": "section-sb-m5",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fffbef"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#e7ded0"
    }
  ],
  "presets": [
    {
      "name": "M5 - The honest warning"
    }
  ]
}
{% endschema %}
