{%- liquid
  assign heading = section.settings.heading
  assign heading_color = section.settings.heading_color | default: '#1F2937'
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign card_radius = section.settings.card_radius | default: 28
  assign card_gap = section.settings.card_gap | default: 24
  assign padding_top = section.settings.padding_top | default: 48
  assign padding_bottom = section.settings.padding_bottom | default: 48
-%}

<div
  id="custom-section-5-{{ section.id }}"
  class="custom-section-5"
  style="
    --cs5-bg: {{ bg_color }};
    --cs5-heading-color: {{ heading_color }};
    --cs5-card-radius: {{ card_radius }}px;
    --cs5-gap: {{ card_gap }}px;
    --cs5-pt: {{ padding_top }}px;
    --cs5-pb: {{ padding_bottom }}px;
  "
>
  <div class="custom-section-5__container">
    {%- if heading != blank -%}
      <div class="custom-section-5__header">
        <h2 class="custom-section-5__heading">{{ heading }}</h2>
      </div>
    {%- endif -%}

    <div class="custom-section-5__track-wrapper">
      <div class="custom-section-5__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign badge_text = block.settings.badge_text
            assign badge_bg = block.settings.badge_bg | default: 'rgba(255, 255, 255, 0.42)'
            assign badge_color = block.settings.badge_color | default: '#1F2937'
            assign title = block.settings.title
            assign title_color = block.settings.title_color | default: '#1F2937'
            assign card_bg = block.settings.card_bg | default: '#F59E0B'
            assign image = block.settings.image
            assign image_by_url = block.settings.image_by_url
            assign thumbnail = block.settings.thumbnail
            assign thumbnail_by_url = block.settings.thumbnail_by_url
            assign products_text = block.settings.products_text
            assign button_text = block.settings.button_text
            assign link = block.settings.link
          -%}

          <div
            class="custom-section-5__item"
            style="
              --cs5-item-bg: {{ card_bg }};
              --cs5-item-badge-bg: {{ badge_bg }};
              --cs5-item-badge-color: {{ badge_color }};
              --cs5-item-title-color: {{ title_color }};
            "
            {{ block.shopify_attributes }}
          >
            {%- if link != blank -%}
              <a href="{{ link }}" class="custom-section-5__card" aria-label="{{ title | default: 'Shop Brand' | escape }}">
            {%- else -%}
              <div class="custom-section-5__card">
            {%- endif -%}

              {%- if badge_text != blank -%}
                <div class="custom-section-5__badge-wrap">
                  <span class="custom-section-5__badge">{{ badge_text }}</span>
                </div>
              {%- endif -%}

              {%- if title != blank -%}
                <h3 class="custom-section-5__title">{{ title }}</h3>
              {%- endif -%}

              <div class="custom-section-5__media">
                {%- if image_by_url != blank -%}
                  <img
                    src="{{ image_by_url }}"
                    loading="lazy"
                    class="custom-section-5__media-img"
                    alt="{{ title | default: 'Brand Product' | escape }}"
                    width="450"
                    height="auto"
                  >
                {%- elsif image != blank -%}
                  {{
                    image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      class: 'custom-section-5__media-img',
                      widths: '240, 360, 480, 600',
                      alt: title | default: image.alt | default: 'Brand Product'
                  }}
                {%- else -%}
                  <div class="custom-section-5__media-placeholder">
                    {{ 'product-1' | placeholder_svg_tag: 'custom-section-5__media-placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>

              {%- if thumbnail != blank or thumbnail_by_url != blank or products_text != blank or button_text != blank -%}
                <div class="custom-section-5__bottom-box">
                  <div class="custom-section-5__thumbnail-box">
                    {%- if thumbnail_by_url != blank -%}
                      <img
                        src="{{ thumbnail_by_url }}"
                        loading="lazy"
                        class="custom-section-5__thumb-img"
                        alt="{{ title | default: 'Product' | escape }}"
                        width="80"
                        height="80"
                      >
                    {%- elsif thumbnail != blank -%}
                      {{
                        thumbnail
                        | image_url: width: 160
                        | image_tag:
                          loading: 'lazy',
                          class: 'custom-section-5__thumb-img',
                          widths: '60, 100, 160',
                          alt: title | default: thumbnail.alt | default: 'Product Thumbnail'
                      }}
                    {%- elsif image != blank -%}
                      {{
                        image
                        | image_url: width: 160
                        | image_tag:
                          loading: 'lazy',
                          class: 'custom-section-5__thumb-img',
                          widths: '60, 100, 160',
                          alt: title | default: image.alt | default: 'Product Thumbnail'
                      }}
                    {%- else -%}
                      <div class="custom-section-5__thumb-placeholder">
                        {{ 'product-1' | placeholder_svg_tag: 'custom-section-5__thumb-placeholder-svg' }}
                      </div>
                    {%- endif -%}
                  </div>

                  <div class="custom-section-5__info">
                    {%- if products_text != blank -%}
                      <span class="custom-section-5__count">{{ products_text }}</span>
                    {%- endif -%}
                    {%- if button_text != blank -%}
                      <span class="custom-section-5__btn-text">{{ button_text }}</span>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}

            {%- if link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          {%- comment -%} Default placeholder state {%- endcomment -%}
          <div class="custom-section-5__item" style="--cs5-item-bg: #F59E0B; --cs5-item-badge-bg: rgba(255,255,255,0.42); --cs5-item-badge-color: #1F2937; --cs5-item-title-color: #1F2937;">
            <div class="custom-section-5__card">
              <div class="custom-section-5__badge-wrap"><span class="custom-section-5__badge">Daily Nutrition</span></div>
              <h3 class="custom-section-5__title">My Pahadi Dukan</h3>
              <div class="custom-section-5__media">
                <div class="custom-section-5__media-placeholder">{{ 'product-1' | placeholder_svg_tag: 'custom-section-5__media-placeholder-svg' }}</div>
              </div>
              <div class="custom-section-5__bottom-box">
                <div class="custom-section-5__thumbnail-box">{{ 'product-1' | placeholder_svg_tag: 'custom-section-5__thumb-placeholder-svg' }}</div>
                <div class="custom-section-5__info">
                  <span class="custom-section-5__count">100 Products</span>
                  <span class="custom-section-5__btn-text">Shop Now</span>
                </div>
              </div>
            </div>
          </div>

          <div class="custom-section-5__item" style="--cs5-item-bg: #82C4EB; --cs5-item-badge-bg: rgba(255,255,255,0.42); --cs5-item-badge-color: #1F2937; --cs5-item-title-color: #1F2937;">
            <div class="custom-section-5__card">
              <div class="custom-section-5__badge-wrap"><span class="custom-section-5__badge">Immunity Boost</span></div>
              <h3 class="custom-section-5__title">Planet Mushroom</h3>
              <div class="custom-section-5__media">
                <div class="custom-section-5__media-placeholder">{{ 'product-2' | placeholder_svg_tag: 'custom-section-5__media-placeholder-svg' }}</div>
              </div>
              <div class="custom-section-5__bottom-box">
                <div class="custom-section-5__thumbnail-box">{{ 'product-2' | placeholder_svg_tag: 'custom-section-5__thumb-placeholder-svg' }}</div>
                <div class="custom-section-5__info">
                  <span class="custom-section-5__count">100 Products</span>
                  <span class="custom-section-5__btn-text">Shop Now</span>
                </div>
              </div>
            </div>
          </div>

          <div class="custom-section-5__item" style="--cs5-item-bg: #FEE79A; --cs5-item-badge-bg: rgba(255,255,255,0.42); --cs5-item-badge-color: #1F2937; --cs5-item-title-color: #1F2937;">
            <div class="custom-section-5__card">
              <div class="custom-section-5__badge-wrap"><span class="custom-section-5__badge">Daily Nutrition</span></div>
              <h3 class="custom-section-5__title">Bilona</h3>
              <div class="custom-section-5__media">
                <div class="custom-section-5__media-placeholder">{{ 'product-3' | placeholder_svg_tag: 'custom-section-5__media-placeholder-svg' }}</div>
              </div>
              <div class="custom-section-5__bottom-box">
                <div class="custom-section-5__thumbnail-box">{{ 'product-3' | placeholder_svg_tag: 'custom-section-5__thumb-placeholder-svg' }}</div>
                <div class="custom-section-5__info">
                  <span class="custom-section-5__count">100 Products</span>
                  <span class="custom-section-5__btn-text">Shop Now</span>
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<style>
  #custom-section-5-{{ section.id }} {
    background-color: var(--cs5-bg);
    padding-top: var(--cs5-pt);
    padding-bottom: var(--cs5-pb);
    width: 100%;
    position: relative;
    box-sizing: border-box;
    font-family: inherit;
  }
  @media only screen and (max-width: 749px){
    #custom-section-5-{{ section.id }}{
         padding-top: 30px;
    padding-bottom: 30px;
    }
  }

  #custom-section-5-{{ section.id }} * {
    box-sizing: border-box;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__container {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 24px;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__header {
    text-align: center;
    margin-bottom: 32px;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__heading {
    margin: 0;
    font-size: 26px;
    font-weight: 700;
    color: var(--cs5-heading-color);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__track-wrapper {
    width: 100%;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--cs5-gap);
    width: 100%;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__item {
    width: 100%;
    height: 100%;
    display: flex;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    border-radius: var(--cs5-card-radius);
    background-color: var(--cs5-item-bg);
    overflow: hidden;
    padding: 28px 24px 24px 24px;
    min-height: 480px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  #custom-section-5-{{ section.id }} .custom-section-5__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
  }

  #custom-section-5-{{ section.id }} .custom-section-5__badge-wrap {
    margin-bottom: 12px;
    z-index: 2;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__badge {
    display: inline-block;
    padding: 6px 18px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    background-color: var(--cs5-item-badge-bg);
    color: var(--cs5-item-badge-color);
    letter-spacing: 0.01em;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  #custom-section-5-{{ section.id }} .custom-section-5__title {
    margin: 0 0 16px 0;
    font-size: 22px;
    font-weight: 700;
    color: var(--cs5-item-title-color);
    text-align: center;
    line-height: 1.25;
    z-index: 2;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__media {
    position: absolute;
    top: 90px;
    bottom: 80px;
    left: -10%;
    right: -10%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    z-index: 1;
    pointer-events: none;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__media-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    transform: rotate(-6deg) scale(1.15);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  #custom-section-5-{{ section.id }} .custom-section-5__card:hover .custom-section-5__media-img {
    transform: rotate(-3deg) scale(1.22);
  }

  #custom-section-5-{{ section.id }} .custom-section-5__media-placeholder {
    width: 60%;
    height: 60%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.3;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__media-placeholder-svg {
    width: 100%;
    height: 100%;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__bottom-box {
    margin-top: auto;
    width: 100%;
    background: #FFFFFF;
    border-radius: 18px;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    z-index: 3;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__card:hover .custom-section-5__bottom-box {
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
  }

  #custom-section-5-{{ section.id }} .custom-section-5__thumbnail-box {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    background-color: #F4F4F6;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 4px;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__thumb-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.4;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__thumb-placeholder-svg {
    width: 80%;
    height: 80%;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    min-width: 0;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__count {
    font-size: 15px;
    font-weight: 700;
    color: #1F2937;
    line-height: 1.25;
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #custom-section-5-{{ section.id }} .custom-section-5__btn-text {
    font-size: 13px;
    font-weight: 600;
    color: #BA5D37;
    text-decoration: underline;
    text-underline-offset: 3px;
    line-height: 1.2;
    display: inline-block;
  }

  @media (max-width: 991px) {
    #custom-section-5-{{ section.id }} .custom-section-5__container {
      padding: 0 16px;
    }

    #custom-section-5-{{ section.id }} .custom-section-5__grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-bottom: 8px;
      gap: 16px;
    }

    #custom-section-5-{{ section.id }} .custom-section-5__grid::-webkit-scrollbar {
      display: none;
    }

    #custom-section-5-{{ section.id }} .custom-section-5__item {
      flex: 0 0 82%;
      max-width: 340px;
      scroll-snap-align: center;
    }

    #custom-section-5-{{ section.id }} .custom-section-5__card {
      min-height: 440px;
      padding: 24px 18px 18px 18px;
    }

    #custom-section-5-{{ section.id }} .custom-section-5__heading {
      font-size: 22px;
    }

    #custom-section-5-{{ section.id }} .custom-section-5__title {
      font-size: 20px;
    }
  }

  @media (max-width: 767px) {
    #custom-section-5-{{ section.id }} .custom-section-5__container {
      padding: 0 12px;
    }

    #custom-section-5-{{ section.id }} .custom-section-5__header {
      margin-bottom: 22px;
    }

    #custom-section-5-{{ section.id }} .custom-section-5__heading {
      font-size: 20px;
    }

    #custom-section-5-{{ section.id }} .custom-section-5__item {
      flex: 0 0 85%;
      max-width: 320px;
    }

    #custom-section-5-{{ section.id }} .custom-section-5__card {
      min-height: 420px;
    }
  }
</style>

{% schema %}
{
  "name": "Shop by Brand (Section 5)",
  "tag": "section",
  "class": "custom-section-5-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Brand"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1F2937"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 28
