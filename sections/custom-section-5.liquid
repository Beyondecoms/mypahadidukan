      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "brand_card",
      "name": "Brand Card",
      "settings": [
        {
          "type": "text",
          "id": "badge_text",
          "label": "Top badge text",
          "default": "Daily Nutrition"
        },
        {
          "type": "color",
          "id": "badge_bg",
          "label": "Badge background color",
          "default": "rgba(255, 255, 255, 0.42)"
        },
        {
          "type": "color",
          "id": "badge_color",
          "label": "Badge text color",
          "default": "#1F2937"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Brand title",
          "default": "My Pahadi Dukan"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Brand title color",
          "default": "#1F2937"
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Card background color",
          "default": "#F59E0B"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Main product image"
        },
        {
          "type": "text",
          "id": "image_by_url",
          "label": "Main product image by URL (optional)"
        },
        {
          "type": "header",
          "content": "Bottom Info Card"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail image"
        },
        {
          "type": "text",
          "id": "thumbnail_by_url",
          "label": "Thumbnail image by URL (optional)"
        },
        {
          "type": "text",
          "id": "products_text",
          "label": "Products count text",
          "default": "100 Products"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Brand (Section 5)",
      "blocks": [
        {
          "type": "brand_card",
          "settings": {
            "badge_text": "Daily Nutrition",
            "title": "My Pahadi Dukan",
            "card_bg": "#F59E0B",
            "products_text": "100 Products",
            "button_text": "Shop Now"
          }
        },
        {
          "type": "brand_card",
          "settings": {
            "badge_text": "Immunity Boost",
            "title": "Planet Mushroom",
            "card_bg": "#82C4EB",
            "products_text": "100 Products",
            "button_text": "Shop Now"
          }
        },
        {
          "type": "brand_card",
          "settings": {
            "badge_text": "Daily Nutrition",
            "title": "Bilona",
            "card_bg": "#FEE79A",
            "products_text": "100 Products",
            "button_text": "Shop Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
