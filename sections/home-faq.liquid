{{ 'faq-accordion.css' | asset_url | stylesheet_tag }}

<section class="faq-section" style="background-color: {{ section.settings.bg_color }};">
  <div class="faq-container">

    <div class="faq-header">
      <p class="faq-eyebrow" style="color: {{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow_text }}</p>
      <h2 class="faq-title" style="color: {{ section.settings.heading_color }};">{{ section.settings.title }}</h2>
    </div>

    <div class="faq-list" style="border-top: 1px solid {{ section.settings.border_color }};">
      {% for block in section.blocks %}
        <details class="faq-item" style="border-bottom: 1px solid {{ section.settings.border_color }};" {{ block.shopify_attributes }}>
          <summary class="faq-question" style="color: {{ section.settings.heading_color }};">
            {{ block.settings.question }}
            <span class="faq-icon" style="color: {{ section.settings.icon_color }};"></span>
          </summary>
          <div class="faq-answer" style="color: {{ section.settings.text_color }};">
            {{ block.settings.answer }}
          </div>
        </details>
      {% endfor %}
    </div>

  </div>
</section>

{% if section.blocks.size > 0 %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for block in section.blocks %}
    {
      "@type": "Question",
      "name": {{ block.settings.question | strip_html | strip_newlines | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ block.settings.answer | strip_html | strip_newlines | json }}
      }
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
</script>
{% endif %}

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "Got Questions?"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Things People Ask Us"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#422D26"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Question / heading color",
      "default": "#FAE4C5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Answer text color",
      "default": "#CEAE95"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#D38946"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#D38946"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider line color",
      "default": "#5A3D34"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question goes here?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer goes here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Are your products really sourced from the Himalayas?",
            "answer": "<p>Yes. Every product we sell is sourced directly from farmers, self-help groups, and cooperatives across nine Himalayan states — including Kashmir, Ladakh, Himachal Pradesh, Uttarakhand, Sikkim, and Meghalaya — as well as Bhutan. We work source-to-shelf, which means we know exactly where each batch comes from. No middlemen, no mystery sourcing.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do you verify purity and authenticity?",
            "answer": "<p>Every batch goes through rigorous lab testing before it reaches you. We believe purity should be something you can verify, not just something we claim — so our products are tested for active compounds, contaminants, and adulteration depending on the category.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How is Kashmiri Saffron different from regular saffron?",
            "answer": "<p>Real saffron has a distinct colour, aroma, and slightly bitter taste — qualities cheap imitations can't replicate. We send our saffron to an independent, government-accredited lab for testing. Our latest batch passed all purity and quality checks under FSSAI standards.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What makes your Shilajit different from other brands?",
            "answer": "<p>Most shilajit sold online isn't sourced from Ladakh at all, despite the label. Ours is — harvested from high-altitude rocks in the Ladakh region, then purified using traditional methods. It's 100% pure resin, with no additives or fillers.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Are your products organic and chemical-free?",
            "answer": "<p>Yes — our products are grown and processed without synthetic chemicals, following traditional Pahadi methods used by mountain communities for generations.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do you test for heavy metals and contaminants?",
            "answer": "<p>Yes. Categories like Shilajit, A2 Ghee, and spices are particularly prone to contamination, so we prioritize lab testing for heavy metals before a batch is approved for sale.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Where can I see lab reports and quality certificates?",
            "answer": "<p>We publish third-party lab test reports for key products like our Kashmiri Saffron, tested by independent, ISO-certified labs such as FARE Labs. You'll find these on the relevant product pages.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do you support the farmers you source from?",
            "answer": "<p>We work directly with farmers, women's collectives, and cooperatives across the Himalayan region, cutting out middlemen so producers earn a fairer share.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
.faq-section {
  padding: 0px 24px;
}

.faq-container {
  max-width: 860px;
  margin: 0 auto;
}

.faq-header {
  margin-bottom: 20px;
}

.faq-eyebrow {
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  margin: 0 0 10px;
}

.faq-title {
  font-size: clamp(25px, 3vw, 36px);
  font-weight: 600;
  text-transform: uppercase;
  margin: 0;
}

.faq-item {
  list-style: none;
}

.faq-item > summary {
  list-style: none;
}
.faq-item > summary::-webkit-details-marker {
  display: none;
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  padding: 20px 0;
  font-size: 15px;
  font-weight: 500;
  cursor: pointer;
  user-select: none;
}

.faq-icon {
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  position: relative;
}

.faq-icon::before,
.faq-icon::after {
  content: '';
  position: absolute;
  background: currentColor;
  border-radius: 1px;
  transition: transform 0.25s ease, opacity 0.25s ease;
}

.faq-icon::before {
  width: 14px;
  height: 1.5px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.faq-icon::after {
  width: 1.5px;
  height: 14px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.faq-item[open] .faq-icon::after {
  transform: translate(-50%, -50%) rotate(90deg);
  opacity: 0;
}

.faq-answer {
  padding: 0 32px 20px 0;
  font-size: 14px;
  line-height: 1.75;
  opacity: 0.85;
}

.faq-answer p {
  margin: 0;
}

@media (max-width: 600px) {
  .faq-section {
    padding: 0px 16px;
  }
  .faq-question {
    font-size: 14px;
    padding: 16px 0;
  }
}

{% endstyle %}