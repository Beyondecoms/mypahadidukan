      "default": "HOURS"
    },
    {
      "type": "text",
      "id": "unit_minutes",
      "label": "Minutes label",
      "default": "MINUTES"
    },
    {
      "type": "text",
      "id": "unit_seconds",
      "label": "Seconds label",
      "default": "SECONDS"
