    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "bg_from",
      "label": "Background left",
      "default": "#060A0E"
    },
    {
      "type": "color",
      "id": "bg_mid",
      "label": "Background middle",
      "default": "#0E1D28"
    },
    {
      "type": "color",
      "id": "bg_to",
      "label": "Background right",
      "default": "#152A3A"
    }
  ],
  "presets": [
    {
      "name": "Black Friday hero"
    }
  ]
}
{% endschema %}
