{{ 'collection-tabs-showcase.css' | asset_url | stylesheet_tag }}

<section class="collection-tabs">
  <div class="tabs-wrapper">

    <!-- Tabs Header -->
    {% render 'collection-tabs-header', section: section %}

    <!-- Content: the ONE real collection for this URL -->
    <div class="tabs-content">
      <div class="tab-content active" id="current-collection-tab">

        {% if collection != blank %}
          <div class="collection-main">

            <!-- TOP BAR -->
            {% render 'collection-topbar', collection: collection %}

            {%- if collection.products_count == 0 -%}
              <!-- EMPTY COLLECTION -->
              <div class="no-products no-products--empty">
                <p>{{ 'sections.collection_template.empty' | t }}</p>
              </div>
            {%- else -%}
            {%- comment -%}
              Filtering, sorting and paging all run in the browser, so every product has to be in the page.
              Without paginate, collection.products stops at 50; Shopify allows up to 250 per page.
              The browser-side page number is kept in ?pg=N because ?page=N is read by paginate.
            {%- endcomment -%}
            {%- paginate collection.products by 250 -%}

            {%- if paginate.current_page > 1 and collection.products.size == 0 -%}
              {%- comment -%} Old ?page=N links: everything is on server page 1, so send them to the browser-side page instead. {%- endcomment -%}
              <script>
                (function () {
                  var url = new URL(window.location.href);
                  var page = url.searchParams.get('page');
                  url.searchParams.delete('page');
                  if (page) url.searchParams.set('pg', page);
                  window.location.replace(url.toString());
                })();
              </script>
            {%- endif -%}

            {%- comment -%}
              Pre-pass over the products:
              - Place filter: a product's places are the tab collections (section blocks) it belongs to.
                Skipped on a tab collection's own page, where every product is in that one place.
              - Price slider ceiling: at least 5000, raised to cover the dearest pack shown on a card.
            {%- endcomment -%}
            {%- liquid
              assign place_handles = ','
              for block in section.blocks
                assign tab_collection = collections[block.settings.collection]
                if tab_collection != blank
                  assign place_handles = place_handles | append: tab_collection.handle | append: ','
                endif
              endfor
              assign current_needle = ',' | append: collection.handle | append: ','
              assign use_places = true
              if place_handles contains current_needle or place_handles == ','
                assign use_places = false
              endif

              assign card_places = ''
              assign card_price_max = 0
              for product in collection.products
                assign card_variant = product.selected_or_first_available_variant
                if card_variant.price > card_price_max
                  assign card_price_max = card_variant.price
                endif
                if use_places
                  assign this_places = ','
                  for product_collection in product.collections
                    assign needle = ',' | append: product_collection.handle | append: ','
                    if place_handles contains needle
                      assign this_places = this_places | append: product_collection.handle | append: ','
                    endif
                  endfor
                  assign card_places = card_places | append: this_places | append: '|'
                endif
              endfor
              assign card_places_list = card_places | split: '|'

              assign price_ceiling = card_price_max | divided_by: 10000.0 | ceil | times: 100
              if price_ceiling < 5000
                assign price_ceiling = 5000
              endif
            -%}

            <!-- FILTER + GRID WRAPPER -->
            <div class="filter-grid-wrapper">

              <!-- FILTER SIDEBAR -->
              {% render 'collection-filter-drawer',
                collection: collection,
                products: collection.products,
                section: section,
                card_places: card_places,
                price_ceiling: price_ceiling
              %}

              <!-- GRID AREA -->
              <div class="grid-area">
                <div id="activeFilters" class="active-filters"></div>

                <div class="products-grid">
                  {% for product in collection.products %}
                    {%- liquid
                      assign card_variant = product.selected_or_first_available_variant
                      assign card_rating = product.metafields.reviews.rating.value
                    -%}
                    <div class="product-link">
                      <div class="product-card{% unless card_variant.available %} product-card--sold-out{% endunless %}"
                           data-index="{{ forloop.index }}"
                           data-available="{{ card_variant.available }}"
                           data-price="{{ card_variant.price | divided_by: 100.0 }}"
                           data-created="{{ product.created_at | date: '%s' }}"
                           data-type="{{ product.type | downcase | escape }}"
                           data-places="{{ card_places_list[forloop.index0] }}"
                           data-tags="{{ product.tags | join: ',' | downcase | escape }}">

                        <!-- IMAGE -->
                        <a href="{{ product.url }}" class="product-image-wrapper">
                          {% if product.tags contains 'Trending' %}
                            <div class="discount-badge">
                              Trending
                            </div>
                          {% endif %}
                          {% if product.tags contains 'Recommended' %}
                            <div class="discount-badge" style="background-color:#ad74b1;">
                              Recommended
                            </div>
                          {% endif %}
                          <button
                            type="button"
                            aria-label="Add to Wishlist"
                            class="swym-button swym-add-to-wishlist-view-product product_{{ product.id }}"
                            data-with-epi="true"
                            data-swaction="addToWishlist"
                            data-product-id="{{ product.id }}"
                            data-variant-id="{{ card_variant.id }}"
                            data-product-url="{{ shop.url | append: product.url }}">
                          </button>
                          {%- if product.featured_image != blank -%}
                            <img
                              src="{{ product.featured_image | image_url: width: 400 }}"
                              alt="{{ product.title | escape }}"
                              width="400"
                              height="{{ 400 | divided_by: product.featured_image.aspect_ratio | round }}"
                              {% if forloop.index > 4 %}loading="lazy"{% endif %}
                            >
                          {%- endif -%}
                        </a>

                        <!-- EXTRA OFFER BAR (not shown on sold-out cards) -->
                        {%- if card_variant.available -%}
                          <div class="extra-offer">Extra 10% Discount at Checkout</div>
                        {%- endif -%}

                        <!-- TITLE (clamped to two lines in CSS) -->
                        <a href="{{ product.url }}" class="product-title">{{ product.title | escape }}</a>

                        <!-- VARIANT: the same pack drives label, price and Add To Cart -->
                        {%- unless product.has_only_default_variant -%}
                          <div class="product-variant">{{ card_variant.title | escape }}</div>
                        {%- endunless -%}

                        <!-- RATING (only when the product has review data) -->
                        {%- if card_rating != blank -%}
                        {%- assign ps_rating_float = card_rating | append: '' | plus: 0.0 -%}
                        {%- assign ps_rating_int = ps_rating_float | floor -%}
                        {%- assign ps_rating_dec = ps_rating_float | minus: ps_rating_int -%}
                        {%- assign ps_partial_star = ps_rating_int | plus: 1 -%}
                        {%- assign ps_dec_width = ps_rating_dec | times: 100 | round -%}

                        <div class="ps-stars">
                          {%- for i in (1..5) -%}
                            {%- if i <= ps_rating_int -%}
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="#f59e0b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                            {%- elsif i == ps_partial_star and ps_dec_width > 0 -%}
                              <span style="position:relative;display:inline-block;width:16px;height:16px;vertical-align:middle;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="#d1d5db" style="position:absolute;left:0;top:0;display:block;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                <span style="position:absolute;left:0;top:0;overflow:hidden;width:{{ ps_dec_width }}%;height:100%;display:block;">
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="#f59e0b" style="display:block;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                </span>
                              </span>
                            {%- else -%}
                              <svg width="16" height="16" viewBox="0 0 24 24" fill="#d1d5db" style="display:block;vertical-align:middle;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                            {%- endif -%}
                          {%- endfor -%}
                          <span class="ps-rating-score">{{ ps_rating_float | round: 1 }}</span>
                        </div>
                        {%- endif -%}

                        <!-- PRICE -->
                        <div class="product-price">
                          {% if card_variant.compare_at_price > card_variant.price %}
                            <span class="compare">{{ card_variant.compare_at_price | money }}</span>
                          {% endif %}
                          <span class="price">{{ card_variant.price | money }}</span>
                          {% if card_variant.compare_at_price > card_variant.price %}
                            <span class="price-off">
                              {{ card_variant.compare_at_price | minus: card_variant.price | times: 100 | divided_by: card_variant.compare_at_price }}% OFF
                            </span>
                          {% endif %}
                        </div>

                        <!-- ADD TO CART -->
                        {%- if card_variant.available -%}
                          <button type="button" class="add-to-cart" data-variant-id="{{ card_variant.id }}">
                            Add To Cart
                          </button>
                        {%- else -%}
                          <button type="button" class="add-to-cart add-to-cart--oos" disabled>
                            Out of Stock
                          </button>
                        {%- endif -%}

                      </div>
                    </div>
                  {% endfor %}
                </div>

                <div class="pagination" id="pagination"></div>

                <div class="no-products" id="noProducts" style="display:none;">
                  <p>No products found for selected filters.</p>
                </div>

              </div><!-- /grid-area -->

            </div><!-- /filter-grid-wrapper -->

            {%- endpaginate -%}

            <!-- SORT DRAWER -->
            {% render 'collection-sort-drawer' %}

            <!-- Dimmed backdrop behind the mobile filter / sort sheets -->
            <div class="collection-sheet-backdrop" aria-hidden="true"></div>
            {%- endif -%}

          </div>

        {% else %}
          <p>No products found</p>
        {% endif %}

      </div>
    </div>

  </div>
</section>

<script>
/* =========================
   FILTER / SORT / PAGINATION
   (operates on the single real collection grid — no tab loop needed)
========================= */
(function () {
  const tab = document.getElementById('current-collection-tab');
  if (!tab) return;
  const grid = tab.querySelector('.products-grid');
  if (!grid) return;

  /* ---- element refs ---- */
  const filterToggleBtn        = tab.querySelectorAll('.filterToggle');
  const deskFilterToggleBtn    = tab.querySelectorAll('.desktop-topbar .filterToggle');
  const filterDrawer           = tab.querySelector('.filterDrawer');
  const closeFilterBtns        = tab.querySelectorAll('.closeFilter');
  const clearAllBtns           = tab.querySelectorAll('.fd-clear-btn');
  const filterGridWrap         = tab.querySelector('.filter-grid-wrapper');

  const sortToggleBtn          = tab.querySelectorAll('.sortToggle');
  const sortDrawer             = tab.querySelector('.sort-drawer');
  const closeSortBtn           = tab.querySelectorAll('.closeSort');
  const sheetBackdrop          = tab.querySelector('.collection-sheet-backdrop');

  const availabilityCheckboxes = tab.querySelectorAll('.filter-availability');
  const typeCheckboxes         = tab.querySelectorAll('.filter-type');
  const placeCheckboxes        = tab.querySelectorAll('.filter-place');
  const filterCheckboxes       = tab.querySelectorAll('.filter-availability, .filter-type, .filter-place');

  /* chips go in the desktop sidebar and in the mobile sheet */
  const chipBoxes              = tab.querySelectorAll('#drawerActiveFilters, #fdActiveChips');
  const countEls               = tab.querySelectorAll('.productCount');
  const noProducts             = tab.querySelector('#noProducts');
  const paginationEl           = tab.querySelector('#pagination');
  const sortStatusMessages     = tab.querySelectorAll('.sort-status-message');

  const rangeMin               = tab.querySelector('#priceRangeMin');
  const rangeMax               = tab.querySelector('#priceRangeMax');
  const mobRangeMin            = tab.querySelector('.fd-range-min');
  const mobRangeMax            = tab.querySelector('.fd-range-max');

  /* slider ceiling comes from the markup; at the ceiling there is no upper price limit */
  const PRICE_CEIL = Number((rangeMax || mobRangeMax || {}).max) || 5000;
  const PAGE_PARAM = 'pg';
  const AVAIL_LABELS = { in: 'In stock', out: 'Out of stock' };
  const SORT_TAGS = { recommended: 'recommended', trending: 'trending', bestseller: 'bestseller' };

  let _minPrice = 0;
  let _maxPrice = PRICE_CEIL;

  function isMobile() {
    return window.matchMedia('(max-width: 768px)').matches;
  }

  function setExpanded(buttons, open) {
    buttons.forEach(btn => btn.setAttribute('aria-expanded', open ? 'true' : 'false'));
  }

  /* ---- filter group collapse ---- */
  tab.querySelectorAll('.filter-group-header').forEach(header => {
    header.addEventListener('click', () => {
      header.closest('.filter-group').classList.toggle('collapsed');
    });
  });

  /* ===== SELECTED VALUES ===== */
  function checkedValues(list) {
    const values = Array.from(list).filter(cb => cb.checked).map(cb => cb.value.toLowerCase());
    return Array.from(new Set(values)); /* desktop + mobile copies of the same option count once */
  }

  function hasPriceFilter() {
    return _minPrice > 0 || _maxPrice < PRICE_CEIL;
  }

  /* ===== FILTER BADGE ===== */
  function updateFilterBadge() {
    const total = checkedValues(availabilityCheckboxes).length
                + checkedValues(typeCheckboxes).length
                + checkedValues(placeCheckboxes).length
                + (hasPriceFilter() ? 1 : 0);

    filterToggleBtn.forEach(btn => {
      let badge = btn.querySelector('.filter-count-badge');
      if (total > 0) {
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'filter-count-badge';
          btn.appendChild(badge);
        }
        badge.textContent = total;
      } else {
        if (badge) badge.remove();
      }
    });
  }

  /* ===== FILTER DRAWER ===== */
  function setFilterLabel(text) {
    deskFilterToggleBtn.forEach(btn => {
      btn.innerHTML = `
          <svg width="22" height="20" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M21 1H1L9 10.46V17L13 19V10.46L21 1Z" stroke="#048E79" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          ${text}`;
    });
    updateFilterBadge();
  }

  function openFilter() {
    if (!filterDrawer) return;
    closeSort();
    filterDrawer.classList.add('active');
    setFilterLabel('Hide Filter');
    setExpanded(filterToggleBtn, true);
    if (filterGridWrap) filterGridWrap.classList.add('filter-open');
    updateColumnsForFilter(true);
  }

  function closeFilter() {
    if (!filterDrawer) return;
    filterDrawer.classList.remove('active');
    setFilterLabel('Show Filter');
    setExpanded(filterToggleBtn, false);
    if (filterGridWrap) filterGridWrap.classList.remove('filter-open');
    updateColumnsForFilter(false);
  }

  function updateColumnsForFilter(isOpen) {
    if (!grid) return;
    const width = window.innerWidth;
    if (width <= 768) return;
    if (isOpen) {
      grid.style.gridTemplateColumns = width > 1280 ? 'repeat(3, 1fr)' : 'repeat(2, 1fr)';
    } else {
      grid.style.gridTemplateColumns = width > 1280 ? 'repeat(4, 1fr)' : 'repeat(3, 1fr)';
    }
  }

  filterToggleBtn.forEach(btn => {
    btn.addEventListener('click', () => {
      const isOpen = filterDrawer && filterDrawer.classList.contains('active');
      isOpen ? closeFilter() : openFilter();
    });
  });

  /* desktop ✕, mobile ✕ and mobile Apply (filters already apply as they change) */
  closeFilterBtns.forEach(btn => btn.addEventListener('click', closeFilter));

  /* ===== SORT DRAWER ===== */
  function positionSortDrawer() {
    if (window.innerWidth <= 768) return;
    const btn = tab.querySelector('.desktop-topbar .sortToggle') || sortToggleBtn[0];
    if (!btn || !sortDrawer) return;
    const btnRect  = btn.getBoundingClientRect();
    const mainRect = sortDrawer.closest('.collection-main').getBoundingClientRect();
    sortDrawer.style.top = (btnRect.bottom - mainRect.top + 8) + 'px';
  }

  function openSort() {
    if (!sortDrawer) return;
    closeFilter();
    positionSortDrawer();
    sortDrawer.classList.add('active');
    setExpanded(sortToggleBtn, true);
  }

  function closeSort() {
    if (!sortDrawer) return;
    sortDrawer.classList.remove('active');
    setExpanded(sortToggleBtn, false);
  }

  sortToggleBtn.forEach(btn => {
    btn.addEventListener('click', () => {
      sortDrawer && sortDrawer.classList.contains('active') ? closeSort() : openSort();
    });
  });

  closeSortBtn.forEach(btn => btn.addEventListener('click', closeSort));

  document.addEventListener('click', (e) => {
    if (!sortDrawer || !sortDrawer.classList.contains('active')) return;
    const clickedOnBtn = Array.from(sortToggleBtn).some(btn => btn.contains(e.target));
    if (!sortDrawer.contains(e.target) && !clickedOnBtn) closeSort();
  });

  /* ===== MOBILE SHEETS: backdrop + page scroll lock ===== */
  function syncSheetState() {
    const filterOpen = !!filterDrawer && filterDrawer.classList.contains('active');
    const sortOpen   = !!sortDrawer && sortDrawer.classList.contains('active');
    const sheetOpen  = isMobile() && (filterOpen || sortOpen);
    document.documentElement.classList.toggle('collection-sheet-open', sheetOpen);
    if (sheetBackdrop) sheetBackdrop.classList.toggle('is-visible', sheetOpen);
  }

  if (window.MutationObserver) {
    const sheetObserver = new MutationObserver(syncSheetState);
    [filterDrawer, sortDrawer].forEach(el => {
      if (el) sheetObserver.observe(el, { attributes: true, attributeFilter: ['class'] });
    });
  }

  if (sheetBackdrop) {
    sheetBackdrop.addEventListener('click', () => {
      closeFilter();
      closeSort();
    });
  }

  function visibleButton(buttons) {
    return Array.from(buttons).find(btn => btn.offsetParent !== null);
  }

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' && e.key !== 'Esc') return;
    if (sortDrawer && sortDrawer.classList.contains('active')) {
      closeSort();
      const btn = visibleButton(sortToggleBtn);
      if (btn) btn.focus();
    } else if (isMobile() && filterDrawer && filterDrawer.classList.contains('active')) {
      closeFilter();
      const btn = visibleButton(filterToggleBtn);
      if (btn) btn.focus();
    }
  });

  /* ===== CHIP UI ===== */
  function labelFor(list, value) {
    const cb = Array.from(list).find(c => c.value.toLowerCase() === value);
    return (cb && cb.dataset.label) || value;
  }

  function setChecked(list, value, checked) {
    list.forEach(cb => {
      if (cb.value.toLowerCase() === value) cb.checked = checked;
    });
  }

  function createChip(label, onRemove) {
    chipBoxes.forEach(box => {
      const chip = document.createElement('div');
      chip.className = 'filter-chip';
      chip.appendChild(document.createTextNode(label + ' '));
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.setAttribute('aria-label', 'Remove filter: ' + label);
      btn.textContent = '×';
      btn.addEventListener('click', onRemove);
      chip.appendChild(btn);
      box.appendChild(chip);
    });
  }

  function renderActiveFilters(selAvail, selTypes, selPlaces) {
    chipBoxes.forEach(box => { box.innerHTML = ''; });
    selAvail.forEach(v => createChip(AVAIL_LABELS[v] || v, () => {
      setChecked(availabilityCheckboxes, v, false);
      applyFilters();
    }));
    selTypes.forEach(v => createChip(labelFor(typeCheckboxes, v), () => {
      setChecked(typeCheckboxes, v, false);
      applyFilters();
    }));
    selPlaces.forEach(v => createChip(labelFor(placeCheckboxes, v), () => {
      setChecked(placeCheckboxes, v, false);
      applyFilters();
    }));
    if (hasPriceFilter()) {
      createChip('₹' + _minPrice + ' – ₹' + _maxPrice, () => setPriceRange(0, PRICE_CEIL));
    }
  }

  /* ===== PRICE RANGE ===== */
  /* Moves both sliders (desktop + mobile). The slider's own input handler in
     collection-filter-drawer redraws the coloured fill and labels, then calls
     applyFiltersWithPrice, so filters are applied exactly once. */
  function setPriceRange(minP, maxP) {
    [rangeMin, mobRangeMin].forEach(el => { if (el) el.value = minP; });
    [rangeMax, mobRangeMax].forEach(el => { if (el) el.value = maxP; });
    _minPrice = Number(minP);
    _maxPrice = Number(maxP);
    const driver = rangeMin || mobRangeMin;
    if (driver) {
      driver.dispatchEvent(new Event('input', { bubbles: true }));
    } else {
      applyFilters();
    }
  }

  function clearAllFilters() {
    filterCheckboxes.forEach(cb => { cb.checked = false; });
    setPriceRange(0, PRICE_CEIL);
  }

  tab.clearAllFilters = clearAllFilters;
  clearAllBtns.forEach(btn => btn.addEventListener('click', clearAllFilters));

  /* ===== PAGINATION ===== */
  function getItemsPerPage() {
    const w = window.innerWidth;
    if (w <= 768)  return 8;
    if (w <= 1280) return 12;
    return 16;
  }

  let ITEMS_PER_PAGE = getItemsPerPage();
  let currentPage    = 1;
  let visibleItems   = [];

  window.addEventListener('resize', () => {
    const perPage = getItemsPerPage();
    updateColumnsForFilter(filterDrawer && filterDrawer.classList.contains('active'));
    syncSheetState();
    if (perPage !== ITEMS_PER_PAGE) {
      ITEMS_PER_PAGE = perPage;
      goToPage(currentPage);
    }
  });

  function readPageFromUrl() {
    const n = parseInt(new URLSearchParams(window.location.search).get(PAGE_PARAM), 10);
    return n > 0 ? n : 1;
  }

  /* replaceState: no extra history entries, but Back from a product returns to this page number */
  function writePageToUrl(page) {
    if (!window.history || !window.history.replaceState) return;
    const url = new URL(window.location.href);
    if (page > 1) url.searchParams.set(PAGE_PARAM, page);
    else url.searchParams.delete(PAGE_PARAM);
    if (url.href !== window.location.href) {
      window.history.replaceState(window.history.state, '', url.href);
    }
  }

  /* height of the fixed/sticky header currently covering the top of the viewport */
  function headerOffset() {
    let bottom = 0;
    document.querySelectorAll('.header-wrapper, .mob-header, sticky-header, .shopify-section-header-sticky').forEach(el => {
      const cs = window.getComputedStyle(el);
      if (cs.display === 'none' || cs.visibility === 'hidden') return;
      if (cs.position !== 'fixed' && cs.position !== 'sticky') return;
      const rect = el.getBoundingClientRect();
      if (rect.height > 0 && rect.top < window.innerHeight / 2 && rect.bottom > bottom) bottom = rect.bottom;
    });
    return bottom;
  }

  function scrollToGrid() {
    const top = grid.getBoundingClientRect().top + window.pageYOffset - headerOffset() - 16;
    window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
  }

  function goToPage(page, opts) {
    const totalPages = Math.max(1, Math.ceil(visibleItems.length / ITEMS_PER_PAGE));
    currentPage = Math.min(Math.max(1, page || 1), totalPages);
    showPage();
    renderPagination(visibleItems.length);
    writePageToUrl(currentPage);
    if (opts && opts.scroll) scrollToGrid();
  }

  function renderPagination(totalItems) {
    if (!paginationEl) return;
    const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);
    paginationEl.innerHTML = '';
    if (totalPages <= 1) return;

    const prevBtn = document.createElement('button');
    prevBtn.type = 'button';
    prevBtn.setAttribute('aria-label', 'Previous page');
    prevBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M12.6667 8.00016H3.33337M8.00004 3.3335L3.33337 8.00016L8.00004 12.6668" stroke="#1E1E1E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Previous`;
    prevBtn.disabled = currentPage === 1;
    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) goToPage(currentPage - 1, { scroll: true });
    });
    paginationEl.appendChild(prevBtn);

    function addPageBtn(num) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.innerText = num;
      if (num === currentPage) {
        btn.classList.add('active');
        btn.setAttribute('aria-current', 'page');
      }
      btn.addEventListener('click', () => goToPage(num, { scroll: true }));
      paginationEl.appendChild(btn);
    }

    function addDots() {
      const d = document.createElement('button');
      d.type = 'button';
      d.className = 'pagination-dots';
      d.innerText = '...';
      d.disabled = true;
      paginationEl.appendChild(d);
    }

    if (totalPages <= 4) {
      for (let i = 1; i <= totalPages; i++) addPageBtn(i);
    } else {
      addPageBtn(1);
      if (currentPage > 3) addDots();
      const start = Math.max(2, currentPage - 1);
      const end   = Math.min(totalPages - 1, currentPage + 1);
      for (let i = start; i <= end; i++) addPageBtn(i);
      if (currentPage < totalPages - 2) addDots();
      addPageBtn(totalPages);
    }

    const nextBtn = document.createElement('button');
    nextBtn.type = 'button';
    nextBtn.setAttribute('aria-label', 'Next page');
    nextBtn.innerHTML = `Next <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M3.33337 8.00016H12.6667M8.00004 12.6668L12.6667 8.00016L8.00004 3.3335" stroke="#1E1E1E" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    nextBtn.disabled = currentPage === totalPages;
    nextBtn.addEventListener('click', () => {
      if (currentPage < totalPages) goToPage(currentPage + 1, { scroll: true });
    });
    paginationEl.appendChild(nextBtn);
  }

  function showPage() {
    const start = (currentPage - 1) * ITEMS_PER_PAGE;
    const end   = start + ITEMS_PER_PAGE;
    visibleItems.forEach((item, i) => {
      item.style.display = (i >= start && i < end) ? 'block' : 'none';
    });
  }

  /* ===== FILTER ENGINE ===== */
  /* Values inside one filter group combine with OR; the groups combine with AND. */
  tab.applyFiltersWithPrice = function(minP, maxP) {
    _minPrice = Number(minP);
    _maxPrice = Number(maxP);
    applyFilters();
  };

  function applyFilters(opts) {
    const selAvail  = checkedValues(availabilityCheckboxes);
    const selTypes  = checkedValues(typeCheckboxes);
    const selPlaces = checkedValues(placeCheckboxes);
    const hasMaxLimit = _maxPrice < PRICE_CEIL;

    visibleItems = [];

    Array.from(grid.children).forEach(item => {
      const card = item.querySelector('.product-card');
      if (!card) return;
      const available = card.dataset.available === 'true';
      const price     = parseFloat(card.dataset.price || 0);
      const type      = (card.dataset.type || '').toLowerCase();
      const places    = (card.dataset.places || '').toLowerCase().split(',').filter(Boolean);
      let show = true;

      if (selAvail.length && !selAvail.includes(available ? 'in' : 'out')) show = false;
      if (price < _minPrice || (hasMaxLimit && price > _maxPrice)) show = false;
      if (selTypes.length && !selTypes.includes(type)) show = false;
      if (selPlaces.length && !selPlaces.some(p => places.includes(p))) show = false;

      if (show) visibleItems.push(item);
      item.style.display = 'none';
    });

    const n = visibleItems.length;
    countEls.forEach(el => { el.innerText = `(${n} ${n === 1 ? 'product' : 'products'})`; });
    if (noProducts) noProducts.style.display = n === 0 ? 'block' : 'none';
    goToPage(opts && opts.page ? opts.page : 1);
    renderActiveFilters(selAvail, selTypes, selPlaces);
    updateFilterBadge();
  }

  /* ===== SORT ENGINE ===== */
  function cardOf(item) {
    return item.querySelector('.product-card') || item;
  }

  function originalIndex(item) {
    return Number(cardOf(item).dataset.index) || 0;
  }

  function cardPrice(item) {
    return parseFloat(cardOf(item).dataset.price || 0);
  }

  function hasTag(item, tag) {
    return (cardOf(item).dataset.tags || '').split(',').map(t => t.trim()).includes(tag);
  }

  function setSortMessage(text) {
    sortStatusMessages.forEach(msg => {
      msg.innerText = text || '';
      msg.style.display = text ? 'block' : 'none';
    });
  }

  /* keep the desktop list and the mobile sheet showing the same choice */
  function syncSortRadios(value) {
    tab.querySelectorAll('.sort-option').forEach(r => { r.checked = !!value && r.value === value; });
  }

  function resetSort() {
    syncSortRadios(null);
    setSortMessage('');
    Array.from(grid.children)
      .sort((a, b) => originalIndex(a) - originalIndex(b))
      .forEach(item => grid.appendChild(item));
    applyFilters();
  }

  function applySort(type) {
    if (!type || type === 'reset') { resetSort(); return; }
    const items = Array.from(grid.children);
    let message = '';

    if (type === 'new') {
      /* newest products first (product created date) */
      items.sort((a, b) =>
        (Number(cardOf(b).dataset.created) || 0) - (Number(cardOf(a).dataset.created) || 0) ||
        originalIndex(a) - originalIndex(b));
    } else if (SORT_TAGS[type]) {
      /* tagged products first; everything else keeps the collection's own order */
      const tag = SORT_TAGS[type];
      items.sort((a, b) => (hasTag(b, tag) - hasTag(a, tag)) || originalIndex(a) - originalIndex(b));
      const matches = items.filter(item => hasTag(item, tag)).length;
      if (matches > 0) {
        message = `${matches} ${tag} ${matches === 1 ? 'product' : 'products'} shown first`;
      }
    } else if (type === 'low-high' || type === 'high-low') {
      items.sort((a, b) => {
        const diff = cardPrice(a) - cardPrice(b);
        return (type === 'low-high' ? diff : -diff) || originalIndex(a) - originalIndex(b);
      });
    }

    items.forEach(el => grid.appendChild(el));
    setSortMessage(message);
    applyFilters();
  }

  /* ===== EVENT BINDINGS ===== */
  filterCheckboxes.forEach(cb => {
    cb.addEventListener('change', () => {
      /* mirror the tick on the other copy (desktop sidebar / mobile sheet) of this option */
      const group = ['filter-availability', 'filter-type', 'filter-place'].find(c => cb.classList.contains(c));
      if (group) {
        tab.querySelectorAll('.' + group).forEach(other => {
          if (other !== cb && other.value === cb.value) other.checked = cb.checked;
        });
      }
      applyFilters();
    });
  });

  tab.querySelectorAll('.sort-option').forEach(option => {
    option.addEventListener('change', () => {
      syncSortRadios(option.value);
      applySort(option.value);
    });
  });

  tab.querySelectorAll('.reset-sort').forEach(btn => btn.addEventListener('click', resetSort));

  /* ===== INIT ===== */
  setExpanded(filterToggleBtn, false);
  setExpanded(sortToggleBtn, false);
  applyFilters({ page: readPageFromUrl() });
  syncSheetState();
})();
</script>

<script>
document.querySelectorAll('#current-collection-tab .add-to-cart[data-variant-id]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.variantId;
      btn.textContent = 'Adding...';
      btn.disabled = true;

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id,
            quantity: 1,
            sections: ['cart-drawer'],
            sections_url: window.location.pathname
          })
        });

        const addedItem = await response.json();

        if (addedItem.sections?.['cart-drawer']) {
          const html = new DOMParser().parseFromString(
            addedItem.sections['cart-drawer'], 'text/html'
          );

          const newBody = html.querySelector('#nc-body');
          const oldBody = document.querySelector('#nc-body');
          if (newBody && oldBody) oldBody.replaceWith(newBody);

          const newBreakdown = html.querySelector('.nc-price-breakdown');
          if (newBreakdown) {
            const oldBreakdown = document.querySelector('.nc-price-breakdown');
            if (oldBreakdown) {
              oldBreakdown.replaceWith(newBreakdown);
            } else {
              const footer = document.querySelector('.cart-drawer__footer');
              if (footer) footer.insertAdjacentElement('beforebegin', newBreakdown);
            }
          }

          const newFooter = html.querySelector('.cart-drawer__footer');
          const oldFooter = document.querySelector('.cart-drawer__footer');
          if (newFooter && oldFooter) oldFooter.replaceWith(newFooter);
        }
        var drawer = document.getElementById('nc-cart-drawer');
        if (drawer) {
          drawer.classList.add('is-open');
          drawer.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }
        const cartResponse = await fetch('/cart.js', {
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const cartData = await cartResponse.json();

        if (typeof publish !== 'undefined' && typeof PUB_SUB_EVENTS !== 'undefined') {
          publish(PUB_SUB_EVENTS.cartUpdate, { source: 'cart-items', cartData: cartData });
        }

        if (typeof window.ncUpdatePriceBreakdown === 'function') {
          window.ncUpdatePriceBreakdown(cartData);
        }
      } catch (e) {
        console.error(e);
      } finally {
        btn.textContent = 'Add To Cart';
        btn.disabled = false;
      }
    });
});
</script>

