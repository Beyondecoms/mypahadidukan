<script>
  (function () {
    function initFastestSelling() {
      var section = document.getElementById('custom-section-3-{{ section.id }}');
      if (!section) return;

      var prevBtn = section.querySelector('[data-arrow="prev"]');
      var nextBtn = section.querySelector('[data-arrow="next"]');

      function getActiveTrack() {
        var activePanel = section.querySelector('.custom-section-3__tab-panel.is-active');
        return activePanel ? activePanel.querySelector('[data-carousel-track]') : section.querySelector('[data-carousel-track]');
      }

      function updateArrows() {
        if (!prevBtn || !nextBtn) return;
        var track = getActiveTrack();
        if (!track) return;
        var maxScrollLeft = track.scrollWidth - track.clientWidth;
        prevBtn.disabled = track.scrollLeft <= 4;
        nextBtn.disabled = track.scrollLeft >= maxScrollLeft - 4;
      }

      function scrollTrack(direction) {
        var track = getActiveTrack();
        if (!track) return;
        var card = track.querySelector('.custom-section-3__slide');
        if (!card) return;
        var cardWidth = card.getBoundingClientRect().width;
        var gap = parseFloat(getComputedStyle(track).gap) || 14;
        var scrollAmount = (cardWidth + gap) * 1.5;
        if (direction === 'prev') {
          track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        } else {
          track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
      }

      if (prevBtn) {
        prevBtn.onclick = function () {
          scrollTrack('prev');
        };
      }

      if (nextBtn) {
        nextBtn.onclick = function () {
          scrollTrack('next');
        };
      }

      // Attach scroll listener to all tracks
      var allTracks = section.querySelectorAll('[data-carousel-track]');
      allTracks.forEach(function (track) {
        track.addEventListener('scroll', updateArrows, { passive: true });
      });
      window.addEventListener('resize', updateArrows, { passive: true });
      updateArrows();

      // Category tab click switching
      var categoryTabs = section.querySelectorAll('[data-category-tab]');
      var tabPanels = section.querySelectorAll('.custom-section-3__tab-panel');

      categoryTabs.forEach(function (tab) {
        tab.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var targetIndex = tab.getAttribute('data-category-tab');

          categoryTabs.forEach(function (t) { t.classList.remove('is-active'); });
          tab.classList.add('is-active');

          tabPanels.forEach(function (panel) {
            if (panel.getAttribute('data-tab-panel') === targetIndex) {
              panel.classList.add('is-active');
            } else {
              panel.classList.remove('is-active');
            }
          });

          updateArrows();
        });
      });

      // Wishlist toggle
      var wishlistBtns = section.querySelectorAll('.custom-section-3__wishlist-btn');
      wishlistBtns.forEach(function (btn) {
        btn.onclick = function (e) {
          e.preventDefault();
          e.stopPropagation();
          btn.classList.toggle('is-active');
          if (window.MinimogTheme && window.MinimogTheme.Wishlist) {
            var handle = btn.getAttribute('data-product-handle');
            if (handle) window.MinimogTheme.Wishlist.handleWishlistClick(btn);
          }
        };
      });

      // Quickview toggle
      var quickviewBtns = section.querySelectorAll('.custom-section-3__quickview-btn');
      quickviewBtns.forEach(function (btn) {
        btn.onclick = function (e) {
          e.preventDefault();
          e.stopPropagation();
          var handle = btn.getAttribute('data-product-handle');
          var url = btn.getAttribute('data-product-url');
          if (window.MinimogTheme && window.MinimogTheme.QuickView) {
            window.MinimogTheme.QuickView.open(handle);
          } else if (url) {
            window.location.href = url;
          }
        };
      });

      // Add to Cart
      var atcBtns = section.querySelectorAll('.custom-section-3__atc-button');
      atcBtns.forEach(function (btn) {
        btn.onclick = function (e) {
          e.preventDefault();
          var hasMultipleVariants = btn.getAttribute('data-has-multiple-variants') === 'true';
          var productUrl = btn.getAttribute('data-product-url');
          var handle = btn.getAttribute('data-product-handle');
          var variantId = btn.getAttribute('data-variant-id');

          if (hasMultipleVariants) {
            var quickViewInstance = window.MinimogTheme && (window.MinimogTheme.ProductQuickView || window.MinimogTheme.QuickView);
            if (quickViewInstance && handle) {
              if (typeof quickViewInstance.open === 'function') {
                quickViewInstance.open(handle);
              } else if (typeof quickViewInstance.loadProductQuickView === 'function') {
                quickViewInstance.loadProductQuickView(handle);
              } else if (productUrl) {
                window.location.href = productUrl;
              }
            } else if (productUrl) {
              window.location.href = productUrl;
            }
            return;
          }

          if (!variantId) return;

          btn.classList.add('is-loading');
          btn.disabled = true;

          var formData = new FormData();
          formData.append('id', variantId);
          formData.append('quantity', 1);

          fetch('/cart/add.js', {
            method: 'POST',
            body: formData,
            headers: {
              'X-Requested-With': 'XMLHttpRequest',
              'Accept': 'application/json'
            }
          })
            .then(function (response) {
              return response.json();
            })
            .then(function (item) {
              btn.classList.remove('is-loading');
              btn.disabled = false;
              // Trigger theme cart events
              document.dispatchEvent(new CustomEvent('cart:item-added', { detail: { item: item } }));
              document.dispatchEvent(new CustomEvent('minimog:cart:item-added', { detail: { item: item } }));
              document.dispatchEvent(new CustomEvent('m:cart:item-added', { detail: { item: item } }));
              if (window.MinimogTheme && window.MinimogTheme.CartDrawer) {
                window.MinimogTheme.CartDrawer.open();
              } else if (window.location.pathname.indexOf('/cart') === -1) {
                window.location.href = '/cart';
              }
            })
            .catch(function (err) {
              console.error('Error adding to cart:', err);
              btn.classList.remove('is-loading');
              btn.disabled = false;
              if (productUrl) window.location.href = productUrl;
            });
        };
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFastestSelling);
    } else {
      initFastestSelling();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target.id === 'shopify-section-{{ section.id }}' || e.target.querySelector('#custom-section-3-{{ section.id }}')) {
        initFastestSelling();
      }
    });

    document.addEventListener('shopify:block:select', function (e) {
      var section = document.getElementById('custom-section-3-{{ section.id }}');
      if (!section) return;
      var blockId = e.detail.blockId;
      var targetTab = section.querySelector('[data-block-id="' + blockId + '"]');
      if (targetTab && targetTab.click) {
        targetTab.click();
      }
    });
  })();
</script>

