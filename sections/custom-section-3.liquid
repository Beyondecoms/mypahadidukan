{%- liquid
  assign heading = section.settings.heading | default: 'Fastest Selling'
  assign default_collection = collections[section.settings.collection]
  assign default_product_list = section.settings.product_list
  assign products_to_show = section.settings.products_to_show | default: 10

  assign desktop_products = section.settings.desktop_products | default: 5
  assign mobile_products = section.settings.mobile_products | default: 1.4
  assign card_gap = section.settings.card_gap | default: 14
  assign padding_top = section.settings.padding_top | default: 40
  assign padding_bottom = section.settings.padding_bottom | default: 48

  assign show_category_nav = section.settings.show_category_nav
  assign show_discount_badge = section.settings.show_discount_badge
  assign show_wishlist = section.settings.show_wishlist
  assign show_quickview = section.settings.show_quickview
  assign show_rating = section.settings.show_rating
  assign show_vendor = section.settings.show_vendor
  assign show_promo_badge = section.settings.show_promo_badge

  assign promo_discount_text = section.settings.promo_discount_text | default: 'Extra 10% off'
  assign promo_coupon_code = section.settings.promo_coupon_code | default: 'SUMMER10'
  assign vendor_text = section.settings.vendor_text | default: 'My Pahadi Dukan'
  assign default_rating = section.settings.default_rating | default: '4.5'
  assign default_reviews = section.settings.default_reviews | default: '1745'
  assign default_subtitle = section.settings.default_subtitle | default: 'Vitamin C, Omega 3,6,7 and 9 and Antioxidants'
  assign default_quantity = section.settings.default_quantity | default: '300 ml'

  assign atc_bg_color = section.settings.atc_bg_color | default: '#BA5D37'
  assign price_color = section.settings.price_color | default: '#1B4D3E'
  assign vendor_color = section.settings.vendor_color | default: '#BA5D37'
-%}

<div
  id="custom-section-3-{{ section.id }}"
  class="custom-section-3"
  style="
    --cs3-pt: {{ padding_top }}px;
    --cs3-pb: {{ padding_bottom }}px;
    --cs3-desktop-products: {{ desktop_products }};
    --cs3-mobile-products: {{ mobile_products }};
    --cs3-gap: {{ card_gap }}px;
    --cs3-atc-bg: {{ atc_bg_color }};
    --cs3-price-color: {{ price_color }};
    --cs3-vendor-color: {{ vendor_color }};
  "
>
  <div class="custom-section-3__container">
    {%- if heading != blank -%}
      <div class="custom-section-3__header">
        <h2 class="custom-section-3__heading">{{ heading }}</h2>
      </div>
    {%- endif -%}

    {%- if show_category_nav and section.blocks.size > 0 -%}
      <div class="custom-section-3__category-nav" data-category-nav>
        <div class="custom-section-3__category-track">
          {%- for block in section.blocks -%}
            {%- liquid
              assign cat_title = block.settings.title
              assign cat_image = block.settings.image
              assign is_first = forloop.first
            -%}
            <button
              type="button"
              class="custom-section-3__category-item{% if is_first %} is-active{% endif %}"
              data-category-tab="{{ forloop.index0 }}"
              data-block-id="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              <div class="custom-section-3__category-icon">
                {%- if cat_image != blank -%}
                  {{ cat_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: cat_title }}
                {%- else -%}
                  <div class="custom-section-3__category-icon-placeholder">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {%- endif -%}
              </div>
              <span class="custom-section-3__category-title">{{ cat_title }}</span>
              <span class="custom-section-3__category-underline"></span>
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <div class="custom-section-3__carousel-wrap" data-carousel-wrap>
      <button
        type="button"
        class="custom-section-3__arrow custom-section-3__arrow--prev"
        aria-label="Previous products"
        data-arrow="prev"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="custom-section-3__panels-container">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign tab_products = blank
              assign tab_collection = collections[block.settings.collection]
              assign tab_product_list = block.settings.product_list

              if tab_product_list != blank and tab_product_list.count > 0
                assign tab_products = tab_product_list
              elsif tab_collection != blank and tab_collection.products.size > 0
                assign tab_products = tab_collection.products
              elsif default_product_list != blank and default_product_list.count > 0
                assign tab_products = default_product_list
              elsif default_collection != blank and default_collection.products.size > 0
                assign tab_products = default_collection.products
              endif

              assign is_panel_active = forloop.first
            -%}
            <div
              class="custom-section-3__tab-panel{% if is_panel_active %} is-active{% endif %}"
              data-tab-panel="{{ forloop.index0 }}"
              data-block-id="{{ block.id }}"
            >
              <div class="custom-section-3__track" data-carousel-track>
                {%- if tab_products != blank and tab_products.size > 0 -%}
                  {%- for product in tab_products limit: products_to_show -%}
                    {%- liquid
                      assign current_variant = product.selected_or_first_available_variant
                      assign on_sale = false
                      assign discount_percentage = 0
                      if current_variant.compare_at_price > current_variant.price
                        assign on_sale = true
                        assign discount_percentage = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price | round
                      endif

                      assign variant_weight_or_title = current_variant.title
                      if product.has_only_default_variant
                        assign variant_weight_or_title = default_quantity
                        if current_variant.weight > 0
                          assign variant_weight_or_title = current_variant.weight | weight_with_unit
                        endif
                      endif
                    -%}
                    <div class="custom-section-3__slide">
                      {% render 'product-card-4', product: product, section: section, image_ratio: '1/1' %}
                    </div>
                  {%- endfor -%}
                {%- else -%}
                  {%- for i in (1..6) -%}
                    <div class="custom-section-3__slide">
                      <div class="custom-section-3__card">
                        <div class="custom-section-3__media-wrap">
                          <span class="custom-section-3__badge-save">SAVE 14%</span>
                          <div class="custom-section-3__img-placeholder">
                            {{ 'product-1' | placeholder_svg_tag }}
                          </div>
                        </div>
                        <div class="custom-section-3__card-body">
                          <div class="custom-section-3__rating-row">
                            <div class="custom-section-3__stars">
                              {%- for s in (1..5) -%}
                                <svg class="custom-section-3__star" viewBox="0 0 20 20" fill="currentColor">
                                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                              {%- endfor -%}
                            </div>
                            <span class="custom-section-3__rating-score">4.5</span>
                            <span class="custom-section-3__reviews-count">| 1745 Reviews</span>
                          </div>
                          <div class="custom-section-3__vendor">{{ vendor_text }}</div>
                          <h3 class="custom-section-3__title">Sea Buckthorn Pulp (Juice)</h3>
                          <div class="custom-section-3__desc">{{ default_subtitle }}</div>
                          <div class="custom-section-3__meta-row">
                            <span class="custom-section-3__quantity">300 ml</span>
                            <div class="custom-section-3__promo-badge">
                              <span class="custom-section-3__promo-text">{{ promo_discount_text }}</span>
                              <span class="custom-section-3__promo-code">{{ promo_coupon_code }}</span>
                            </div>
                          </div>
                          <div class="custom-section-3__price-row">
                            <span class="custom-section-3__price-current">Rs. 775</span>
                            <span class="custom-section-3__price-compare">Rs. 899</span>
                          </div>
                          <div class="custom-section-3__atc-wrap">
                            <button type="button" class="custom-section-3__atc-button">
                              <span class="custom-section-3__atc-text">Add to cart</span>
                              <svg class="custom-section-3__atc-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                              </svg>
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                  {%- endfor -%}
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="custom-section-3__tab-panel is-active" data-tab-panel="0">
            <div class="custom-section-3__track" data-carousel-track>
              {%- for i in (1..6) -%}
                <div class="custom-section-3__slide">
                  <div class="custom-section-3__card">
                    <div class="custom-section-3__media-wrap">
                      <span class="custom-section-3__badge-save">SAVE 14%</span>
                      <div class="custom-section-3__img-placeholder">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    </div>
                    <div class="custom-section-3__card-body">
                      <div class="custom-section-3__rating-row">
                        <div class="custom-section-3__stars">
                          {%- for s in (1..5) -%}
                            <svg class="custom-section-3__star" viewBox="0 0 20 20" fill="currentColor">
                              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                          {%- endfor -%}
                        </div>
                        <span class="custom-section-3__rating-score">4.5</span>
                        <span class="custom-section-3__reviews-count">| 1745 Reviews</span>
                      </div>
                      <div class="custom-section-3__vendor">{{ vendor_text }}</div>
                      <h3 class="custom-section-3__title">Sea Buckthorn Pulp (Juice)</h3>
                      <div class="custom-section-3__desc">{{ default_subtitle }}</div>
                      <div class="custom-section-3__meta-row">
                        <span class="custom-section-3__quantity">300 ml</span>
                        <div class="custom-section-3__promo-badge">
                          <span class="custom-section-3__promo-text">{{ promo_discount_text }}</span>
                          <span class="custom-section-3__promo-code">{{ promo_coupon_code }}</span>
                        </div>
                      </div>
                      <div class="custom-section-3__price-row">
                        <span class="custom-section-3__price-current">Rs. 775</span>
                        <span class="custom-section-3__price-compare">Rs. 899</span>
                      </div>
                      <div class="custom-section-3__atc-wrap">
                        <button type="button" class="custom-section-3__atc-button">
                          <span class="custom-section-3__atc-text">Add to cart</span>
                          <svg class="custom-section-3__atc-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      <button
        type="button"
        class="custom-section-3__arrow custom-section-3__arrow--next"
        aria-label="Next products"
        data-arrow="next"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  #custom-section-3-{{ section.id }} {
    background-color: #ffffff;
    padding-top: var(--cs3-pt);
    padding-bottom: var(--cs3-pb);
    width: 100%;
    position: relative;
    box-sizing: border-box;
    font-family: inherit;
  }
  @media only screen and (max-width: 749px){
    #custom-section-3-{{ section.id }}{
  padding-top:30px;
    }
  }

  #custom-section-3-{{ section.id }} * {
    box-sizing: border-box;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__container {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__header {
    text-align: center;
    margin-bottom: 24px;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__heading {
    margin: 0;
    font-size: 26px;
    font-weight: 700;
    color: #111111;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  /* Category Navigation */
  #custom-section-3-{{ section.id }} .custom-section-3__category-nav {
    width: 100%;
    margin-bottom: 28px;
    overflow: hidden;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__category-track {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 4px;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__category-track::-webkit-scrollbar {
    display: none;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__category-item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 6px 8px 14px 8px;
    background: transparent;
    border: none;
    text-decoration: none;
    color: #111111;
    position: relative;
    cursor: pointer;
    flex-shrink: 0;
    font-family: inherit;
    transition: opacity 0.2s ease;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__category-item:hover {
    opacity: 0.9;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__category-icon {
    width: 54px;
    height: 54px;
    min-width: 54px;
    border-radius: 12px;
    overflow: hidden;
    background-color: #000000;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  #custom-section-3-{{ section.id }} .custom-section-3__category-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 12px;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__category-icon-placeholder {
    width: 100%;
    height: 100%;
    background: #222;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__category-icon-placeholder svg {
    width: 60%;
    height: 60%;
    opacity: 0.5;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__category-title {
    font-size: 16px;
    font-weight: 700;
    color: #111111;
    white-space: nowrap;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__category-underline {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2.5px;
    background-color: #BA5D37;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__category-item.is-active .custom-section-3__category-underline {
    opacity: 1;
  }

  /* Carousel */
  #custom-section-3-{{ section.id }} .custom-section-3__carousel-wrap {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__panels-container {
    width: 100%;
    overflow: hidden;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__tab-panel {
    display: none;
    width: 100%;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__tab-panel.is-active {
    display: block;
    animation: cs3FadeIn 0.25s ease;
  }

  @keyframes cs3FadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #custom-section-3-{{ section.id }} .custom-section-3__track {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--cs3-gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 8px 4px 18px 4px;
    width: 100%;
    scroll-behavior: smooth;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__track::-webkit-scrollbar {
    display: none;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__slide {
    flex: 0 0 calc((100% - (var(--cs3-desktop-products) - 1) * var(--cs3-gap)) / var(--cs3-desktop-products));
    width: calc((100% - (var(--cs3-desktop-products) - 1) * var(--cs3-gap)) / var(--cs3-desktop-products));
    max-width: calc((100% - (var(--cs3-desktop-products) - 1) * var(--cs3-gap)) / var(--cs3-desktop-products));
    min-width: 0;
    scroll-snap-align: start;
  }



  /* Card */
  #custom-section-3-{{ section.id }} .custom-section-3__card {
    background-color: #ffffff;
    border: 1px solid #ECECEC;
    border-radius: 12px;
    padding: 12px 14px 14px 14px;
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  #custom-section-3-{{ section.id }} .custom-section-3__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
  }

  /* Media */
  #custom-section-3-{{ section.id }} .custom-section-3__media-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.05;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 8px;
    background-color: #ffffff;
    margin-bottom: 8px;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__image-link {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition: transform 0.35s ease;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__card:hover .custom-section-3__img {
    transform: scale(1.04);
  }

  #custom-section-3-{{ section.id }} .custom-section-3__img-placeholder {
    width: 100%;
    height: 100%;
    background: #f8f8f8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__img-placeholder svg {
    width: 50%;
    height: 50%;
    opacity: 0.4;
  }

  /* Badges & Action Buttons on Image */
  #custom-section-3-{{ section.id }} .custom-section-3__badge-save {
    position: absolute;
    top: 6px;
    left: 6px;
    background-color: #C05638;
    color: #ffffff;
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 10px;
    letter-spacing: 0.02em;
    z-index: 3;
    pointer-events: none;
    line-height: 1.2;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__action-btn {
    position: absolute;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #BA5D37;
    z-index: 3;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__action-btn:hover {
    transform: scale(1.15);
  }

  #custom-section-3-{{ section.id }} .custom-section-3__wishlist-btn {
    top: 6px;
    right: 6px;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__wishlist-btn.is-active svg {
    fill: #BA5D37;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__quickview-btn {
    bottom: 6px;
    right: 6px;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__icon-heart,
  #custom-section-3-{{ section.id }} .custom-section-3__icon-eye {
    width: 20px;
    height: 20px;
  }

  /* Card Body */
  #custom-section-3-{{ section.id }} .custom-section-3__card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__rating-row {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 4px;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__stars {
    display: flex;
    align-items: center;
    color: #FBBF24;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__star {
    width: 14px;
    height: 14px;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__rating-score {
    font-size: 12px;
    font-weight: 700;
    color: #111111;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__reviews-count {
    font-size: 11.5px;
    color: #4B5563;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__vendor {
    font-size: 12px;
    font-weight: 600;
    color: var(--cs3-vendor-color);
    margin-bottom: 4px;
  }

  #custom-section-3-{{ section.id }} .custom-section-3__title {
    margin: 0 0 4px 0;
    font-size: 15px;
