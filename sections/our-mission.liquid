    {
      "type": "color",
      "id": "label_color",
      "label": "Label & Icon Color",
      "default": "#e8dfc8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#e8dfc8"
    },
    {
      "type": "color",
      "id": "italic_color",
      "label": "Italic Text Color",
      "default": "#e8dfc8"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Line Color",
      "default": "#4a8a7a"
    },
    {
      "type": "color",
      "id": "stat_number_color",
