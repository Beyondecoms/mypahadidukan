{{ 'section-our-mission.css' | asset_url | stylesheet_tag }}

<section class="mission-section" style="background-color: {{ section.settings.background_color }};">
  <div class="mission-inner">

    <!-- LABEL -->
    <div class="mission-label">
      <span class="mission-label-icon">
        <svg width="22" height="13.2" viewBox="0 0 40 24" fill="none" aria-hidden="true"><path d="M2 22 L10 10 L14 16 L20 6 L26 16 L30 10 L38 22 Z" stroke="#f5f1e4" stroke-width="1.5" fill="none" stroke-linejoin="round"></path></svg>
      </span>
      <span class="mission-label-text" style="color: {{ section.settings.label_color }};">{{ section.settings.label_text }}</span>
    </div>

    <!-- HEADING -->
    <h2 class="mission-heading" style="color: {{ section.settings.heading_color }};">
      {{ section.settings.heading_before_italic }}
      <em style="color: {{ section.settings.italic_color }};">{{ section.settings.heading_italic }}</em>
      {{ section.settings.heading_after_italic }}
    </h2>

    <!-- DIVIDER -->
    <div class="mission-divider" style="border-color: {{ section.settings.divider_color }};"></div>

    <!-- STATS -->
    <div class="mission-stats">
      {% for i in (1..4) %}
        {% assign stat_num = 'stat_' | append: i | append: '_number' %}
        {% assign stat_label = 'stat_' | append: i | append: '_label' %}
        {% if section.settings[stat_num] != blank %}
          <div class="mission-stat-item">
            <span class="mission-stat-number" style="color: {{ section.settings.stat_number_color }};">{{ section.settings[stat_num] }}</span>
            <span class="mission-stat-label" style="color: {{ section.settings.stat_label_color }};">{{ section.settings[stat_label] }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Our Mission",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#2e6b5e"
