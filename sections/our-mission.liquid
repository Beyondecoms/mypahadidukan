      "default": "Pahadi Farmers Partnered"
    },
    {
      "type": "header",
      "content": "Stat 2"
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Number",
      "default": "8"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Label",
      "default": "Himalayan States Sourced"
    },
    {
      "type": "header",
      "content": "Stat 3"
    },
    {
      "type": "text",
      "id": "stat_3_number",
      "label": "Number",
      "default": "60k+"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Label",
      "default": "Households Served"
    },
    {
      "type": "header",
      "content": "Stat 4"
    },
    {
      "type": "text",
      "id": "stat_4_number",
      "label": "Number",
      "default": "0"
    },
