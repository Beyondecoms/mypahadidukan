{%- liquid
  assign badge_text = section.settings.badge_text
  assign badge_bg = section.settings.badge_bg | default: '#FEF3C7'
  assign badge_color = section.settings.badge_color | default: '#92400E'

  assign heading = section.settings.heading
  assign heading_color = section.settings.heading_color | default: '#C0503B'

  assign subheading = section.settings.subheading
  assign subheading_color = section.settings.subheading_color | default: '#4B5563'

  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign card_radius = section.settings.card_radius | default: 18

  assign show_arrows = section.settings.show_arrows
  assign show_dots = section.settings.show_dots
  assign autoplay = section.settings.autoplay
  assign autoplay_speed = section.settings.autoplay_speed | default: 5

  assign desktop_padding_top = section.settings.desktop_padding_top | default: 60
  assign desktop_padding_bottom = section.settings.desktop_padding_bottom | default: 60
  assign mobile_padding_top = section.settings.mobile_padding_top | default: 40
  assign mobile_padding_bottom = section.settings.mobile_padding_bottom | default: 40
-%}

<div
  id="fun-points-{{ section.id }}"
  class="fun-points-section"
  style="
    --fp-bg: {{ bg_color }};
    --fp-badge-bg: {{ badge_bg }};
    --fp-badge-color: {{ badge_color }};
    --fp-heading-color: {{ heading_color }};
    --fp-subheading-color: {{ subheading_color }};
    --fp-card-radius: {{ card_radius }}px;
    --fp-pt: {{ desktop_padding_top }}px;
    --fp-pb: {{ desktop_padding_bottom }}px;
    --fp-pt-mb: {{ mobile_padding_top }}px;
    --fp-pb-mb: {{ mobile_padding_bottom }}px;
  "
  data-autoplay="{{ autoplay }}"
  data-speed="{{ autoplay_speed }}"
>
  <div class="fun-points__container">
    <!-- Header Section -->
    <div class="fun-points__header">
      {%- if badge_text != blank -%}
        <div class="fun-points__badge-wrap">
          <span class="fun-points__badge">{{ badge_text | escape }}</span>
        </div>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2 class="fun-points__heading">{{ heading | escape }}</h2>
      {%- endif -%}

      {%- if subheading != blank -%}
        <p class="fun-points__subheading">{{ subheading | escape }}</p>
      {%- endif -%}
    </div>

    <!-- Carousel Component -->
    {%- if section.blocks.size > 0 -%}
      <div class="fun-points__slider-wrapper" data-fun-slider>
        {%- if show_arrows and section.blocks.size > 1 -%}
          <button
            type="button"
            class="fun-points__arrow fun-points__arrow--prev"
            aria-label="Previous slide"
            data-arrow="prev"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
        {%- endif -%}

        <div class="fun-points__track-container">
          <div class="fun-points__track" data-track>
            {%- for block in section.blocks -%}
              {%- liquid
                assign slide_image = block.settings.image
                assign slide_image_url = block.settings.image_by_url
                assign mobile_image = block.settings.mobile_image
                assign slide_link = block.settings.link
                assign alt_text = block.settings.alt_text | default: heading | default: 'Philosophy Fun Point'
              -%}

              <div
                class="fun-points__slide{% if forloop.first %} is-active{% endif %}"
                data-slide-index="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                {%- if slide_link != blank -%}
                  <a href="{{ slide_link }}" class="fun-points__slide-card" aria-label="{{ alt_text | escape }}">
                {%- else -%}
                  <div class="fun-points__slide-card">
                {%- endif -%}

                  <div class="fun-points__image-box">
                    {%- if slide_image_url != blank -%}
                      <img
                        src="{{ slide_image_url }}"
                        loading="lazy"
                        class="fun-points__image"
                        alt="{{ alt_text | escape }}"
                        width="1200"
                        height="600"
                      >
                    {%- elsif slide_image != blank -%}
                      <picture>
                        {%- if mobile_image != blank -%}
                          <source
                            media="(max-width: 640px)"
                            srcset="{{ mobile_image | image_url: width: 750 }}"
                          >
                        {%- endif -%}
                        {{
                          slide_image
                          | image_url: width: 1600
                          | image_tag:
                            loading: 'lazy',
                            class: 'fun-points__image',
                            widths: '400, 600, 800, 1000, 1200, 1600',
                            sizes: '(max-width: 1024px) 100vw, 1140px',
                            alt: alt_text
                        }}
                      </picture>
                    {%- else -%}
                      <div class="fun-points__placeholder">
                        {{ 'lifestyle-1' | placeholder_svg_tag: 'fun-points__placeholder-svg' }}
                      </div>
                    {%- endif -%}
                  </div>

                {%- if slide_link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

        {%- if show_arrows and section.blocks.size > 1 -%}
          <button
            type="button"
            class="fun-points__arrow fun-points__arrow--next"
            aria-label="Next slide"
            data-arrow="next"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        {%- endif -%}
      </div>

      <!-- Pagination Dots -->
      {%- if show_dots and section.blocks.size > 1 -%}
        <div class="fun-points__pagination" data-pagination role="tablist">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="fun-points__dot{% if forloop.first %} is-active{% endif %}"
              data-dot-index="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

<style>
  #fun-points-{{ section.id }} {
    width: 100%;
    position: relative;
    box-sizing: border-box;
    background-color: var(--fp-bg);
    padding-top: var(--fp-pt);
    padding-bottom: var(--fp-pb);
    font-family: inherit;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow: hidden;
  }

  #fun-points-{{ section.id }} * {
    box-sizing: border-box;
  }

  #fun-points-{{ section.id }} .fun-points__container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
  }

  /* --- HEADER --- */
  #fun-points-{{ section.id }} .fun-points__header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 34px auto;
  }

  #fun-points-{{ section.id }} .fun-points__badge-wrap {
    margin-bottom: 12px;
    display: flex;
    justify-content: center;
  }

  #fun-points-{{ section.id }} .fun-points__badge {
    display: inline-block;
    background-color: var(--fp-badge-bg);
    color: var(--fp-badge-color);
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1;
    padding: 6px 16px;
    border-radius: 9999px;
    letter-spacing: 0.01em;
  }

  #fun-points-{{ section.id }} .fun-points__heading {
    margin: 0 0 10px 0;
    font-size: 36px;
    line-height: 1.25;
    font-weight: 700;
    color: var(--fp-heading-color);
    letter-spacing: -0.01em;
  }

  #fun-points-{{ section.id }} .fun-points__subheading {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--fp-subheading-color);
  }

  /* --- SLIDER WRAPPER --- */
  #fun-points-{{ section.id }} .fun-points__slider-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
  }

  #fun-points-{{ section.id }} .fun-points__track-container {
    width: 100%;
    overflow: hidden;
    border-radius: var(--fp-card-radius);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  #fun-points-{{ section.id }} .fun-points__track {
    display: flex;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #fun-points-{{ section.id }} .fun-points__track::-webkit-scrollbar {
    display: none;
  }

  #fun-points-{{ section.id }} .fun-points__slide {
    flex: 0 0 100%;
    width: 100%;
    min-width: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  #fun-points-{{ section.id }} .fun-points__slide-card {
    display: block;
    width: 100%;
    text-decoration: none;
    overflow: hidden;
    position: relative;
    background-color: #F8FAFC;
  }

  #fun-points-{{ section.id }} .fun-points__image-box {
    width: 100%;
    aspect-ratio: 16 / 7.2;
    min-height: 340px;
    position: relative;
    overflow: hidden;
  }

  #fun-points-{{ section.id }} .fun-points__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
    transition: transform 0.4s ease;
  }

  #fun-points-{{ section.id }} .fun-points__slide-card:hover .fun-points__image {
    transform: scale(1.02);
  }

  #fun-points-{{ section.id }} .fun-points__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #F1F5F9;
  }

  #fun-points-{{ section.id }} .fun-points__placeholder-svg {
    width: 100%;
    height: 100%;
    opacity: 0.6;
  }

  /* --- ARROWS --- */
  #fun-points-{{ section.id }} .fun-points__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: #FFFFFF;
    color: #1F2937;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s ease, background-color 0.25s ease;
    padding: 0;
  }

  #fun-points-{{ section.id }} .fun-points__arrow:hover {
    transform: translateY(-50%) scale(1.08);
    background-color: #FFFFFF;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
  }

  #fun-points-{{ section.id }} .fun-points__arrow--prev {
    left: -56px;
  }

  #fun-points-{{ section.id }} .fun-points__arrow--next {
    right: -56px;
  }

  /* --- PAGINATION DOTS --- */
  #fun-points-{{ section.id }} .fun-points__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 22px;
  }

  #fun-points-{{ section.id }} .fun-points__dot {
    appearance: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.25s ease;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Inactive dot style: solid dot */
    width: 6px;
    height: 6px;
    background-color: #1F2937;
    opacity: 0.85;
  }

  #fun-points-{{ section.id }} .fun-points__dot.is-active {
    /* Active dot style: hollow outline ring */
    width: 10px;
    height: 10px;
    background-color: transparent;
    border: 1.5px solid #1F2937;
    opacity: 1;
  }

  /* --- RESPONSIVE STYLES --- */
  @media screen and (max-width: 1240px) {
    #fun-points-{{ section.id }} .fun-points__arrow--prev {
      left: 12px;
    }
    #fun-points-{{ section.id }} .fun-points__arrow--next {
      right: 12px;
    }
  }

  @media screen and (max-width: 991px) {
    #fun-points-{{ section.id }} .fun-points__heading {
      font-size: 30px;
    }

    #fun-points-{{ section.id }} .fun-points__subheading {
      font-size: 15.5px;
    }

    #fun-points-{{ section.id }} .fun-points__image-box {
      aspect-ratio: 16 / 8.5;
      min-height: 280px;
    }
  }

  @media screen and (max-width: 767px) {
    #fun-points-{{ section.id }} {
      padding-top: var(--fp-pt-mb);
      padding-bottom: var(--fp-pb-mb);
    }

    #fun-points-{{ section.id }} .fun-points__container {
      padding: 0 16px;
    }

    #fun-points-{{ section.id }} .fun-points__header {
      margin-bottom: 24px;
    }

    #fun-points-{{ section.id }} .fun-points__heading {
      font-size: 24px;
    }

    #fun-points-{{ section.id }} .fun-points__subheading {
      font-size: 14px;
      line-height: 1.5;
    }

    #fun-points-{{ section.id }} .fun-points__image-box {
      aspect-ratio: 16 / 10;
      min-height: 220px;
    }

    #fun-points-{{ section.id }} .fun-points__arrow {
      width: 36px;
      height: 36px;
    }

    #fun-points-{{ section.id }} .fun-points__arrow svg {
      width: 15px;
      height: 15px;
    }

    #fun-points-{{ section.id }} .fun-points__arrow--prev {
      left: 8px;
    }

    #fun-points-{{ section.id }} .fun-points__arrow--next {
      right: 8px;
    }

    #fun-points-{{ section.id }} .fun-points__pagination {
      margin-top: 16px;
    }
  }
</style>

<script>
  (function() {
    function initFunPointsSlider(sectionEl) {
      if (!sectionEl) return;
      var track = sectionEl.querySelector('[data-track]');
      if (!track) return;

      var slides = sectionEl.querySelectorAll('.fun-points__slide');
      var dots = sectionEl.querySelectorAll('.fun-points__dot');
      var prevBtn = sectionEl.querySelector('[data-arrow="prev"]');
      var nextBtn = sectionEl.querySelector('[data-arrow="next"]');
      var autoplay = sectionEl.getAttribute('data-autoplay') === 'true';
      var speed = parseInt(sectionEl.getAttribute('data-speed'), 10) || 5;

      var totalSlides = slides.length;
      if (totalSlides <= 1) return;

      var currentIndex = 0;
      var autoplayTimer = null;
      var isHovered = false;

      function updateActiveDot(index) {
        currentIndex = index;
        dots.forEach(function(dot, idx) {
          if (idx === index) {
            dot.classList.add('is-active');
            dot.setAttribute('aria-selected', 'true');
          } else {
            dot.classList.remove('is-active');
            dot.setAttribute('aria-selected', 'false');
          }
        });
      }

      function scrollToSlide(index) {
        if (index < 0) index = 0;
        if (index >= totalSlides) index = totalSlides - 1;

        var targetSlide = slides[index];
        if (targetSlide) {
          var targetScrollLeft = targetSlide.offsetLeft;
          track.scrollTo({
            left: targetScrollLeft,
            behavior: 'smooth'
          });
          updateActiveDot(index);
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          var newIndex = currentIndex - 1;
          if (newIndex < 0) newIndex = totalSlides - 1;
          scrollToSlide(newIndex);
          resetAutoplay();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          var newIndex = currentIndex + 1;
          if (newIndex >= totalSlides) newIndex = 0;
          scrollToSlide(newIndex);
          resetAutoplay();
        });
      }

      dots.forEach(function(dot) {
        dot.addEventListener('click', function(e) {
          e.preventDefault();
          var targetIndex = parseInt(dot.getAttribute('data-dot-index'), 10);
          scrollToSlide(targetIndex);
          resetAutoplay();
        });
      });

      // Scroll listener to sync dots on swipe / touch
      var scrollTimeout;
      track.addEventListener('scroll', function() {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(function() {
          var scrollLeft = track.scrollLeft;
          var slideWidth = track.clientWidth;
          if (slideWidth > 0) {
            var calculatedIndex = Math.round(scrollLeft / slideWidth);
            if (calculatedIndex >= 0 && calculatedIndex < totalSlides && calculatedIndex !== currentIndex) {
              updateActiveDot(calculatedIndex);
            }
          }
        }, 80);
      }, { passive: true });

      // Autoplay feature
      function startAutoplay() {
        if (!autoplay || totalSlides <= 1) return;
        clearInterval(autoplayTimer);
        autoplayTimer = setInterval(function() {
          if (!isHovered) {
            var next = (currentIndex + 1) % totalSlides;
            scrollToSlide(next);
          }
        }, speed * 1000);
      }

      function resetAutoplay() {
        if (autoplay) {
          clearInterval(autoplayTimer);
          startAutoplay();
        }
      }

      sectionEl.addEventListener('mouseenter', function() { isHovered = true; });
      sectionEl.addEventListener('mouseleave', function() { isHovered = false; });

      startAutoplay();
    }

    function setup() {
      var sections = document.querySelectorAll('.fun-points-section');
      sections.forEach(function(sec) {
        initFunPointsSlider(sec);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }

    document.addEventListener('shopify:section:load', function(e) {
      var section = e.target.querySelector('.fun-points-section');
      if (section) initFunPointsSlider(section);
    });

    document.addEventListener('shopify:block:select', function(e) {
      var slide = e.target.closest('.fun-points__slide');
      if (slide) {
        var index = parseInt(slide.getAttribute('data-slide-index'), 10);
        var sec = slide.closest('.fun-points-section');
        if (sec && !isNaN(index)) {
          var track = sec.querySelector('[data-track]');
          if (track) {
            track.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
            var dots = sec.querySelectorAll('.fun-points__dot');
            dots.forEach(function(dot, idx) {
              if (idx === index) dot.classList.add('is-active');
              else dot.classList.remove('is-active');
            });
          }
        }
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Fun Points",
  "tag": "section",
  "class": "fun-points-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Our Philosophy in 5 fun points!"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background color",
      "default": "#FEF3C7"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge text color",
      "default": "#92400E"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Health is not just an option"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#C0503B"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "It’s a journey to self-love and feeling well from day one"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#4B5563"
    },
    {
      "type": "header",
      "content": "Section Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Carousel Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show side arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable auto-rotation",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto-rotate speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile padding top",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile padding bottom",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Point Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide image"
        },
        {
          "type": "text",
          "id": "image_by_url",
          "label": "Image by URL (optional)",
          "info": "Paste an external or CDN image link"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile slide image (optional)"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image alt text",
          "default": "Health philosophy fun point"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Slide link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fun Points",
      "settings": {
        "badge_text": "Our Philosophy in 5 fun points!",
        "badge_bg": "#FEF3C7",
        "badge_color": "#92400E",
        "heading": "Health is not just an option",
        "heading_color": "#C0503B",
