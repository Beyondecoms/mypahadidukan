{%- liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign heading_color = section.settings.heading_color | default: '#1F2937'
  assign subheading_color = section.settings.subheading_color | default: '#4B5563'
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign card_bg = section.settings.card_bg | default: '#FFFFFF'
  assign card_border = section.settings.card_border | default: '#EAD8C7'
  assign card_radius = section.settings.card_radius | default: 18
  assign card_gap = section.settings.card_gap | default: 20
  assign desktop_cards = section.settings.desktop_cards | default: 4
  assign mobile_cards = section.settings.mobile_cards | default: 1
  assign show_arrows = section.settings.show_arrows
  assign padding_top = section.settings.padding_top | default: 48
  assign padding_bottom = section.settings.padding_bottom | default: 48
-%}

<div
  id="custom-section-9-{{ section.id }}"
  class="custom-section-9"
  style="
    --cs9-bg: {{ bg_color }};
    --cs9-heading-color: {{ heading_color }};
    --cs9-subheading-color: {{ subheading_color }};
    --cs9-card-bg: {{ card_bg }};
    --cs9-card-border: {{ card_border }};
    --cs9-card-radius: {{ card_radius }}px;
    --cs9-cards-desktop: {{ desktop_cards }};
    --cs9-cards-mobile: {{ mobile_cards }};
    --cs9-gap: {{ card_gap }}px;
    --cs9-pt: {{ padding_top }}px;
    --cs9-pb: {{ padding_bottom }}px;
  "
>
  <div class="custom-section-9__container">
    {%- if heading != blank or subheading != blank -%}
      <div class="custom-section-9__header">
        {%- if heading != blank -%}
          <h2 class="custom-section-9__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="custom-section-9__subheading">{{ subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="custom-section-9__carousel-wrapper" data-carousel-wrapper>
      {%- if show_arrows and section.blocks.size > 0 -%}
        <button
          type="button"
          class="custom-section-9__arrow custom-section-9__arrow--prev"
          aria-label="Previous reviews"
          data-arrow="prev"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
      {%- endif -%}

      <div class="custom-section-9__track" data-carousel-track>
        {%- for block in section.blocks -%}
          {%- liquid
            assign quote = block.settings.quote
            assign image = block.settings.image
            assign image_url = block.settings.image_url
            assign author_name = block.settings.author_name
            assign badge_text = block.settings.badge_text
            assign show_verified = block.settings.show_verified_badge
            assign link = block.settings.link
          -%}

          <div class="custom-section-9__item" {{ block.shopify_attributes }}>
            {%- if link != blank -%}
              <a href="{{ link }}" class="custom-section-9__card" aria-label="Review by {{ author_name | default: 'Customer' | escape }}">
            {%- else -%}
              <div class="custom-section-9__card">
            {%- endif -%}

              {%- if quote != blank -%}
                <div class="custom-section-9__quote-wrap">
                  <p class="custom-section-9__quote">“{{ quote | remove_first: '“' | remove_first: '"' | remove: '”' }}</p>
                </div>
              {%- endif -%}

              <div class="custom-section-9__image-box">
                {%- if image_url != blank -%}
                  <img
                    src="{{ image_url }}"
                    loading="lazy"
                    class="custom-section-9__image"
                    alt="{{ author_name | default: 'Customer review photo' | escape }}"
                    width="450"
                    height="280"
                  >
                {%- elsif image != blank -%}
                  {{
                    image
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      class: 'custom-section-9__image',
                      widths: '240, 360, 480, 600',
                      alt: author_name | default: image.alt | default: 'Customer photo'
                  }}
                {%- else -%}
                  <div class="custom-section-9__placeholder">
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'custom-section-9__placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>

              {%- if author_name != blank or badge_text != blank -%}
                <div class="custom-section-9__author-info">
                  {%- if author_name != blank -%}
                    <span class="custom-section-9__author-name">{{ author_name }}</span>
                  {%- endif -%}

                  {%- if show_verified and badge_text != blank -%}
                    <div class="custom-section-9__verified-badge">
                      <svg class="custom-section-9__icon-check" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                      <span class="custom-section-9__badge-text">{{ badge_text }}</span>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- if link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="custom-section-9__item">
              <div class="custom-section-9__card">
                <div class="custom-section-9__quote-wrap">
                  <p class="custom-section-9__quote">“I've tried Shilajit from multiple brands, but nothing felt as pure and potent as the one from My Pahadi Dukan. You can literally feel the energy kick in a few days. Love that it's sourced straight from the mountains.</p>
                </div>
                <div class="custom-section-9__image-box">
                  <div class="custom-section-9__placeholder">
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'custom-section-9__placeholder-svg' }}
                  </div>
                </div>
                <div class="custom-section-9__author-info">
                  <span class="custom-section-9__author-name">Jayant</span>
                  <div class="custom-section-9__verified-badge">
                    <svg class="custom-section-9__icon-check" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                    <span class="custom-section-9__badge-text">Verified Buyer</span>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>

      {%- if show_arrows and section.blocks.size > 0 -%}
        <button
          type="button"
          class="custom-section-9__arrow custom-section-9__arrow--next"
          aria-label="Next reviews"
          data-arrow="next"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  #custom-section-9-{{ section.id }} {
    background-color: var(--cs9-bg);
    padding-top: var(--cs9-pt);
    padding-bottom: var(--cs9-pb);
    width: 100%;
    position: relative;
    box-sizing: border-box;
    font-family: inherit;
  }

  #custom-section-9-{{ section.id }} * {
    box-sizing: border-box;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__container {
    width: 100%;
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__header {
    text-align: center;
    margin-bottom: 30px;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__heading {
    margin: 0 0 6px 0;
    font-size: 24px;
    font-weight: 700;
    color: var(--cs9-heading-color);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__subheading {
    margin: 0;
    font-size: 14px;
    font-weight: 400;
    color: var(--cs9-subheading-color);
    line-height: 1.4;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__track {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--cs9-gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 10px 4px 14px 4px;
    width: 100%;
    scroll-behavior: smooth;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__track::-webkit-scrollbar {
    display: none;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__item {
    flex: 0 0 calc((100% - (var(--cs9-cards-desktop) - 1) * var(--cs9-gap)) / var(--cs9-cards-desktop));
    min-width: 0;
    scroll-snap-align: start;
    display: flex;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-radius: var(--cs9-card-radius);
    background-color: var(--cs9-card-bg);
    border: 1px solid var(--cs9-card-border);
    padding: 24px 22px 20px 22px;
    text-decoration: none;
    color: inherit;
    position: relative;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  #custom-section-9-{{ section.id }} .custom-section-9__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
  }

  #custom-section-9-{{ section.id }} .custom-section-9__quote-wrap {
    margin-bottom: 20px;
    flex-grow: 1;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__quote {
    margin: 0;
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.55;
    color: #1F2937;
    letter-spacing: 0.005em;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__image-box {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 14px;
    overflow: hidden;
    background-color: #F3F4F6;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.35s ease;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__card:hover .custom-section-9__image {
    transform: scale(1.03);
  }

  #custom-section-9-{{ section.id }} .custom-section-9__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.35;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__placeholder-svg {
    width: 60%;
    height: 60%;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__author-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__author-name {
    font-size: 16px;
    font-weight: 700;
    color: #111827;
    line-height: 1.2;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #2E7D6F;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__icon-check {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__badge-text {
    font-size: 11px;
    font-weight: 500;
    color: #4B5563;
    letter-spacing: 0.01em;
  }

  /* Arrows */
  #custom-section-9-{{ section.id }} .custom-section-9__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #FFFFFF;
    border: none;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1F2937;
    cursor: pointer;
    z-index: 5;
    transition: transform 0.2s ease, opacity 0.2s ease, box-shadow 0.2s ease;
    padding: 0;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__arrow:hover:not(:disabled) {
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.18);
  }

  #custom-section-9-{{ section.id }} .custom-section-9__arrow:disabled {
    opacity: 0.25;
    cursor: not-allowed;
    pointer-events: none;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__arrow--prev {
    left: 4px;
  }

  #custom-section-9-{{ section.id }} .custom-section-9__arrow--next {
    right: 4px;
  }

  @media (max-width: 1200px) {
    #custom-section-9-{{ section.id }} .custom-section-9__item {
      flex: 0 0 calc((100% - 2 * var(--cs9-gap)) / 3);
    }
  }

  @media (max-width: 991px) {
    #custom-section-9-{{ section.id }} .custom-section-9__container {
      padding: 0 16px;
    }
    #custom-section-9-{{ section.id }} .custom-section-9__item {
      flex: 0 0 calc((100% - var(--cs9-gap)) / 2.2);
    }
    #custom-section-9-{{ section.id }} .custom-section-9__heading {
      font-size: 21px;
    }
  }

  @media (max-width: 767px) {
    #custom-section-9-{{ section.id }} .custom-section-9__container {
      padding: 0 12px;
    }
    #custom-section-9-{{ section.id }} .custom-section-9__header {
      margin-bottom: 20px;
    }
    #custom-section-9-{{ section.id }} .custom-section-9__heading {
      font-size: 18px;
    }
    #custom-section-9-{{ section.id }} .custom-section-9__item {
      flex: 0 0 calc((100% - (var(--cs9-cards-mobile) - 0.2) * var(--cs9-gap)) / var(--cs9-cards-mobile));
    }
    #custom-section-9-{{ section.id }} .custom-section-9__card {
      padding: 18px 16px 16px 16px;
    }
    #custom-section-9-{{ section.id }} .custom-section-9__arrow {
      width: 30px;
      height: 30px;
    }
    #custom-section-9-{{ section.id }} .custom-section-9__arrow--prev {
      left: 0px;
    }
    #custom-section-9-{{ section.id }} .custom-section-9__arrow--next {
      right: 0px;
    }
  }
</style>

<script>
  (function () {
    function initTestimonialsCarousel() {
      var section = document.getElementById('custom-section-9-{{ section.id }}');
      if (!section) return;

      var track = section.querySelector('[data-carousel-track]');
      var prevBtn = section.querySelector('[data-arrow="prev"]');
      var nextBtn = section.querySelector('[data-arrow="next"]');

      if (!track) return;

      function updateArrows() {
        if (!prevBtn || !nextBtn) return;
        var maxScrollLeft = track.scrollWidth - track.clientWidth;
        prevBtn.disabled = track.scrollLeft <= 4;
        nextBtn.disabled = track.scrollLeft >= maxScrollLeft - 4;
      }

      function scrollTrack(direction) {
        var card = track.querySelector('.custom-section-9__item');
        if (!card) return;
        var cardWidth = card.getBoundingClientRect().width;
        var gap = parseFloat(getComputedStyle(track).gap) || 20;
        var scrollAmount = (cardWidth + gap) * 1.5;
        if (direction === 'prev') {
          track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        } else {
          track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          scrollTrack('prev');
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          scrollTrack('next');
        });
      }

      track.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows, { passive: true });
      setTimeout(updateArrows, 100);
      updateArrows();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTestimonialsCarousel);
    } else {
      initTestimonialsCarousel();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target.id === 'shopify-section-{{ section.id }}' || e.target.querySelector('#custom-section-9-{{ section.id }}')) {
        initTestimonialsCarousel();
      }
    });
  })();
</script>

