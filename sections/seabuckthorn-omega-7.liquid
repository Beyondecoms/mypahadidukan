{{ 'section-seabuckthorn-m3.css' | asset_url | stylesheet_tag }}

<div class="sb-m3-section" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="sb-m3-container">
    
    <!-- Top Meta Bar -->
    <div class="sb-m3-top-bar">
      <span class="sb-m3-module-badge">{{ section.settings.module_tag }}</span>
      {%- if section.settings.design_tag != blank -%}
        <span class="sb-m3-pill-badge" style="background-color: {{ section.settings.badge_bg }}; color: {{ section.settings.badge_color }};">{{ section.settings.design_tag }}</span>
      {%- endif -%}

    </div>

    <!-- Header Section -->
    <div class="sb-m3-header">
      {%- if section.settings.subtitle != blank -%}
        <h4 class="sb-m3-subtitle" style="color: {{ section.settings.subtitle_color }};">{{ section.settings.subtitle }}</h4>
      {%- endif -%}
      <h2 class="sb-m3-title" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
    </div>

    <!-- 4 Cards Grid -->
    <div class="sb-m3-cards-grid">
      {%- for block in section.blocks -%}
        <div class="sb-m3-card" style="background-color: {{ section.settings.card_bg }}; color: {{ section.settings.card_text_color }};" {{ block.shopify_attributes }}>
          
          <!-- Card Header (Number + Title + Stamp Motif) -->
          <div class="sb-m3-card-header">
            <div class="sb-m3-card-header-text">
              <span class="sb-m3-num">{{ block.settings.num }}</span>
              <h3 class="sb-m3-card-title">{{ block.settings.title }}</h3>
            </div>
            <div class="sb-m3-card-stamp">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>

          <!-- Card Body -->
          <div class="sb-m3-card-body">
            <p>{{ block.settings.content }}</p>
            {%- if block.settings.highlight_text != blank -%}
              <p class="sb-m3-highlight-text">{{ block.settings.highlight_text }}</p>
            {%- endif -%}
          </div>

        </div>
      {%- endfor -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "M3 - Meet omega-7",
  "tag": "section",
  "class": "section-sb-m3",
  "settings": [
    {
      "type": "text",
      "id": "module_tag",
      "label": "Module Tag",
      "default": "M3 · Meet omega-7"
    },
    {
      "type": "text",
      "id": "design_tag",
      "label": "Design Badge",
      "default": "balanced"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "THE ONE YOU CAN'T GET ANYWHERE ELSE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet omega-7"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fffbef"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1c1918"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#ee5922"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Text Color",
      "default": "#1c1918"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Pill Badge BG",
      "default": "#008b75"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Pill Badge Text Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "num",
          "label": "Number Badge",
          "default": "①"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title",
          "default": "WHAT IS IT?"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Card Content",
          "default": "A fatty acid. Most people have heard of omega-3. Almost nobody has heard of this one. It's also in mother's milk, oddly enough."
        },
        {
          "type": "textarea",
          "id": "highlight_text",
          "label": "Highlight Subtext (Optional)",
          "default": "Highlight Subtext"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "M3 - Meet omega-7",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
