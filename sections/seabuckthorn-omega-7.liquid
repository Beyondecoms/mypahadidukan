{{ 'section-seabuckthorn-m3.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign m3_eyebrow = product.metafields.custom.m3_section_eyebrow.value
  assign m3_heading = product.metafields.custom.m3_section_heading.value

  assign m3_card_1_title = product.metafields.custom.m3_card_1_title.value
  assign m3_card_1_desc = product.metafields.custom.m3_card_1_description.value
  assign m3_card_1_highlight = product.metafields.custom.m3_card_1_highlight.value

  assign m3_card_2_title = product.metafields.custom.m3_card_2_title.value
  assign m3_card_2_desc = product.metafields.custom.m3_card_2_description.value
  assign m3_card_2_highlight = product.metafields.custom.m3_card_2_highlight.value

  assign m3_card_3_title = product.metafields.custom.m3_card_3_title.value
  assign m3_card_3_desc = product.metafields.custom.m3_card_3_description.value
  assign m3_card_3_highlight = product.metafields.custom.m3_card_3_highlight.value

  assign m3_card_4_title = product.metafields.custom.m3_card_4_title.value
  assign m3_card_4_desc = product.metafields.custom.m3_card_4_description.value
  assign m3_card_4_highlight = product.metafields.custom.m3_card_4_highlight.value

  assign has_card_1 = false
  if m3_card_1_title != blank or m3_card_1_desc != blank or m3_card_1_highlight != blank
    assign has_card_1 = true
  endif

  assign has_card_2 = false
  if m3_card_2_title != blank or m3_card_2_desc != blank or m3_card_2_highlight != blank
    assign has_card_2 = true
  endif

  assign has_card_3 = false
  if m3_card_3_title != blank or m3_card_3_desc != blank or m3_card_3_highlight != blank
    assign has_card_3 = true
  endif

  assign has_card_4 = false
  if m3_card_4_title != blank or m3_card_4_desc != blank or m3_card_4_highlight != blank
    assign has_card_4 = true
  endif

  assign has_cards = false
  if has_card_1 or has_card_2 or has_card_3 or has_card_4
    assign has_cards = true
  endif

  assign has_content = false
  if m3_eyebrow != blank or m3_heading != blank or has_cards
    assign has_content = true
  endif
-%}

{%- if has_content -%}
<div class="sb-m3-section" style="{% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}">
  <div class="sb-m3-container">
    
    <!-- Header Section -->
    {%- if m3_eyebrow != blank or m3_heading != blank -%}
      <div class="sb-m3-header">
        {%- if m3_eyebrow != blank -%}
          <h4 class="sb-m3-subtitle" style="color: {{ section.settings.subtitle_color }};">{{ m3_eyebrow }}</h4>
        {%- endif -%}
        {%- if m3_heading != blank -%}
          <h2 class="sb-m3-title" style="color: {{ section.settings.heading_color }};">{{ m3_heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- 4 Cards Grid -->
    {%- if has_cards -%}
      <div class="sb-m3-cards-grid">
        
        <!-- Card 1 -->
        {%- if has_card_1 -%}
          <div class="sb-m3-card" style="background-color: {{ section.settings.card_bg }}; color: {{ section.settings.card_text_color }};">
            <!-- Card Header (Number + Title + Stamp Motif) -->
            <div class="sb-m3-card-header">
              <div class="sb-m3-card-header-text">
                <span class="sb-m3-num">①</span>
                {%- if m3_card_1_title != blank -%}
                  <h3 class="sb-m3-card-title">{{ m3_card_1_title }}</h3>
                {%- endif -%}
              </div>
              <div class="sb-m3-card-stamp">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>

            <!-- Card Body -->
            {%- if m3_card_1_desc != blank or m3_card_1_highlight != blank -%}
              <div class="sb-m3-card-body">
                {%- if m3_card_1_desc != blank -%}
                  <p>{{ m3_card_1_desc | newline_to_br }}</p>
                {%- endif -%}
                {%- if m3_card_1_highlight != blank -%}
                  <p class="sb-m3-highlight-text">{{ m3_card_1_highlight | newline_to_br }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- Card 2 -->
        {%- if has_card_2 -%}
          <div class="sb-m3-card" style="background-color: {{ section.settings.card_bg }}; color: {{ section.settings.card_text_color }};">
            <!-- Card Header (Number + Title + Stamp Motif) -->
            <div class="sb-m3-card-header">
              <div class="sb-m3-card-header-text">
                <span class="sb-m3-num">②</span>
                {%- if m3_card_2_title != blank -%}
                  <h3 class="sb-m3-card-title">{{ m3_card_2_title }}</h3>
                {%- endif -%}
              </div>
              <div class="sb-m3-card-stamp">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>

            <!-- Card Body -->
            {%- if m3_card_2_desc != blank or m3_card_2_highlight != blank -%}
              <div class="sb-m3-card-body">
                {%- if m3_card_2_desc != blank -%}
                  <p>{{ m3_card_2_desc | newline_to_br }}</p>
                {%- endif -%}
                {%- if m3_card_2_highlight != blank -%}
                  <p class="sb-m3-highlight-text">{{ m3_card_2_highlight | newline_to_br }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- Card 3 -->
        {%- if has_card_3 -%}
          <div class="sb-m3-card" style="background-color: {{ section.settings.card_bg }}; color: {{ section.settings.card_text_color }};">
            <!-- Card Header (Number + Title + Stamp Motif) -->
            <div class="sb-m3-card-header">
              <div class="sb-m3-card-header-text">
                <span class="sb-m3-num">③</span>
                {%- if m3_card_3_title != blank -%}
                  <h3 class="sb-m3-card-title">{{ m3_card_3_title }}</h3>
                {%- endif -%}
              </div>
              <div class="sb-m3-card-stamp">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>

            <!-- Card Body -->
            {%- if m3_card_3_desc != blank or m3_card_3_highlight != blank -%}
              <div class="sb-m3-card-body">
                {%- if m3_card_3_desc != blank -%}
                  <p>{{ m3_card_3_desc | newline_to_br }}</p>
                {%- endif -%}
                {%- if m3_card_3_highlight != blank -%}
                  <p class="sb-m3-highlight-text">{{ m3_card_3_highlight | newline_to_br }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- Card 4 -->
        {%- if has_card_4 -%}
          <div class="sb-m3-card" style="background-color: {{ section.settings.card_bg }}; color: {{ section.settings.card_text_color }};">
            <!-- Card Header (Number + Title + Stamp Motif) -->
            <div class="sb-m3-card-header">
              <div class="sb-m3-card-header-text">
                <span class="sb-m3-num">④</span>
                {%- if m3_card_4_title != blank -%}
                  <h3 class="sb-m3-card-title">{{ m3_card_4_title }}</h3>
                {%- endif -%}
              </div>
              <div class="sb-m3-card-stamp">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>

            <!-- Card Body -->
            {%- if m3_card_4_desc != blank or m3_card_4_highlight != blank -%}
              <div class="sb-m3-card-body">
                {%- if m3_card_4_desc != blank -%}
                  <p>{{ m3_card_4_desc | newline_to_br }}</p>
                {%- endif -%}
                {%- if m3_card_4_highlight != blank -%}
                  <p class="sb-m3-highlight-text">{{ m3_card_4_highlight | newline_to_br }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>
    {%- endif -%}

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "M3 - Meet omega-7",
  "tag": "section",
  "class": "section-sb-m3",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fffbef"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1c1918"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#ee5922"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Text Color",
      "default": "#1c1918"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Pill Badge BG",
      "default": "#008b75"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Pill Badge Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "M3 - Meet omega-7"
    }
  ]
}
{% endschema %}
