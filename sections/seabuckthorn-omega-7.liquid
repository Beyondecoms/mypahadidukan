{{ 'section-seabuckthorn-m3.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign m3_eyebrow = product.metafields.custom.m3_section_eyebrow.value | default: product.metafields.custom.m3_section_eyebrow
  assign m3_heading = product.metafields.custom.m3_section_heading.value | default: product.metafields.custom.m3_section_heading

  assign m3_images = product.metafields.custom.m3_image.value | default: product.metafields.custom.m3_image | default: product.metafields.custom.m3_images.value | default: product.metafields.custom.m3_images | default: product.metafields.custom['m3_image'].value | default: product.metafields.custom['m3_image'] | default: product.metafields.custom['m3_images'].value | default: product.metafields.custom['m3_images']

  assign m3_first = m3_images | first
  assign has_cards = false
  if m3_first != blank
    assign has_cards = true
  elsif m3_images != blank and m3_images.src != blank or m3_images.width != blank
    assign has_cards = true
  endif

  assign has_content = false
  if m3_eyebrow != blank or m3_heading != blank or has_cards
    assign has_content = true
  endif
-%}

{%- if has_content -%}
<div class="sb-m3-section" style="{% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}">
  <div class="sb-m3-container">
    
    <!-- Header Section -->
    {%- if m3_eyebrow != blank or m3_heading != blank -%}
      <div class="sb-m3-header">
        {%- if m3_eyebrow != blank -%}
          <h4 class="sb-m3-subtitle" style="color: {{ section.settings.subtitle_color }};">{{ m3_eyebrow }}</h4>
        {%- endif -%}
        {%- if m3_heading != blank -%}
          <h2 class="sb-m3-title" style="color: {{ section.settings.heading_color }};">{{ m3_heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Cards Grid -->
    {%- if has_cards -%}
      <div class="sb-m3-cards-grid">
        {%- if m3_first != blank -%}
          {%- for image in m3_images limit: 4 -%}
            {%- if image != blank -%}
              {%- assign img_alt = image.alt | default: m3_heading | default: product.title | escape -%}
              <div class="sb-m3-card sb-m3-card--image" style="background-color: {{ section.settings.card_bg }};">
                {{ image | image_url: width: 1200 | image_tag: 
                  loading: 'lazy', 
                  alt: img_alt,
                  class: 'sb-m3-card-img',
                  widths: '300, 450, 600, 800, 1000, 1200',
                  sizes: '(max-width: 749px) 100vw, (max-width: 1024px) 50vw, 25vw'
                }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- elsif m3_images.src != blank or m3_images.width != blank -%}
          {%- assign img_alt = m3_images.alt | default: m3_heading | default: product.title | escape -%}
          <div class="sb-m3-card sb-m3-card--image" style="background-color: {{ section.settings.card_bg }};">
            {{ m3_images | image_url: width: 1200 | image_tag: 
              loading: 'lazy', 
              alt: img_alt,
              class: 'sb-m3-card-img',
              widths: '300, 450, 600, 800, 1000, 1200',
              sizes: '(max-width: 749px) 100vw, (max-width: 1024px) 50vw, 25vw'
            }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "M3 - Meet omega-7",
  "tag": "section",
  "class": "section-sb-m3",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fffbef"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1c1918"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#ee5922"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Text Color",
      "default": "#1c1918"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Pill Badge BG",
      "default": "#008b75"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Pill Badge Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "M3 - Meet omega-7"
    }
  ]
}
{% endschema %}
