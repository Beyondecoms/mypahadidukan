{{ 'section-bank-details.css' | asset_url | stylesheet_tag }}

<section class="bd-section" style="background-color: {{ section.settings.background_color }};">
  <div class="bd-inner" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">

    <!-- BANK DETAILS TABLE -->
    <div class="bd-table">
      {% assign fields = section.blocks | where: "type", "bank_field" %}
      {% for block in fields %}
        <div class="bd-row" {{ block.shopify_attributes }}>
          <span class="bd-label" style="color: {{ section.settings.label_color }};">{{ block.settings.label }}:</span>
          <span class="bd-value" style="color: {{ section.settings.value_color }};">{{ block.settings.value }}</span>
        <button
        class="bd-copy-btn"
        data-copy="{{ block.settings.value }}"
        aria-label="Copy {{ block.settings.label }}"
        title="Copy"
        >
            <!-- CLIPBOARD IMAGE -->
            <span class="bd-icon-clipboard">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="8" y="2" width="8" height="4" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <path d="M8 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-2" stroke="currentColor" stroke-width="1.5" fill="none"/>
                <line x1="9" y1="12" x2="15" y2="12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="9" y1="15" x2="13" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>           
             </span>
            <!-- COPIED CHECKMARK SVG -->
            <span class="bd-icon-copied">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" fill="#1a6b4a" opacity="0.12"/>
                <path d="M7 12.5l3.5 3.5L17 9" stroke="#1a6b4a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="bd-copied-text">Copied!</span>
            </span>
        </button>
        </div>
      {% endfor %}
    </div>

    <!-- DIVIDER -->
    <div class="bd-divider" style="border-color: {{ section.settings.divider_color }};"></div>

    <!-- HELP SECTION -->
    <div class="bd-help">
      <h3 class="bd-help-title" style="color: {{ section.settings.help_title_color }};">{{ section.settings.help_title }}</h3>
      <p class="bd-help-sub" style="color: {{ section.settings.help_sub_color }};">{{ section.settings.help_subtitle }}</p>
      <div class="bd-help-links">
        {% if section.settings.whatsapp_url != blank %}
          <a class="bd-help-link" href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener" style="color: {{ section.settings.link_color }};">
            {{ section.settings.whatsapp_label }}
          </a>
        {% endif %}
        {% if section.settings.email_url != blank %}
          <a class="bd-help-link" href="{{ section.settings.email_url }}" style="color: {{ section.settings.link_color }};">
            {{ section.settings.email_label }}
          </a>
        {% endif %}
      </div>
    </div>

  </div>
</section>

<script>
  document.querySelectorAll('.bd-copy-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var text = btn.getAttribute('data-copy');
      navigator.clipboard.writeText(text).then(function() {
        btn.classList.add('bd-copied');
        setTimeout(function() {
          btn.classList.remove('bd-copied');
        }, 2000);
      }).catch(function() {
        // Fallback for older browsers
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        btn.classList.add('bd-copied');
        setTimeout(function() {
          btn.classList.remove('bd-copied');
        }, 2000);
      });
    });
  });
</script>

