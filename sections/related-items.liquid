{% comment %}
Related Items Section
{% endcomment %}

<style>
  .related-items-container {
    display: flex;
    flex-wrap: wrap;
    margin: 0 auto;
    gap: 10px;
    width: 1320px;
    height: auto; /* fixed height removed */
    padding: 20px 40px;
    border-radius: 9px;
    background: #f2f2f2;
    overflow-x: hidden; /* scroll removed */
    margin-top: 25px;
    margin-bottom: -14px;
  }

  .related-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 140px;
    height: 30px;
    padding: 4px 25px;
    border-left: 1.6px solid var(--primary-web-color);
    border-top-right-radius: 6px ;
    border-bottom-right-radius: 6px ;
    background: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    color: #231F20;
    font-family: 'Archivo', sans-serif;
    font-weight: 600;
    font-size: 14px;
    line-height: 23.1px;
    text-align: center;
    opacity: 0.8;
    transition: transform 0.2s, opacity 0.2s;
  }

  .related-item:hover {
    transform: translateY(-2px);
    opacity: 1;
  }

  #related-tittle {
    color: #000000;
    width: 1320px;
    margin: 0px;
    font-size: 16px;
    font-weight: 500;
    font-family: var(--font-family-normal);
  }
  .related-item-content{
    display: flex;
    flex-direction: row;
    overflow-x: scroll;
    gap: 21px;
  }
  .related-item-content::-webkit-scrollbar{
  display: none; /* Chrome, Safari */
}
@media (max-width: 1024px) {
  .related-items-container {
    width: calc(100% - 80px); /* same side margin feel */
    margin: 0 auto;
    padding: 20px 40px;
    box-sizing: border-box;
    margin-top: 33px;
  }

  #related-tittle {
    width: calc(100% - 80px);
    margin: 0px;
  }
}

@media (max-width: 768px) {
  .related-items-container {
        gap: 6px;
        padding: 12px;
        width: 93%;
        margin: 21px auto;
  }

  .related-item {
    width: auto;
    min-width: 120px;
    padding: 4px 16px;
    font-size: 13px;
  }

  #related-tittle {
    font-size: 16px;
  }
}

@media (max-width: 480px) {
  .related-item {
    min-width: 110px;
    padding: 4px 12px;
    font-size: 12px;
  }
}
</style>



<div class="related-items-container">
  <p id="related-tittle">Related Items</p>
  <div class="related-item-content">
      {% for block in section.blocks %}
      <a href="{{ block.settings.item_link }}" class="related-item">
        <span class="related-item-name">{{ block.settings.item_name }}</span>
      </a>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Related Items",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Related Item",
      "settings": [
        {
          "type": "text",
          "id": "item_name",
          "label": "Item Name"
        },
        {
          "type": "url",
          "id": "item_link",
          "label": "Item Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Related Items",
      "category": "Collection"
    }
  ]
}
{% endschema %}