{{ 'section-brand-story.css' | asset_url | stylesheet_tag }}

    <div 
      class="bs-section"
      style="
        {% if section.settings.bg_image != blank %}
          background-image: url({{ section.settings.bg_image | image_url: width: 2000 }});
          background-size: cover;
          background-position: center;
          background-repeat: no-repeat;
        {% else %}
          background: {{ section.settings.bg_color }};
        {% endif %}
      "
    >
    <div class="bs-wrapper">
      <!-- Mobile-only image shown above title -->
    <h2 class="bs-philosophy-title">
        {%- if section.settings.team_image != blank -%}
      <img
        src="{{ section.settings.team_image | image_url: width: 600 }}"
        alt="{{ section.settings.philosophy_title }}"
        class="bs-team-img--mobile-top"
        loading="lazy"
      >
    {%- endif -%}
      {{ section.settings.philosophy_title }}</h2>
    <!-- ── ROW 1: Philosophy + Image ── -->
    <div class="bs-top-row">
      <div class="bs-left">
        <p class="bs-philosophy-text">{{ section.settings.philosophy_text }}</p>

        <!-- Stats -->
        <div class="bs-stats">
          {%- for block in section.blocks -%}
            {%- if block.type == 'stat' -%}
              <div class="bs-stat" {{ block.shopify_attributes }}>
                <div class="bs-stat-label-wrap">
                  <div class="bs-stat-number">{{ block.settings.number }}</div>
                  <span class="bs-stat-label-top">{{ block.settings.label_top }}</span>
                </div>
                <span class="bs-stat-label-bottom">{{ block.settings.label_bottom }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="bs-right">
        {%- if section.settings.team_image != blank -%}
          <img
            src="{{ section.settings.team_image | image_url: width: 600 }}"
            alt="{{ section.settings.philosophy_title }}"
            class="bs-team-img"
            loading="lazy"
          >
        {%- endif -%}
      </div>
    </div>

    <!-- ── ROW 2: In the Media ── -->
    <div class="bs-media-row">
      <h3 class="bs-media-title">{{ section.settings.media_title }}</h3>
      <div class="bs-marquee-outer">
        <div class="bs-marquee-track bs-media-logos">
          {%- for i in (1..6) -%}
            {%- assign logo_key = 'media_logo_' | append: i -%}
            {%- assign link_key = 'media_link_' | append: i -%}
            {%- if section.settings[logo_key] != blank -%}
              <div class="bs-media-logo">
                {%- if section.settings[link_key] != blank -%}
                  <a href="{{ section.settings[link_key] }}" target="_blank" rel="noopener">
                {%- endif -%}
                <img
                  src="{{ section.settings[logo_key] | image_url: width: 160 }}"
                  alt="Media logo {{ i }}"
                  loading="lazy"
                >
                {%- if section.settings[link_key] != blank -%}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
          {%- for i in (1..6) -%}
            {%- assign logo_key = 'media_logo_' | append: i -%}
            {%- assign link_key = 'media_link_' | append: i -%}
            {%- if section.settings[logo_key] != blank -%}
              <div class="bs-media-logo" aria-hidden="true">
                {%- if section.settings[link_key] != blank -%}
                  <a href="{{ section.settings[link_key] }}" target="_blank" rel="noopener" tabindex="-1">
                {%- endif -%}
                <img
                  src="{{ section.settings[logo_key] | image_url: width: 160 }}"
                  alt=""
                  loading="lazy"
                >
                {%- if section.settings[link_key] != blank -%}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var card = document.getElementById('bs-letter-{{ section.id }}');
  if (!card) return;
  card.addEventListener('click', function () {
    card.classList.toggle('flipped');
  });
})();
</script>
<script>
(function () {
  var mediaLogos = document.querySelector('.bs-media-logos');
  if (!mediaLogos) return;

  if (!('IntersectionObserver' in window)) {
    mediaLogos.classList.add('bs-in-view');
    return;
  }

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        mediaLogos.classList.add('bs-in-view');
      } else {
        mediaLogos.classList.remove('bs-in-view');
      }
    });
  }, { threshold: 0.2 });

  observer.observe(mediaLogos);
})();
</script>
