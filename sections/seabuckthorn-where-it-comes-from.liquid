{{ 'section-seabuckthorn-m6.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign m6_heading = product.metafields.custom.m6_section_heading.value
  assign m6_subtitle = product.metafields.custom.m6_subtitle.value
  assign m6_badge = product.metafields.custom.m6_badge_text.value
  assign m6_image = product.metafields.custom.m6_image.value | default: product.metafields.custom.m6_image
  assign m6_caption = product.metafields.custom.m6_image_caption.value
  assign m6_desc_1 = product.metafields.custom.m6_description_1.value
  assign m6_desc_2 = product.metafields.custom.m6_description_2.value
  assign m6_desc_3 = product.metafields.custom.m6_description_3.value
  assign m6_desc_4 = product.metafields.custom.m6_description_4.value
  assign m6_tags = product.metafields.custom.m6_tags.value
  assign m6_alt = m6_caption | default: m6_heading | default: product.title | escape

  assign has_story = false
  if m6_desc_1 != blank or m6_desc_2 != blank or m6_desc_3 != blank or m6_desc_4 != blank
    assign has_story = true
  endif

  assign has_content = false
  if m6_heading != blank or m6_subtitle != blank or m6_image != blank or m6_badge != blank or has_story or m6_tags != blank
    assign has_content = true
  endif
-%}

{%- if has_content -%}
<div class="sb-m6-section">
  <div class="sb-m6-container">
    
    <!-- Header Section -->
    {%- if m6_heading != blank or m6_subtitle != blank -%}
      <div class="sb-m6-header">
        {%- if m6_heading != blank -%}
          <h2 class="sb-m6-title">{{ m6_heading }}</h2>
        {%- endif -%}
        {%- if m6_subtitle != blank -%}
          <p class="sb-m6-subtitle">{{ m6_subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Full Bleed Banner & Story Card -->
    {%- if m6_image != blank or m6_badge != blank or has_story or m6_tags != blank -%}
      <div class="sb-m6-banner-card">
        
        <!-- Banner Image Wrap (Only if image is present) -->
        {%- if m6_image != blank -%}
          <div class="sb-m6-banner-image-wrap">
            {{ m6_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: m6_alt, width: 1400, height: 400 }}
            {%- if m6_badge != blank -%}
              <div class="sb-m6-stamp-overlay">
                <span>{{ m6_badge }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- elsif m6_badge != blank -%}
          <div style="padding: 16px 24px; background: #fff8e8; border-bottom: 1.5px solid #e7ded0;">
            <span class="sb-m6-pill-badge">{{ m6_badge }}</span>
          </div>
        {%- endif -%}

        <!-- Story Paragraphs -->
        {%- if has_story -%}
          <div class="sb-m6-story-body">
            {%- if m6_desc_1 != blank -%}
              <div class="sb-m6-story-block">
                <p>{{ m6_desc_1 }}</p>
              </div>
            {%- endif -%}
            {%- if m6_desc_2 != blank -%}
              <div class="sb-m6-story-block">
                <p>{{ m6_desc_2 }}</p>
              </div>
            {%- endif -%}
            {%- if m6_desc_3 != blank -%}
              <div class="sb-m6-story-block">
                <p>{{ m6_desc_3 }}</p>
              </div>
            {%- endif -%}
            {%- if m6_desc_4 != blank -%}
              <div class="sb-m6-story-block">
                <p>{{ m6_desc_4 }}</p>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <!-- Facts Ticker Footer -->
        {%- if m6_tags != blank -%}
          <div class="sb-m6-facts-bar">
            {%- for tag in m6_tags -%}
              {%- if tag != blank -%}
                <div class="sb-m6-fact-item"><span class="sb-m6-fact-bullet">●</span> {{ tag }}</div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    {%- endif -%}

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "M6 - Where it comes from",
  "tag": "section",
  "class": "section-sb-m6",
  "settings": [],
  "presets": [
    {
      "name": "M6 - Where it comes from"
    }
  ]
}
{% endschema %}
