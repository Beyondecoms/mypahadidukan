{% comment %}
  ── Pre-pass: figure out which blocks actually have data ──────────────────────
  Build a comma-separated string of block indexes that have real content.
  A block index is appended as "N," so we can safely use `contains "N,"`.
{% endcomment %}
{%- assign visible_blocks = "" -%}
{%- for block in section.blocks -%}
  {%- assign _has = false -%}

  {%- case block.type -%}

    {%- when 'description_tab' -%}
      {%- if product.metafields.custom.description_banner_desktop != blank -%}
        {%- assign _has = true -%}
      {%- endif -%}

    {%- when 'benefits_tab' -%}
      {%- if product.metafields.custom.benefits_banner_desktop != blank -%}
        {%- assign _has = true -%}
      {%- endif -%}

    {%- when 'nutrients_tab' -%}
      {%- if product.metafields.custom.nutrients_banner_desktop != blank -%}
        {%- assign _has = true -%}
      {%- endif -%}

    {%- when 'ingredients_tab' -%}
      {%- assign _ing = product.metafields.custom.ingredients_json.value -%}
      {%- if _ing != blank -%}{%- assign _has = true -%}{%- endif -%}

    {%- when 'how_to_use_tab' -%}
      {%- assign _vid   = product.metafields.custom.how_to_use_video.value -%}
      {%- assign _steps = product.metafields.custom.how_to_use_steps.value -%}
      {%- if _vid != blank or _steps != blank -%}{%- assign _has = true -%}{%- endif -%}

  {%- endcase -%}

  {%- if _has -%}
    {%- assign visible_blocks = visible_blocks | append: forloop.index0 | append: "," -%}
  {%- endif -%}
{%- endfor -%}

{% comment %} ── Render nothing if no block has data ─────────────────────────── {% endcomment %}
{%- if visible_blocks == "" -%}
  {%- comment -%}No data for any tab – section is intentionally empty.{%- endcomment -%}
{%- else -%}

{{ 'section-product-tabs.css' | asset_url | stylesheet_tag }}

<div class="pt-section" id="pt-section-{{ section.id }}">

  <!-- Tab Bar -->
  <div class="pt-tab-bar">
    <div class="pt-tabs-wrap">
      <div class="pt-tab-indicator"></div>
      {%- assign _tab_i = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign _bkey = forloop.index0 | append: "," -%}
        {%- if visible_blocks contains _bkey -%}
          <button
            class="pt-tab {% if _tab_i == 0 %}active{% endif %}"
            data-tab="{{ _tab_i }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.tab_label }}
          </button>
          {%- assign _tab_i = _tab_i | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <!-- Content Panels -->
  <div class="pt-content" id="pt-content-{{ section.id }}">
    {%- assign _panel_i = 0 -%}
    {%- for block in section.blocks -%}
      {%- assign _bkey = forloop.index0 | append: "," -%}
      {%- unless visible_blocks contains _bkey -%}{%- continue -%}{%- endunless -%}

      <div
        class="pt-panel {% if _panel_i == 0 %}active{% endif %}"
        data-panel="{{ _panel_i }}"
      >
        {%- case block.type -%}

          {%- when 'description_tab' -%}
            {%- assign desc_desktop = product.metafields.custom.description_banner_desktop -%}
            {%- assign desc_mobile  = product.metafields.custom.description_banner_mobile -%}

            {%- if desc_desktop != blank -%}
              <img src="{{ desc_desktop }}" alt="{{ block.settings.tab_label }}" class="pt-banner-img pt-banner-desktop" loading="lazy">
            {%- endif -%}
            {%- if desc_mobile != blank -%}
              <img src="{{ desc_mobile }}" alt="{{ block.settings.tab_label }}" class="pt-banner-img pt-banner-mobile" loading="lazy">
            {%- endif -%}

          {%- when 'benefits_tab' -%}
            {%- assign ben_desktop = product.metafields.custom.benefits_banner_desktop -%}
            {%- assign ben_mobile  = product.metafields.custom.benefits_banner_mobile -%}

            {%- if ben_desktop != blank -%}
              <img src="{{ ben_desktop }}" alt="{{ block.settings.tab_label }}" class="pt-banner-img pt-banner-desktop" loading="lazy">
            {%- endif -%}
            {%- if ben_mobile != blank -%}
              <img src="{{ ben_mobile }}" alt="{{ block.settings.tab_label }}" class="pt-banner-img pt-banner-mobile" loading="lazy">
            {%- endif -%}

          {%- when 'nutrients_tab' -%}
            {%- assign nut_desktop = product.metafields.custom.nutrients_banner_desktop -%}
            {%- assign nut_mobile  = product.metafields.custom.nutrients_banner_mobile -%}

            {%- if nut_desktop != blank -%}
              <img src="{{ nut_desktop }}" alt="{{ block.settings.tab_label }}" class="pt-banner-img pt-banner-desktop" loading="lazy">
            {%- endif -%}
            {%- if nut_mobile != blank -%}
              <img src="{{ nut_mobile }}" alt="{{ block.settings.tab_label }}" class="pt-banner-img pt-banner-mobile" loading="lazy">
            {%- endif -%}

          {%- when 'ingredients_tab' -%}
            {%- assign ing_json_raw = product.metafields.custom.ingredients_json.value -%}

            <div class="pt-ing-outer">
              <div class="pt-ing-track" id="pt-ing-track-{{ section.id }}-{{ _panel_i }}">
                {%- for item in ing_json_raw -%}
                  <div class="pt-ing-card">
                    {%- if item.image != blank -%}
                      <div class="pt-ing-img-wrap">
                        <img src="{{ item.image }}" alt="{{ item.title }}" class="pt-ing-img" loading="lazy">
                      </div>
                    {%- else -%}
                      <div class="pt-ing-img-wrap pt-ing-img-placeholder"></div>
                    {%- endif -%}
                    <div class="pt-ing-body">
                      <h3 class="pt-ing-title">{{ item.title }}</h3>
                      <p class="pt-ing-desc">{{ item.description }}</p>
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            </div>

          {%- when 'how_to_use_tab' -%}
            <div class="pt-how-inner">

              <!-- Left: Video -->
              <div class="pt-how-video-wrap">
                {%- assign video_url = product.metafields.custom.how_to_use_video.value -%}

                {%- if video_url != blank -%}
                  {%- if video_url contains 'youtube' or video_url contains 'youtu.be' -%}
                    {%- assign yt_id = video_url | split: 'v=' | last | split: '&' | first -%}
                    {%- if video_url contains 'youtu.be/' -%}
                      {%- assign yt_id = video_url | split: 'youtu.be/' | last | split: '?' | first -%}
                    {%- endif -%}
                    <div class="pt-video-thumb" data-yt-id="{{ yt_id }}">
                      <img src="https://img.youtube.com/vi/{{ yt_id }}/maxresdefault.jpg" alt="How to use video" class="pt-video-poster" loading="lazy">
                      <button class="pt-play-btn" aria-label="Play video">
                        <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <circle cx="32" cy="32" r="32" fill="rgba(255,255,255,0.90)"/>
                          <polygon points="26,20 50,32 26,44" fill="#e07b39"/>
                        </svg>
                      </button>
                    </div>
                  {%- else -%}
                    <div class="pt-video-thumb pt-video-native">
                      <video src="{{ video_url }}" class="pt-video-poster" playsinline></video>
                      <button class="pt-play-btn" aria-label="Play video">
                        <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <circle cx="32" cy="32" r="32" fill="rgba(255,255,255,0.90)"/>
                          <polygon points="26,20 50,32 26,44" fill="#e07b39"/>
                        </svg>
                      </button>
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </div>

              <!-- Right: Heading + Steps -->
              <div class="pt-how-content">
                <h2 class="pt-how-heading">How to Use ?</h2>

                {%- assign steps_raw = product.metafields.custom.how_to_use_steps.value -%}

                {%- if steps_raw != blank -%}
                  <ol class="pt-steps-list">
                    {%- assign steps = steps_raw | split: '|' -%}
                    {%- for step in steps -%}
                      {%- if step != blank -%}
                        <li class="pt-step-item">
                          <span class="pt-step-num">{{ forloop.index }}.</span>
                          <span class="pt-step-text">{{ step | strip }}</span>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ol>
                {%- endif -%}
              </div>

            </div>

        {%- endcase -%}
      </div>

      {%- assign _panel_i = _panel_i | plus: 1 -%}
    {%- endfor -%}
  </div>

</div>

<script>
(function () {
  var sectionEl = document.getElementById('pt-section-{{ section.id }}');
  if (!sectionEl) return;

  var tabs      = Array.from(sectionEl.querySelectorAll('.pt-tab'));
  var panels    = Array.from(sectionEl.querySelectorAll('.pt-panel'));
  var indicator = sectionEl.querySelector('.pt-tab-indicator');
  var currentIdx = 0;

  function moveIndicator(tab) {
    if (!indicator || !tab) return;
    indicator.style.left   = tab.offsetLeft + 'px';
    indicator.style.width  = tab.offsetWidth + 'px';
    indicator.style.height = tab.offsetHeight + 'px';
    indicator.style.top    = tab.offsetTop + 'px';
  }

  function switchTab(newIdx, direction) {
    if (newIdx === currentIdx || newIdx < 0 || newIdx >= tabs.length) return;

    var oldPanel = panels[currentIdx];
    var newPanel = panels[newIdx];
    var slideOut = direction > 0 ? '-100%' : '100%';
    var slideIn  = direction > 0 ? '100%'  : '-100%';

    tabs.forEach(function(t) { t.classList.remove('active'); });
    tabs[newIdx].classList.add('active');
    moveIndicator(tabs[newIdx]);

    oldPanel.style.transform  = 'translateX(' + slideOut + ')';
    oldPanel.style.opacity    = '0';
    oldPanel.style.transition = 'transform 0.38s cubic-bezier(0.4,0,0.2,1), opacity 0.28s ease';

    newPanel.style.transform  = 'translateX(' + slideIn + ')';
    newPanel.style.opacity    = '0';
    newPanel.style.transition = 'none';
    newPanel.classList.add('active');

    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        newPanel.style.transition = 'transform 0.38s cubic-bezier(0.4,0,0.2,1), opacity 0.32s ease';
        newPanel.style.transform  = 'translateX(0)';
        newPanel.style.opacity    = '1';
      });
    });

    setTimeout(function () {
      oldPanel.classList.remove('active');
      oldPanel.style.cssText = '';
      newPanel.style.cssText = '';
    }, 420);

    currentIdx = newIdx;
  }

  tabs.forEach(function (tab, idx) {
    tab.addEventListener('click', function () {
      switchTab(idx, idx > currentIdx ? 1 : -1);
    });
  });

  moveIndicator(tabs[0]);
  window.addEventListener('resize', function () { moveIndicator(tabs[currentIdx]); });

  // ── VIDEO: click thumbnail to load iframe / play native ──
  sectionEl.querySelectorAll('.pt-video-thumb').forEach(function(thumb) {
    thumb.addEventListener('click', function () {
      var ytId = thumb.dataset.ytId;
      if (ytId) {
        var iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube.com/embed/' + ytId + '?autoplay=1&rel=0&modestbranding=1';
        iframe.setAttribute('frameborder', '0');
        iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
        iframe.setAttribute('allowfullscreen', '');
        iframe.style.cssText = 'width:100%;height:100%;display:block;position:absolute;top:0;left:0;';
        thumb.innerHTML = '';
        thumb.style.paddingBottom = '0';
        thumb.appendChild(iframe);
      } else {
        var vid = thumb.querySelector('video');
        var btn = thumb.querySelector('.pt-play-btn');
        if (vid) { vid.play(); if (btn) btn.style.display = 'none'; }
      }
    });
  });
    // ── MOBILE SCROLL LOCK ──
  {% comment %} var totalTabs = tabs.length;
  var allDone   = false;
  var touchStartY = 0;

  function handleScrollDown() {
    if (currentIdx < totalTabs - 1) {
      if (!locked) {
        locked = true;
        switchTab(currentIdx + 1, 1);
        setTimeout(function () { locked = false; }, 650);
      }
      return true;
    }
    allDone = true;
    return false;
  }

  function handleScrollUp() {
    if (currentIdx > 0) {
      allDone = false;
      if (!locked) {
        locked = true;
        switchTab(currentIdx - 1, -1);
        setTimeout(function () { locked = false; }, 650);
      }
      return true;
    }
    return false;
  }

  sectionEl.addEventListener('wheel', function (e) {
    if (window.innerWidth > 768) return;
    if (allDone && e.deltaY > 0) return;
    var intercepted = e.deltaY > 0 ? handleScrollDown() : handleScrollUp();
    if (intercepted) e.preventDefault();
  }, { passive: false });

  sectionEl.addEventListener('touchstart', function (e) {
    touchStartY = e.touches[0].clientY;
  }, { passive: true });

  sectionEl.addEventListener('touchmove', function (e) {
    if (window.innerWidth > 768) return;
    var deltaY = touchStartY - e.touches[0].clientY;
    if (Math.abs(deltaY) < 40) return;
    if (allDone && deltaY > 0) return;
    var intercepted = deltaY > 0 ? handleScrollDown() : handleScrollUp();
    if (intercepted) {
      e.preventDefault();
      touchStartY = e.touches[0].clientY;
    }
  }, { passive: false }); {% endcomment %}
})();
</script>

{%- endif -%}

{% schema %}
