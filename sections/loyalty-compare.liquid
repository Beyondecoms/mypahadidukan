{%- comment -%}
  Loyalty page "Compare your access": benefits table with three tier columns.
  Tiers are section settings; each benefit row is a block whose tier values
  accept "yes" (tick), "no" (grey tick) or any text (shown in the tier color).

  Layout: one CSS grid. Every cell is placed explicitly (grid-row inline,
  grid-column by class) so each tier's background card can span all rows
  behind its cells and rows stay aligned across columns.
  Styles: section-loyalty-page.css
{%- endcomment -%}
{% render 'loyalty-page-assets' %}

{%- liquid
  assign row_count = section.blocks.size
  assign foot_row = row_count | plus: 2
  assign tier_span = row_count | plus: 2
-%}

<style>
  #shopify-section-{{ section.id }} .lp {
    --lp-heading: {{ section.settings.heading_color }};
    --lp-text: {{ section.settings.text_color }};
    --lp-panel: {{ section.settings.panel_color }};
    --lp-line: {{ section.settings.line_color }};
    --lp-yes: {{ section.settings.yes_color }};
    --lp-no: {{ section.settings.no_color }};
    --lp-tier-1-color: {{ section.settings.tier_1_color }};
    --lp-tier-1-bg: {{ section.settings.tier_1_bg }};
    --lp-tier-1-line: {{ section.settings.tier_1_line }};
    --lp-tier-1-divider: {{ section.settings.tier_1_divider }};
    --lp-tier-2-color: {{ section.settings.tier_2_color }};
    --lp-tier-2-bg: {{ section.settings.tier_2_bg }};
    --lp-tier-2-line: {{ section.settings.tier_2_line }};
    --lp-tier-2-divider: {{ section.settings.tier_2_divider }};
    --lp-tier-3-color: {{ section.settings.tier_3_color }};
    --lp-tier-3-bg: {{ section.settings.tier_3_bg }};
    --lp-tier-3-line: {{ section.settings.tier_3_line }};
    --lp-tier-3-divider: {{ section.settings.tier_3_divider }};
  }
  #shopify-section-{{ section.id }} .lp-table__foot {
    grid-row: {{ foot_row }};
  }
</style>

<div class="lp lp-compare">
  <div class="lp-container lp-compare__panel">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="lp-head">
        {%- if section.settings.heading != blank -%}
          <h2 class="lp-title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="lp-sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="lp-table-scroll">
      <div class="lp-table" role="table" aria-label="{{ section.settings.heading | escape }}">
        {%- for n in (1..3) -%}
          <div
            class="lp-tier-bg lp-tier--{{ n }} lp-col-{{ n | plus: 1 }}"
            style="grid-row: 1 / span {{ tier_span }};"
            aria-hidden="true"
          ></div>
        {%- endfor -%}

        <div class="lp-table__row" role="row">
          <div class="lp-label-head lp-col-1" style="grid-row: 1;" role="columnheader">
            {%- if section.settings.benefits_heading != blank -%}
              <p class="lp-label-head__title lp-label-head__title--desktop">
                {{- section.settings.benefits_heading | escape -}}
              </p>
            {%- endif -%}
            {%- assign mobile_heading = section.settings.benefits_heading_mobile
              | default: section.settings.benefits_heading
            -%}
            {%- if mobile_heading != blank -%}
              <p class="lp-label-head__title lp-label-head__title--mobile" aria-hidden="true">
                {{- mobile_heading | escape -}}
              </p>
            {%- endif -%}
            {%- if section.settings.benefits_text != blank -%}
              <p class="lp-label-head__text">{{ section.settings.benefits_text | escape }}</p>
            {%- endif -%}
          </div>

          {%- for n in (1..3) -%}
            {%- liquid
              assign key_name = 'tier_' | append: n | append: '_name'
              assign key_badge = 'tier_' | append: n | append: '_badge'
              assign key_req = 'tier_' | append: n | append: '_requirement'
              assign badge_asset = 'loyalty-tier-' | append: n | append: '.webp'
            -%}
            <div
              class="lp-tier-head lp-tier--{{ n }} lp-col-{{ n | plus: 1 }}"
              style="grid-row: 1;"
              role="columnheader"
            >
              {% render 'loyalty-image',
                image: section.settings[key_badge],
                fallback: badge_asset,
                fallback_width: 202,
                fallback_height: 202,
                alt: '',
                class: 'lp-tier-head__badge',
                sizes: '67px'
              %}
              <h3 class="lp-tier-head__name">{{ section.settings[key_name] | escape }}</h3>
              <span class="lp-tier-head__divider" aria-hidden="true"></span>
              {%- if section.settings[key_req] != blank -%}
                <div class="lp-tier-head__req">{{ section.settings[key_req] }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- for block in section.blocks -%}
          {%- assign grid_row = forloop.index | plus: 1 -%}
          <div
            class="lp-table__row{% if forloop.last %} lp-table__row--last{% endif %}"
            role="row"
            {{ block.shopify_attributes }}
          >
            <div class="lp-label lp-col-1" style="grid-row: {{ grid_row }};" role="rowheader">
              {{- block.settings.label | escape -}}
            </div>

            {%- for n in (1..3) -%}
              {%- liquid
                assign key = 'tier_' | append: n
                assign value = block.settings[key] | strip
                assign value_key = value | downcase
              -%}
              <div
                class="lp-cell lp-tier--{{ n }} lp-col-{{ n | plus: 1 }}"
                style="grid-row: {{ grid_row }};"
                role="cell"
              >
                <div class="lp-cell__in">
                  {%- if value_key == 'yes' -%}
                    <svg class="lp-check" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
                      <circle cx="14" cy="14" r="14"/>
                      <path d="M7.41 14.29c1.65 1.5 4.21 3.83 4.21 3.83l8.15-7.41" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round"/>
                    </svg>
                    <span class="visually-hidden">Included</span>
                  {%- elsif value_key == 'no' -%}
                    <svg class="lp-check lp-check--no" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
                      <circle cx="14" cy="14" r="14"/>
                      <path d="M7.41 14.29c1.65 1.5 4.21 3.83 4.21 3.83l8.15-7.41" fill="none" stroke="#fff" stroke-width="3.5" stroke-linecap="round"/>
                    </svg>
                    <span class="visually-hidden">Not included</span>
                  {%- elsif value != blank -%}
                    <span class="lp-cell__val">{{ value | escape }}</span>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endfor -%}

        <div class="lp-table__foot lp-col-1" aria-hidden="true"></div>
      </div>
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="lp-compare__note">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
