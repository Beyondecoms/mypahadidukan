          "settings": {
            "title": "Lorem"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Lorem"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Lorem"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Lorem"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Lorem"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Lorem"
          }
        }
      ]
    }
  ]
}
{% endschema %}
