{%- liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign heading_color = section.settings.heading_color | default: '#1F2937'
  assign label_color = section.settings.label_color | default: '#111827'
  assign card_bg_color = section.settings.card_bg_color | default: '#F0F2F5'
  assign card_radius = section.settings.card_radius | default: 18
  assign card_gap = section.settings.card_gap | default: 16
  assign desktop_items = section.settings.desktop_items | default: 8
  assign mobile_card_width = section.settings.mobile_card_width | default: 110
  assign padding_top = section.settings.padding_top | default: 48
  assign padding_bottom = section.settings.padding_bottom | default: 48
-%}

<div
  id="custom-section-4-{{ section.id }}"
  class="custom-section-4"
  style="
    --cs4-bg: {{ bg_color }};
    --cs4-heading-color: {{ heading_color }};
    --cs4-label-color: {{ label_color }};
    --cs4-card-bg: {{ card_bg_color }};
    --cs4-card-radius: {{ card_radius }}px;
    --cs4-gap: {{ card_gap }}px;
    --cs4-desktop-items: {{ desktop_items }};
    --cs4-mobile-card-width: {{ mobile_card_width }}px;
    --cs4-pt: {{ padding_top }}px;
    --cs4-pb: {{ padding_bottom }}px;
  "
>
  <div class="custom-section-4__container">
    {%- if heading != blank -%}
      <div class="custom-section-4__header">
        <h2 class="custom-section-4__heading">{{ heading }}</h2>
      </div>
    {%- endif -%}

    {%- if subheading != blank -%}
      <div class="custom-section-4__subheading-wrap">
        <span class="custom-section-4__subheading">{{ subheading }}</span>
      </div>
    {%- endif -%}

    <div class="custom-section-4__track-wrapper">
      <div class="custom-section-4__track">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_image = block.settings.image
            assign block_title = block.settings.title
            assign block_link = block.settings.link
          -%}
          <div class="custom-section-4__item" {{ block.shopify_attributes }}>
            {%- if block_link != blank -%}
              <a href="{{ block_link }}" class="custom-section-4__link" aria-label="{{ block_title | escape }}">
            {%- else -%}
              <div class="custom-section-4__link">
            {%- endif -%}

              <div class="custom-section-4__image-box">
                {%- if block_image != blank -%}
                  {{
                    block_image
                    | image_url: width: 360
                    | image_tag:
                      loading: 'lazy',
                      class: 'custom-section-4__image',
                      widths: '120, 180, 240, 360',
                      alt: block_title | default: block_image.alt | default: 'Product'
                  }}
                {%- else -%}
                  <div class="custom-section-4__placeholder">
                    {{ 'product-1' | placeholder_svg_tag: 'custom-section-4__placeholder-svg' }}
                  </div>
                {%- endif -%}
              </div>

              {%- if block_title != blank -%}
                <span class="custom-section-4__label">{{ block_title }}</span>
              {%- endif -%}

            {%- if block_link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          {%- for i in (1..8) -%}
            <div class="custom-section-4__item">
              <div class="custom-section-4__link">
                <div class="custom-section-4__image-box">
                  <div class="custom-section-4__placeholder">
                    {{ 'product-1' | placeholder_svg_tag: 'custom-section-4__placeholder-svg' }}
                  </div>
                </div>
                <span class="custom-section-4__label">Lorem</span>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<style>
  #custom-section-4-{{ section.id }} {
    background-color: var(--cs4-bg);
    padding-top: var(--cs4-pt);
    padding-bottom: var(--cs4-pb);
    width: 100%;
    position: relative;
    box-sizing: border-box;
    font-family: inherit;
  }

  #custom-section-4-{{ section.id }} * {
    box-sizing: border-box;
  }

  #custom-section-4-{{ section.id }} .custom-section-4__container {
    width: 100%;
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 24px;
  }

  #custom-section-4-{{ section.id }} .custom-section-4__header {
    text-align: center;
    margin-bottom: 28px;
  }

  #custom-section-4-{{ section.id }} .custom-section-4__heading {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--cs4-heading-color);
    letter-spacing: -0.01em;
  }

  #custom-section-4-{{ section.id }} .custom-section-4__subheading-wrap {
    margin-bottom: 16px;
    text-align: left;
  }

  #custom-section-4-{{ section.id }} .custom-section-4__subheading {
    font-size: 18px;
    font-weight: 700;
    color: var(--cs4-heading-color);
    line-height: 1.3;
    display: inline-block;
  }

  #custom-section-4-{{ section.id }} .custom-section-4__track-wrapper {
    width: 100%;
    overflow: hidden;
  }

  #custom-section-4-{{ section.id }} .custom-section-4__track {
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: var(--cs4-gap);
    width: 100%;
  }

  #custom-section-4-{{ section.id }} .custom-section-4__item {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #custom-section-4-{{ section.id }} .custom-section-4__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  #custom-section-4-{{ section.id }} .custom-section-4__image-box {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: var(--cs4-card-bg);
    border-radius: var(--cs4-card-radius);
    padding: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  #custom-section-4-{{ section.id }} .custom-section-4__link:hover .custom-section-4__image-box {
    transform: translateY(-3px);
  }

  #custom-section-4-{{ section.id }} .custom-section-4__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
    transition: transform 0.28s ease;
  }

  #custom-section-4-{{ section.id }} .custom-section-4__link:hover .custom-section-4__image {
    transform: scale(1.04);
  }

  #custom-section-4-{{ section.id }} .custom-section-4__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.35;
  }

  #custom-section-4-{{ section.id }} .custom-section-4__placeholder-svg {
    width: 60%;
    height: 60%;
    max-width: 64px;
    max-height: 64px;
  }

  #custom-section-4-{{ section.id }} .custom-section-4__label {
    margin-top: 12px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--cs4-label-color);
    text-align: center;
    display: block;
    width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 991px) {
    #custom-section-4-{{ section.id }} .custom-section-4__container {
      padding: 0 16px;
    }

    #custom-section-4-{{ section.id }} .custom-section-4__track {
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      padding-bottom: 6px;
    }

    #custom-section-4-{{ section.id }} .custom-section-4__track::-webkit-scrollbar {
      display: none;
    }

    #custom-section-4-{{ section.id }} .custom-section-4__item {
      flex: 0 0 var(--cs4-mobile-card-width);
      scroll-snap-align: start;
    }

    #custom-section-4-{{ section.id }} .custom-section-4__image-box {
      padding: 10px;
    }

    #custom-section-4-{{ section.id }} .custom-section-4__heading {
      font-size: 20px;
    }

    #custom-section-4-{{ section.id }} .custom-section-4__subheading {
      font-size: 16px;
    }

    #custom-section-4-{{ section.id }} .custom-section-4__label {
      font-size: 13px;
      margin-top: 8px;
    }
  }

  @media (max-width: 767px) {
    #custom-section-4-{{ section.id }} .custom-section-4__container {
      padding: 0 12px;
    }

    #custom-section-4-{{ section.id }} .custom-section-4__header {
      margin-bottom: 20px;
    }

    #custom-section-4-{{ section.id }} .custom-section-4__heading {
      font-size: 18px;
    }

    #custom-section-4-{{ section.id }} .custom-section-4__subheading {
      font-size: 15px;
    }
  }
</style>

{% schema %}
{
  "name": "Start Here (Section 4)",
  "tag": "section",
  "class": "custom-section-4-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New to My Pahadi Dukan? Start Here"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading / Group title",
      "default": "Vitamin Rich"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading text color",
      "default": "#1F2937"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Block label text color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Image box background color",
      "default": "#F0F2F5"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Image box border radius",
      "default": 18
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Space between blocks",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_items",
      "min": 4,
      "max": 10,
      "step": 1,
      "label": "Blocks per row on desktop",
      "default": 8
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "min": 80,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Block width on mobile",
      "default": 110
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Label text",
          "default": "Lorem"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New to My Pahadi Dukan? Start Here",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Lorem"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Lorem"
          }
        },
        {
