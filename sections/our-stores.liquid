        },
        {
          "type": "text",
          "id": "store_type",
          "label": "Store type tags",
          "default": "Grocery · Tasting Counter"
        },
        {
          "type": "text",
          "id": "store_name",
          "label": "Store name",
          "default": "New Lucknow Store"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "Picnic Spot Road, Khurram Nagar Rd, opp. Fatimi Masjid, Sector 8, Vikas Nagar, Lucknow, UP 226022"
        },
        {
          "type": "text",
          "id": "hours",
