          "default": "Mon – Sun · 10:00 – 21:00"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone number",
          "default": "08881999204"
        },
        {
          "type": "url",
          "id": "map_url",
          "label": "Google Maps URL"
        },
        {
          "type": "url",
          "id": "calendar_url",
          "label": "Book visit URL (optional)"
        }
      ]
    },
    {
      "type": "coming_soon",
      "name": "Coming Soon Banner",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "OPENING SOON"
        },
        {
          "type": "text",
          "id": "cities",
