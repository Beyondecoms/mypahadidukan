{{ 'section-seabuckthorn-m9.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign m9_image_1 = product.metafields.custom.m9_image_1.value | default: product.metafields.custom.m9_image_1 | default: product.metafields.custom['m9_image-1'].value | default: product.metafields.custom['m9_image-1'] | default: product.metafields.custom.m9_image__1.value | default: product.metafields.custom.m9_image__1
  assign m9_images_2 = product.metafields.custom.m9_image_2.value | default: product.metafields.custom.m9_image_2 | default: product.metafields.custom['m9_image-2'].value | default: product.metafields.custom['m9_image-2'] | default: product.metafields.custom.m9_images_2.value | default: product.metafields.custom.m9_images_2
  assign m9_image_3 = product.metafields.custom.m9_image_3.value | default: product.metafields.custom.m9_image_3 | default: product.metafields.custom['m9_image-3'].value | default: product.metafields.custom['m9_image-3'] | default: product.metafields.custom.m9_image__3.value | default: product.metafields.custom.m9_image__3

  assign m9_first_1 = m9_image_1 | first
  if m9_first_1 != blank
    assign m9_img_1_obj = m9_first_1
  else
    assign m9_img_1_obj = m9_image_1
  endif

  assign m9_recipe_first = m9_images_2 | first

  assign m9_first_3 = m9_image_3 | first
  if m9_first_3 != blank
    assign m9_img_3_obj = m9_first_3
  else
    assign m9_img_3_obj = m9_image_3
  endif
-%}

<div class="sb-m9-section" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="sb-m9-container">
    
    <!-- Top Meta Row -->
    <div class="sb-m9-top-bar">
      <span class="sb-m9-module-badge">{{ section.settings.module_tag }}</span>
    </div>
               
    <!-- Main Card Box -->
    <div class="sb-m9-card-wrapper">
      <div class="sb-m9-header">
        <h2 class="sb-m9-title">{{ section.settings.heading }}</h2>
        {% comment %} <h3 class="sb-m9-subtitle">{{ section.settings.subtitle }}</h3> {% endcomment %}
      </div>

      <!-- Hero Graphic + 30-Glass Stamp Sheet Grid -->
      <div class="sb-m9-hero-grid{% if m9_img_1_obj == blank %} sb-m9-hero-grid--single{% endif %}">
        <!-- Hero Graphic (1st block) -->
        <div class="sb-m9-graphic-box">
          <svg class="sb-m9-graphic-svg" viewBox="0 0 200 120" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Glass -->
            <rect x="110" y="35" width="45" height="70" rx="4" stroke="#008B75" stroke-width="2.5" fill="rgba(0, 139, 117, 0.05)"/>
            <path d="M112 70 Q132 68 153 70 L153 102 C153 103 151 104 150 104 L115 104 C113 104 112 103 112 102 Z" fill="#EE5922"/>
            <!-- Spoon -->
            <path d="M30 40 Q70 30 115 50" stroke="#1C1918" stroke-width="2.5" stroke-linecap="round"/>
            <ellipse cx="118" cy="52" rx="14" ry="8" fill="#EE5922" stroke="#1C1918" stroke-width="2"/>
            <!-- Arrow -->
            <path d="M105 45 Q120 40 125 58" stroke="#EE5922" stroke-width="2" stroke-dasharray="3 3" marker-end="url(#arrow)"/>
          </svg>
          <div class="sb-m9-instruction-step">{{ section.settings.step_text }}</div>
          <div class="sb-m9-instruction-timing">{{ section.settings.timing_text }}</div>
        </div>

        <!-- 30-Glass Stamp Sheet Grid (2nd block: only if m9_image_1 exists) -->
        {%- if m9_img_1_obj != blank -%}
          <div class="sb-m9-stamp-sheet sb-m9-stamp-sheet--image">
            {%- assign img_alt_1 = m9_img_1_obj.alt | default: "30 glasses in a bottle" | escape -%}
            {{ m9_img_1_obj | image_url: width: 1000 | image_tag:
              class: 'sb-m9-stamp-image',
              loading: 'lazy',
              alt: img_alt_1
            }}
          </div>
        {%- endif -%}
      </div>

      <!-- Recipe Cards (Only if m9_images_2 exists) -->
      {%- if m9_recipe_first != blank -%}
        {%- assign m9_cols = m9_images_2.size | at_most: 4 -%}
        <div class="sb-m9-cards-row" style="--m9-cols: {{ m9_cols }};">
          {%- for image in m9_images_2 -%}
            {%- if image != blank -%}
              {%- assign img_alt = image.alt | default: 'Recipe ' | append: forloop.index | escape -%}
              <div class="sb-m9-recipe-card sb-m9-recipe-card--image">
                {{ image | image_url: width: 800 | image_tag:
                  class: 'sb-m9-recipe-card-img',
                  loading: 'lazy',
                  alt: img_alt
                }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- elsif m9_images_2 != blank and m9_images_2.src != blank or m9_images_2.width != blank -%}
        <div class="sb-m9-cards-row" style="--m9-cols: 1;">
          {%- assign img_alt = m9_images_2.alt | default: 'Recipe 1' | escape -%}
          <div class="sb-m9-recipe-card sb-m9-recipe-card--image">
            {{ m9_images_2 | image_url: width: 800 | image_tag:
              class: 'sb-m9-recipe-card-img',
              loading: 'lazy',
              alt: img_alt
            }}
          </div>
        </div>
      {%- endif -%}

      <!-- Storage Card (Only if m9_image_3 exists) -->
      {%- if m9_img_3_obj != blank -%}
        <div class="sb-m9-storage-card sb-m9-storage-card--image">
          {%- assign storage_alt = m9_img_3_obj.alt | default: 'Storage instructions' | escape -%}
          {{ m9_img_3_obj | image_url: width: 1400 | image_tag:
            class: 'sb-m9-storage-img',
            loading: 'lazy',
            alt: storage_alt
          }}
        </div>
      {%- endif -%}

    </div>

  </div>
</div>

{% schema %}
{
  "name": "M9 - How to drink it",
  "tag": "section",
  "class": "section-sb-m9",
  "settings": [
    {
      "type": "text",
      "id": "module_tag",
      "label": "Module Tag",
      "default": "M9 · How to Take It"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to Take It"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "ONE SPOON. THAT'S THE WHOLE INSTRUCTION."
    },
    {
      "type": "text",
      "id": "step_text",
      "label": "Instruction Step",
      "default": "10 ml into a glass of warm water. Stir."
    },
    {
      "type": "text",
      "id": "timing_text",
      "label": "Timing Text",
      "default": "Best to have it in the morning. But nothing bad happens at 4pm either."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fffbef"
    }
  ],
  "presets": [
    {
      "name": "M9 - How to drink it"
    }
  ]
}
{% endschema %}

