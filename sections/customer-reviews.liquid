        },
        {
          "type": "color",
          "id": "avatar_color",
          "label": "Avatar background color",
          "default": "#1a6b4a"
        },
        {
          "type": "image_picker",
          "id": "profile_image",
          "label": "Profile picture"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified buyer",
          "default": true
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
