<!-- More Popup Menu -->
<div class="mbn-more-overlay" id="mbnMoreOverlay"></div>
<div class="mbn-more-popup" id="mbnMorePopup">
  <div class="mbn-more-handle"></div>
  <ul class="mbn-more-list">
    {%- if section.settings.menu != blank -%}
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}" class="mbn-more-link">
          {{ link.title }}
        </a>
      {%- endfor -%}
    {%- else -%}
      <a href="/pages/wishlist" class="mbn-more-link">Wishlist</a>
      <a href="{{ routes.account_url }}" class="mbn-more-link">Account</a>
      <a href="/pages/about" class="mbn-more-link">About Us</a>
      <a href="/blogs/news" class="mbn-more-link">Blog</a>
    {%- endif -%}
  </ul>
</div>

<script>
(function () {
  var moreBtn = document.getElementById('mbnMoreBtn');
  var overlay = document.getElementById('mbnMoreOverlay');
  var popup = document.getElementById('mbnMorePopup');

  function openMore() {
    popup.classList.add('open');
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeMore() {
    popup.classList.remove('open');
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  if (moreBtn) moreBtn.addEventListener('click', openMore);
  if (overlay) overlay.addEventListener('click', closeMore);

  // Active state
  var items = document.querySelectorAll('.mbn-item');
  var currentPath = window.location.pathname;
  items.forEach(function(item) {
    var href = item.getAttribute('href');
    if (href && currentPath === href) {
      item.classList.add('active');
    }
  });
})();
</script>

{% schema %}
{
  "name": "Mobile Bottom Nav",
  "tag": "div",
  "class": "mbn-outer",
  "settings": [
    {
      "type": "url",
      "id": "shop_url",
      "label": "Shop link",
      "info": "Default: /collections/all"
    },
    {
      "type": "text",
      "id": "whatsapp_url",
      "label": "WhatsApp URL",
      "default": "https://wa.me/919999999999"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "More menu",
      "info": "Links shown in the More popup"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Bar background",
      "default": "#fdf6e3"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Active icon color",
      "default": "#1a6b4a"
    }
  ],
  "presets": [
    {
      "name": "Mobile Bottom Nav"
    }
  ]
}
{% endschema %}