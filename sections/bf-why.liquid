{{ 'section-black-friday.css' | asset_url | stylesheet_tag }}
{%- render 'bf-fonts' -%}

<div class="bf-section">
  <section class="bf-why" style="background: {{ section.settings.bg }};">
    <div class="bf-why__grid">
      <div class="bf-why__copy">
        <h2 class="bf-why__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="bf-why__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
        {%- if stat_blocks.size > 0 -%}
          <div class="bf-stats">
            {%- for block in stat_blocks -%}
              <div class="bf-stat" {{ block.shopify_attributes }}>
                <div class="bf-stat__top">
                  <span class="bf-stat__num">{{ block.settings.number }}</span>
                  <span class="bf-stat__unit">{{ block.settings.unit }}</span>
                </div>
                <div class="bf-stat__sub">{{ block.settings.caption }}</div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="bf-days" style="background: {{ section.settings.card_bg }};">
        <div>
          <h3 class="bf-days__title bf-sc">{{ section.settings.card_title }}</h3>
          {%- if section.settings.card_subtitle != blank -%}
            <span class="bf-days__sub">{{ section.settings.card_subtitle }}</span>
          {%- endif -%}
        </div>
        <div class="bf-days__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'day' -%}
              <div {{ block.shopify_attributes }}>
                <b>{{ block.settings.title }}</b><br>
                {{- block.settings.text -}}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.card_footer != blank -%}
          <div class="bf-days__foot">{{ section.settings.card_footer }}</div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- if section.settings.show_bottom_scallop -%}
    <div class="bf-scallop" style="--bf-scallop-bg: {{ section.settings.bg }}; --bf-scallop-fg: {{ section.settings.next_bg }};" aria-hidden="true"></div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Black Friday story",
  "tag": "div",
  "class": "bf-why-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why we only do this once a year"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We price fairly all year, so the families who grow and make our products get paid properly every day, not just on sale days. That's why we don't run regular discounts. Black Friday is the one time we pass the savings on to you.</p>"
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Card title",
      "default": "The Four Days"
    },
    {
      "type": "text",
      "id": "card_subtitle",
      "label": "Card subtitle",
      "default": "(27 to 30 Nov)"
    },
    {
      "type": "text",
      "id": "card_footer",
      "label": "Card footer",
      "default": "Once a year • Lab-tested • Farmer-direct"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#FFFBEF"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#8B4512"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_scallop",
      "label": "Scalloped bottom edge",
      "default": true
    },
    {
      "type": "color",
      "id": "next_bg",
      "label": "Next section background",
      "default": "#FFEEB8"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "11" },
        { "type": "text", "id": "unit", "label": "Unit", "default": "STATES" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "All in one place" }
      ]
    },
    {
      "type": "day",
      "name": "Timeline step",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Fri 27 Nov, 12:00 AM IST · Sale goes live" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Sale prices are live and the timer counts down the time left." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Black Friday story"
    }
  ]
}
{% endschema %}
