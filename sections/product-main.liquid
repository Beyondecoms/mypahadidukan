            <path d="M15.4265 0C15.2545 0 15.0824 0.0573478 14.9677 0.172043L8.02867 7.11111L1.03226 0.172043C0.802867 -0.0573476 0.401434 -0.0573476 0.172043 0.172043C-0.0573477 0.401434 -0.0573477 0.802867 0.172043 1.03226L7.56989 8.43011C7.79928 8.6595 8.20072 8.6595 8.43011 8.43011L15.828 1.03226C16.0573 0.802867 16.0573 0.401434 15.828 0.172043C15.7706 0.0573478 15.5986 0 15.4265 0Z" fill="black"/>
            </svg>
          </button>
          <div class="pm-accordion-body" id="pm-acc-ingredients">
            <div class="pm-accordion-content">
              {{ product.metafields.custom.ingredientsdd.value | default: section.settings.ingredients_text }}
            </div>
          </div>
        </div>

        <div class="pm-accordion">
          <button class="pm-accordion-btn" data-accordion="additional">
            <span>Additional Information</span>
            <svg width="16" height="9" viewBox="0 0 16 9" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15.4265 0C15.2545 0 15.0824 0.0573478 14.9677 0.172043L8.02867 7.11111L1.03226 0.172043C0.802867 -0.0573476 0.401434 -0.0573476 0.172043 0.172043C-0.0573477 0.401434 -0.0573477 0.802867 0.172043 1.03226L7.56989 8.43011C7.79928 8.6595 8.20072 8.6595 8.43011 8.43011L15.828 1.03226C16.0573 0.802867 16.0573 0.401434 15.828 0.172043C15.7706 0.0573478 15.5986 0 15.4265 0Z" fill="black"/>
            </svg>
          </button>
          <div class="pm-accordion-body" id="pm-acc-additional">
            <div class="pm-accordion-content">
              {{ product.metafields.custom.additional_info.value | default: section.settings.additional_info_text }}
            </div>
          </div>
        </div>

      </div>

      <!-- ══════════════════════════════
          RIGHT COLUMN
      ══════════════════════════════ -->
      <div class="pm-right">

        <!-- Main Image -->
        <div class="pm-main-image-wrap">
          <button class="pm-wishlist-btn my-custom-wishlist-button swym-button swym-add-to-wishlist" data-with-epi="true"
    data-swaction="addToWishlist"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ product.variants[0].id }}"
    data-product-url="{{ shop.url }}{{ product.url }}" aria-label="Wishlist">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="1.8">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </button>
          <div class="pm-main-image-slider" id="pm-main-slider-{{ section.id }}">
            {%- for image in product.images -%}
              <div class="pm-main-slide {% if forloop.first %}active{% endif %}">
                <img
                  src="{{ image | image_url: width: 900 }}"
                  alt="{{ product.title }}"
                  class="pm-main-img"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                >
              </div>
            {%- endfor -%}
          </div>
          {% comment %} circular button {% endcomment %}
           {%- if product.images.size > 1 -%}
              <button class="pm-main-arrow pm-main-arrow-prev" id="pm-main-prev-{{ section.id }}" aria-label="Previous image">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>
              <button class="pm-main-arrow pm-main-arrow-next" id="pm-main-next-{{ section.id }}" aria-label="Next image">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            {%- endif -%}
          <!-- Dot indicators -->
          <div class="pm-main-dots" id="pm-main-dots-{{ section.id }}">
            {%- for image in product.images -%}
              <button class="pm-main-dot {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}"></button>
            {%- endfor -%}
          </div>
        </div>

        <!-- Thumbnails -->
        <div class="pm-thumbnails" id="pm-thumbs-{{ section.id }}">
          {%- for image in product.images -%}
            <div class="pm-thumb {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}">
              <img
                src="{{ image | image_url: width: 160 }}"
                alt="{{ product.title }}"
                loading="lazy"
              >
            </div>
          {%- endfor -%}
        </div>

        <!-- Check Delivery -->
        {% comment %} <div class="pm-delivery-section">
          <p class="pm-delivery-title">Check Delivery</p>
          <div class="pm-delivery-row">
            <input type="text" class="pm-pincode-input" placeholder="Enter Pincode" maxlength="6" id="pm-pincode">
            <button class="pm-pincode-check" id="pm-pincode-btn">Check</button>
          </div>
          <p class="pm-delivery-estimate" id="pm-delivery-result"></p>
        </div> {% endcomment %}
        <!-- Check Delivery -->
        <div class="pm-delivery-section">
          <p class="pm-delivery-title">Check Delivery</p>
          <div class="promise-product-page">
            <div class="sr-promise-pdp-page" id="PromiseEddSection"></div>
          </div>
        </div>
        <!-- Fresh Batch Banner -->
        {%- if fresh_batch_text != blank -%}
          <div class="pm-fresh-batch">
            <div class="pm-fresh-left"></div>
            <div class="pm-fresh-content">
              <p class="pm-fresh-title">{{ fresh_batch_text }}</p>
              {%- if fresh_batch_dates != blank -%}
                <p class="pm-fresh-dates">{{ fresh_batch_dates }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <!-- Available Offers -->
        {%- assign offer_blocks = section.blocks | where: 'type', 'offer' -%}
        {%- if offer_blocks.size > 0 -%}
          <div class="pm-offers-section">
            <p class="pm-offers-title">Available Offers</p>
            <div class="pm-offers-grid">
              {%- for block in offer_blocks -%}
                <div class="pm-offer-card" {{ block.shopify_attributes }}>
                  <p class="pm-offer-text">{{ block.settings.offer_text }}</p>
                  {%- if block.settings.coupon_code != blank -%}
                    <div class="pm-coupon-row">
                      <span class="pm-coupon-label">Code: {{ block.settings.coupon_code }}</span>
                      <button class="pm-coupon-copy" data-code="{{ block.settings.coupon_code }}">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                      </button>
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</div>
<div class="pm-mobile-only">
  {% render 'product-main-mobile' %}
</div>
  {%- render 'product-sticky-bar' -%}

<script>
(function () {
  var sectionEl = document.getElementById('pm-section-{{ section.id }}');
  if (!sectionEl) return;

  // ── IMAGE SLIDER ──
  var mainSlides = Array.from(sectionEl.querySelectorAll('#pm-main-slider-{{ section.id }} .pm-main-slide'));
  var mainDots   = Array.from(sectionEl.querySelectorAll('#pm-main-dots-{{ section.id }} .pm-main-dot'));
  var thumbs     = Array.from(sectionEl.querySelectorAll('#pm-thumbs-{{ section.id }} .pm-thumb'));
  var currentImg = 0;

  function goToImage(idx) {
    mainSlides[currentImg].classList.remove('active');
    mainDots[currentImg] && mainDots[currentImg].classList.remove('active');
    thumbs[currentImg] && thumbs[currentImg].classList.remove('active');
    currentImg = idx;
    mainSlides[currentImg].classList.add('active');
    mainDots[currentImg] && mainDots[currentImg].classList.add('active');
    thumbs[currentImg] && thumbs[currentImg].classList.add('active');
  }

  mainDots.forEach(function(dot, i) {
    dot.addEventListener('click', function() { goToImage(i); });
  });

  thumbs.forEach(function(thumb, i) {
    thumb.addEventListener('click', function() { goToImage(i); });
  });

  // ── VARIANT SELECTOR ──
  var variantCards = Array.from(sectionEl.querySelectorAll('.pm-variant-card'));
  var selectedVariantId = {{ current_variant.id }};

  variantCards.forEach(function(card) {
    card.addEventListener('click', function() {
      variantCards.forEach(function(c) { c.classList.remove('active'); });
      card.classList.add('active');
      selectedVariantId = parseInt(card.dataset.variantId);

      // Update price display
      var price    = parseInt(card.dataset.price);
      var compare  = parseInt(card.dataset.compare);
      var priceEl  = sectionEl.querySelector('.pm-price');
      var compareEl = sectionEl.querySelector('.pm-compare');
      var discEl   = sectionEl.querySelector('.pm-discount-badge');

      if (priceEl) priceEl.textContent = '₹' + (price / 100).toFixed(0);
      if (compareEl && compare > price) {
        compareEl.textContent = '₹' + (compare / 100).toFixed(0);
        if (discEl) {
          var disc = Math.round((compare - price) * 100 / compare);
          discEl.textContent = disc + '% off';
        }
      }
    });
  });
    // ── ACCORDIONS ──
  var accBtns = sectionEl.querySelectorAll('.pm-accordion-btn');
  accBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var key = btn.dataset.accordion;
      var body = document.getElementById('pm-acc-' + key);
      var isOpen = btn.classList.contains('open');
      // Close all
      accBtns.forEach(function(b) {
        b.classList.remove('open');
        var k = b.dataset.accordion;
        var bd = document.getElementById('pm-acc-' + k);
        if (bd) bd.style.maxHeight = null;
      });
      if (!isOpen && body) {
        btn.classList.add('open');
        body.style.maxHeight = body.scrollHeight + 'px';
      }
    });
  });

  // ── COUPON COPY ──
  sectionEl.querySelectorAll('.pm-coupon-copy').forEach(function(btn) {
    btn.addEventListener('click', function() {
        var cleanCode = btn.dataset.code.replace(/<[^>]*>/g, '').trim();
        navigator.clipboard.writeText(cleanCode).then(function() {
        btn.innerHTML = '✓';
        setTimeout(function() {
          btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
        }, 1500);
      });
    });
  });

   // ── QUANTITY ──
  var qty = 1;
  var qtyVal = document.getElementById('pm-qty-val');
  var maxQty = 3;

  document.getElementById('pm-qty-minus').addEventListener('click', function() {
    if (qty > 1) { qty--; qtyVal.textContent = qty; }
  });
  document.getElementById('pm-qty-plus').addEventListener('click', function() {
    if (qty < maxQty) { qty++; qtyVal.textContent = qty; }
  });

  // ── ADD TO CART ──
  document.getElementById('pm-atc-btn').addEventListener('click', async function () {
    const btn = this;
    btn.textContent = 'Adding...';
    btn.disabled = true;

    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: selectedVariantId,
          quantity: qty,
          sections: ['cart-drawer'],
          sections_url: window.location.pathname
        })
      });

      const addedItem = await response.json();

      if (addedItem.sections?.['cart-drawer']) {
        const html = new DOMParser().parseFromString(
          addedItem.sections['cart-drawer'], 'text/html'
        );

        // Swap body first — replaces empty state + all items in one shot
        const newBody = html.querySelector('#nc-body');
        const oldBody = document.querySelector('#nc-body');
        if (newBody && oldBody) oldBody.replaceWith(newBody);

        // Insert or swap price breakdown
        const newBreakdown = html.querySelector('.nc-price-breakdown');
        if (newBreakdown) {
          const oldBreakdown = document.querySelector('.nc-price-breakdown');
          if (oldBreakdown) {
            oldBreakdown.replaceWith(newBreakdown);
          } else {
            // Not in DOM on empty cart page load — insert before footer
            const footer = document.querySelector('.cart-drawer__footer');
            if (footer) footer.insertAdjacentElement('beforebegin', newBreakdown);
          }
        }

        // Swap footer (sits outside nc-body)
        const newFooter = html.querySelector('.cart-drawer__footer');
        const oldFooter = document.querySelector('.cart-drawer__footer');
        if (newFooter && oldFooter) oldFooter.replaceWith(newFooter);
      }

      // Open cart drawer
      var drawer = document.getElementById('nc-cart-drawer');
      if (drawer) {
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      // Fetch full cart for pubsub (badge + price breakdown JS update)
      const cartResponse = await fetch('/cart.js', {
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      });
      const cartData = await cartResponse.json();

      if (typeof publish !== 'undefined' && typeof PUB_SUB_EVENTS !== 'undefined') {
        publish(PUB_SUB_EVENTS.cartUpdate, { source: 'product-main', cartData: cartData });
      }

      if (typeof window.ncUpdatePriceBreakdown === 'function') {
        window.ncUpdatePriceBreakdown(cartData);
      }

    } catch (e) {
      console.error(e);
    }

    btn.textContent = 'Add to Cart';
    btn.disabled = false;
  });

  // ── BUY IT NOW ──
// ── SYNC HIDDEN FORM ──
function syncGokwikForm() {
  var gkVariant = document.getElementById('pm-gokwik-variant');
  var gkQty     = document.getElementById('pm-gokwik-qty');
  if (gkVariant) gkVariant.value = selectedVariantId;
  if (gkQty)     gkQty.value     = qty;
}

// Keep form in sync on variant change
variantCards.forEach(function(card) {
  card.addEventListener('click', function() { syncGokwikForm(); });
});

// Keep form in sync on qty change  
document.getElementById('pm-qty-minus').addEventListener('click', function() { syncGokwikForm(); });
document.getElementById('pm-qty-plus').addEventListener('click',  function() { syncGokwikForm(); });

// ── BUY IT NOW — GoKwik with direct checkout fallback ──
document.getElementById('pm-buy-btn').addEventListener('click', function() {
  syncGokwikForm();
  if (typeof onBuyNowClick === 'function') {
    // GoKwik loaded — it handles the click via onclick attribute
    return;
  }
  // GoKwik not loaded — fallback to direct checkout
  window.location.href = '/checkout?variant=' + selectedVariantId + '&quantity=' + qty;
});

  // ── PINCODE CHECK ──
  {% comment %} document.getElementById('pm-pincode-btn').addEventListener('click', function() {
    var pin = document.getElementById('pm-pincode').value;
    var result = document.getElementById('pm-delivery-result');
    if (pin.length === 6) {
      var date = new Date();
      date.setDate(date.getDate() + 5);
      result.textContent = 'Get it by ' + date.toLocaleDateString('en-IN', { weekday:'long', day:'numeric', month:'short', year:'numeric' });
    } else {
      result.textContent = 'Please enter a valid 6-digit pincode';
    }
  }); {% endcomment %}

// ── VARIANTS SLIDER DOTS / BAR ──
  var variantsGrid = document.getElementById('pm-variants-{{ section.id }}');
  var variantsDots = document.getElementById('pm-variants-dots-{{ section.id }}');
  var variantsBar  = document.getElementById('pm-variants-bar-{{ section.id }}');
  var variantsBarFill = document.getElementById('pm-variants-bar-fill-{{ section.id }}');
  var totalCards = variantCards.length;
  var totalPages = 1;
  var cardsPerView = 1;

  function buildVariantsDots() {
    if (!variantsDots || !variantsGrid || totalCards === 0) return;

    variantsDots.innerHTML = '';

    var cardWidth = variantCards[0].offsetWidth;
    var gap = 12;
    cardsPerView = Math.max(1, Math.round(variantsGrid.clientWidth / (cardWidth + gap)));
    totalPages = Math.max(1, Math.ceil(totalCards / cardsPerView));

    if (totalPages <= 1) return;

    for (var di = 0; di < totalPages; di++) {
      var dot = document.createElement('button');
      dot.className = 'pm-variants-dot' + (di === 0 ? ' active' : '');
      dot.setAttribute('aria-label', 'Page ' + (di + 1));
      dot.dataset.variantDot = di;
      variantsDots.appendChild(dot);
    }

    variantsDots.querySelectorAll('.pm-variants-dot').forEach(function(dot) {
      dot.addEventListener('click', function() {
        var pageIdx = parseInt(dot.dataset.variantDot);
        var cardIdx = pageIdx * cardsPerView;
        var card = variantCards[Math.min(cardIdx, totalCards - 1)];
        if (card) {
          variantsGrid.scrollTo({ left: card.offsetLeft - variantsGrid.offsetLeft, behavior: 'smooth' });
        }
      });
    });
  }

  // ── SHOW DOTS/BAR ONLY WHEN OVERFLOWING ──
  function updateVariantsOverflow() {
    if (!variantsGrid) return;
    var isOverflowing = variantsGrid.scrollWidth > variantsGrid.clientWidth + 2;
    if (variantsDots) variantsDots.style.display = isOverflowing ? '' : 'none';
    if (variantsBar) variantsBar.style.display = isOverflowing ? '' : 'none';
  }

  buildVariantsDots();
  updateVariantsOverflow();

  window.addEventListener('resize', function () {
    buildVariantsDots();
    updateVariantsOverflow();
  });

  // ── ARROW FUNCTIONALITY ──
  var prevBtn = document.getElementById('pm-main-prev-{{ section.id }}');
  var nextBtn = document.getElementById('pm-main-next-{{ section.id }}');
  var totalImages = mainSlides.length;

  if (prevBtn) {
    prevBtn.addEventListener('click', function () {
      var idx = (currentImg - 1 + totalImages) % totalImages;
      goToImage(idx);
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', function () {
      var idx = (currentImg + 1) % totalImages;
      goToImage(idx);
    });
  }

  // Update dots/bar on scroll
// Update dots/bar on scroll
  if (variantsGrid) {
    variantsGrid.addEventListener('scroll', function() {
      var scrollLeft = variantsGrid.scrollLeft;
      var maxScroll  = variantsGrid.scrollWidth - variantsGrid.clientWidth;
      var progress   = maxScroll > 0 ? scrollLeft / maxScroll : 0;

      // Update progress bar (mobile)
      if (variantsBarFill) {
        variantsBarFill.style.width = (progress * 100) + '%';
      }

      // Update dots (desktop) — map scroll progress directly to page index
      if (variantsDots && totalPages > 1) {
        var activeIdx = Math.round(progress * (totalPages - 1));
        activeIdx = Math.max(0, Math.min(activeIdx, totalPages - 1));

        variantsDots.querySelectorAll('.pm-variants-dot').forEach(function(d, i) {
          d.classList.toggle('active', i === activeIdx);
        });
      }
    });
  }
  
  document.querySelectorAll('a[href="#judgeme_product_reviews"]').forEach(function(link) {
  link.addEventListener('click', function(e) {
    e.preventDefault();
    var target = document.getElementById('judgeme_product_reviews');
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
})();
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {

  var initInterval = setInterval(function () {
    if (typeof editPromisePincode === 'function') {
      editPromisePincode();
      clearInterval(initInterval);

      var mq = window.matchMedia('(max-width: 768px)');

      // Store the original desktop anchor ONCE before any moves
      var desktopRight    = document.querySelector('.pm-desktop-only .pm-right');
      var freshBatch      = desktopRight && desktopRight.querySelector('.pm-fresh-batch');
      var placeholder     = document.querySelector('.pm-mobile-delivery-placeholder');
      var deliverySection = document.querySelector('.pm-desktop-only .pm-delivery-section');

      function placeDelivery(isMobile) {
        if (!deliverySection) return;

        if (isMobile && placeholder) {
          placeholder.appendChild(deliverySection);
        } else {
          // Move back to exact original position in desktop
          if (freshBatch) {
            desktopRight.insertBefore(deliverySection, freshBatch);
          } else if (desktopRight) {
            desktopRight.appendChild(deliverySection);
          }
        }
      }

      placeDelivery(mq.matches);

      mq.addEventListener('change', function (e) {
        placeDelivery(e.matches);
      });
    }
  }, 500);

});
</script>

