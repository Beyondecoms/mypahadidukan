  // ── PRODUCT IMAGE LIGHTBOX / ZOOM ──
(function () {
  var lightbox      = document.getElementById('pm-lightbox');
  var lbImg         = document.getElementById('pm-lightbox-img');
  var lbLoader      = document.getElementById('pm-lightbox-loader');
  var lbClose       = document.getElementById('pm-lightbox-close');
  var lbBackdrop    = document.getElementById('pm-lightbox-backdrop');
  var lbPrev        = document.getElementById('pm-lightbox-prev');
  var lbNext        = document.getElementById('pm-lightbox-next');
  var lbCounter     = document.getElementById('pm-lightbox-counter');
  if (!lightbox || !lbImg) return;

  // Collect all zoomable images (desktop section only)
  var zoomableImgs = Array.from(
    document.querySelectorAll('#pm-section-{{ section.id }} .pm-zoomable')
  );
  var totalImgs = zoomableImgs.length;
  var lbIndex   = 0;
  var previouslyFocused = null;

  function openLightbox(idx) {
    if (totalImgs === 0) return;
    lbIndex = ((idx % totalImgs) + totalImgs) % totalImgs;
    previouslyFocused = document.activeElement;

    var img = zoomableImgs[lbIndex];
    var hiResSrc = img.dataset.zoomSrc || img.src;
    var altText  = img.alt || '{{ product.title | escape }}';

    // Show loader, hide old image
    lbImg.style.opacity = '0';
    if (lbLoader) lbLoader.style.display = 'flex';

    // Load high-res image
    var tempImg = new Image();
    tempImg.onload = function () {
      lbImg.src = hiResSrc;
      lbImg.alt = altText;
      lbImg.style.opacity = '1';
      if (lbLoader) lbLoader.style.display = 'none';
    };
    tempImg.onerror = function () {
      // Fallback to displayed src
      lbImg.src = img.src;
      lbImg.alt = altText;
      lbImg.style.opacity = '1';
      if (lbLoader) lbLoader.style.display = 'none';
    };
    tempImg.src = hiResSrc;

    // Counter
    if (lbCounter && totalImgs > 1) {
      lbCounter.textContent = (lbIndex + 1) + ' / ' + totalImgs;
    }

    // Show lightbox
    lightbox.setAttribute('aria-hidden', 'false');
    lightbox.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    lbClose && lbClose.focus();
  }

  function closeLightbox() {
    lightbox.setAttribute('aria-hidden', 'true');
    lightbox.classList.remove('is-open');
    document.body.style.overflow = '';
    lbImg.src = '';
    if (previouslyFocused) previouslyFocused.focus();
  }

  function goLightbox(dir) {
    openLightbox(lbIndex + dir);
  }

  // Click on any main image
  var sliderEl = document.getElementById('pm-main-slider-{{ section.id }}');
  zoomableImgs.forEach(function (img, i) {
    img.addEventListener('click', function () {
      // Read the slider's current active index (set by goToImage via dataset)
      var activeIdx = sliderEl ? parseInt(sliderEl.dataset.activeIdx || '0', 10) : i;
      openLightbox(isNaN(activeIdx) ? i : activeIdx);
    });
    img.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        var activeIdx = sliderEl ? parseInt(sliderEl.dataset.activeIdx || '0', 10) : i;
        openLightbox(isNaN(activeIdx) ? i : activeIdx);
      }
    });
  });

  // Close button
  if (lbClose) lbClose.addEventListener('click', closeLightbox);
  // Backdrop click
  if (lbBackdrop) lbBackdrop.addEventListener('click', closeLightbox);
  // Arrow buttons
  if (lbPrev) lbPrev.addEventListener('click', function () { goLightbox(-1); });
  if (lbNext) lbNext.addEventListener('click', function () { goLightbox(1); });

  // Keyboard: ESC / arrow keys
  document.addEventListener('keydown', function (e) {
    if (!lightbox.classList.contains('is-open')) return;
    if (e.key === 'Escape')      { closeLightbox(); }
    else if (e.key === 'ArrowLeft')  { goLightbox(-1); }
    else if (e.key === 'ArrowRight') { goLightbox(1); }
  });

  // Touch/swipe support (mobile)
  var touchStartX = null;
  lightbox.addEventListener('touchstart', function (e) {
    touchStartX = e.changedTouches[0].clientX;
  }, { passive: true });
  lightbox.addEventListener('touchend', function (e) {
    if (touchStartX === null) return;
    var diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) { goLightbox(diff > 0 ? 1 : -1); }
    touchStartX = null;
  }, { passive: true });

  // When gallery changes slide (via goToImage), keep lbIndex in sync
  // so nav arrows in lightbox follow the visible slide
  document.addEventListener('pm:slideChange', function (e) {
    lbIndex = e.detail.idx;
    if (lbCounter && totalImgs > 1) {
      lbCounter.textContent = (lbIndex + 1) + ' / ' + totalImgs;
    }
  });
})();
  {% comment %} document.getElementById('pm-pincode-btn').addEventListener('click', function() {
    var pin = document.getElementById('pm-pincode').value;
    var result = document.getElementById('pm-delivery-result');
    if (pin.length === 6) {
      var date = new Date();
      date.setDate(date.getDate() + 5);
      result.textContent = 'Get it by ' + date.toLocaleDateString('en-IN', { weekday:'long', day:'numeric', month:'short', year:'numeric' });
    } else {
      result.textContent = 'Please enter a valid 6-digit pincode';
    }
  }); {% endcomment %}

// ── VARIANTS SLIDER DOTS / BAR ──
  var variantsGrid = document.getElementById('pm-variants-{{ section.id }}');
  var variantsDots = document.getElementById('pm-variants-dots-{{ section.id }}');
  var variantsBar  = document.getElementById('pm-variants-bar-{{ section.id }}');
  var variantsBarFill = document.getElementById('pm-variants-bar-fill-{{ section.id }}');
  var totalCards = variantCards.length;
  var totalPages = 1;
  var cardsPerView = 1;

  function buildVariantsDots() {
    if (!variantsDots || !variantsGrid || totalCards === 0) return;

    variantsDots.innerHTML = '';

    var cardWidth = variantCards[0].offsetWidth;
    var gap = 12;
    cardsPerView = Math.max(1, Math.round(variantsGrid.clientWidth / (cardWidth + gap)));
    totalPages = Math.max(1, Math.ceil(totalCards / cardsPerView));

    if (totalPages <= 1) return;

    for (var di = 0; di < totalPages; di++) {
      var dot = document.createElement('button');
      dot.className = 'pm-variants-dot' + (di === 0 ? ' active' : '');
      dot.setAttribute('aria-label', 'Page ' + (di + 1));
      dot.dataset.variantDot = di;
      variantsDots.appendChild(dot);
    }

    variantsDots.querySelectorAll('.pm-variants-dot').forEach(function(dot) {
      dot.addEventListener('click', function() {
        var pageIdx = parseInt(dot.dataset.variantDot);
        var cardIdx = pageIdx * cardsPerView;
        var card = variantCards[Math.min(cardIdx, totalCards - 1)];
        if (card) {
          variantsGrid.scrollTo({ left: card.offsetLeft - variantsGrid.offsetLeft, behavior: 'smooth' });
        }
      });
    });
  }

  // ── SHOW DOTS/BAR ONLY WHEN OVERFLOWING ──
  function updateVariantsOverflow() {
    if (!variantsGrid) return;
    var isOverflowing = variantsGrid.scrollWidth > variantsGrid.clientWidth + 2;
    if (variantsDots) variantsDots.style.display = isOverflowing ? '' : 'none';
    if (variantsBar) variantsBar.style.display = isOverflowing ? '' : 'none';
  }

  buildVariantsDots();
  updateVariantsOverflow();

  window.addEventListener('resize', function () {
    buildVariantsDots();
    updateVariantsOverflow();
  });

  // ── ARROW FUNCTIONALITY ──
  var prevBtn = document.getElementById('pm-main-prev-{{ section.id }}');
  var nextBtn = document.getElementById('pm-main-next-{{ section.id }}');
  var totalImages = mainSlides.length;

  if (prevBtn) {
    prevBtn.addEventListener('click', function () {
      var idx = (currentImg - 1 + totalImages) % totalImages;
      goToImage(idx);
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', function () {
      var idx = (currentImg + 1) % totalImages;
      goToImage(idx);
    });
  }

  // Update dots/bar on scroll
// Update dots/bar on scroll
  if (variantsGrid) {
    variantsGrid.addEventListener('scroll', function() {
      var scrollLeft = variantsGrid.scrollLeft;
      var maxScroll  = variantsGrid.scrollWidth - variantsGrid.clientWidth;
      var progress   = maxScroll > 0 ? scrollLeft / maxScroll : 0;

      // Update progress bar (mobile)
      if (variantsBarFill) {
        variantsBarFill.style.width = (progress * 100) + '%';
      }

      // Update dots (desktop) — map scroll progress directly to page index
      if (variantsDots && totalPages > 1) {
        var activeIdx = Math.round(progress * (totalPages - 1));
        activeIdx = Math.max(0, Math.min(activeIdx, totalPages - 1));

        variantsDots.querySelectorAll('.pm-variants-dot').forEach(function(d, i) {
          d.classList.toggle('active', i === activeIdx);
        });
      }
    });
  }
  
  document.querySelectorAll('a[href="#judgeme_product_reviews"]').forEach(function(link) {
  link.addEventListener('click', function(e) {
    e.preventDefault();
    var target = document.getElementById('judgeme_product_reviews');
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
})();
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {

  var initInterval = setInterval(function () {
    if (typeof editPromisePincode === 'function') {
      editPromisePincode();
      clearInterval(initInterval);

      var mq = window.matchMedia('(max-width: 768px)');

      // Store the original desktop anchor ONCE before any moves
      var desktopRight    = document.querySelector('.pm-desktop-only .pm-right');
      var freshBatch      = desktopRight && desktopRight.querySelector('.pm-fresh-batch');
      var placeholder     = document.querySelector('.pm-mobile-delivery-placeholder');
      var deliverySection = document.querySelector('.pm-desktop-only .pm-delivery-section');

      function placeDelivery(isMobile) {
        if (!deliverySection) return;

        if (isMobile && placeholder) {
          placeholder.appendChild(deliverySection);
        } else {
          // Move back to exact original position in desktop
          if (freshBatch) {
            desktopRight.insertBefore(deliverySection, freshBatch);
          } else if (desktopRight) {
            desktopRight.appendChild(deliverySection);
          }
        }
      }

      placeDelivery(mq.matches);

      mq.addEventListener('change', function (e) {
        placeDelivery(e.matches);
      });
    }
  }, 500);

});
</script>

