{{ 'section-product-main.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign show_amazon = product.metafields.custom.available_on_amazon.value 
  assign amazon_link = product.metafields.custom.amazon_link.value
  assign trusted_count = product.metafields.custom.trusted_customers.value | default: '1M+'
  assign stock_text = blank 
  assign disclaimer = product.metafields.custom.disclaimer.value | default:'Not recommended for pregnant or breastfeeding women, individuals with low blood pressure, or those with a vitamin C allergy or vitamin K deficiency.'
  assign fresh_batch_text = product.metafields.custom.fresh_batch_text.value | default:'Fresh Batch  Under Process'
  assign fresh_batch_dates = product.metafields.custom.fresh_batch_dates.value | default:'Orders placed between Thursday, 23rd April and Wednesday, 29th April will be shipped 30th April onwards'
-%}
<div class="pm-breadcrumb-wrap">
  {% render 'breadcrumb' %}
</div>
<div class="pm-desktop-only">
  <div class="pm-section" id="pm-section-{{ section.id }}">
    <div class="pm-inner">

      <!-- ══════════════════════════════
          LEFT COLUMN
      ══════════════════════════════ -->
      <div class="pm-left">

        <!-- Badges row -->
        {%- if section.blocks.size > 0 -%}
          <div class="pm-badges-row">
            {%- for block in section.blocks -%}
              {%- if block.type == 'badge' -%}
                <span class="pm-badge" style="background:{{ block.settings.bg_color }}; color:{{ block.settings.text_color }};" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != blank -%}
                    <img src="{{ block.settings.icon | image_url: width: 20 }}" alt="" width="16" height="16">
                  {%- endif -%}
                  {{ block.settings.label }}
                </span>
              {%- endif -%}
            {%- endfor -%}

            <!-- Share / External link icon -->
            <button class="pm-share-btn" onclick="navigator.share ? navigator.share({ title: '{{ product.title | escape }}', url: window.location.href }) : navigator.clipboard.writeText(window.location.href)" aria-label="Share">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <g opacity="0.8">
                <path d="M22.909 12.0014C22.6197 12.0014 22.3422 12.1164 22.1376 12.3209C21.9331 12.5255 21.8181 12.803 21.8181 13.0923V19.6378C21.8181 20.2164 21.5882 20.7714 21.1791 21.1805C20.7699 21.5897 20.215 21.8196 19.6363 21.8196H4.36362C3.78497 21.8196 3.23002 21.5897 2.82085 21.1805C2.41168 20.7714 2.18181 20.2164 2.18181 19.6378V4.36509C2.18181 3.78644 2.41168 3.23148 2.82085 2.82231C3.23002 2.41315 3.78497 2.18328 4.36362 2.18328H10.9091C11.1984 2.18328 11.4759 2.06834 11.6804 1.86376C11.885 1.65917 12 1.3817 12 1.09237C12 0.803044 11.885 0.525568 11.6804 0.320984C11.4759 0.116399 11.1984 0.00146484 10.9091 0.00146484H4.36362C3.20632 0.00146484 2.09641 0.461202 1.27808 1.27954C0.459738 2.09788 0 3.20778 0 4.36509V19.6378C0 20.7951 0.459738 21.905 1.27808 22.7233C2.09641 23.5417 3.20632 24.0014 4.36362 24.0014H19.6363C20.7936 24.0014 21.9035 23.5417 22.7219 22.7233C23.5402 21.905 23.9999 20.7951 23.9999 19.6378V13.0923C23.9999 12.803 23.885 12.5255 23.6804 12.3209C23.4758 12.1164 23.1983 12.0014 22.909 12.0014Z" fill="#363636"/>
                <path d="M23.9048 0.669889C23.8549 0.558011 23.7863 0.455454 23.7019 0.366617C23.6888 0.352435 23.6845 0.33389 23.6703 0.319708C23.6561 0.305526 23.6376 0.301163 23.6234 0.288072C23.4293 0.100363 23.169 -0.00313943 22.899 7.25859e-05H16.3536C16.0643 7.25859e-05 15.7868 0.115007 15.5822 0.319591C15.3776 0.524176 15.2627 0.801652 15.2627 1.09098C15.2627 1.3803 15.3776 1.65778 15.5822 1.86237C15.7868 2.06695 16.0643 2.18188 16.3536 2.18188H20.2656L12.3096 10.1379C12.2054 10.2385 12.1223 10.3589 12.0651 10.492C12.008 10.6251 11.9779 10.7682 11.9766 10.9131C11.9753 11.0579 12.0029 11.2016 12.0578 11.3356C12.1127 11.4697 12.1937 11.5915 12.2961 11.6939C12.3985 11.7964 12.5203 11.8774 12.6544 11.9322C12.7884 11.9871 12.9321 12.0147 13.0769 12.0134C13.2218 12.0121 13.3649 11.982 13.498 11.9249C13.6311 11.8677 13.7515 11.7846 13.8521 11.6804L21.8081 3.72442V7.63641C21.8081 7.92574 21.9231 8.20322 22.1276 8.4078C22.3322 8.61238 22.6097 8.72732 22.899 8.72732C23.1884 8.72732 23.4658 8.61238 23.6704 8.4078C23.875 8.20322 23.9899 7.92574 23.9899 7.63641V1.09098C23.9901 0.946333 23.9611 0.803137 23.9048 0.669889Z" fill="#363636"/>
                </g>
                </svg>
            </button>

          </div>
        {%- endif -%}

        <!-- Title -->
        <h1 class="pm-title">{{ product.title }}</h1>
        <!-- Rating row -->
        <div class="pm-rating-row">
{%- assign rating = product.metafields.reviews.rating.value | default: 4.8 -%}

<div class="pm-stars">
  {%- assign rating_float = product.metafields.reviews.rating.value | default: 4.8 | append: '' | plus: 0.0 -%}
  {% for i in (1..5) %}
    {%- assign index_float = forloop.index0 | append: '' | plus: 0.0 -%}
    {%- assign diff = rating_float | minus: index_float -%}
    <span class="star-wrapper">
      <svg class="star-bg" width="16" height="16" viewBox="0 0 24 24">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="#d1d5db"/>
      </svg>
      <span class="star-fill" style="width:{% if diff >= 1 %}100{% elsif diff > 0 %}{{ diff | times: 100 | round }}{% else %}0{% endif %}%;">
        <svg width="16" height="16" viewBox="0 0 24 24">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="#f59e0b"/>
        </svg>
      </span>
    </span>
  {% endfor %}
</div>
          <span class="pm-rating-score">{{ rating }}</span>
          <a href="#judgeme_product_reviews" class="pm-rating-count">from {{ product.metafields.reviews.rating_count.value | default: '1,405' }} reviews</a>
          <span class="pm-trusted">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="#1a6b4a"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10" stroke="white" stroke-width="2" fill="none"/></svg>
            Trusted by {{ trusted_count }} Customers
          </span>
        </div> 
        {% comment %} <div class="pm-rating-row">
          <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}"></div>
          <span class="pm-trusted">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="#1a6b4a"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10" stroke="white" stroke-width="2" fill="none"/></svg>
            Trusted by {{ trusted_count }} Customers
          </span>
        </div> {% endcomment %}
        <!-- Vendor -->
        <p class="pm-vendor">Vendor : <a href="/collections/vendor?q={{ product.vendor | url_encode }}">{{ product.vendor }}</a></p>

        <!-- Price -->
        <div class="pm-price-row">
          <span class="pm-price">₹{{ current_variant.price | money_without_currency }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="pm-compare">₹{{ current_variant.compare_at_price | money_without_currency }}</span>
            {%- assign disc = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
            <span class="pm-discount-badge">{{ disc }}% off</span>
          {%- endif -%}
            {%- if current_variant.inventory_management == 'shopify' -%}
                <span class="pm-stock">Last {{ current_variant.inventory_quantity }} stock left</span>
            {%- endif -%}
        </div>
        <p class="pm-tax-note">MRP inclusive of all taxes</p>

        <!-- Mini Reviews Carousel -->
        <!-- Mini Reviews Carousel -->
        {%- assign mini_reviews_json = product.metafields.custom.mini_reviews.value -%}
        {%- if mini_reviews_json != blank -%}
          <div class="pm-mini-reviews">
            {%- for review in mini_reviews_json -%}
              <div class="pm-mini-review">
                <div class="pm-mini-top">
                  <span class="pm-mini-name">{{ review.name }}</span>
                  <div class="pm-mini-stars">
                    {%- for i in (1..review.rating) -%}
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="#f59e0b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    {%- endfor -%}
                  </div>
                </div>
                <p class="pm-mini-text">{{ review.review }}</p>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Select Pack -->
        <div class="pm-pack-section">
          <p class="pm-pack-label">Select Pack</p>
          <div class="pm-variants-wrap">
            <div class="pm-variants-grid" id="pm-variants-{{ section.id }}">
              {%- for variant in product.variants -%}
                {%- assign v_disc = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price -%}
                <div
                  class="pm-variant-card {% if variant.id == current_variant.id %}active{% endif %} {% if variant.metafields.custom.best_seller.value %}best-seller{% endif %}"
                  data-variant-id="{{ variant.id }}"
                  data-price="{{ variant.price }}"
                  data-compare="{{ variant.compare_at_price }}"
                >
                  {%- if variant.compare_at_price > variant.price -%}
                    <div style="justify-content: space-between; display: flex; align-items: center;">
                      <div class="pm-variant-disc">{{ v_disc }}% off
                      </div>
                      {%- if variant.id == current_variant.id -%}
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect width="20" height="20" rx="10" fill="#048E79"/>
                        <path d="M5.71191 9.83165L8.73712 12.8569L14.4514 7.14258" stroke="white" stroke-width="0.9" stroke-linecap="round"/>
                        </svg>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  {% assign title_parts = variant.title | split: '(' %}

                  <div class="pm-variant-title">
                    {{ title_parts[0] | strip }}
                  </div>

                  {% if title_parts.size > 1 %}
                    <div class="pm-variant-sub">
                      {{ title_parts[1] | remove: ')' | strip }}
                    </div>
                  {% endif %}
                  <div class="pm-variant-price">
                    <span class="pm-variant-main-price">₹{{ variant.price | money_without_currency }}</span>
                    {% comment %} ₹{{ variant.price | money_without_currency }} {% endcomment %}
                    {%- if variant.compare_at_price > variant.price -%}
                      <span class="pm-variant-compare">₹{{ variant.compare_at_price | money_without_currency }}</span>
                    {%- endif -%}
                  </div>
                  {%- if variant.metafields.custom.per_bottle_price.value != blank -%}
                    <div class="pm-variant-per">₹{{ variant.metafields.custom.per_bottle_price.value }} per bottle</div>
                  {%- endif -%}
                  {%- if variant.metafields.custom.tag -%}
                    <div class="pm-best-seller-tag">{{ variant.metafields.custom.tag }}</div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
            <div class="pm-variants-dots" id="pm-variants-dots-{{ section.id }}"></div>
            <!-- Mobile progress bar -->
            <div class="pm-variants-bar" id="pm-variants-bar-{{ section.id }}">
              <div class="pm-variants-bar-fill" id="pm-variants-bar-fill-{{ section.id }}"></div>
            </div>
          </div>
        </div>

        <!-- Disclaimer -->
        {%- if disclaimer != blank -%}
          <div class="pm-disclaimer">{{ disclaimer }}</div>
        {%- endif -%}
        {%- if product.available -%}
          <div class="add-to-buy">
              <!-- Quantity + ATC -->
              <div class="pm-atc-row">
                <div class="pm-qty">
                  <button class="pm-qty-btn" id="pm-qty-minus">−</button>
                  <span class="pm-qty-val" id="pm-qty-val">1</span>
                  <button class="pm-qty-btn" id="pm-qty-plus">+</button>
                </div>
                <button class="pm-atc-btn" id="pm-atc-btn">Add to Cart</button>
              </div>

              <!-- Buy It Now + Amazon -->
              <div class="pm-buy-row">
                {%- form 'product', product, id: 'pm-gokwik-form', style: 'display:none' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" id="pm-gokwik-variant">
                  <input type="hidden" name="quantity" value="1" id="pm-gokwik-qty">
                {%- endform -%}

                <button 
                  type="button" 
                  class="pm-buy-btn" 
                  id="pm-buy-btn"
                  onclick="onBuyNowClick(this,'#pm-gokwik-form')"
                  {% if settings.hideFlow %} style="display:none !important;" {% endif %}
                >
                  Buy It Now
                </button>
                {%- if show_amazon == true -%}
                  <a href="{{ amazon_link.url | default: 'https://amazon.in' }}" class="pm-amazon-btn" target="_blank" rel="noopener">
                    Available at
