{%- comment -%}
  Product page: desktop layout here, mobile layout in product-main-mobile,
  sticky bar in product-sticky-bar. Pack, quantity, cart, gallery and the
  delivery check: assets/product-main.js, fed by the data block below.
  Product text comes from metafields; nothing placeholder shows when one is
  empty (the disclaimer falls back to the section's default only for products
  whose title contains the keyword set in the section).
{%- endcomment -%}
{{ 'section-product-main.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-main.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  assign amazon_link = product.metafields.custom.amazon_link.value
  assign amazon_url = amazon_link.url | default: amazon_link
  assign show_amazon = false
  if product.metafields.custom.available_on_amazon.value == true and amazon_url != blank
    assign show_amazon = true
  endif

  assign trusted_count = product.metafields.custom.trusted_customers.value | default: section.settings.trusted_customers
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value

  assign disclaimer = product.metafields.custom.disclaimer.value
  if disclaimer == blank and section.settings.disclaimer_keyword != blank
    assign title_lower = product.title | downcase
    assign keyword_lower = section.settings.disclaimer_keyword | downcase
    if title_lower contains keyword_lower
      assign disclaimer = section.settings.default_disclaimer
    endif
  endif

  assign fresh_batch_text = product.metafields.custom.fresh_batch_text.value
  assign fresh_batch_dates = product.metafields.custom.fresh_batch_dates.value
  assign ingredients = product.metafields.custom.ingredients.value | default: product.metafields.custom.ingredientsdd.value | default: section.settings.ingredients_text
  assign additional_info = product.metafields.custom.additional_info.value | default: section.settings.additional_info_text

  assign low_stock_text = ''
  if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= section.settings.low_stock_threshold
    assign low_stock_text = 'Only [count] left in stock' | replace: '[count]', current_variant.inventory_quantity
  endif

  assign has_compare = false
  if current_variant.compare_at_price > current_variant.price
    assign has_compare = true
    assign current_disc = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price
  endif
-%}

<script type="application/json" data-pm-data>
  {
    "currentVariant": {{ current_variant.id | json }},
    "maxQty": {{ section.settings.max_quantity | default: 0 | json }},
    "lowStock": {{ section.settings.low_stock_threshold | default: 0 | json }},
    "lowStockText": "Only [count] left in stock",
    "labels": {
      "add": "Add to Cart",
      "adding": "Adding...",
      "soldOut": "Sold out",
      "error": "Couldn't add this to your cart. Please try again.",
      "maxQty": "You can add up to [count] at a time",
      "linkCopied": "Link copied"
    },
    "variants": [
      {%- for variant in product.variants -%}
        {%- liquid
          assign v_image = -1
          if variant.featured_image
            for image in product.images
              if image.id == variant.featured_image.id
                assign v_image = forloop.index0
                break
              endif
            endfor
          endif
          assign v_disc = 0
          if variant.compare_at_price > variant.price
            assign v_disc = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price
          endif
        -%}
        {
          "id": {{ variant.id }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | money_without_currency | json }},
          "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money_without_currency | json }}{% else %}null{% endif %},
          "discount": {{ v_disc }},
          "stock": {% if variant.inventory_management == 'shopify' %}{{ variant.inventory_quantity | json }}{% else %}null{% endif %},
          "deny": {% if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' %}true{% else %}false{% endif %},
          "image": {{ v_image }}
        }
        {%- unless forloop.last %},{% endunless -%}
      {%- endfor -%}
    ]
  }
</script>

<div class="pm-breadcrumb-wrap">
  {% render 'breadcrumb' %}
</div>
<div class="pm-desktop-only">
  <div class="pm-section" id="pm-section-{{ section.id }}" data-pm-root="desktop">
    <div class="pm-inner">

      <!-- ══════════════════════════════
          LEFT COLUMN
      ══════════════════════════════ -->
      <div class="pm-left">

        <!-- Badges row -->
        {%- if section.blocks.size > 0 -%}
          <div class="pm-badges-row">
            {%- for block in section.blocks -%}
              {%- if block.type == 'badge' -%}
                <span class="pm-badge" style="background:{{ block.settings.bg_color }}; color:{{ block.settings.text_color }};" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != blank -%}
                    <img src="{{ block.settings.icon | image_url: width: 20 }}" alt="" width="16" height="16">
                  {%- endif -%}
                  {{ block.settings.label }}
                </span>
              {%- endif -%}
            {%- endfor -%}

            <!-- Share / External link icon -->
            <span class="pm-share-status" data-pm-share-status role="status" hidden></span>
            <button type="button" class="pm-share-btn" data-pm-share data-title="{{ product.title | escape }}" aria-label="Share">
                {%- render 'icon-share-product' -%}
            </button>

          </div>
        {%- endif -%}

        <!-- Title -->
        <h1 class="pm-title">{{ product.title }}</h1>
        <!-- Rating row -->
        {%- render 'product-main-rating', rating: rating, rating_count: rating_count, trusted_count: trusted_count -%}

        <!-- Vendor -->
        <p class="pm-vendor">Vendor : <a href="{{ product.vendor | url_for_vendor }}">{{ product.vendor }}</a></p>

        <!-- Price -->
        <div class="pm-price-row">
          <span class="pm-price" data-pm-price>₹{{ current_variant.price | money_without_currency }}</span>
          <span class="pm-compare" data-pm-compare{% unless has_compare %} hidden{% endunless %}>
            {%- if has_compare %}₹{{ current_variant.compare_at_price | money_without_currency }}{% endif -%}
          </span>
          <span class="pm-discount-badge" data-pm-discount{% unless has_compare %} hidden{% endunless %}>{{ current_disc }}% off</span>
          <span class="pm-stock" data-pm-stock{% if low_stock_text == blank %} hidden{% endif %}>{{ low_stock_text }}</span>
        </div>
        <p class="pm-tax-note">MRP inclusive of all taxes</p>

        <!-- Mini Reviews -->
        {%- render 'product-main-mini-reviews' -%}

        <!-- Select Pack -->
        <div class="pm-pack-section">
          <p class="pm-pack-label">Select Pack</p>
          <div class="pm-variants-wrap">
            <div class="pm-variants-grid" role="radiogroup" aria-label="Select pack">
              {%- for variant in product.variants -%}
                {%- render 'product-main-pack', variant: variant, current_variant: current_variant -%}
              {%- endfor -%}
            </div>
            <div class="pm-variants-dots"></div>
            <!-- Mobile progress bar -->
            <div class="pm-variants-bar">
              <div class="pm-variants-bar-fill"></div>
            </div>
          </div>
        </div>

        <!-- Disclaimer -->
        {%- if disclaimer != blank -%}
          <div class="pm-disclaimer">{{ disclaimer }}</div>
        {%- endif -%}
        {%- if product.available -%}
          <div class="add-to-buy">
              <!-- Quantity + ATC -->
              <div class="pm-atc-row">
                <div class="pm-qty">
                  <button type="button" class="pm-qty-btn" data-pm-qty-minus aria-label="Decrease quantity" disabled>−</button>
                  <span class="pm-qty-val" data-pm-qty-value aria-live="polite">1</span>
                  <button type="button" class="pm-qty-btn" data-pm-qty-plus aria-label="Increase quantity">+</button>
                </div>
                <button type="button" class="pm-atc-btn" data-pm-atc{% unless current_variant.available %} disabled{% endunless %}>
                  {%- if current_variant.available %}Add to Cart{% else %}Sold out{% endif -%}
                </button>
              </div>
              <p class="pm-qty-note" data-pm-qty-note hidden></p>
              <p class="pm-cart-error" data-pm-cart-error role="alert" hidden></p>

              <!-- Buy It Now + Amazon -->
              <div class="pm-buy-row">
                {%- form 'product', product, id: 'pm-gokwik-form', style: 'display:none' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-pm-form-variant>
                  <input type="hidden" name="quantity" value="1" data-pm-form-qty>
                {%- endform -%}

                <button
                  type="button"
                  class="pm-buy-btn"
                  id="pm-buy-btn"
                  data-pm-buy
                  onclick="if (typeof onBuyNowClick === 'function') onBuyNowClick(this, '#pm-gokwik-form')"
                  {% unless current_variant.available %}disabled{% endunless %}
                  {% if settings.hideFlow %} style="display:none !important;" {% endif %}
                >
                  Buy It Now
                </button>
                {%- if show_amazon -%}
                  <a href="{{ amazon_url }}" class="pm-amazon-btn" target="_blank" rel="noopener">
                    Available at
                              {%- render 'icon-amazon-logo' -%}
                  </a>
                {%- endif -%}
              </div>
          </div>
        {%- else -%}
          <div class="out-to-notify">
              <button class="pm-out" disabled>Out of Stock</button>
          </div>
        {%- endif -%}
        <!-- Trust Icons -->
        <div class="pm-trust-row">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_icon' -%}
              <div class="pm-trust-item" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <img src="{{ block.settings.icon | image_url: width: 40 }}" alt="{{ block.settings.label }}" width="32" height="32">
                {%- else -%}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1a6b4a" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/></svg>
                {%- endif -%}
                <span>{{ block.settings.label }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <!-- Ingredients / Additional Information -->
        {%- render 'product-main-accordions', ingredients: ingredients, additional_info: additional_info -%}

      </div>

      <!-- ══════════════════════════════
          RIGHT COLUMN
      ══════════════════════════════ -->
      <div class="pm-right">

        <!-- Main Image -->
        <div class="pm-main-image-wrap">
          <button class="pm-wishlist-btn my-custom-wishlist-button swym-button swym-add-to-wishlist" data-with-epi="true"
    data-swaction="addToWishlist"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ current_variant.id }}"
    data-pm-wishlist
    data-product-url="{{ shop.url }}{{ product.url }}" aria-label="Add to wishlist">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="1.8">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </button>
          <div class="pm-main-image-slider">
            {%- for image in product.images -%}
              <div class="pm-main-slide{% if forloop.first %} active{% endif %}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
                <img
                  src="{{ image | image_url: width: 900 }}"
                  alt="{{ image.alt | default: product.title | escape }}"
                  class="pm-main-img"
                  width="900"
                  height="{{ 900 | divided_by: image.aspect_ratio | round }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                >
              </div>
            {%- endfor -%}
          </div>
          {% comment %} circular button {% endcomment %}
           {%- if product.images.size > 1 -%}
              <button type="button" class="pm-main-arrow pm-main-arrow-prev" aria-label="Previous image">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>
              <button type="button" class="pm-main-arrow pm-main-arrow-next" aria-label="Next image">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            {%- endif -%}
          {%- render 'product-main-dots' -%}
        </div>

        <!-- Thumbnails -->
        <div class="pm-thumbnails">
          {%- for image in product.images -%}
            <div class="pm-thumb{% if forloop.first %} active{% endif %}" role="button" tabindex="0" aria-label="Show image {{ forloop.index }}" data-slide="{{ forloop.index0 }}">
              <img
                src="{{ image | image_url: width: 160 }}"
                alt=""
                width="80"
                height="80"
                loading="lazy"
              >
            </div>
          {%- endfor -%}
        </div>

        <!-- Check Delivery -->
        {% comment %} <div class="pm-delivery-section">
          <p class="pm-delivery-title">Check Delivery</p>
          <div class="pm-delivery-row">
            <input type="text" class="pm-pincode-input" placeholder="Enter Pincode" maxlength="6" id="pm-pincode">
            <button class="pm-pincode-check" id="pm-pincode-btn">Check</button>
          </div>
          <p class="pm-delivery-estimate" id="pm-delivery-result"></p>
        </div> {% endcomment %}
        <!-- Check Delivery -->
        <div class="pm-delivery-section">
          <p class="pm-delivery-title">Check Delivery</p>
          <div class="promise-product-page">
            <div class="sr-promise-pdp-page" id="PromiseEddSection"></div>
          </div>
        </div>
        <!-- Fresh Batch Banner -->
        {%- if fresh_batch_text != blank -%}
          <div class="pm-fresh-batch">
            <div class="pm-fresh-left"></div>
            <div class="pm-fresh-content">
              <p class="pm-fresh-title">{{ fresh_batch_text }}</p>
              {%- if fresh_batch_dates != blank -%}
                <p class="pm-fresh-dates">{{ fresh_batch_dates }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <!-- Available Offers -->
        {%- assign offer_blocks = section.blocks | where: 'type', 'offer' -%}
        {%- if offer_blocks.size > 0 -%}
          <div class="pm-offers-section">
            <p class="pm-offers-title">Available Offers</p>
            <div class="pm-offers-grid">
              {%- for block in offer_blocks -%}
                <div class="pm-offer-card" {{ block.shopify_attributes }}>
                  <p class="pm-offer-text">{{ block.settings.offer_text }}</p>
                  {%- if block.settings.coupon_code != blank -%}
                    <div class="pm-coupon-row">
                      <span class="pm-coupon-label">Code: {{ block.settings.coupon_code }}</span>
                      <button class="pm-coupon-copy" data-code="{{ block.settings.coupon_code }}">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                      </button>
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</div>
<div class="pm-mobile-only">
  {%- render 'product-main-mobile',
    current_variant: current_variant,
    show_amazon: show_amazon,
    amazon_url: amazon_url,
    trusted_count: trusted_count,
    rating: rating,
    rating_count: rating_count,
    disclaimer: disclaimer,
    fresh_batch_text: fresh_batch_text,
    fresh_batch_dates: fresh_batch_dates,
    ingredients: ingredients,
    additional_info: additional_info,
    low_stock_text: low_stock_text,
    has_compare: has_compare,
    current_disc: current_disc
  -%}
</div>
  {%- render 'product-sticky-bar' -%}

{% schema %}
{
  "name": "Product Main",
  "tag": "section",
  "class": "pm-section-outer",
  "settings": [
    {
      "type": "textarea",
      "id": "ingredients_text",
      "label": "Default ingredients text",
      "info": "Shown when a product has no ingredients metafield. Leave empty to hide the accordion."
    },
    {
      "type": "textarea",
      "id": "additional_info_text",
      "label": "Default additional info text",
      "info": "Shown when a product has no additional info metafield. Leave empty to hide the accordion."
    },
    {
      "type": "text",
      "id": "trusted_customers",
      "label": "Trusted customers",
      "info": "Shown as \"Trusted by … Customers\" when a product has no trusted customers metafield. Leave empty to hide.",
      "default": "100k+"
    },
    {
      "type": "header",
      "content": "Disclaimer"
    },
    {
      "type": "textarea",
      "id": "default_disclaimer",
      "label": "Default disclaimer",
      "info": "Shown when a product has no disclaimer metafield and its title contains the keyword below.",
      "default": "Not recommended for pregnant or breastfeeding women, individuals with low blood pressure, or those with a vitamin C allergy or vitamin K deficiency."
    },
    {
      "type": "text",
      "id": "disclaimer_keyword",
      "label": "Products that get the default disclaimer",
      "info": "Title keyword, e.g. \"buckthorn\". Leave empty to use the disclaimer metafield only.",
      "default": "buckthorn"
    },
    {
      "type": "header",
      "content": "Quantity and stock"
    },
    {
      "type": "range",
      "id": "max_quantity",
      "label": "Maximum quantity per add to cart",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 10,
      "info": "Also capped by stock for packs that can't be oversold."
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Show \"Only N left in stock\" from",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 10,
      "info": "Set to 0 to never show it."
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Product Badge",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Badge label",
          "default": "Boosts Immunity"
        },
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background",
          "default": "#1a6b4a"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        }
      ]
    },
    {
      "type": "mini_review",
      "name": "Mini Review",
      "settings": [
        {
          "type": "paragraph",
          "content": "Shown only when the product has no custom.mini_reviews metafield. Use real customer quotes."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Raja Kumar"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "review",
          "label": "Review text",
          "default": "Great Results, Loved it!"
        }
      ]
    },
    {
      "type": "trust_icon",
      "name": "Trust Icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "No Added Sugar"
        }
      ]
    },
    {
      "type": "offer",
      "name": "Available Offer",
      "settings": [
        {
          "type": "textarea",
          "id": "offer_text",
          "label": "Offer text",
          "default": "Get a EXTRA 10% Off on a Cart value of Rs2199"
        },
        {
          "type": "text",
          "id": "coupon_code",
          "label": "Coupon code",
          "default": "SUMMER10"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Main",
      "blocks": [
        { "type": "badge", "settings": { "label": "Boosts Immunity", "bg_color": "#1a6b4a" } },
        { "type": "badge", "settings": { "label": "No Added Color", "bg_color": "#7c5c3a" } },
        { "type": "badge", "settings": { "label": "No Added Sugar", "bg_color": "#555" } },
        { "type": "trust_icon", "settings": { "label": "No Added Sugar" } },
        { "type": "trust_icon", "settings": { "label": "No Preservatives 100% Natural" } },
        { "type": "trust_icon", "settings": { "label": "No Added Color" } },
        { "type": "offer", "settings": { "offer_text": "Get a EXTRA 10% Off on a Cart value of Rs2199", "coupon_code": "SUMMER10" } }
      ]
    }
  ]
}
{% endschema %}