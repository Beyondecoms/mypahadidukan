                {%- else -%}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1a6b4a" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/></svg>
                {%- endif -%}
