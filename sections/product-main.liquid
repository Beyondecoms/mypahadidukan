{{ 'section-product-main.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign capsule_features = product.metafields.custom.product_capsule_features.value
  assign trusted_count = product.metafields.custom.trusted_customers.value | default: '1M+'
  if product.handle == 'sea-buckthorn-juice' or product.handle == 'buy-shilajit-online'
    assign disclaimer = product.metafields.custom.disclaimer.value | remove: '(meta)' | strip
  elsif product.handle == 'seabuckthorn-oil-vitamin-c-serum'
    assign disclaimer = product.metafields.custom.important_information.value | strip
  endif
  assign fresh_batch_text = product.metafields.custom.fresh_batch_text.value | default:'Fresh Batch  Under Process'
  assign fresh_batch_dates = product.metafields.custom.fresh_batch_dates.value | default:'Orders placed between Thursday, 23rd April and Wednesday, 29th April will be shipped 30th April onwards'
-%}
<div class="pm-breadcrumb-wrap">
  {% render 'breadcrumb' %}
</div>
<div class="pm-desktop-only">
  <div class="pm-section" id="pm-section-{{ section.id }}">
    <div class="pm-inner">

      <!-- ══════════════════════════════
          LEFT COLUMN
      ══════════════════════════════ -->
      <div class="pm-left">

        {% render 'product-main-heading', capsule_features: capsule_features %}
        <!-- Rating row -->
        <div class="pm-rating-row">
{%- assign rating = product.metafields.reviews.rating.value | default: 4.8 -%}

<div class="pm-stars">
  {%- assign rating_float = product.metafields.reviews.rating.value | default: 4.8 | append: '' | plus: 0.0 -%}
  {% for i in (1..5) %}
    {%- assign index_float = forloop.index0 | append: '' | plus: 0.0 -%}
    {%- assign diff = rating_float | minus: index_float -%}
    <span class="star-wrapper">
      <svg class="star-bg" width="16" height="16" viewBox="0 0 24 24">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="#d1d5db"/>
      </svg>
      <span class="star-fill" style="width:{% if diff >= 1 %}100{% elsif diff > 0 %}{{ diff | times: 100 | round }}{% else %}0{% endif %}%;">
        <svg width="16" height="16" viewBox="0 0 24 24">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="#f59e0b"/>
        </svg>
      </span>
    </span>
  {% endfor %}
</div>
          <span class="pm-rating-score">{{ rating }}</span>
          <a href="#judgeme_product_reviews" class="pm-rating-count">from {{ product.metafields.reviews.rating_count.value | default: '1,405' }} reviews</a>
          <span class="pm-trusted">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="#1a6b4a"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10" stroke="white" stroke-width="2" fill="none"/></svg>
            Trusted by {{ trusted_count }} Customers
          </span>
        </div> 
        {% comment %} <div class="pm-rating-row">
          <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}"></div>
          <span class="pm-trusted">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="#1a6b4a"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10" stroke="white" stroke-width="2" fill="none"/></svg>
            Trusted by {{ trusted_count }} Customers
          </span>
        </div> {% endcomment %}
        <!-- Vendor -->
        <p class="pm-vendor">Vendor : <a href="{{ product.vendor | url_for_vendor | escape }}">{{ product.vendor | escape }}</a></p>

        <!-- Price -->
        {%- capture stock_text -%}{% render 'product-main-stock-text', variant: current_variant %}{%- endcapture -%}
        <div class="pm-price-row">
          <span class="pm-price">₹{{ current_variant.price | money_without_currency }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="pm-compare">₹{{ current_variant.compare_at_price | money_without_currency }}</span>
            {%- assign disc = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
            <span class="pm-discount-badge">{{ disc }}% off</span>
          {%- endif -%}
          <span class="pm-stock"{% if stock_text == blank %} hidden{% endif %}>{{ stock_text }}</span>
        </div>
        <p class="pm-tax-note">MRP inclusive of all taxes</p>

        <!-- Mini Reviews Carousel -->
        <!-- Mini Reviews Carousel -->
        {%- assign mini_reviews_json = product.metafields.custom.mini_reviews.value -%}
        {%- if mini_reviews_json != blank -%}
          <div class="pm-mini-reviews">
            {%- for review in mini_reviews_json -%}
              <div class="pm-mini-review">
                <div class="pm-mini-top">
                  <span class="pm-mini-name">{{ review.name }}</span>
                  <div class="pm-mini-stars">
                    {%- for i in (1..review.rating) -%}
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="#f59e0b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    {%- endfor -%}
                  </div>
                </div>
                <p class="pm-mini-text">{{ review.review }}</p>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Select Pack (single-variant products only have Shopify's "Default Title" placeholder) -->
        {%- unless product.has_only_default_variant -%}
        <div class="pm-pack-section">
          <p class="pm-pack-label">Select Pack</p>
          <div class="pm-variants-wrap">
            <div class="pm-variants-grid" id="pm-variants-{{ section.id }}">
              {%- for variant in product.variants -%}
                {%- assign v_disc = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price -%}
                <div
                  class="pm-variant-card {% if variant.id == current_variant.id %}active{% endif %} {% if variant.metafields.custom.best_seller.value %}best-seller{% endif %}"
                  data-variant-id="{{ variant.id }}"
                  data-price="{{ variant.price }}"
                  data-compare="{{ variant.compare_at_price }}"
                  data-stock-text="{% render 'product-main-stock-text', variant: variant %}"
                  data-image-id="{{ variant.featured_image.id }}"
                >
                  {%- if variant.compare_at_price > variant.price -%}
                    <div style="justify-content: space-between; display: flex; align-items: center;">
                      <div class="pm-variant-disc">{{ v_disc }}% off
                      </div>
                      {%- if variant.id == current_variant.id -%}
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect width="20" height="20" rx="10" fill="#048E79"/>
                        <path d="M5.71191 9.83165L8.73712 12.8569L14.4514 7.14258" stroke="white" stroke-width="0.9" stroke-linecap="round"/>
                        </svg>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  {% assign title_parts = variant.title | split: '(' %}

                  <div class="pm-variant-title">
                    {{ title_parts[0] | strip }}
                  </div>

                  {% if title_parts.size > 1 %}
                    <div class="pm-variant-sub">
                      {{ title_parts[1] | remove: ')' | strip }}
                    </div>
                  {% endif %}
                  <div class="pm-variant-price">
                    <span class="pm-variant-main-price">₹{{ variant.price | money_without_currency }}</span>
                    {% comment %} ₹{{ variant.price | money_without_currency }} {% endcomment %}
                    {%- if variant.compare_at_price > variant.price -%}
                      <span class="pm-variant-compare">₹{{ variant.compare_at_price | money_without_currency }}</span>
                    {%- endif -%}
                  </div>
                  {%- if variant.metafields.custom.per_bottle_price.value != blank -%}
                    <div class="pm-variant-per">₹{{ variant.metafields.custom.per_bottle_price.value }} per bottle</div>
                  {%- endif -%}
                  {%- if variant.metafields.custom.tag -%}
                    <div class="pm-best-seller-tag">{{ variant.metafields.custom.tag }}</div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
            <div class="pm-variants-dots" id="pm-variants-dots-{{ section.id }}"></div>
            <!-- Mobile progress bar -->
            <div class="pm-variants-bar" id="pm-variants-bar-{{ section.id }}">
              <div class="pm-variants-bar-fill" id="pm-variants-bar-fill-{{ section.id }}"></div>
            </div>
          </div>
        </div>
        {%- endunless -%}

        <!-- Disclaimer -->
        {%- if disclaimer != blank -%}
          <div class="pm-disclaimer">{{ disclaimer | escape | newline_to_br }}</div>
        {%- endif -%}
        {%- if product.available -%}
          <div class="add-to-buy">
              <!-- Quantity + ATC -->
              <div class="pm-atc-row">
                <div class="pm-qty">
                  <button class="pm-qty-btn" id="pm-qty-minus">−</button>
                  <span class="pm-qty-val" id="pm-qty-val">1</span>
                  <button class="pm-qty-btn" id="pm-qty-plus">+</button>
                </div>
                <button class="pm-atc-btn" id="pm-atc-btn">Add to Cart</button>
              </div>

              <!-- Buy It Now + Amazon -->
              <div class="pm-buy-row">
                {%- form 'product', product, id: 'pm-gokwik-form', style: 'display:none' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" id="pm-gokwik-variant">
                  <input type="hidden" name="quantity" value="1" id="pm-gokwik-qty">
                {%- endform -%}

                <button 
                  type="button" 
                  class="pm-buy-btn" 
                  id="pm-buy-btn"
                  onclick="onBuyNowClick(this,'#pm-gokwik-form')"
                  {% if settings.hideFlow %} style="display:none !important;" {% endif %}
                >
                  Buy It Now
                </button>
                {%- render 'product-amazon-button', vendor: product.vendor, section_id: section.id, placement: 'desktop' -%}
              </div>
          </div>
        {%- else -%}
          <div class="out-to-notify">
              <button class="pm-out" disabled>Out of Stock</button>
              {%- render 'product-amazon-button', vendor: product.vendor, section_id: section.id, placement: 'desktop' -%}
          </div>
        {%- endif -%}
        {% render 'product-research-link', product: product %}

        <!-- Trust Icons -->
        <div class="pm-trust-row">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_icon' -%}
              <div class="pm-trust-item" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  <img src="{{ block.settings.icon | image_url: width: 40 }}" alt="{{ block.settings.label }}" width="32" height="32">
                {%- else -%}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#1a6b4a" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/></svg>
                {%- endif -%}
                <span>{{ block.settings.label }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {% render 'product-information-accordion', product: product, panel_prefix: section.id, layout: 'desktop' %}

      </div>

      <!-- ══════════════════════════════
          RIGHT COLUMN
      ══════════════════════════════ -->
      <div class="pm-right">

        <!-- Main Image -->
        <div class="pm-main-image-wrap">
          <button class="pm-wishlist-btn my-custom-wishlist-button swym-button swym-add-to-wishlist" data-with-epi="true"
    data-swaction="addToWishlist"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ product.variants[0].id }}"
    data-product-url="{{ shop.url }}{{ product.url }}" aria-label="Wishlist">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#333" stroke-width="1.8">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </button>
          <!-- Zoom hint icon -->
          <span class="pm-zoom-hint" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          </span>
          <div class="pm-main-image-slider" id="pm-main-slider-{{ section.id }}">
            {%- for image in product.images -%}
              <div class="pm-main-slide {% if forloop.first %}active{% endif %}" data-image-id="{{ image.id }}">
                <img
                  src="{{ image | image_url: width: 900 }}"
                  data-zoom-src="{{ image | image_url: width: 1800 }}"
                  alt="{{ product.title }}"
                  class="pm-main-img pm-zoomable"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  role="button"
                  tabindex="0"
                  aria-label="Zoom image: {{ product.title }}"
                >
              </div>
            {%- endfor -%}
          </div>
          {% comment %} circular button {% endcomment %}
           {%- if product.images.size > 1 -%}
              <button class="pm-main-arrow pm-main-arrow-prev" id="pm-main-prev-{{ section.id }}" aria-label="Previous image">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>
              <button class="pm-main-arrow pm-main-arrow-next" id="pm-main-next-{{ section.id }}" aria-label="Next image">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            {%- endif -%}
          <!-- Dot indicators -->
          <div class="pm-main-dots" id="pm-main-dots-{{ section.id }}">
            {%- for image in product.images -%}
              <button class="pm-main-dot {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}"></button>
            {%- endfor -%}
          </div>
        </div>

        <!-- Thumbnails -->
        <div class="pm-thumbnails" id="pm-thumbs-{{ section.id }}">
          {%- for image in product.images -%}
            <div class="pm-thumb {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}">
              <img
                src="{{ image | image_url: width: 160 }}"
                alt="{{ product.title }}"
                loading="lazy"
              >
            </div>
          {%- endfor -%}
        </div>

        <!-- Check Delivery -->
        {% comment %} <div class="pm-delivery-section">
          <p class="pm-delivery-title">Check Delivery</p>
          <div class="pm-delivery-row">
            <input type="text" class="pm-pincode-input" placeholder="Enter Pincode" maxlength="6" id="pm-pincode">
            <button class="pm-pincode-check" id="pm-pincode-btn">Check</button>
          </div>
          <p class="pm-delivery-estimate" id="pm-delivery-result"></p>
        </div> {% endcomment %}
        <!-- Check Delivery -->
        {% comment %} <div class="pm-delivery-section">
          <p class="pm-delivery-title">Check Delivery</p>
          <div class="promise-product-page">
            <div class="sr-promise-pdp-page" id="PromiseEddSection"></div>
          </div>
        </div> {% endcomment %}
        <!-- Fresh Batch Banner -->
        {% comment %} {%- if fresh_batch_text != blank -%}
          <div class="pm-fresh-batch">
            <div class="pm-fresh-left"></div>
            <div class="pm-fresh-content">
              <p class="pm-fresh-title">{{ fresh_batch_text }}</p>
              {%- if fresh_batch_dates != blank -%}
                <p class="pm-fresh-dates">{{ fresh_batch_dates }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%} {% endcomment %}

        <!-- Available Offers -->
        {%- assign offer_blocks = section.blocks | where: 'type', 'offer' -%}
        {%- if offer_blocks.size > 0 and settings.show_product_offer_cards -%}
          <div class="pm-offers-section">
            <p class="pm-offers-title">Available Offers</p>
            <div class="pm-offers-grid">
              {%- for block in offer_blocks -%}
                <div class="pm-offer-card" {{ block.shopify_attributes }}>
                  <p class="pm-offer-text">{{ block.settings.offer_text }}</p>
                  {%- if block.settings.coupon_code != blank -%}
                    <div class="pm-coupon-row">
                      <span class="pm-coupon-label">Code: {{ block.settings.coupon_code }}</span>
                      <button class="pm-coupon-copy" data-code="{{ block.settings.coupon_code }}">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                      </button>
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- elsif offer_blocks.size > 0 -%}
          {% render 'product-checkout-offer' %}
        {%- endif -%}

      </div>
    </div>
  </div>
</div>

<!-- ══ PRODUCT IMAGE LIGHTBOX (desktop + mobile) ══ -->
<div
  id="pm-lightbox"
  class="pm-lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Product image viewer"
  aria-hidden="true"
  tabindex="-1"
>
  <div class="pm-lightbox-backdrop" id="pm-lightbox-backdrop"></div>
  <button class="pm-lightbox-close" id="pm-lightbox-close" aria-label="Close image viewer">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <div class="pm-lightbox-inner">
    <img
      id="pm-lightbox-img"
      class="pm-lightbox-image"
      src=""
      alt=""
      draggable="false"
    >
    <div class="pm-lightbox-loader" id="pm-lightbox-loader" aria-hidden="true">
      <svg width="36" height="36" viewBox="0 0 50 50"><circle cx="25" cy="25" r="20" fill="none" stroke="#fff" stroke-width="4" stroke-dasharray="80 20" stroke-linecap="round"><animateTransform attributeName="transform" type="rotate" from="0 25 25" to="360 25 25" dur="0.8s" repeatCount="indefinite"/></circle></svg>
    </div>
  </div>
  <div class="pm-lightbox-counter" id="pm-lightbox-counter" aria-live="polite"></div>
  {%- if product.images.size > 1 -%}
  <button class="pm-lightbox-arrow pm-lightbox-prev" id="pm-lightbox-prev" aria-label="Previous image">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
  </button>
  <button class="pm-lightbox-arrow pm-lightbox-next" id="pm-lightbox-next" aria-label="Next image">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
  </button>
  {%- endif -%}
</div>

<div class="pm-mobile-only">
  {% render 'product-main-mobile', capsule_features: capsule_features, disclaimer: disclaimer, stock_text: stock_text %}
</div>
  {%- render 'product-sticky-bar' -%}

<script>
  // Descriptions pasted from Docs/Sheets carry blank spacer blocks; tag them so
  // section-product-main.css can collapse runs of them. trim() also strips &nbsp;.
  document.querySelectorAll('#shopify-section-{{ section.id }} .pm-accordion-content :is(p, div, ul, ol)').forEach(function (el) {
    if (el.textContent.trim() === '' && !el.querySelector('img, iframe, video, svg, table, button, input, select, textarea')) {
      el.classList.add('pm-rte-blank');
    }
  });
</script>

<script>
(function () {
  var sectionEl = document.getElementById('pm-section-{{ section.id }}');
  if (!sectionEl) return;

  // ── IMAGE SLIDER ──
  var mainSlides = Array.from(sectionEl.querySelectorAll('#pm-main-slider-{{ section.id }} .pm-main-slide'));
  var mainDots   = Array.from(sectionEl.querySelectorAll('#pm-main-dots-{{ section.id }} .pm-main-dot'));
  var thumbs     = Array.from(sectionEl.querySelectorAll('#pm-thumbs-{{ section.id }} .pm-thumb'));
  var currentImg = 0;

  function goToImage(idx) {
    mainSlides[currentImg].classList.remove('active');
    mainDots[currentImg] && mainDots[currentImg].classList.remove('active');
    thumbs[currentImg] && thumbs[currentImg].classList.remove('active');
    currentImg = idx;
    mainSlides[currentImg].classList.add('active');
    mainDots[currentImg] && mainDots[currentImg].classList.add('active');
    thumbs[currentImg] && thumbs[currentImg].classList.add('active');
    // Store active index on slider element so lightbox can read it
    var sliderEl = document.getElementById('pm-main-slider-{{ section.id }}');
    if (sliderEl) sliderEl.dataset.activeIdx = currentImg;
    // Notify lightbox of slide change
    document.dispatchEvent(new CustomEvent('pm:slideChange', { detail: { idx: currentImg } }));
  }

  mainDots.forEach(function(dot, i) {
    dot.addEventListener('click', function() { goToImage(i); });
  });

  thumbs.forEach(function(thumb, i) {
    thumb.addEventListener('click', function() { goToImage(i); });
  });

  // ── VARIANT SELECTOR ──
  var variantCards = Array.from(sectionEl.querySelectorAll('.pm-variant-card'));
  var selectedVariantId = {{ current_variant.id }};
  var stockEl = sectionEl.querySelector('.pm-stock');

  variantCards.forEach(function(card) {
    card.addEventListener('click', function() {
      variantCards.forEach(function(c) { c.classList.remove('active'); });
      card.classList.add('active');
      selectedVariantId = parseInt(card.dataset.variantId);
      stockEl.textContent = card.dataset.stockText;
      stockEl.hidden = !card.dataset.stockText;

      // Update price display
      var price    = parseInt(card.dataset.price);
      var compare  = parseInt(card.dataset.compare);
      var priceEl  = sectionEl.querySelector('.pm-price');
      var compareEl = sectionEl.querySelector('.pm-compare');
      var discEl   = sectionEl.querySelector('.pm-discount-badge');

      if (priceEl) priceEl.textContent = '₹' + (price / 100).toFixed(0);
      if (compareEl && compare > price) {
        compareEl.textContent = '₹' + (compare / 100).toFixed(0);
        if (discEl) {
          var disc = Math.round((compare - price) * 100 / compare);
          discEl.textContent = disc + '% off';
        }
      }

      // ── Switch gallery to variant's featured image ──
      var imgId = card.dataset.imageId;
      if (imgId && imgId !== 'nil' && imgId !== '') {
        var targetIdx = -1;
        mainSlides.forEach(function(slide, i) {
          if (slide.dataset.imageId === imgId) { targetIdx = i; }
        });
        if (targetIdx >= 0 && targetIdx !== currentImg) {
          goToImage(targetIdx);
        }
      }
    });
  });
    // ── ACCORDIONS ──
  sectionEl.querySelectorAll('.pm-accordion-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var openBtn = sectionEl.querySelector('.pm-accordion-btn.open');
      if (openBtn) {
        openBtn.classList.remove('open');
        openBtn.setAttribute('aria-expanded', 'false');
        openBtn.nextElementSibling.setAttribute('inert', '');
      }
      if (openBtn !== btn) {
        btn.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        btn.nextElementSibling.removeAttribute('inert');
      }
    });
  });

  // ── COUPON COPY ──
  sectionEl.querySelectorAll('.pm-coupon-copy').forEach(function(btn) {
    btn.addEventListener('click', function() {
        var cleanCode = btn.dataset.code.replace(/<[^>]*>/g, '').trim();
        navigator.clipboard.writeText(cleanCode).then(function() {
        btn.innerHTML = '✓';
        setTimeout(function() {
          btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
        }, 1500);
      });
    });
