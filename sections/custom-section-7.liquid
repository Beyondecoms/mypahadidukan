<script>
  (function () {
    function initSection7() {
      var section = document.getElementById('custom-section-7-{{ section.id }}');
      if (!section) return;

      var tabButtons = section.querySelectorAll('[data-tab-index]');
      var tabPanels = section.querySelectorAll('[data-tab-panel]');
      var prevBtn = section.querySelector('[data-arrow="prev"]');
      var nextBtn = section.querySelector('[data-arrow="next"]');

      function getActiveTrack() {
        var activePanel = section.querySelector('.custom-section-7__tab-panel.is-active');
        return activePanel ? activePanel.querySelector('[data-carousel-track]') : null;
      }

      function updateArrows() {
        var track = getActiveTrack();
        if (!track || !prevBtn || !nextBtn) return;
        var maxScrollLeft = track.scrollWidth - track.clientWidth;
        prevBtn.disabled = track.scrollLeft <= 4;
        nextBtn.disabled = track.scrollLeft >= maxScrollLeft - 4;
      }

      function scrollTrack(direction) {
        var track = getActiveTrack();
        if (!track) return;
        var slide = track.querySelector('.custom-section-7__slide');
        if (!slide) return;
        var slideWidth = slide.getBoundingClientRect().width;
        var gap = parseFloat(getComputedStyle(track).gap) || 14;
        var scrollAmount = (slideWidth + gap) * 2;
        if (direction === 'prev') {
          track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        } else {
          track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
      }

      tabButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var index = this.dataset.tabIndex;
          tabButtons.forEach(function (b) { b.classList.remove('is-active'); });
          tabPanels.forEach(function (p) { p.classList.remove('is-active'); });

          this.classList.add('is-active');
          var targetPanel = section.querySelector('[data-tab-panel="' + index + '"]');
          if (targetPanel) {
            targetPanel.classList.add('is-active');
            var track = targetPanel.querySelector('[data-carousel-track]');
            if (track) track.scrollLeft = 0;
            setTimeout(updateArrows, 60);
          }
        });
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          scrollTrack('prev');
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          scrollTrack('next');
        });
      }

      tabPanels.forEach(function (panel) {
        var track = panel.querySelector('[data-carousel-track]');
        if (track) {
          track.addEventListener('scroll', updateArrows, { passive: true });
        }
      });

      window.addEventListener('resize', updateArrows, { passive: true });

      // Add to Cart handling
      section.addEventListener('click', function (e) {
        // Variant dropdown toggle
        var toggleBtn = e.target.closest('[data-dropdown-toggle]');
        if (toggleBtn) {
          e.preventDefault();
          var wrap = toggleBtn.closest('.custom-section-7__variant-dropdown-wrap');
          var menu = wrap ? wrap.querySelector('[data-variant-menu]') : null;
          if (menu) {
            menu.classList.toggle('is-open');
          }
          return;
        }

        // Close dropdown if clicked outside
        if (!e.target.closest('.custom-section-7__variant-dropdown-wrap')) {
          section.querySelectorAll('.custom-section-7__variant-menu.is-open').forEach(function (m) {
            m.classList.remove('is-open');
          });
        }

        // Add to cart click
        var atcBtn = e.target.closest('[data-add-to-cart]');
        var variantOption = e.target.closest('[data-variant-id]');
        var variantId = null;

        if (atcBtn) {
          variantId = atcBtn.dataset.addToCart;
        } else if (variantOption) {
          variantId = variantOption.dataset.variantId;
          var menu = variantOption.closest('.custom-section-7__variant-menu');
          if (menu) menu.classList.remove('is-open');
        }

        if (variantId) {
          e.preventDefault();
          var btn = atcBtn || variantOption;
          var originalText = btn.innerHTML;
          btn.style.opacity = '0.7';

          fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({ id: variantId, quantity: 1 })
          })
          .then(function (res) { return res.json(); })
          .then(function (cartItem) {
            btn.style.opacity = '1';
            // Trigger cart drawer if available
            document.documentElement.dispatchEvent(new CustomEvent('cart:item-added', { bubbles: true, detail: { item: cartItem } }));
            document.dispatchEvent(new CustomEvent('cart:updated'));
            if (window.MinimogTheme && window.MinimogTheme.Cart) {
              window.MinimogTheme.Cart.getCart();
            }
          })
          .catch(function (err) {
            console.error('Cart add error:', err);
            btn.style.opacity = '1';
          });
        }
      });

      setTimeout(updateArrows, 100);
      updateArrows();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSection7);
    } else {
      initSection7();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target.id === 'shopify-section-{{ section.id }}' || e.target.querySelector('#custom-section-7-{{ section.id }}')) {
        initSection7();
      }
    });
  })();
</script>

