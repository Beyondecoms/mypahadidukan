{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'section-header.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .header-wrapper {
    background: {{ section.settings.bg_color }};
  }
{%- endstyle -%}
{%- render 'header-mobile' -%}
<div class="header-wrapper" data-section-id="{{ section.id }}" data-section-type="header-section">

  <!-- ── LOGO: now sits outside the flex row so it can overlap both rows ── -->
  <div class="header-logo">
    <a href="{{ routes.root_url }}" class="logo-link">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 200 }}"
          alt="{{ shop.name }}"
          width="{{ section.settings.logo_width }}"
          height="auto"
          loading="eager"
        >
      {%- else -%}
        <span class="logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>
  </div>

  <!-- ── TOP ROW: Nav | Icons ── -->
  <div class="header-top-row">
    <div class="header-container">

      <!-- ── BOTTOM ROW: Nav ── -->
      <div class="header-bottom-row">
        <div class="header-container">

          <nav class="header-nav" role="navigation" aria-label="Main menu">
            <ul class="nav-list">
              {%- for link in section.settings.menu.links -%}
                {%- assign has_children = false -%}
                {%- if link.links != blank -%}
                  {%- assign has_children = true -%}
                {%- endif -%}

                <li class="nav-item {% if has_children %}has-children{% endif %}">
                  <a
                    href="{{ link.url }}"
                    class="nav-link {% if link.title == section.settings.highlight_nav_item %}nav-highlight{% endif %}"
                    {% if has_children %}aria-haspopup="true" aria-expanded="false"{% endif %}
                  >
                    {{ link.title }}
                    {%- if has_children -%}
                      <svg class="nav-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="6 9 12 15 18 9"/>
                      </svg>
                    {%- endif -%}
                  </a>

                  {%- if has_children -%}
                    <ul class="dropdown-menu">
                      {%- for childlink in link.links -%}
                        {%- assign child_has_children = false -%}
                        {%- if childlink.links != blank -%}
                          {%- assign child_has_children = true -%}
                        {%- endif -%}
                        <li class="dropdown-item {% if child_has_children %}has-children{% endif %}">
                          <a href="{{ childlink.url }}" class="dropdown-link">
                            {{ childlink.title }}
                            {%- if child_has_children -%}
                              <svg class="dropdown-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <polyline points="9 6 15 12 9 18"/>
                              </svg>
                            {%- endif -%}
                          </a>
                          {%- if child_has_children -%}
                            <ul class="sub-dropdown-menu">
                              {%- for grandchild in childlink.links -%}
                                <li>
                                  <a href="{{ grandchild.url }}" class="sub-dropdown-link">{{ grandchild.title }}</a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </nav>

        </div>
      </div>

      <!-- Icons: Wishlist | Search toggle (scroll only) | Account | Cart -->
      <div class="header-icons">
        <!-- Wishlist -->
        <a href="#swym-wishlist" class="header-icon" aria-label="Wishlist">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </a>

        <!-- NEW: Small search toggle button, shown only after scroll -->
        <button
          type="button"
          class="header-icon header-search-toggle"
          id="headerSearchToggle-{{ section.id }}"
          aria-label="Toggle search"
        >
          <svg width="20" height="20" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M13.125 13.125L16.5 16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M15 8.25C15 4.52208 11.9779 1.5 8.25 1.5C4.52208 1.5 1.5 4.52208 1.5 8.25C1.5 11.9779 4.52208 15 8.25 15C11.9779 15 15 11.9779 15 8.25Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
        </button>

        <!-- Account -->
        <a href="{{ routes.account_url }}" class="header-icon" aria-label="Account">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </a>

        <!-- Cart -->
        <a href="{{ routes.cart_url }}" class="header-icon cart-icon" aria-label="Cart">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="cart-count" id="header-cart-count">{{ cart.item_count }}</span>
          {%- else -%}
            <span class="cart-count" id="header-cart-count" style="display:none;">0</span>
          {%- endif -%}
        </a>
      </div>
    </div>

    <div class="header-search">
      <form action="{{ routes.search_url }}" method="get" role="search">
        <div class="search-input-wrap">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M13.125 13.125L16.5 16.5" stroke="#323232" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M15 8.25C15 4.52208 11.9779 1.5 8.25 1.5C4.52208 1.5 1.5 4.52208 1.5 8.25C1.5 11.9779 4.52208 15 8.25 15C11.9779 15 15 11.9779 15 8.25Z" stroke="#323232" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
          <input
            type="search"
            name="q"
            placeholder=""
            class="search-input"
            aria-label="Search"
            autocomplete="off"
            id="headerSearchInput-{{ section.id }}"
          >
          <div class="search-rotating-placeholder" id="searchRotatingPlaceholder-{{ section.id }}" aria-hidden="true">
              <span class="srp-static">Search for&nbsp;</span>
              <span class="srp-word-wrap">
                {%- assign words = section.settings.rotating_words | split: ',' -%}
                {%- for word in words -%}
                  <span class="srp-word">{{ word | strip }}</span>
                {%- endfor -%}
              </span>
            </div>
          </div>
      </form>
      <div class="search-suggestions" id="headerSearchSuggestions-{{ section.id }}"></div>
    </div>
  </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  /* ── Click-to-open dropdowns (replaces hover) ── */
  document.querySelectorAll('.nav-item.has-children').forEach(function (item) {
    var trigger = item.querySelector(':scope > .nav-link');
    if (!trigger) return;

    trigger.addEventListener('click', function (e) {
      e.preventDefault(); // stop navigation, toggle dropdown instead
      var isOpen = item.classList.contains('open');

      // close any other open dropdowns
      document.querySelectorAll('.nav-item.open').forEach(function (openItem) {
        if (openItem !== item) openItem.classList.remove('open');
      });

      item.classList.toggle('open', !isOpen);
    });
  });

  // close when clicking outside any nav item
  document.addEventListener('click', function (e) {
    if (!e.target.closest('.nav-item')) {
      document.querySelectorAll('.nav-item.open').forEach(function (item) {
        item.classList.remove('open');
      });
    }
  });

  // close on Escape
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('.nav-item.open').forEach(function (item) {
        item.classList.remove('open');
      });
    }
  });
  /* ── Cart drawer ── */
  var cartIcon = document.querySelector('.cart-icon');
  if (cartIcon) {
    cartIcon.addEventListener('click', function (e) {
      e.preventDefault();
      document.dispatchEvent(new CustomEvent('cart:open'));
      var cartDrawer = document.querySelector('cart-drawer');
      if (cartDrawer) { cartDrawer.open(); return; }
      var themeCartBtn = document.querySelector('[data-cart-icon-bubble], #cart-icon-bubble');
      if (themeCartBtn) themeCartBtn.click();
    });
  }

  /* ── Predictive search ── */
  var searchInput = document.getElementById('headerSearchInput-{{ section.id }}');
  var suggestionsBox = document.getElementById('headerSearchSuggestions-{{ section.id }}');
  if (!searchInput || !suggestionsBox) return;

  var rotatingBox = document.getElementById('searchRotatingPlaceholder-{{ section.id }}');
  var wordEls = rotatingBox ? rotatingBox.querySelectorAll('.srp-word') : [];

  if (rotatingBox && wordEls.length >= 0) {
    var wordIndex = 0;
    wordEls.forEach(function(el, i) { el.classList.toggle('active', i === 0); });

    function rotateWord() {
      var current = wordEls[wordIndex];
      var nextIndex = (wordIndex + 1) % wordEls.length;
      var next = wordEls[nextIndex];

      current.classList.remove('active');
      current.classList.add('exit');
      next.classList.add('active');

      setTimeout(function() {
        current.classList.remove('exit');
      }, 400);

      wordIndex = nextIndex;
    }

    var rotateTimer = setInterval(rotateWord, 2200);

    function toggleRotatingVisibility() {
      var hasValue = searchInput.value.length > 0;
      rotatingBox.style.opacity = hasValue ? '0' : '1';
    }

    searchInput.addEventListener('input', toggleRotatingVisibility);
    searchInput.addEventListener('focus', toggleRotatingVisibility);
    searchInput.addEventListener('blur', toggleRotatingVisibility);
  }

  var debounceTimer;
  var currentQuery = '';

  function renderSuggestions(results) {
    suggestionsBox.innerHTML = '';
    if (!results || results.length === 0) {
      suggestionsBox.innerHTML = '<div class="search-no-results">No results found</div>';
      suggestionsBox.classList.add('open');
      return;
    }
    results.forEach(function(item) {
      var a = document.createElement('a');
      a.className = 'search-suggestion-item';
      a.href = item.url;

      var imgHtml = item.featured_image && item.featured_image.url
        ? '<img class="search-suggestion-img" src="' + item.featured_image.url + '" alt="' + item.title + '">'
        : '<div class="search-suggestion-img-placeholder"></div>';

      a.innerHTML = imgHtml +
        '<span class="search-suggestion-title">' + item.title + '</span>';

      suggestionsBox.appendChild(a);
    });
    suggestionsBox.classList.add('open');
  }

  function fetchSuggestions(query) {
    if (query.length < 1) {
      suggestionsBox.classList.remove('open');
      return;
    }
    fetch('/search/suggest.json?q=' + encodeURIComponent(query) + '&resources[type]=product&resources[limit]=6&resources[options][unavailable_products]=last&resources[options][fields]=title,product_type,variants.title')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        var products = data.resources && data.resources.results && data.resources.results.products;
        renderSuggestions(products || []);
      })
      .catch(function() {
        suggestionsBox.classList.remove('open');
      });
  }

  searchInput.addEventListener('input', function() {
    currentQuery = this.value.trim();
    clearTimeout(debounceTimer);
    if (currentQuery.length < 1) {
      suggestionsBox.classList.remove('open');
      return;
    }
    debounceTimer = setTimeout(function() {
      fetchSuggestions(currentQuery);
    }, 250);
  });

  searchInput.addEventListener('focus', function() {
    if (currentQuery.length >= 1) suggestionsBox.classList.add('open');
  });

  document.addEventListener('click', function(e) {
    if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
      suggestionsBox.classList.remove('open');
    }
  });

  searchInput.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') suggestionsBox.classList.remove('open');
  });

  /* ── NEW: Scroll behavior — shrink logo, hide search, show toggle ── */
  var headerWrapperEl = document.querySelector('.header-wrapper');
  var headermb=document.querySelector('.mob-header');
  var searchToggleBtn = document.getElementById('headerSearchToggle-{{ section.id }}');
  var SCROLL_THRESHOLD = 80; // px — change this to trigger sooner/later

  function handleHeaderScroll() {
    if (window.scrollY > SCROLL_THRESHOLD) {
      headerWrapperEl.classList.add('is-scrolled');
      document.body.classList.add('header-is-scrolled');
      headermb.classList.add('header-is-top');
      headerWrapperEl.classList.remove('is-top');
    } else {
      headerWrapperEl.classList.remove('is-scrolled');
      headerWrapperEl.classList.remove('search-open');
      document.body.classList.remove('header-is-scrolled');
      headermb.classList.remove('header-is-top');
    }
  }
  window.addEventListener('scroll', handleHeaderScroll, { passive: true });
  handleHeaderScroll();

  if (searchToggleBtn) {
    searchToggleBtn.addEventListener('click', function () {
      headerWrapperEl.classList.remove('is-scrolled');
      headerWrapperEl.classList.add('is-top');
      headerWrapperEl.classList.remove('search-open');
    });
  }

});
</script>
{% schema %}
{
  "name": "Header",
  "tag": "header",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    {"type": "url","id": "track_order_url","label": "Track Link URL"},
    { "type": "textarea", "id": "rotating_words", "label": "Rotating search words", "default": "gift, kapiva, flower" },
    { "type": "range", "id": "logo_width", "min": 50, "max": 300, "step": 10, "unit": "px", "label": "Logo width", "default": 120 },
    { "type": "link_list", "id": "menu", "label": "Navigation menu", "default": "main-menu" },
    { "type": "select", "id": "menu_type_desktop", "label": "Desktop menu type", "options": [ { "value": "dropdown", "label": "Dropdown" }, { "value": "mega", "label": "Mega menu" }, { "value": "drawer", "label": "Drawer" } ], "default": "dropdown" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search for gift" },
    { "type": "url", "id": "wishlist_url", "label": "Wishlist page URL" },
    { "type": "checkbox", "id": "show_currency", "label": "Show currency selector", "default": true },
    { "type": "color", "id": "bg_color", "label": "Header background", "default": "#f5f0e0" },
    { "type": "color", "id": "nav_text_color", "label": "Nav text color", "default": "#2d2d2d" },
    { "type": "color", "id": "nav_hover_color", "label": "Nav hover color", "default": "#1a6b4a" },
    { "type": "color", "id": "highlight_bg_color", "label": "Highlight pill background", "default": "#1a6b4a" },
    { "type": "color", "id": "highlight_text_color", "label": "Highlight pill text color", "default": "#ffffff" }
  ],
  "presets": [ { "name": "Header" } ]
}
{% endschema %}
