{{ 'section-seabuckthorn-m4.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign m4_heading = product.metafields.custom.m4_section_heading.value
  assign m4_card_titles = product.metafields.custom.m4_card_titles.value
  assign m4_card_descriptions = product.metafields.custom.m4_card_1_description.value
  assign m4_bottom_statement = product.metafields.custom.m4_bottom_statement.value

  assign marquee_text = m4_bottom_statement | join: ' · '

  assign has_cards = false
  if m4_card_titles != blank or m4_card_descriptions != blank
    assign has_cards = true
  endif

  assign has_content = false
  if m4_heading != blank or has_cards or marquee_text != blank
    assign has_content = true
  endif
-%}

{%- if has_content -%}
<div class="sb-m4-section" style="{% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}">
  <div class="sb-m4-container">

    <!-- Header Section -->
    {%- if m4_heading != blank -%}
      <div class="sb-m4-header">
        <h2 class="sb-m4-title" style="color: {{ section.settings.heading_color }};">{{ m4_heading }}</h2>
      </div>
    {%- endif -%}

    <!-- Postcard Carousel / Grid Cards -->
    {%- if has_cards -%}
      <div class="sb-m4-cards-wrapper">
        {%- for i in (0..4) -%}
          {%- assign card_title = m4_card_titles[i] -%}
          {%- assign card_desc = m4_card_descriptions[i] -%}
          {%- if card_title != blank or card_desc != blank -%}
            <div class="sb-m4-card" style="background-color: {{ section.settings.card_bg }}; color: {{ section.settings.card_text_color }};">
              <div class="sb-m4-card-header">
                <span class="sb-m4-cross">✕</span>
                {%- if card_title != blank -%}
                  <h3 class="sb-m4-card-title">{{ card_title }}</h3>
                {%- endif -%}
              </div>
              {%- if card_desc != blank -%}
                <div class="sb-m4-card-body">
                  <p>{{ card_desc | newline_to_br }}</p>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Marquee Ticker Banner -->
    {%- if marquee_text != blank -%}
      <div class="sb-m4-marquee-outer" style="background-color: {{ section.settings.marquee_bg }}; color: {{ section.settings.marquee_text_color }};">
        <div class="sb-m4-marquee-track">
          {%- for i in (1..4) -%}
            <div class="sb-m4-marquee-item">
              <span>{{ marquee_text }}</span>
              <span class="sb-m4-marquee-dot">•</span>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "M4 - What's not in bottle",
  "tag": "section",
  "class": "section-sb-m4",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fffbef"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1c1918"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Text Color",
      "default": "#1c1918"
    },
    {
      "type": "color",
      "id": "marquee_bg",
      "label": "Marquee BG Color",
      "default": "#008b75"
    },
    {
      "type": "color",
      "id": "marquee_text_color",
      "label": "Marquee Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Pill Badge BG",
      "default": "#008b75"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Pill Badge Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "M4 - What's not in bottle"
    }
  ]
}
{% endschema %}
