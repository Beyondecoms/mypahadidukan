{{ 'section-seabuckthorn-m2.css' | asset_url | stylesheet_tag }}

<div class="sb-m2-section" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <div class="sb-m2-container">
    
    <!-- Top Meta Row -->
    <div class="sb-m2-top-bar">
      <span class="sb-m2-module-badge">{{ section.settings.module_tag }}</span>
      {%- if section.settings.design_tag != blank -%}
        <span class="sb-m2-pill-badge" style="background-color: {{ section.settings.badge_bg }}; color: {{ section.settings.badge_color }};">{{ section.settings.design_tag }}</span>
      {%- endif -%}
    </div>

    <!-- Header Section -->
    <div class="sb-m2-header">
      <h2 class="sb-m2-title" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="sb-m2-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <!-- Main Content Box: Glass Diagram + Callouts + Parchment Card -->
    <div class="sb-m2-card-wrapper" style="background-color: {{ section.settings.card_wrapper_bg }}; border-color: {{ section.settings.card_border_color }};">
      <div class="sb-m2-grid">
        
        <!-- Glass Diagram Column -->
        <div class="sb-m2-diagram-col">
          <div class="sb-m2-glass-container">
            <div class="sb-m2-glass-rim"></div>
            <div class="sb-m2-glass-body">
              <!-- Liquid 99.99% -->
              <div class="sb-m2-liquid-pulp">
                <div class="sb-m2-pulp-texture"></div>
                <div class="sb-m2-liquid-sheen"></div>
              </div>
              <!-- Hairline sliver 0.01% -->
              <div class="sb-m2-sliver-layer"></div>
            </div>
          </div>
          <span class="sb-m2-glass-label">{{ section.settings.diagram_label }}</span>
        </div>

        <!-- Callouts & Bracket Connector Column -->
        <div class="sb-m2-callouts-col">
          
          <!-- Bracket Connector Wrapper -->
          <div class="sb-m2-bracket-container">
            <div class="sb-m2-bracket-graphic">
              <svg width="40" height="72" viewBox="0 0 40 72" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Top orange branch & spine -->
                <path d="M 6 56 L 6 16 L 28 16" stroke="#ee5922" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="32" cy="16" r="5" fill="#ee5922"/>
                
                <!-- Bottom teal branch -->
                <path d="M 6 56 L 28 56" stroke="#008b75" stroke-width="2.5" stroke-linecap="round"/>
                <circle cx="32" cy="56" r="5" fill="#008b75"/>
              </svg>
            </div>

            <div class="sb-m2-callout-items">
              <!-- Callout 1: 99.99% -->
              <div class="sb-m2-callout sb-m2-callout-berries">
                <div class="sb-m2-callout-text">
                  <span class="sb-m2-ingredient-name">{{ section.settings.ingredient_1_name }}</span>
                  <span class="sb-m2-dot">·</span>
                  <span class="sb-m2-percentage">{{ section.settings.ingredient_1_pct }}</span>
                </div>
              </div>

              <!-- Callout 2: 0.01% -->
              <div class="sb-m2-callout sb-m2-callout-preservative">
                <div class="sb-m2-callout-text">
                  <span class="sb-m2-prefix">{{ section.settings.ingredient_2_prefix }}</span>
                  <span class="sb-m2-percentage-highlight">{{ section.settings.ingredient_2_pct }}</span>
                  <span class="sb-m2-suffix">{{ section.settings.ingredient_2_suffix }}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Parchment Note Card -->
          <div class="sb-m2-parchment-card" style="background-color: {{ section.settings.parchment_bg }}; color: {{ section.settings.parchment_text_color }};">
            <div class="sb-m2-parchment-stamp">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2"/>
                <path d="M12 7V17M7 12H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <h3 class="sb-m2-parchment-title">{{ section.settings.parchment_title }}</h3>
            <div class="sb-m2-parchment-body">
              <p>{{ section.settings.parchment_para1 }}</p>
              <p>{{ section.settings.parchment_para2 }}</p>
              <p>{{ section.settings.parchment_para3 }}</p>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "M2 - What's in bottle",
  "tag": "section",
  "class": "section-sb-m2",
  "settings": [
    {
      "type": "text",
      "id": "module_tag",
      "label": "Module Tag",
      "default": "M2 · What's in my bottle"
    },
    {
      "type": "text",
      "id": "design_tag",
      "label": "Design Badge",
      "default": "design-led"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHAT'S IN MY BOTTLE"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "One ingredient. This won't take long."
    },
    {
      "type": "text",
      "id": "diagram_label",
      "label": "Diagram Label",
      "default": "glass diagram"
    },
    {
      "type": "text",
      "id": "ingredient_1_name",
      "label": "Ingredient 1 Name",
      "default": "WILD SEA BUCKTHORN BERRIES"
    },
    {
      "type": "text",
      "id": "ingredient_1_pct",
      "label": "Ingredient 1 Percentage",
      "default": "99.99%"
    },
    {
      "type": "text",
      "id": "ingredient_2_prefix",
      "label": "Ingredient 2 Prefix",
      "default": "and this bit —"
    },
    {
      "type": "text",
      "id": "ingredient_2_pct",
      "label": "Ingredient 2 Percentage",
      "default": "0.01%"
    },
    {
      "type": "text",
      "id": "ingredient_2_suffix",
      "label": "Ingredient 2 Suffix",
      "default": "— is E211"
    },
    {
      "type": "text",
      "id": "parchment_title",
      "label": "Parchment Card Title",
      "default": "About that 0.01%"
    },
    {
      "type": "textarea",
      "id": "parchment_para1",
      "label": "Parchment Paragraph 1",
      "default": "Pressed berry with nothing added to it spoils in about a week. E211 is a permitted preservative, it's in there at one part in ten thousand, and it's the reason this bottle can reach Chennai instead of only Leh."
    },
    {
      "type": "textarea",
      "id": "parchment_para2",
      "label": "Parchment Paragraph 2",
      "default": "We could have rounded up and called it 100% pure. Plenty of bottles on the internet do."
    },
    {
      "type": "textarea",
      "id": "parchment_para3",
      "label": "Parchment Paragraph 3",
      "default": "We'd rather you knew what the hundredth of a percent was."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fffbef"
    },
    {
      "type": "color",
      "id": "card_wrapper_bg",
      "label": "Card Wrapper BG",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#e7ded0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1c1918"
    },
    {
      "type": "color",
      "id": "parchment_bg",
      "label": "Parchment Card BG",
      "default": "#fffbef"
    },
    {
      "type": "color",
      "id": "parchment_text_color",
      "label": "Parchment Text Color",
      "default": "#1c1918"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Pill Badge BG",
      "default": "#008b75"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Pill Badge Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "M2 - What's in bottle"
    }
  ]
}
{% endschema %}
