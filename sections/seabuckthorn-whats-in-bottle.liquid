{{ 'section-seabuckthorn-m2.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign m2_heading = product.metafields.custom.m2_section_heading.value
  assign m2_subtitle = product.metafields.custom.m2_subtitle.value
  assign m2_image = product.metafields.custom.m2_product_image.value | default: product.metafields.custom.m2_product_image
  assign m2_main_ing = product.metafields.custom.m2_main_ingredient.value
  assign m2_main_pct = product.metafields.custom.m2_main_percentage.value
  assign m2_secondary_ing = product.metafields.custom.m2_secondary_ingredient.value
  assign m2_secondary_pct = product.metafields.custom.m2_secondary_percentage.value
  assign m2_about_heading = product.metafields.custom.m2_about_heading.value
  assign m2_about_desc = product.metafields.custom.m2_about_description.value
  assign m2_add_desc = product.metafields.custom.m2_additional_description.value
  assign m2_highlight = product.metafields.custom.m2_highlighted_statement.value
  assign m2_image_alt = m2_image.alt | default: m2_heading | default: product.title | escape

  assign has_callout_1 = false
  if m2_main_ing != blank or m2_main_pct != blank
    assign has_callout_1 = true
  endif

  assign has_callout_2 = false
  if m2_secondary_ing != blank or m2_secondary_pct != blank
    assign has_callout_2 = true
  endif

  assign has_parchment = false
  if m2_about_heading != blank or m2_about_desc != blank or m2_add_desc != blank or m2_highlight != blank
    assign has_parchment = true
  endif

  assign has_content = false
  if m2_heading != blank or m2_subtitle != blank or m2_image != blank or has_callout_1 or has_callout_2 or has_parchment
    assign has_content = true
  endif
-%}

{%- if has_content -%}
<div class="sb-m2-section" style="{% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}{% if section.settings.text_color != blank %} color: {{ section.settings.text_color }};{% endif %}">
  <div class="sb-m2-container">
    
    <!-- Top Meta Row -->
    {%- if section.settings.module_tag != blank or section.settings.design_tag != blank -%}
      <div class="sb-m2-top-bar">
        {%- if section.settings.module_tag != blank -%}
          <span class="sb-m2-module-badge">{{ section.settings.module_tag }}</span>
        {%- endif -%}
        {%- if section.settings.design_tag != blank -%}
          <span class="sb-m2-pill-badge" style="background-color: {{ section.settings.badge_bg }}; color: {{ section.settings.badge_color }};">{{ section.settings.design_tag }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Header Section -->
    {%- if m2_heading != blank or m2_subtitle != blank -%}
      <div class="sb-m2-header">
        {%- if m2_heading != blank -%}
          <h2 class="sb-m2-title" style="color: {{ section.settings.heading_color }};">{{ m2_heading }}</h2>
        {%- endif -%}
        {%- if m2_subtitle != blank -%}
          <p class="sb-m2-subtitle">{{ m2_subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Main Content Box: Product Image + Callouts + Parchment Card -->
    {%- if m2_image != blank or has_callout_1 or has_callout_2 or has_parchment -%}
      <div class="sb-m2-card-wrapper" style="background-color: {{ section.settings.card_wrapper_bg }}; border-color: {{ section.settings.card_border_color }};">
        <div class="sb-m2-grid{% if m2_image == blank %} sb-m2-grid--no-image{% endif %}">
          
          <!-- Product Image Column -->
          {%- if m2_image != blank -%}
            <div class="sb-m2-diagram-col">
              <div class="sb-m2-image-wrapper">
                {{ m2_image | image_url: width: 600 | image_tag: 
                   loading: 'lazy', 
                   alt: m2_image_alt,
                   class: 'sb-m2-product-img',
                   widths: '160, 240, 320, 480, 600',
                   sizes: '(max-width: 749px) 160px, 240px'
                }}
              </div>
            </div>
          {%- endif -%}

          <!-- Callouts & Bracket Connector Column -->
          {%- if has_callout_1 or has_callout_2 or has_parchment -%}
            <div class="sb-m2-callouts-col">
              
              {%- if has_callout_1 or has_callout_2 -%}
                <!-- Bracket Connector Wrapper -->
                <div class="sb-m2-bracket-container">
                  {%- if has_callout_1 and has_callout_2 -%}
                    <div class="sb-m2-bracket-graphic">
                      <svg width="40" height="72" viewBox="0 0 40 72" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Top orange branch & spine -->
                        <path d="M 6 56 L 6 16 L 28 16" stroke="#ee5922" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <circle cx="32" cy="16" r="5" fill="#ee5922"/>
                        
                        <!-- Bottom teal branch -->
                        <path d="M 6 56 L 28 56" stroke="#008b75" stroke-width="2.5" stroke-linecap="round"/>
                        <circle cx="32" cy="56" r="5" fill="#008b75"/>
                      </svg>
                    </div>
                  {%- elsif has_callout_1 -%}
                    <div class="sb-m2-bracket-graphic">
                      <svg width="40" height="32" viewBox="0 0 40 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M 6 16 L 28 16" stroke="#ee5922" stroke-width="2.5" stroke-linecap="round"/>
                        <circle cx="32" cy="16" r="5" fill="#ee5922"/>
                      </svg>
                    </div>
                  {%- elsif has_callout_2 -%}
                    <div class="sb-m2-bracket-graphic">
                      <svg width="40" height="32" viewBox="0 0 40 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M 6 16 L 28 16" stroke="#008b75" stroke-width="2.5" stroke-linecap="round"/>
                        <circle cx="32" cy="16" r="5" fill="#008b75"/>
                      </svg>
                    </div>
                  {%- endif -%}

                  <div class="sb-m2-callout-items">
                    <!-- Callout 1: Main Ingredient -->
                    {%- if has_callout_1 -%}
                      <div class="sb-m2-callout sb-m2-callout-berries">
                        <div class="sb-m2-callout-text">
                          {%- if m2_main_ing != blank -%}
                            <span class="sb-m2-ingredient-name">{{ m2_main_ing }}</span>
                          {%- endif -%}
                          {%- if m2_main_ing != blank and m2_main_pct != blank -%}
                            <span class="sb-m2-dot">·</span>
                          {%- endif -%}
                          {%- if m2_main_pct != blank -%}
                            <span class="sb-m2-percentage">{{ m2_main_pct }}</span>
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endif -%}

                    <!-- Callout 2: Secondary Ingredient -->
                    {%- if has_callout_2 -%}
                      <div class="sb-m2-callout sb-m2-callout-preservative">
                        <div class="sb-m2-callout-text">
                          {%- if m2_secondary_pct != blank and m2_secondary_ing contains m2_secondary_pct -%}
                            {%- assign sec_parts = m2_secondary_ing | split: m2_secondary_pct -%}
                            <span class="sb-m2-prefix">{{ sec_parts[0] }}</span>
                            <span class="sb-m2-percentage-highlight">{{ m2_secondary_pct }}</span>
                            <span class="sb-m2-suffix">{{ sec_parts[1] }}</span>
                          {%- elsif m2_secondary_pct != blank and m2_secondary_ing contains '[percentage]' -%}
                            {%- assign sec_parts = m2_secondary_ing | split: '[percentage]' -%}
                            <span class="sb-m2-prefix">{{ sec_parts[0] }}</span>
                            <span class="sb-m2-percentage-highlight">{{ m2_secondary_pct }}</span>
                            <span class="sb-m2-suffix">{{ sec_parts[1] }}</span>
                          {%- elsif m2_secondary_pct != blank and m2_secondary_ing contains '[pct]' -%}
                            {%- assign sec_parts = m2_secondary_ing | split: '[pct]' -%}
                            <span class="sb-m2-prefix">{{ sec_parts[0] }}</span>
                            <span class="sb-m2-percentage-highlight">{{ m2_secondary_pct }}</span>
                            <span class="sb-m2-suffix">{{ sec_parts[1] }}</span>
                          {%- elsif m2_secondary_pct != blank and m2_secondary_ing contains ' — ' -%}
                            {%- assign sec_parts = m2_secondary_ing | split: ' — ' -%}
                            <span class="sb-m2-prefix">{{ sec_parts[0] }} —</span>
                            <span class="sb-m2-percentage-highlight">{{ m2_secondary_pct }}</span>
                            <span class="sb-m2-suffix">— {{ sec_parts[1] }}</span>
                          {%- elsif m2_secondary_pct != blank and m2_secondary_ing contains ' - ' -%}
                            {%- assign sec_parts = m2_secondary_ing | split: ' - ' -%}
                            <span class="sb-m2-prefix">{{ sec_parts[0] }} —</span>
                            <span class="sb-m2-percentage-highlight">{{ m2_secondary_pct }}</span>
                            <span class="sb-m2-suffix">— {{ sec_parts[1] }}</span>
                          {%- else -%}
                            {%- if m2_secondary_ing != blank -%}
                              <span class="sb-m2-prefix">{{ m2_secondary_ing }}</span>
                            {%- endif -%}
                            {%- if m2_secondary_ing != blank and m2_secondary_pct != blank -%}
                              <span class="sb-m2-dot">·</span>
                            {%- endif -%}
                            {%- if m2_secondary_pct != blank -%}
                              <span class="sb-m2-percentage-highlight">{{ m2_secondary_pct }}</span>
                            {%- endif -%}
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}

              <!-- Parchment Note Card -->
              {%- if has_parchment -%}
                <div class="sb-m2-parchment-card" style="background-color: {{ section.settings.parchment_bg }}; color: {{ section.settings.parchment_text_color }};">
                  <div class="sb-m2-parchment-stamp">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2"/>
                      <path d="M12 7V17M7 12H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  </div>
                  {%- if m2_about_heading != blank -%}
                    <h3 class="sb-m2-parchment-title">{{ m2_about_heading }}</h3>
                  {%- endif -%}
                  {%- if m2_about_desc != blank or m2_add_desc != blank or m2_highlight != blank -%}
                    <div class="sb-m2-parchment-body">
                      {%- if m2_about_desc != blank -%}
                        <p>{{ m2_about_desc | newline_to_br }}</p>
                      {%- endif -%}
                      {%- if m2_add_desc != blank -%}
                        <p>{{ m2_add_desc | newline_to_br }}</p>
                      {%- endif -%}
                      {%- if m2_highlight != blank -%}
                        <p class="sb-m2-parchment-highlight">{{ m2_highlight | newline_to_br }}</p>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

            </div>
          {%- endif -%}

        </div>
      </div>
    {%- endif -%}

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "M2 - What's in bottle",
  "tag": "section",
  "class": "section-sb-m2",
  "settings": [
    {
      "type": "text",
      "id": "module_tag",
      "label": "Module Tag",
      "default": "M2 · What's in my bottle"
    },
    {
      "type": "text",
      "id": "design_tag",
      "label": "Design Badge",
      "default": "design-led"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fffbef"
    },
    {
      "type": "color",
      "id": "card_wrapper_bg",
      "label": "Card Wrapper BG",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#e7ded0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1c1918"
    },
    {
      "type": "color",
      "id": "parchment_bg",
      "label": "Parchment Card BG",
      "default": "#fffbef"
    },
    {
      "type": "color",
      "id": "parchment_text_color",
      "label": "Parchment Text Color",
      "default": "#1c1918"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Pill Badge BG",
      "default": "#008b75"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Pill Badge Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "M2 - What's in bottle"
    }
  ]
}
{% endschema %}
