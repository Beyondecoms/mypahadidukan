{{ 'section-product-slider.css' | asset_url | stylesheet_tag }}

<div
  id="ps-section-{{ section.id }}"
  class="ps-section"
  data-product-id="{{ product.id }}"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&limit={{ section.settings.products_to_show }}&product_id={{ product.id }}"
  style=" {% if section.settings.bg_image != blank %}
          background-image: url({{ section.settings.bg_image | image_url: width: 2000 }});
          background-size: cover;
          background-position: center;
          background-repeat: no-repeat;
        {% else %}
          background: {{ section.settings.bg_color }};
        {% endif %}">

  <!-- Corner Decorations -->
  {%- if section.settings.corner_tr != blank -%}
    <img src="{{ section.settings.corner_tr | image_url: width: 120 }}" class="ps-corner ps-corner--tr" alt="">
  {%- endif -%}
  {%- if section.settings.corner_br != blank -%}
    <img src="{{ section.settings.corner_br | image_url: width: 120 }}" class="ps-corner ps-corner--br" alt="">
  {%- endif -%}
  {%- if section.settings.corner_tl != blank -%}
    <img src="{{ section.settings.corner_tl | image_url: width: 120 }}" class="ps-corner ps-corner--tl" alt="">
  {%- endif -%}
  {%- if section.settings.corner_bl != blank -%}
    <img src="{{ section.settings.corner_bl | image_url: width: 120 }}" class="ps-corner ps-corner--bl" alt="">
  {%- endif -%}

  <div class="ps-wrapper">

    <h2 class="ps-title">{{ section.settings.title }}</h2>

    {%- comment -%}
      Mirrors the native "related-products" section's data source:
      Shopify's own recommendations.performed / recommendations.products,
      populated via routes.product_recommendations_url (no manual intent
      param, no guessing). Falls back to a chosen collection only if
      Shopify genuinely has nothing for this product yet.
    {%- endcomment -%}
    {%- assign ps_products = recommendations.products -%}
    {%- assign ps_has_products = false -%}
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      {%- assign ps_has_products = true -%}
    {%- elsif section.settings.fallback_collection != blank and collections[section.settings.fallback_collection].products.size > 0 -%}
      {%- assign ps_products = collections[section.settings.fallback_collection].products -%}
      {%- assign ps_has_products = true -%}
    {%- endif -%}
    <div class="ps-content" data-has-products="{{ ps_has_products }}">
      {%- if ps_has_products -%}
        <div class="ps-slider-row">
          <button class="ps-arrow ps-arrow--prev" aria-label="Previous">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12.5 15L7.5 10L12.5 5" stroke="black" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="ps-slider">
            {%- for rec_product in ps_products limit: section.settings.products_to_show -%}
              <div class="ps-card">
               <button
                  type="button"
                  aria-label="Add to Wishlist"
                  class="swym-button swym-add-to-wishlist-view-product product_{{ rec_product.id }}"
                  data-with-epi="true"
                  data-swaction="addToWishlist"
                  data-product-id="{{ rec_product.id }}"
                  data-variant-id="{{ rec_product.selected_or_first_available_variant.id | default: rec_product.variants[0].id }}"
                  data-product-url="{{ shop.url | append: rec_product.url }}">
                </button>
                {%- if rec_product.metafields.custom.badge != blank -%}
                  <span class="ps-badge">{{ rec_product.metafields.custom.badge }}</span>
                {%- elsif forloop.index == 1 -%}
                  <span class="ps-badge ps-badge--recommended">Recommended</span>
                {%- elsif forloop.index == 3 -%}
                  <span class="ps-badge ps-badge--trending">Trending</span>
                {%- endif -%}

                {%- assign ps_first_image = rec_product.featured_image -%}
                {%- assign ps_second_image = rec_product.images[1] -%}

                <a href="{{ rec_product.url }}" class="ps-img-wrap{% if section.settings.show_secondary_image and ps_second_image %} ps-img-wrap--has-secondary{% endif %}">
                  <img
                    src="{{ ps_first_image | image_url: width: 400 }}"
                    alt="{{ rec_product.title | escape }}"
                    class="ps-img ps-img--primary">

                  {%- if section.settings.show_secondary_image and ps_second_image -%}
                    <img
                      src="{{ ps_second_image | image_url: width: 400 }}"
                      alt="{{ rec_product.title | escape }}"
                      class="ps-img ps-img--secondary"
                      loading="lazy">
                  {%- endif -%}
                </a>

                {%- if rec_product.compare_at_price > rec_product.price -%}
                  <div class="ps-discount-bar">
                    {{ section.settings.discount_text }}
                  </div>
                {%- endif -%}

                <div class="ps-info">
                  <a href="{{ rec_product.url }}" class="ps-product-title">{{ rec_product.title | truncate: 35 }}</a>
                  <p class="ps-variant">{{ rec_product.variants.first.title }}</p>
                  {%- assign ps_rating = rec_product.metafields.reviews.rating.value | default: 4.8 -%}
                  {%- assign ps_rating_float = ps_rating | append: '' | plus: 0.0 -%}
                  {%- assign ps_rating_int = ps_rating_float | floor -%}
                  {%- assign ps_rating_dec = ps_rating_float | minus: ps_rating_int -%}
                  {%- assign ps_partial_star = ps_rating_int | plus: 1 -%}
                  {%- assign ps_dec_width = ps_rating_dec | times: 100 | round -%}

                  <div class="ps-stars">
                    {%- for i in (1..5) -%}
                      {%- if i <= ps_rating_int -%}
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="#f59e0b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      {%- elsif i == ps_partial_star and ps_dec_width > 0 -%}
                        <span style="position:relative;display:inline-block;width:16px;height:16px;vertical-align:middle;">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="#d1d5db" style="position:absolute;left:0;top:0;display:block;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                          <span style="position:absolute;left:0;top:0;overflow:hidden;width:{{ ps_dec_width }}%;height:100%;display:block;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="#f59e0b" style="display:block;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                          </span>
                        </span>
                      {%- else -%}
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="#d1d5db" style="display:block;vertical-align:middle;"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      {%- endif -%}
                    {%- endfor -%}
                    <span class="ps-rating-score">{{ ps_rating_float | round: 1 }}</span>
                  </div>
                  <div class="ps-price-row">
                    {%- if rec_product.compare_at_price > rec_product.price -%}
                      <span class="ps-compare">₹{{ rec_product.compare_at_price | money_without_currency }}</span>
                    {%- endif -%}
                    <span class="ps-price">₹{{ rec_product.price | money_without_currency }}</span>

                    {%- if rec_product.compare_at_price > rec_product.price -%}
                      {%- assign discount = rec_product.compare_at_price | minus: rec_product.price | times: 100 | divided_by: rec_product.compare_at_price -%}
                      <span class="ps-off">{{ discount }}%off</span>
                    {%- endif -%}
                  </div>

                  {%- if rec_product.available -%}
                    <button class="ps-atc" data-variant-id="{{ rec_product.variants.first.id }}">
                      Add To Cart
                    </button>
                  {%- else -%}
                    <button class="ps-atc ps-atc--oos" disabled>
                      Out of Stock
                    </button>
                  {%- endif -%}
                </div>

              </div>
            {%- endfor -%}
          </div>

          <button class="ps-arrow ps-arrow--next" aria-label="Next">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7.5 15L12.5 10L7.5 5" stroke="black" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>

        <div class="ps-dots"></div>
      {%- else -%}
        {#- Shown only while waiting on the fetch, when no fallback collection is set (nothing to display synchronously yet) -#}
        <div class="ps-slider-row ps-slider-row--placeholder">
          <div class="ps-slider">
            {%- for i in (1..section.settings.products_to_show) -%}
              <div class="ps-card ps-card--skeleton">
                <div class="ps-skeleton-img"></div>
                <div class="ps-skeleton-line ps-skeleton-line--title"></div>
                <div class="ps-skeleton-line ps-skeleton-line--price"></div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

<style>
  #ps-section-{{ section.id }} .ps-card--skeleton { pointer-events: none; }
  #ps-section-{{ section.id }} .ps-skeleton-img,
  #ps-section-{{ section.id }} .ps-skeleton-line {
    background: linear-gradient(90deg, rgba(0,0,0,0.06) 25%, rgba(0,0,0,0.12) 37%, rgba(0,0,0,0.06) 63%);
    background-size: 400% 100%;
    animation: ps-skeleton-pulse 1.4s ease infinite;
    border-radius: 6px;
  }
  #ps-section-{{ section.id }} .ps-skeleton-img { width: 100%; aspect-ratio: 1 / 1; margin-bottom: 10px; }
  #ps-section-{{ section.id }} .ps-skeleton-line { height: 12px; margin-bottom: 8px; }
  #ps-section-{{ section.id }} .ps-skeleton-line--title { width: 80%; }
  #ps-section-{{ section.id }} .ps-skeleton-line--price { width: 40%; }
  @keyframes ps-skeleton-pulse {
    0% { background-position: 100% 50%; }
    100% { background-position: 0 50%; }
  }
</style>

<script>
(function () {
  const section = document.getElementById('ps-section-{{ section.id }}');
  if (!section) return;

  let slider, prevBtn, nextBtn, dotsContainer, cards;
  let current = 0;

  const visible = () => window.innerWidth < 600 ? 2 : window.innerWidth < 900 ? 4 : 5;

  function cardWidth() {
    return cards && cards[0] ? cards[0].offsetWidth + parseInt(getComputedStyle(slider).gap || 24) : 0;
  }

  function buildDots() {
    const count = Math.max(1, cards.length - visible() + 1);
    dotsContainer.innerHTML = '';

    for (let i = 0; i < count; i++) {
      const b = document.createElement('button');
      b.className = 'ps-dot' + (i === 0 ? ' active' : '');
      b.addEventListener('click', () => goTo(i));
      dotsContainer.appendChild(b);
    }
  }

  function updateArrows() {
    prevBtn.classList.toggle('disabled', current <= 0);
    nextBtn.classList.toggle('disabled', current >= cards.length - visible());
  }

  function goTo(i) {
    current = Math.max(0, Math.min(i, cards.length - visible()));
    slider.scrollTo({ left: current * cardWidth(), behavior: 'smooth' });

    dotsContainer.querySelectorAll('.ps-dot').forEach((d, idx) => {
      d.classList.toggle('active', idx === current);
    });

    updateArrows();
  }

  function bindAddToCart() {
    section.querySelectorAll('.ps-atc').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.variantId;
        btn.textContent = 'Adding...';
        btn.disabled = true;

        try {
          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              id,
              quantity: 1,
              sections: ['cart-drawer'],
              sections_url: window.location.pathname
            })
          });

          const addedItem = await response.json();

          if (addedItem.sections?.['cart-drawer']) {
            const html = new DOMParser().parseFromString(
              addedItem.sections['cart-drawer'], 'text/html'
            );

            const newBody = html.querySelector('#nc-body');
            const oldBody = document.querySelector('#nc-body');
            if (newBody && oldBody) oldBody.replaceWith(newBody);

            const newBreakdown = html.querySelector('.nc-price-breakdown');
            if (newBreakdown) {
              const oldBreakdown = document.querySelector('.nc-price-breakdown');
              if (oldBreakdown) {
                oldBreakdown.replaceWith(newBreakdown);
              } else {
                const footer = document.querySelector('.cart-drawer__footer');
                if (footer) footer.insertAdjacentElement('beforebegin', newBreakdown);
              }
            }

            const newFooter = html.querySelector('.cart-drawer__footer');
            const oldFooter = document.querySelector('.cart-drawer__footer');
            if (newFooter && oldFooter) oldFooter.replaceWith(newFooter);
          }

          var drawer = document.getElementById('nc-cart-drawer');
          if (drawer) {
            drawer.classList.add('is-open');
            drawer.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
          }

          const cartResponse = await fetch('/cart.js', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
          });
          const cartData = await cartResponse.json();

          if (typeof publish !== 'undefined' && typeof PUB_SUB_EVENTS !== 'undefined') {
            publish(PUB_SUB_EVENTS.cartUpdate, { source: 'cart-items', cartData: cartData });
          }

          if (typeof window.ncUpdatePriceBreakdown === 'function') {
            window.ncUpdatePriceBreakdown(cartData);
          }
        } catch (e) {
          console.error(e);
        } finally {
          btn.textContent = 'Add To Cart';
          btn.disabled = false;
        }
      });
    });
  }

  // (Re)binds slider controls. Called on first load and again after the
  // recommendations HTML is swapped in, since the old DOM (and its
  // listeners) is discarded.
  function initSlider() {
    slider = section.querySelector('.ps-slider');
    prevBtn = section.querySelector('.ps-arrow--prev');
    nextBtn = section.querySelector('.ps-arrow--next');
    dotsContainer = section.querySelector('.ps-dots');

    // Nothing to bind while the skeleton placeholder is showing.
    if (!slider || !prevBtn || !nextBtn || !dotsContainer) return;

    cards = slider.querySelectorAll('.ps-card');
    current = 0;

    prevBtn.addEventListener('click', () => goTo(current - 1));
    nextBtn.addEventListener('click', () => goTo(current + 1));

    slider.addEventListener('scroll', () => {
      const cw = cardWidth();
      if (!cw) return;
      current = Math.round(slider.scrollLeft / cw);
      dotsContainer.querySelectorAll('.ps-dot').forEach((d, i) => {
        d.classList.toggle('active', i === current);
      });
      updateArrows();
    });

    window.addEventListener('resize', () => {
      buildDots();
      updateArrows();
    });

    buildDots();
    updateArrows();
    bindAddToCart();
  }

  // Mirrors the native related-products section's approach: fetch from
  // the URL Shopify itself builds via routes.product_recommendations_url,
  // stored on the section as data-url. No manually guessed "intent" param.
  async function loadRecommendations() {
    const contentEl = section.querySelector('.ps-content');
    const hadInitialProducts = contentEl && contentEl.dataset.hasProducts === 'true';
    const productId = section.dataset.productId;
    const url = section.dataset.url;

    if (!productId || !url) {
      // Section isn't on a product page — nothing to recommend against.
      if (!hadInitialProducts) section.style.display = 'none';
      return;
    }

    try {
      const res = await fetch(url);
      if (!res.ok) throw new Error('Recommendations request failed: ' + res.status);

      const text = await res.text();
      const doc = new DOMParser().parseFromString(text, 'text/html');
      const newSection = doc.getElementById('ps-section-{{ section.id }}');
      const newContent = newSection ? newSection.querySelector('.ps-content') : null;
      const newHasProducts = newContent && newContent.dataset.hasProducts === 'true';

      if (newHasProducts) {
        // Real recommendations (or the fallback collection, rendered server-side) are ready — swap them in.
        contentEl.innerHTML = newContent.innerHTML;
        contentEl.dataset.hasProducts = 'true';
        initSlider();
      } else if (!hadInitialProducts) {
        // Genuinely nothing to show (no recommendations, no fallback collection configured).
        section.style.display = 'none';
      }
      // else: keep whatever fallback content was already rendered synchronously.
    } catch (e) {
      console.error('Product recommendations error:', e);
      if (!hadInitialProducts) section.style.display = 'none';
    }
  }

  initSlider(); // no-op unless something is already rendered (e.g. theme editor)
  loadRecommendations();
})();
</script>

{% schema %}
{
  "name": "Product Recommendations",
  "tag": "section",
  "class": "ps-section-outer",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "This section fetches recommendations for the product currently being viewed, using Shopify's built-in recommendation engine (same data source as the native 'Related products' section). It only works on a Product page."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section heading",
      "default": "You May Also Like"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback collection",
      "info": "Shown immediately, and kept if Shopify has no recommendations for this product (common for new stores/products with little order history)."
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Swap to second image on hover",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background Image (Mobile)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Number of products",
      "default": 8
    },
    {
      "type": "text",
      "id": "discount_text",
      "label": "Discount banner text",
      "default": "Extra 10% Discount at Checkout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#fdf6e3"
    },
    {
      "type": "image_picker",
      "id": "corner_tr",
      "label": "Top right decoration image"
    },
    {
      "type": "image_picker",
      "id": "corner_br",
      "label": "Bottom right decoration image"
    },
    {
      "type": "image_picker",
      "id": "corner_tl",
      "label": "Top left decoration image"
    },
    {
      "type": "image_picker",
      "id": "corner_bl",
      "label": "Bottom left decoration image"
    }
  ],
  "presets": [
    {
      "name": "Product Recommendations",
      "settings": {
        "title": "You May Also Like"
      }
    }
  ]
}
{% endschema %}
