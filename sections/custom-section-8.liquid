{%- liquid
  assign show_stars = section.settings.show_stars
  assign reviews_text = section.settings.reviews_text
  assign headline_text = section.settings.headline_text
  assign banner_bg = section.settings.banner_bg | default: '#B85338'
  assign banner_text_color = section.settings.banner_text_color | default: '#FFFFFF'
  assign banner_radius = section.settings.banner_radius | default: 20
  
  assign available_heading = section.settings.available_heading
  assign available_heading_color = section.settings.available_heading_color | default: '#1F2937'
  assign bg_color = section.settings.bg_color | default: '#FFFFFF'
  assign padding_top = section.settings.padding_top | default: 40
  assign padding_bottom = section.settings.padding_bottom | default: 48
-%}

<div
  id="custom-section-8-{{ section.id }}"
  class="custom-section-8"
  style="
    --cs8-bg: {{ bg_color }};
    --cs8-banner-bg: {{ banner_bg }};
    --cs8-banner-color: {{ banner_text_color }};
    --cs8-banner-radius: {{ banner_radius }}px;
    --cs8-avail-color: {{ available_heading_color }};
    --cs8-pt: {{ padding_top }}px;
    --cs8-pb: {{ padding_bottom }}px;
  "
>
  <div class="custom-section-8__container">
    {%- if show_stars or reviews_text != blank or headline_text != blank -%}
      <div class="custom-section-8__banner">
        {%- if show_stars -%}
          <div class="custom-section-8__stars">
            {%- for s in (1..5) -%}
              <svg class="custom-section-8__star" viewBox="0 0 20 20" fill="currentColor">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if reviews_text != blank -%}
          <p class="custom-section-8__reviews">{{ reviews_text }}</p>
        {%- endif -%}

        {%- if headline_text != blank -%}
          <h3 class="custom-section-8__headline">{{ headline_text }}</h3>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if available_heading != blank or section.blocks.size > 0 -%}
      <div class="custom-section-8__available-wrap">
        {%- if available_heading != blank -%}
          <h4 class="custom-section-8__available-heading">{{ available_heading }}</h4>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="custom-section-8__marketplaces">
            {%- for block in section.blocks -%}
              {%- liquid
                assign block_image = block.settings.image
                assign block_image_url = block.settings.image_url
                assign block_alt = block.settings.alt_text | default: 'Marketplace'
                assign block_link = block.settings.link
              -%}
              <div class="custom-section-8__marketplace-item" {{ block.shopify_attributes }}>
                {%- if block_link != blank -%}
                  <a href="{{ block_link }}" class="custom-section-8__marketplace-card" target="_blank" rel="noopener noreferrer" aria-label="{{ block_alt | escape }}">
                {%- else -%}
                  <div class="custom-section-8__marketplace-card">
                {%- endif -%}

                  {%- if block_image != blank -%}
                    {{
                      block_image
                      | image_url: width: 300
                      | image_tag:
                        loading: 'lazy',
                        class: 'custom-section-8__logo-img',
                        widths: '120, 180, 240, 300',
                        alt: block_alt
                    }}
                  {%- elsif block_image_url != blank -%}
                    <img
                      src="{{ block_image_url }}"
                      loading="lazy"
                      class="custom-section-8__logo-img"
                      alt="{{ block_alt | escape }}"
                      width="140"
                      height="36"
                    >
                  {%- else -%}
                    <span class="custom-section-8__logo-text">{{ block_alt }}</span>
                  {%- endif -%}

                {%- if block_link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  #custom-section-8-{{ section.id }} {
    background-color: var(--cs8-bg);
    padding-top: var(--cs8-pt);
    padding-bottom: var(--cs8-pb);
    width: 100%;
    position: relative;
    box-sizing: border-box;
    font-family: inherit;
  }

  @media only screen and (max-width: 749px){
    #custom-section-8-{{ section.id }} {
    padding-top: 20px;
    padding-bottom: 20px;
    }
  }


  #custom-section-8-{{ section.id }} * {
    box-sizing: border-box;
  }

  #custom-section-8-{{ section.id }} .custom-section-8__container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Top Banner */
  #custom-section-8-{{ section.id }} .custom-section-8__banner {
    background-color: var(--cs8-banner-bg);
    color: var(--cs8-banner-color);
    border-radius: var(--cs8-banner-radius);
    padding: 38px 24px 34px 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  #custom-section-8-{{ section.id }} .custom-section-8__stars {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    margin-bottom: 12px;
    color: #F59E0B;
  }

  #custom-section-8-{{ section.id }} .custom-section-8__star {
    width: 22px;
    height: 22px;
  }

  #custom-section-8-{{ section.id }} .custom-section-8__reviews {
    margin: 0 0 10px 0;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    opacity: 0.95;
  }

  #custom-section-8-{{ section.id }} .custom-section-8__headline {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.35;
    color: inherit;
    max-width: 800px;
    letter-spacing: -0.01em;
  }

  /* Available On Section */
  #custom-section-8-{{ section.id }} .custom-section-8__available-wrap {
    margin-top: 40px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #custom-section-8-{{ section.id }} .custom-section-8__available-heading {
    margin: 0 0 20px 0;
    font-size: 17px;
    font-weight: 700;
    color: var(--cs8-avail-color);
    line-height: 1.3;
  }

  #custom-section-8-{{ section.id }} .custom-section-8__marketplaces {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
    width: 100%;
  }

  #custom-section-8-{{ section.id }} .custom-section-8__marketplace-item {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #custom-section-8-{{ section.id }} .custom-section-8__marketplace-card {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #FFFFFF;
    border-radius: 14px;
    padding: 10px 16px;
    height: 60px;
    width: 154px;
    min-width: 154px;
    max-width: 154px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.07);
    border: 1px solid rgba(0, 0, 0, 0.04);
    text-decoration: none;
    color: inherit;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
    cursor: pointer;
    box-sizing: border-box;
    overflow: hidden;
  }

  #custom-section-8-{{ section.id }} .custom-section-8__marketplace-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  #custom-section-8-{{ section.id }} .custom-section-8__logo-img {
    width: 110px;
    height: 32px;
    max-width: 110px;
    max-height: 32px;
    object-fit: contain;
    object-position: center;
    display: block;
    margin: 0 auto;
  }

  #custom-section-8-{{ section.id }} .custom-section-8__logo-text {
    font-size: 14px;
    font-weight: 700;
    color: #1F2937;
    text-align: center;
  }

  @media (max-width: 767px) {
    #custom-section-8-{{ section.id }} .custom-section-8__container {
      padding: 0 14px;
    }

    #custom-section-8-{{ section.id }} .custom-section-8__banner {
      padding: 28px 16px 24px 16px;
      border-radius: calc(var(--cs8-banner-radius) * 0.8);
    }

    #custom-section-8-{{ section.id }} .custom-section-8__star {
      width: 18px;
      height: 18px;
    }

    #custom-section-8-{{ section.id }} .custom-section-8__reviews {
      font-size: 12px;
      margin-bottom: 8px;
    }

    #custom-section-8-{{ section.id }} .custom-section-8__headline {
      font-size: 16px;
    }

    #custom-section-8-{{ section.id }} .custom-section-8__available-wrap {
      margin-top: 28px;
    }

    #custom-section-8-{{ section.id }} .custom-section-8__available-heading {
      font-size: 15px;
      margin-bottom: 14px;
    }

    #custom-section-8-{{ section.id }} .custom-section-8__marketplaces {
      gap: 12px;
    }

    #custom-section-8-{{ section.id }} .custom-section-8__marketplace-card {
      padding: 8px 12px;
      height: 52px;
      width: 128px;
      min-width: 128px;
      max-width: 128px;
      border-radius: 12px;
    }

    #custom-section-8-{{ section.id }} .custom-section-8__logo-img {
      width: 90px;
      height: 26px;
      max-width: 90px;
      max-height: 26px;
    }
  }
</style>

{% schema %}
{
  "name": "Social Proof Marketplaces",
  "tag": "section",
  "class": "custom-section-8-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Top Banner (Social Proof)"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show 5 Star Rating",
      "default": true
    },
    {
      "type": "text",
      "id": "reviews_text",
      "label": "Reviews Subtitle",
      "default": "More than 1,00,00 5 star reviews"
    },
    {
      "type": "text",
      "id": "headline_text",
      "label": "Headline Text",
      "default": "More than 10 Lakh products sold, and just as many lives changed."
    },
    {
      "type": "color",
      "id": "banner_bg",
      "label": "Banner Background Color",
      "default": "#B85338"
    },
    {
      "type": "color",
      "id": "banner_text_color",
      "label": "Banner Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "banner_radius",
      "min": 8,
      "max": 36,
      "step": 2,
      "unit": "px",
      "label": "Banner Border Radius",
      "default": 20
    },
    {
      "type": "header",
      "content": "Marketplace Logos"
    },
    {
      "type": "text",
      "id": "available_heading",
      "label": "Marketplace Section Heading",
      "default": "Also available on:"
    },
    {
      "type": "color",
      "id": "available_heading_color",
      "label": "Marketplace Heading Color",
      "default": "#1F2937"
    },
    {
      "type": "header",
      "content": "Section Spacing & Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "marketplace",
      "name": "Marketplace Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Logo Image URL (optional)"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Marketplace Name / Alt Text",
          "default": "Marketplace"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Marketplace Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Proof & Marketplaces (Section 8)",
      "settings": {
        "show_stars": true,
        "reviews_text": "More than 1,00,00 5 star reviews",
        "headline_text": "More than 10 Lakh products sold, and just as many lives changed.",
        "banner_bg": "#B85338",
        "available_heading": "Also available on:"
      },
      "blocks": [
        {
          "type": "marketplace",
          "settings": {
            "image_url": "https://cdn.shopify.com/s/files/1/0746/0952/5042/files/amazon_logo.png?v=1721059703",
            "alt_text": "Amazon"
          }
        },
        {
          "type": "marketplace",
          "settings": {
            "image_url": "https://cdn.shopify.com/s/files/1/0746/0952/5042/files/48c3a84cedd2cc03dda46fc273a18f395f24d959.png?v=1788241897",
            "alt_text": "Flipkart"
          }
        },
        {
          "type": "marketplace",
          "settings": {
            "image_url": "https://cdn.shopify.com/s/files/1/0746/0952/5042/files/amazon_logo.png?v=1721059703",
            "alt_text": "Amazon"
          }
        }
      ]
    }
  ]
}
{% endschema %}
