{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Desktop background */
  .footer {
    background-color: {{ section.settings.bg_color }};
    {%- if section.settings.bg_image != blank -%}
      background-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    {%- endif -%}
  }

  /* Mobile background override */
  @media screen and (max-width: 749px) {
    .footer {
      {%- if section.settings.bg_image_mobile != blank -%}
        background-image: url('{{ section.settings.bg_image_mobile | image_url: width: 800 }}') !important;
        background-size: cover;
        background-position: center bottom;
        background-repeat: no-repeat;
      {%- elsif section.settings.bg_image != blank -%}
        background-image: url('{{ section.settings.bg_image | image_url: width: 800 }}');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
      {%- endif -%}
    }
  }
{%- endstyle -%}

<footer class="footer section-{{ section.id }}-padding" style="position: relative; overflow: hidden;">

  <!-- Overlay for readability -->
  <div class="footer__overlay" style="background: {{ section.settings.overlay_color }};"></div>

  <div class="footer__inner page-width">

    <!-- ── TOP ROW (Desktop) ── -->
    <div class="footer__top-row footer__top-row--desktop">

      <!-- LEFT: Logo + Description + Newsletter -->
      <div class="footer__col footer__col--brand">

        <!-- Logo -->
        <div class="footer__logo">
          {%- if section.settings.logo != blank -%}
            <img
              src="{{ section.settings.logo | image_url: width: 160 }}"
              alt="{{ shop.name }}"
              width="{{ section.settings.logo_width }}"
              height="auto"
              loading="lazy"
            >
          {%- else -%}
            <span class="footer__shop-name">{{ shop.name }}</span>
          {%- endif -%}
        </div>

        <!-- Description -->
        {%- if section.settings.brand_description != blank -%}
          <p class="footer__brand-desc">{{ section.settings.brand_description }}</p>
        {%- endif -%}

        {%- if section.settings.brand_disclaimer != blank -%}
          <p class="footer__brand-disclaimer">{{ section.settings.brand_disclaimer }}</p>
        {%- endif -%}

        <!-- Newsletter -->
        {%- if section.settings.newsletter_enable -%}
          <div class="footer__newsletter-wrap">
            {%- if section.settings.newsletter_heading != blank -%}
              <p class="footer__newsletter-heading">{{ section.settings.newsletter_heading }}</p>
            {%- endif -%}
            {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="footer__newsletter-field">
                <input
                  id="NewsletterForm--{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  placeholder="{{ section.settings.newsletter_placeholder | default: 'Example@gmail.com' }}"
                  aria-required="true"
                  autocomplete="email"
                  required
                >
                <button type="submit" aria-label="Subscribe">
                  <svg width="23" height="17" viewBox="0 0 23 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M20.442 8.0249H1.02499" stroke="white" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M13.1935 1.0249L21.025 8.44256L13.1935 15.8614" stroke="white" stroke-width="2.05" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
              {%- if form.posted_successfully? -%}
                <p class="footer__newsletter-success">✓ Thank you for subscribing!</p>
              {%- endif -%}
            {%- endform -%}
            {%- if section.settings.newsletter_subtext != blank -%}
              <p class="footer__newsletter-subtext">{{ section.settings.newsletter_subtext }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>

      <div>
        <!-- RIGHT: Nav Columns -->
        <div class="footer__col footer__col--nav">
          {%- for block in section.blocks -%}
            {%- if block.type == 'link_list' -%}
              <div class="footer__nav-col" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h3 class="footer__nav-heading">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="footer__nav-list">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a href="{{ link.url }}" class="footer__nav-link">{{ link.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <!-- Payment + Social on right side -->
        <div class="footer__nav-col footer__nav-col--icons">

          <!-- Payment Icons -->
          {%- if section.settings.payment_enable -%}
            <div class="footer__payment">
              <ul class="footer__payment-list">
                {%- for type in shop.enabled_payment_types -%}
                  <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <!-- Social Icons -->
          {%- liquid
            assign has_social = false
            if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_twitter_link != blank or settings.social_pinterest_link != blank or settings.social_tiktok_link != blank
              assign has_social = true
            endif
          -%}
          {%- if has_social -%}
            <div class="footer__social">
              <ul class="footer__social-list">
                {%- if settings.social_facebook_link != blank -%}
                  <li><a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook" class="footer__social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                  </a></li>
                {%- endif -%}
                {%- if settings.social_pinterest_link != blank -%}
                  <li><a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener" aria-label="Pinterest" class="footer__social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
                  </a></li>
                {%- endif -%}
                {%- if settings.social_instagram_link != blank -%}
                  <li><a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram" class="footer__social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                  </a></li>
                {%- endif -%}
                {%- if settings.social_youtube_link != blank -%}
                  <li><a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" aria-label="YouTube" class="footer__social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="white"/></svg>
                  </a></li>
                {%- endif -%}
                {%- if settings.social_twitter_link != blank -%}
                  <li><a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" aria-label="Twitter" class="footer__social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  </a></li>
                {%- endif -%}
                {%- if settings.social_tiktok_link != blank -%}
                  <li><a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok" class="footer__social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.75a8.16 8.16 0 0 0 4.78 1.52V6.82a4.85 4.85 0 0 1-1.01-.13z"/></svg>
                  </a></li>
                {%- endif -%}
                {%- if section.settings.social_linkedin != blank -%}
                  <li><a href="{{ section.settings.social_linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn" class="footer__social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                  </a></li>
                {%- endif -%}
                {%- if section.settings.social_email != blank -%}
                  <li><a href="mailto:{{ section.settings.social_email }}" aria-label="Email" class="footer__social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                  </a></li>
                {%- endif -%}
              </ul>
            </div>
          {%- endif -%}

        </div>
      </div>
    </div>
    {% render 'footer__mobile' %}
    <!-- ── BOTTOM ROW ── -->
    <div class="footer__bottom-row">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }} | All rights reserved.Made with 💖 by FarziEngineer
      </p>
      {%- if section.settings.show_policy -%}
        <ul class="footer__policies">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

  </div>
</footer>

<script>
  (function() {
    var triggers = document.querySelectorAll('.footer__accordion-trigger');
    triggers.forEach(function(trigger) {
      trigger.addEventListener('click', function() {
        var expanded = this.getAttribute('aria-expanded') === 'true';
        var bodyId = this.getAttribute('aria-controls');
        var body = document.getElementById(bodyId);

        // Close all others
        triggers.forEach(function(t) {
          t.setAttribute('aria-expanded', 'false');
          var id = t.getAttribute('aria-controls');
          var b = document.getElementById(id);
          if (b) b.hidden = true;
        });

        // Toggle current
        if (!expanded) {
          this.setAttribute('aria-expanded', 'true');
          if (body) body.hidden = false;
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Footer",
  "blocks": [
    {
      "type": "link_list",
      "name": "Navigation",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1a6b4a"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background image (Mobile)"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color (for readability)",
      "default": "rgba(0,0,0,0.35)"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "image_picker",
      "id": "logo_mobile",
      "label": "Footer logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 250,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 140
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description",
      "default": "Discover authentic products rooted in Pahadi culture."
    },
    {
      "type": "text",
      "id": "brand_disclaimer",
      "label": "Disclaimer text (small)",
      "default": "--The products listed on this website are not intended to diagnose, treat, cure, or prevent any disease.--"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Enable newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Get Our Exclusive Offers"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Input placeholder",
      "default": "Example@gmail.com"
    },
    {
      "type": "text",
      "id": "newsletter_subtext",
      "label": "Newsletter subtext",
      "default": "Get Exclusive Coupons in Your Mail Box"
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "url",
      "id": "social_linkedin",
      "label": "LinkedIn URL"
    },
    {
      "type": "text",
      "id": "social_email",
      "label": "Email address"
    },
    {
      "type": "header",
      "content": "Bottom"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 24
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_list", "settings": { "heading": "Quick Links" } },
      { "type": "link_list", "settings": { "heading": "Policies" } },
      { "type": "link_list", "settings": { "heading": "Company" } }
    ]
  }
}
{% endschema %}
