/* ============================================================
   Collection Offer Banner — slots into the product grid
   as a single card-sized item
   ============================================================ */
.m-collection-offer-banner {
  /* inherits m:w-6/12 md:m:w-4/12 from m-product-item — no width override needed */
}

.m-collection-offer-banner__link {
  display: flex;
  width: 100%;
  height: 100%;
  text-decoration: none;
  border-radius: 20px;       /* match product-card-4 border-radius */
  overflow: hidden;
  border: 1px solid #d1d1d1; /* match product-card-4 border */
  box-shadow: 0 0 1px 1px #f3f3f3;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  background: #ffffff;
}

.m-collection-offer-banner__link:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
}

/* Image wrapper — full width, natural height so image is never clipped */
.m-collection-offer-banner__img-wrap {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: stretch;
}

/* The actual <img> rendered by image_tag */
.m-collection-offer-banner__image {
  width: 100%;
  height: 100%;
  object-fit: contain;  /* show the entire image — no cropping */
  display: block;
}

/* Fallback image (Frame_212.png) */
.m-collection-offer-banner__fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: stretch;
}

.m-collection-offer-banner__fallback-img {
  width: 100%;
  height: 100%;
  object-fit: cover;  /* show the entire image — no cropping */
  display: block;
}

/* Mobile — match the 2-column card layout */
@media screen and (max-width: 767px) {
  .m-collection-offer-banner__link {
    border-radius: 10px; /* match product-card-4 mobile border-radius */
  }

  .m-collection-products .m-product-item:not(.m-collection-inline-icon-box-row) {
    width: 100% !important;
    max-width: 100% !important;
    flex: 0 0 100% !important;
    box-sizing: border-box !important;
  }

  .m-collection-products .m-collection-inline-icon-box-row {
    width: 100% !important;
    max-width: 100% !important;
    flex: 0 0 100% !important;
    box-sizing: border-box !important;
    grid-column: 1 / -1 !important;
  }
}