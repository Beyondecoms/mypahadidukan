/* =============================================
   Product Title Actions (Wishlist + Share)
   ============================================= */

/*
  DESKTOP (>= 768px):
  The theme's product.css already handles:
    .main-product__block .m-product-wishlist { position: absolute; top: 0; right: 0 }
    .main-product__block .product-block-group--title { padding-right: 48px }
  We just let our wrapper sit naturally — it's zero-size since the wishlist inside is absolute.
  Share button is hidden on desktop.
*/
.main-product__block .m-product-title-actions {
  /* no position — let wishlist child's own position:absolute handle desktop placement */
  display: contents; /* wrapper is invisible on desktop, children render as-is */
}

.main-product__block .m-product-share-btn {
  display: none; /* hidden on desktop */
}

/* ── Mobile only (max-width: 767px) ── */
@media screen and (max-width: 767px) {

  /* Title row: flex — title left, icons right */
  .main-product__block .product-vendor-my-pahadi-dukan.product-block-group--title {
    display: flex !important;
    flex-direction: row !important;
    align-items: flex-start !important;
    justify-content: space-between !important;
    flex-wrap: wrap !important;
    padding-right: 0 !important; /* override desktop padding-right:48px */
  }

  /* Title fills the left */
  .main-product__block .product-vendor-my-pahadi-dukan.product-block-group--title > h1.m-product-title,
  .main-product__block .product-vendor-my-pahadi-dukan.product-block-group--title > h2.m-product-title {
    flex: 1 1 auto !important;
    min-width: 0 !important;
    margin-right: 12px !important;
    display: block !important; /* override theme's inline-block on mobile */
  }

  /* Actions wrapper: visible flex row on mobile */
  .main-product__block .product-vendor-my-pahadi-dukan .m-product-title-actions {
    display: flex !important;   /* override display:contents */
    flex-direction: row !important;
    align-items: center !important;
    gap: 14px !important;
    flex-shrink: 0 !important;
    margin-top: 4px !important;
    position: static !important;
  }

  /* Override theme's position:absolute on the wishlist div inside our wrapper */
  .main-product__block .product-vendor-my-pahadi-dukan .m-product-title-actions .m-product-wishlist {
    position: static !important;
    display: block !important;
  }

  /* Strip decoration from the wishlist button/tooltip on mobile */
  .main-product__block .product-vendor-my-pahadi-dukan .m-product-title-actions .m-product-wishlist .m-tooltip,
  .main-product__block .product-vendor-my-pahadi-dukan .m-product-title-actions .m-product-wishlist button {
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
    border-radius: 0 !important;
    width: auto !important;
    height: auto !important;
    min-width: 0 !important;
    min-height: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  /* Show share button on mobile — bare icon */
  .main-product__block .product-vendor-my-pahadi-dukan .m-product-share-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: none !important;
    border-radius: 0 !important;
    background: transparent !important;
    cursor: pointer !important;
    padding: 0 !important;
    margin: 0 !important;
    color: rgb(var(--color-foreground)) !important;
    flex-shrink: 0 !important;
  }

  /* Highlights wrap to a new row below title + icons */
  .main-product__block .product-vendor-my-pahadi-dukan.product-block-group--title .product-highlights {
    flex-basis: 100%;
    order: 10;
    margin-top: 8px;
  }
}

/* Wishlist heart state styling */
.m-wishlist-button .m-tooltip-icon--active {
  display: none !important;
}

.m-wishlist-button.added-to-wishlist .m-tooltip-icon,
.m-wishlist-button.active .m-tooltip-icon,
.m-wishlist-button.is-active .m-tooltip-icon {
  display: none !important;
}

.m-wishlist-button.added-to-wishlist .m-tooltip-icon--active,
.m-wishlist-button.active .m-tooltip-icon--active,
.m-wishlist-button.is-active .m-tooltip-icon--active {
  display: inline-flex !important;
