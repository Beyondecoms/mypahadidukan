.m-product-quickview--info .main-product__block:nth-child(3) { animation-delay: 0.3s; }
.m-product-quickview--info .main-product__block:nth-child(4) { animation-delay: 0.4s; }
.m-product-quickview--info .main-product__block:nth-child(5) { animation-delay: 0.5s; }
.m-product-quickview--info .main-product__block:nth-child(6) { animation-delay: 0.6s; }

/* ─── Accessibility ─── */
