.m-product-quickview--info .m-quantity__input::-webkit-outer-spin-button,
.m-product-quickview--info .m-quantity__input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.m-product-quickview--info .m-quantity__input:focus {
  outline: none;
}

/* ─── Add to Cart Button ─── */
.m-product-quickview--info .m-add-to-cart {
  position: relative;
  overflow: hidden;
  color: white !important;
  border: none !important;
  border-radius: var(--qv-radius-md) !important;
  font-size: 1.0625rem !important;
  font-weight: 700 !important;
  cursor: pointer;
  transition: var(--qv-transition);
  box-shadow: 0 4px 14px rgba(45, 106, 79, 0.3) !important;
  text-transform: none !important;
  letter-spacing: 0.01em !important;
}

.m-product-quickview--info .m-add-to-cart::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: 0.5s;
}

.m-product-quickview--info .m-add-to-cart:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(45, 106, 79, 0.4) !important;
}

.m-product-quickview--info .m-add-to-cart:hover::before {
  left: 100%;
}

.m-product-quickview--info .m-add-to-cart:active {
  transform: translateY(0);
}

/* ─── Buy It Now Buttons ─── */
.m-product-quickview--info .shopify-payment-button__button--unbranded,
.m-product-quickview--info #gokwik-buy-now {
  background: linear-gradient(135deg, var(--qv-primary-dark) 0%, var(--qv-primary) 100%) !important;
  color: white !important;
  border: none !important;
  border-radius: var(--qv-radius-md) !important;
  padding: 14px 32px !important;
  font-size: 1.0625rem !important;
  font-weight: 700 !important;
  cursor: pointer;
  transition: var(--qv-transition);
  box-shadow: 0 4px 14px rgba(27, 67, 50, 0.3) !important;
  width: 100% !important;
  margin-top: 12px !important;
  text-transform: uppercase !important;
  letter-spacing: 0.05em !important;
}

.m-product-title a {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
}

.m-product-quickview--info .shopify-payment-button__button--unbranded:hover,
.m-product-quickview--info #gokwik-buy-now:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(27, 67, 50, 0.4) !important;
}

/* ─── Form Layout ─── */
.m-product-quickview--info .m-product-form--wrapper {
  gap: 0px !important;
}

.m-product-quickview--info .m-product-form--input {
  flex: 0 0 auto !important;
}

