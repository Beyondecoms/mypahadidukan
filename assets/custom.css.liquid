/* ============================================
   SCOPED QUICK VIEW REDESIGN
   Targets ONLY .m-product-quickview--info
   Won't affect product page with same classes
   ============================================ */

/* ─── CSS Variables (scoped within quickview) ─── */
.m-product-quickview--info {
  --qv-primary: #2D6A4F;
  --qv-primary-dark: #1B4332;
  --qv-primary-light: #40916C;
  --qv-accent: #E76F51;
  --qv-accent-hover: #D45A3C;
  --qv-gold: #D4A574;
  --qv-bg: #FAFAF8;
  --qv-card-bg: #FFFFFF;
  --qv-text-primary: #1A1A1A;
  --qv-text-secondary: #6B7280;
  --qv-text-muted: #9CA3AF;
  --qv-border: #E5E7EB;
  --qv-border-light: #F3F4F6;
  --qv-shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --qv-shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --qv-shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --qv-shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  --qv-radius-sm: 8px;
  --qv-radius-md: 12px;
  --qv-radius-lg: 16px;
  --qv-radius-xl: 24px;
  --qv-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ─── Main Quickview Container ─── */
.m-product-quickview--info {
  background: var(--qv-bg);
  padding: 0;
  overflow-y: auto;
  scrollbar-width: thin;
  scrollbar-color: var(--qv-primary-light) transparent;
}

.m-product-quickview--info::-webkit-scrollbar {
  width: 6px;
}

.m-product-quickview--info::-webkit-scrollbar-track {
  background: transparent;
}

.m-product-quickview--info::-webkit-scrollbar-thumb {
  background: var(--qv-primary-light);
  border-radius: 10px;
}

/* ─── Product Info Wrapper ─── */
.m-product-quickview--info .m-product-info--wrapper {
  padding: 28px 32px;
  max-width: 100%;
}

/* ─── Product Title ─── */
.m-product-quickview--info .main-product__block-title {
  margin-bottom: 16px;
}

.m-product-quickview--info .m-product-title {
  font-size: 1.75rem;
  font-weight: 700;
  line-height: 1.3;
  color: var(--qv-text-primary);
  margin: 0;
  letter-spacing: -0.02em;
}

.m-product-quickview--info .m-product-title a {
  color: inherit;
  text-decoration: none;
  transition: var(--qv-transition);
  background: linear-gradient(135deg, var(--qv-primary) 0%, var(--qv-primary-light) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.m-product-quickview--info .m-product-title a:hover {
  opacity: 0.8;
}

/* ─── Price Section ─── */
.m-product-quickview--info .main-product__block-price {
  margin-bottom: 5px;
}

.m-product-quickview--info .m-price {
  gap: 12px;
  align-items: center;
}

.m-product-quickview--info .m-price__sale {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.m-product-quickview--info .m-price-item--sale {
  font-size: 1.5rem !important;
  font-weight: 800 !important;
  color: var(--qv-primary) !important;
  letter-spacing: -0.03em;
}

a.m-product-card__link.m\:block.m\:w-full.restock-rocket-collection-rendered [style*='--aspect-ratio']:before{
padding-top: calc(100% / (0.0001 + var(--aspect-ratio, 16 / 3)));
}
.template-collection a.m-product-card__link.m\:block.m\:w-full.restock-rocket-collection-rendered [style*='--aspect-ratio']:before{
padding-top: calc(75% / (0.0001 + var(--aspect-ratio, 16 / 3)));
}


.m-product-quickview--info .main-product__block+.main-product__block{
 margin-top: 20px !important; 
}

.m-product-quickview--info .m-price-item--regular s {
  font-size: 1.25rem;
  color: var(--qv-text-muted);
  text-decoration: none;
  position: relative;
}

.m-product-quickview--info .m-price-item--regular s::after {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  width: 100%;
  height: 2px;
  background: var(--qv-accent);
  transform: rotate(-5deg);
}

.m-product-quickview--info .m-price__badge-sale {
  animation: qv-pulse-badge 2s infinite;
}

.m-product-quickview--info .m-product-tag--sale {
  background: linear-gradient(135deg, var(--qv-accent) 0%, var(--qv-accent-hover) 100%) !important;
  color: white !important;
  border-radius: 50px !important;
  font-size: 0.875rem !important;
  font-weight: 700 !important;
  text-transform: uppercase !important;
  letter-spacing: 0.05em !important;
  box-shadow: 0 4px 14px rgba(231, 111, 81, 0.4) !important;
}
.m-product-quickview--info span.vertas{
   font-size: 10px;
}
@keyframes qv-pulse-badge {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

/* ─── Description ─── */
.m-product-quickview--info .main-product__block-description {
  font-size: 9px;
  line-height: 0;
  color: var(--qv-text-secondary);
  margin-bottom: 5px;
  padding: 10px;
  background: var(--qv-card-bg);
  border-radius: var(--qv-radius-md);
  border: 1px solid var(--qv-border-light);
  box-shadow: var(--qv-shadow-sm);
}

.m-product-quickview--info .m-product-quickview--viewmore {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 12px;
  color: var(--qv-primary);
  font-weight: 600;
  text-decoration: none;
  transition: var(--qv-transition);
}

.m-product-quickview--info .m-product-quickview--viewmore::after {
  content: '→';
  transition: var(--qv-transition);
}

.m-product-quickview--info .m-product-quickview--viewmore:hover {
  color: var(--qv-primary-dark);
  gap: 10px;
}

/* ─── Inventory Status ─── */
.m-product-quickview--info .main-product__block-inventory_status {
  margin-bottom: 5px;
}
.m-product-quickview--info .option-label--title{
