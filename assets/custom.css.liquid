/* Custom Product Page Important Information Link & Modal */
.important-info-trigger {
  display: inline-flex;
  align-items: center;
  background: none !important;
  border: none !important;
  box-shadow: none !important;
  padding: 0 !important;
  margin: 15px 0 !important;
  color: #E8513F !important;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  font-family: inherit;
  transition: opacity 0.2s ease;
  line-height: 1.2;
}

.important-info-trigger:hover {
  opacity: 0.85;
}

.important-info-trigger .warning-text {
  text-decoration: underline;
  margin: 0 6px;
}

.important-info-trigger .warning-icon-wrapper {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.important-info-trigger .chevron-wrapper {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* Modal Overlay style */
.important-info-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100000;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.important-info-modal-overlay[aria-hidden="false"] {
  opacity: 1;
  pointer-events: auto;
}

/* Modal Container style */
.important-info-modal-container {
  background-color: #ffffff;
  border-radius: 18px;
  padding: 24px;
  position: relative;
  width: 90%;
  max-width: 420px;
  box-sizing: border-box;
  transform: scale(0.85);
  opacity: 0;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
  box-shadow: 0 10px 30px rgba(0,0,0,0.15);
}

.important-info-modal-overlay[aria-hidden="false"] .important-info-modal-container {
  transform: scale(1);
  opacity: 1;
}

/* Close button style */
.important-info-modal-close {
  position: absolute;
  top: 16px;
  right: 16px;
  background: none !important;
  border: none !important;
  font-size: 28px;
  font-weight: 300;
  color: #888888 !important;
  cursor: pointer;
  line-height: 1;
  padding: 4px !important;
  transition: color 0.2s ease;
}

.important-info-modal-close:hover,
.important-info-modal-close:focus {
  color: #000000 !important;
  outline: none;
}

/* Typography styles */
.important-info-modal-title {
  font-size: 24px;
  font-weight: bold;
  color: #D7862D !important;
  margin-top: 0;
  margin-bottom: 16px;
  line-height: 1.2;
}

.important-info-modal-body {
  font-size: 18px;
  line-height: 1.7;
  color: #222222 !important;
  margin: 0;
}

/* Custom Variant Picker Dilution Notice Layout */

/* Mobile (Default) Layout: Label -> Swatches -> Dilution Notice (centered) */
.main-product__block-variant_picker .m-product-option__inner {
